---
import '../styles/global.css';
import '../styles/redesign.css';

interface Props {
	title: string;
	description: string;
	lang?: 'en' | 'es';
	type?: 'website' | 'article';
}

const {
	title,
	description,
	lang = 'en',
	type = 'website',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://federodrigo.com');

const currentPath = Astro.url.pathname;

const normalizedPath =
	currentPath === '/'
		? '/'
		: currentPath.endsWith('/')
			? currentPath
			: `${currentPath}/`;

let englishPath: string;
let spanishPath: string;

if (normalizedPath === '/es/') {
	englishPath = '/';
	spanishPath = '/es/';
} else if (normalizedPath.startsWith('/es/')) {
	englishPath = normalizedPath.replace(/^\/es/, '');
	spanishPath = normalizedPath;
} else {
	englishPath = normalizedPath;
	spanishPath =
		normalizedPath === '/'
			? '/es/'
			: `/es${normalizedPath}`;
}

const canonicalPath =
	lang === 'es'
		? spanishPath
		: englishPath;

const canonicalURL = new URL(canonicalPath, siteUrl);
const englishURL = new URL(englishPath, siteUrl);
const spanishURL = new URL(spanishPath, siteUrl);
const imageURL = new URL('/images/fede-rodrigo-share-logo.png', siteUrl);

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': new URL('/#website', siteUrl).href,
			url: new URL('/', siteUrl).href,
			name: 'Fede Rodrigo',
			description:
				'Personal website of Fede Rodrigo, Chief Information Officer, advisor, speaker, and author.',
			inLanguage: ['en', 'es'],
			publisher: {
				'@id': new URL('/#person', siteUrl).href,
			},
		},
		{
			'@type': 'Person',
			'@id': new URL('/#person', siteUrl).href,
			name: 'Federico Rodrigo',
			alternateName: 'Fede Rodrigo',
			url: new URL('/', siteUrl).href,
			image: new URL('/images/fede.png', siteUrl).href,
			jobTitle: 'Chief Information Officer',
			description:
				'Chief Information Officer, advisor, speaker, and author focused on business value, leadership, technology strategy, and operational excellence.',
			sameAs: [
				'https://www.linkedin.com/in/fede-rodrigo/',
			],
			knowsAbout: [
				'Technology strategy',
				'IT leadership',
				'Business value',
				'Digital transformation',
				'Technology operations',
			],
		},
	],
};
---

<!-- Global metadata -->
<meta charset="utf-8" />

<meta
	name="viewport"
	content="width=device-width, initial-scale=1"
/>

<link
	rel="icon"
	type="image/svg+xml"
	href="/favicon.svg"
/>

<meta
	name="generator"
	content={Astro.generator}
/>

<title>{title}</title>

<meta
	name="title"
	content={title}
/>

<meta
	name="description"
	content={description}
/>

<!-- Canonical and language alternatives -->
<link
	rel="canonical"
	href={canonicalURL}
/>

<link
	rel="alternate"
	hreflang="en"
	href={englishURL}
/>

<link
	rel="alternate"
	hreflang="es"
	href={spanishURL}
/>

<link
	rel="alternate"
	hreflang="x-default"
	href={englishURL}
/>

<!-- Open Graph -->
<meta
	property="og:type"
	content={type}
/>

<meta
	property="og:url"
	content={canonicalURL}
/>

<meta
	property="og:title"
	content={title}
/>

<meta
	property="og:description"
	content={description}
/>

<meta
	property="og:image"
	content={imageURL}
/>

<meta property="og:image:secure_url" content={imageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Fede Rodrigo" />
<link rel="image_src" href={imageURL} />

<meta
	property="og:site_name"
	content="Fede Rodrigo"
/>

<meta
	property="og:locale"
	content={lang === 'es' ? 'es_ES' : 'en_US'}
/>

<meta
	property="og:locale:alternate"
	content={lang === 'es' ? 'en_US' : 'es_ES'}
/>

<!-- Twitter -->
<meta
	name="twitter:card"
	content="summary_large_image"
/>

<meta
	name="twitter:url"
	content={canonicalURL}
/>

<meta
	name="twitter:title"
	content={title}
/>

<meta
	name="twitter:description"
	content={description}
/>

<meta
	name="twitter:image"
	content={imageURL}
/>

<meta name="twitter:image:alt" content="Fede Rodrigo" />

<!-- Structured data -->
<script
	type="application/ld+json"
	set:html={JSON.stringify(structuredData)}
	is:inline
></script>
