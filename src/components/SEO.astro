---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	lang?: 'en' | 'es';
	image?: string;
	type?: 'website' | 'article';
}

const {
	title,
	description,
	lang = 'en',
	image = '/fede.png',
	type = 'website',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://federodrigo.com');

const currentPath = Astro.url.pathname;

const normalizedPath =
	currentPath === '/'
		? '/'
		: currentPath.endsWith('/')
			? currentPath
			: `${currentPath}/`;

let englishPath: string;
let spanishPath: string;

if (normalizedPath === '/es/') {
	englishPath = '/';
	spanishPath = '/es/';
} else if (normalizedPath.startsWith('/es/')) {
	englishPath = normalizedPath.replace(/^\/es/, '');
	spanishPath = normalizedPath;
} else {
	englishPath = normalizedPath;
	spanishPath =
		normalizedPath === '/'
			? '/es/'
			: `/es${normalizedPath}`;
}

const canonicalPath =
	lang === 'es'
		? spanishPath
		: englishPath;

const canonicalURL = new URL(canonicalPath, siteUrl);
const englishURL = new URL(englishPath, siteUrl);
const spanishURL = new URL(spanishPath, siteUrl);
const imageURL = new URL(image, siteUrl);
---

<!-- Global metadata -->
<meta charset="utf-8" />

<meta
	name="viewport"
	content="width=device-width, initial-scale=1"
/>

<link
	rel="icon"
	type="image/svg+xml"
	href="/favicon.svg"
/>

<meta
	name="generator"
	content={Astro.generator}
/>

<!-- Font preloads -->
<link
	rel="preload"
	href="/fonts/atkinson-regular.woff"
	as="font"
	type="font/woff"
	crossorigin
/>

<link
	rel="preload"
	href="/fonts/atkinson-bold.woff"
	as="font"
	type="font/woff"
	crossorigin
/>

<!-- Primary metadata -->
<title>{title}</title>

<meta
	name="title"
	content={title}
/>

<meta
	name="description"
	content={description}
/>

<!-- Canonical and language alternatives -->
<link
	rel="canonical"
	href={canonicalURL}
/>

<link
	rel="alternate"
	hreflang="en"
	href={englishURL}
/>

<link
	rel="alternate"
	hreflang="es"
	href={spanishURL}
/>

<link
	rel="alternate"
	hreflang="x-default"
	href={englishURL}
/>

<!-- Open Graph -->
<meta
	property="og:type"
	content={type}
/>

<meta
	property="og:url"
	content={canonicalURL}
/>

<meta
	property="og:title"
	content={title}
/>

<meta
	property="og:description"
	content={description}
/>

<meta
	property="og:image"
	content={imageURL}
/>

<meta
	property="og:site_name"
	content="Fede Rodrigo"
/>

<meta
	property="og:locale"
	content={lang === 'es' ? 'es_ES' : 'en_US'}
/>

<meta
	property="og:locale:alternate"
	content={lang === 'es' ? 'en_US' : 'es_ES'}
/>

<!-- Twitter -->
<meta
	name="twitter:card"
	content="summary_large_image"
/>

<meta
	name="twitter:url"
	content={canonicalURL}
/>

<meta
	name="twitter:title"
	content={title}
/>

<meta
	name="twitter:description"
	content={description}
/>

<meta
	name="twitter:image"
	content={imageURL}
/>
