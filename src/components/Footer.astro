---
const today = new Date();
const isSpanish = Astro.url.pathname.startsWith('/es');

const currentPath =
	Astro.url.pathname.replace(/\/+$/, '') || '/';

const navigation = isSpanish
	? [
			{ label: 'Oficina del CIO', href: '/es/cio-office/' },
			{ label: 'Charlas', href: '/es/speaking/' },
			{ label: 'Libros', href: '/es/books/' },
			{ label: 'Sobre mí', href: '/es/about/' },
			{ label: 'Contacto', href: '/es/contact/' },
		]
	: [
			{ label: 'CIO Office', href: '/cio-office/' },
			{ label: 'Speaking', href: '/speaking/' },
			{ label: 'Books', href: '/books/' },
			{ label: 'About', href: '/about/' },
			{ label: 'Contact', href: '/contact/' },
		];

const englishPath = isSpanish
	? Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/'
	: Astro.url.pathname;

const spanishPath = isSpanish
	? Astro.url.pathname
	: Astro.url.pathname === '/'
		? '/es/'
		: `/es${Astro.url.pathname}`;
---

<footer class="site-footer">
	<div class="footer-shell">

		<div class="footer-main">

			<div class="footer-brand">
				<a
					href={isSpanish ? '/es/' : '/'}
					class="footer-name"
				>
					Fede Rodrigo
				</a>

				<p class="footer-role">
					{isSpanish
						? 'CIO · Speaker · Autor'
						: 'CIO · Speaker · Author'}
				</p>

				<div class="footer-socials">
					<a
						href="mailto:contact@federodrigo.com"
						aria-label={isSpanish ? 'Correo electrónico' : 'Email'}
						title={isSpanish ? 'Correo electrónico' : 'Email'}
					>
						✉
					</a>

					<a
						href="https://www.linkedin.com/in/fede-rodrigo/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
						title="LinkedIn"
					>
						in
					</a>
				</div>
			</div>

			<nav
				class="footer-navigation"
				aria-label={isSpanish
					? 'Navegación del pie de página'
					: 'Footer navigation'}
			>
				<p class="footer-navigation-title">
					{isSpanish ? 'Navegar' : 'Navigate'}
				</p>

				<ul>
					{
						navigation.map((item) => {
							const itemPath =
								item.href.replace(/\/+$/, '') || '/';

							const isActive = currentPath === itemPath;

							return (
								<li>
									<a
										href={item.href}
										aria-current={isActive ? 'page' : undefined}
									>
										{item.label}
									</a>
								</li>
							);
						})
					}
				</ul>
			</nav>

		</div>

		<div class="footer-bottom">
			<p>
				© {today.getFullYear()} Fede Rodrigo
			</p>

			<div
				class="footer-language"
				aria-label={isSpanish ? 'Seleccionar idioma' : 'Select language'}
			>
				<a
					href={englishPath}
					class={!isSpanish ? 'is-active' : undefined}
					aria-current={!isSpanish ? 'page' : undefined}
				>
					EN
				</a>

				<span aria-hidden="true">·</span>

				<a
					href={spanishPath}
					class={isSpanish ? 'is-active' : undefined}
					aria-current={isSpanish ? 'page' : undefined}
				>
					ES
				</a>
			</div>
		</div>

	</div>
</footer>

<style>
	.site-footer {
		margin-top: 0;
		padding: 32px 24px 18px;
		border-top: 1px solid #d9e3f0;
		background: #f7f9fc;
	}

	.footer-shell {
		width: min(1040px, 100%);
		margin: 0 auto;
	}

	.footer-main {
		display: grid;
		grid-template-columns: auto auto;
		justify-content: space-between;
		align-items: start;
		gap: 50px;

		width: min(820px, 100%);
		margin: 0 auto;

		padding-bottom: 26px;
	}

	.footer-brand {
		min-width: 0;
	}

	.footer-name {
		display: inline-block;
		color: #102a43;
		font-size: clamp(1.4rem, 2vw, 1.8rem);
		font-weight: 750;
		line-height: 1.1;
		letter-spacing: -0.035em;

		text-decoration: none !important;
		border: none !important;
		border-bottom: none !important;
		box-shadow: none !important;
		background: none !important;
		background-image: none !important;

		transition: color 180ms ease;
	}

	.footer-name:hover {
		color: #4667e2;

		text-decoration: none !important;
		border: none !important;
		border-bottom: none !important;
		box-shadow: none !important;
		background: none !important;
		background-image: none !important;
	}

	.footer-name::before,
	.footer-name::after {
		display: none !important;
		content: none !important;
	}

	.footer-role {
		margin: 10px 0 0;
		color: #64748b;
		font-size: 0.98rem;
		line-height: 1.45;
	}

	.footer-socials {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 18px;
	}

	.footer-socials a {
		display: flex;
		align-items: center;
		justify-content: center;

		width: 34px;
		height: 34px;

		border: 1px solid #d9e3f0;
		border-radius: 50%;

		color: #64748b;
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1;

		text-decoration: none !important;
		box-shadow: none !important;
		background: none !important;
		background-image: none !important;

		transition:
			color 180ms ease,
			border-color 180ms ease,
			transform 180ms ease;
	}

	.footer-socials a:hover {
		color: #102a43;
		border-color: #102a43;
		transform: translateY(-1px);

		text-decoration: none !important;
	}

	.footer-socials a::before,
	.footer-socials a::after {
		display: none !important;
		content: none !important;
	}

	.footer-navigation {
		min-width: 0;
		padding-top: 2px;
	}

	.footer-navigation-title {
		margin: 0 0 13px;

		color: #102a43;
		font-size: 0.72rem;
		font-weight: 750;
		line-height: 1.2;

		letter-spacing: 0.19em;
		text-transform: uppercase;
	}

	.footer-navigation ul {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;

		gap: 21px;

		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-navigation li {
		margin: 0;
		padding: 0;
		white-space: nowrap;
	}

	.footer-navigation a {
		display: inline-block;

		color: #64748b;
		font-size: 0.98rem;
		font-weight: 600;
		line-height: 1.35;

		text-decoration: none !important;
		border: none !important;
		border-bottom: none !important;
		box-shadow: none !important;
		background: none !important;
		background-image: none !important;

		transition: color 180ms ease;
	}

	.footer-navigation a:hover {
		color: #4667e2;

		text-decoration: none !important;
		border: none !important;
		border-bottom: none !important;
		box-shadow: none !important;
		background: none !important;
		background-image: none !important;
	}

	.footer-navigation a:focus,
	.footer-navigation a:active,
	.footer-navigation a:visited {
		text-decoration: none !important;
		border: none !important;
		border-bottom: none !important;
		box-shadow: none !important;
		background: none !important;
		background-image: none !important;
	}

	.footer-navigation a[aria-current='page'] {
		color: #102a43;

		text-decoration: none !important;
		border: none !important;
		border-bottom: none !important;
		box-shadow: none !important;
		background: none !important;
		background-image: none !important;
	}

	.footer-navigation a::before,
	.footer-navigation a::after {
		display: none !important;
		width: 0 !important;
		height: 0 !important;
		border: 0 !important;
		background: none !important;
		background-image: none !important;
		content: none !important;
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;

		padding-top: 16px;

		border-top: 1px solid #d9e3f0;

		color: #64748b;
		font-size: 0.82rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	.footer-language {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.footer-language span {
		color: #a8b3c2;
	}

	.footer-language a {
		color: #64748b;
		font-weight: 650;
		letter-spacing: 0.04em;

		text-decoration: none !important;
		border: none !important;
		border-bottom: none !important;
		box-shadow: none !important;
		background: none !important;
		background-image: none !important;

		transition: color 180ms ease;
	}

	.footer-language a:hover {
		color: #4667e2;

		text-decoration: none !important;
		border: none !important;
		border-bottom: none !important;
	}

	.footer-language a.is-active {
		color: #102a43;

		text-decoration: none !important;
		border: none !important;
		border-bottom: none !important;
	}

	.footer-language a::before,
	.footer-language a::after {
		display: none !important;
		content: none !important;
	}

	.footer-socials a:focus-visible,
	.footer-navigation a:focus-visible,
	.footer-language a:focus-visible,
	.footer-name:focus-visible {
		outline: 2px solid #6fa7ef;
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.footer-main {
			width: 100%;
			grid-template-columns: 1fr;
			gap: 28px;
		}

		.footer-navigation {
			padding-top: 0;
		}

		.footer-navigation ul {
			flex-wrap: wrap;
			gap: 10px 22px;
		}
	}

	@media (max-width: 520px) {
		.site-footer {
			padding: 28px 20px 18px;
		}

		.footer-navigation ul {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 10px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-name,
		.footer-socials a,
		.footer-navigation a,
		.footer-language a {
			transition: none;
		}
	}
</style>
