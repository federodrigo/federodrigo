---
const es = Astro.url.pathname.startsWith('/es');
const base = es ? '/es' : '';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const enPath = es ? path.replace(/^\/es/, '') || '/' : path;
const esPath = es ? path : `/es${path === '/' ? '/' : path}`;
const links = [['speaking','Speaking','Charlas'],['cio-office','Advisory','Consultoría'],['stories','Stories','Historias'],['books','Books','Libros'],['about','About','Sobre mí'],['contact','Contact','Contacto']];
---
<footer class="site-footer"><div class="wrap">
  <div class="footer-main">
    <div class="footer-brand">
      <div class="footer-brand-row"><a class="wordmark" aria-label="Fede Rodrigo" href={es ? '/es/' : '/'}>fede<span>rodrigo</span><span class="wordmark-dot" aria-hidden="true">.</span></a>
        <div class="footer-social"><a href="mailto:contact@federodrigo.com" aria-label={es ? 'Escribir por correo' : 'Email Fede Rodrigo'} title="contact@federodrigo.com"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></a><a href="https://www.linkedin.com/in/fede-rodrigo/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96C2 21.32 2.69 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.31h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.53 1.96 3.53 4.51v5.25h.05Z"/></svg></a></div>
      </div>
      <p class="footer-role">{es ? 'CIO · Asesor · Speaker · Autor' : 'CIO · Advisor · Speaker · Author'}</p>
    </div>
    <div class="footer-utility"><a class="footer-top" href="#top">{es ? 'Volver al inicio' : 'Back to the start'} <span aria-hidden="true">↑</span></a><nav class="footer-nav" aria-label={es ? 'Navegación al pie' : 'Footer navigation'}>{links.map(([slug,en,spanish])=><a href={`${base}/${slug}/`}>{es ? spanish : en}</a>)}</nav></div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()}</span><nav class="footer-languages" aria-label={es ? 'Idioma' : 'Language'}><a href={enPath === '/' ? '/' : enPath + '/'} lang="en" aria-current={!es ? 'page' : undefined}>{es ? 'Inglés' : 'English'}</a><span aria-hidden="true">/</span><a href={esPath.endsWith('/') ? esPath : esPath + '/'} lang="es" aria-current={es ? 'page' : undefined}>Español</a></nav></div>
</div></footer>
