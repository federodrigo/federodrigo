---
const today = new Date();
const isSpanish = Astro.url.pathname.startsWith('/es');
---

<footer>
	<div class="footer-content">

		<div class="footer-left">
			<p>© {today.getFullYear()} Fede Rodrigo · {isSpanish ? 'CIO · Speaker · Autor' : 'CIO · Speaker · Author'}</p>
		</div>

		<div class="footer-right">
			<a
				href="mailto:contact@federodrigo.com"
				aria-label="Email"
				title="Email"
			>
				✉
			</a>

			<a
				href="https://www.linkedin.com/in/fede-rodrigo/"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="LinkedIn"
				title="LinkedIn"
			>
				in
			</a>
		</div>

	</div>
</footer>

<style>
	footer {
		margin-top: 0;
		padding: 28px 24px;
		border-top: 1px solid #d9e3f0;
	}

	.footer-content {
		max-width: 920px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.9rem;
		color: #64748b;
	}

	.footer-left p {
		margin: 0;
	}

	.footer-right {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.footer-right a {
		width: 34px;
		height: 34px;
		border: 1px solid #d9e3f0;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		color: #64748b;
		font-size: 1rem;
		font-weight: 600;
		transition: all 0.2s ease;
	}

	.footer-right a:hover {
		color: #102a43;
		border-color: #102a43;
		transform: translateY(-1px);
	}

	@media (max-width: 720px) {
		.footer-content {
			flex-direction: column;
			gap: 14px;
		}
	}
</style>
