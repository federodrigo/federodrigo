---
const es = Astro.url.pathname.startsWith('/es');
const base = es ? '/es' : '';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const enPath = es ? path.replace(/^\/es/, '') || '/' : path;
const esPath = es ? path : `/es${path === '/' ? '/' : path}`;
const items = [
  { slug: 'speaking', en: 'Speaking', es: 'Charlas' },
  { slug: 'cio-office', en: 'Advisory', es: 'Consultoría' },
  { slug: 'stories', en: 'Stories', es: 'Historias' },
  { slug: 'books', en: 'Books', es: 'Libros' },
  { slug: 'about', en: 'About', es: 'Sobre mí' },
  { slug: 'contact', en: 'Contact', es: 'Contacto' },
];
---
<a class="skip-link" href="#main-content">{es ? 'Ir al contenido' : 'Skip to content'}</a>
<header class="site-header" id="top">
  <div class="wrap header-inner">
    <a class="wordmark" href={es ? '/es/' : '/'} aria-label={es ? 'Fede Rodrigo, inicio' : 'Fede Rodrigo, home'}>fede<span>rodrigo</span><span class="wordmark-dot" aria-hidden="true">.</span></a>
    <nav class="main-nav" id="primary-navigation" aria-label={es ? 'Navegación principal' : 'Main navigation'}>
      {items.map(item => <a href={`${base}/${item.slug}/`} class:list={{ 'nav-active': path === `${base}/${item.slug}` || (item.slug === 'stories' && path.startsWith(`${base}/stories/`)) || (item.slug === 'books' && /\/(cio-book|itworks-book)$/.test(path)) }} aria-current={path === `${base}/${item.slug}` ? 'page' : undefined}>{es ? item.es : item.en}</a>)}
    </nav>
    <div class="header-tools">
      <div class="language-switch" role="group" aria-label={es ? 'Idioma' : 'Language'}>
        <a href={enPath === '/' ? '/' : enPath + '/'} lang="en" data-language="en" aria-current={!es ? 'page' : undefined}>EN</a><span aria-hidden="true">/</span><a href={esPath.endsWith('/') ? esPath : esPath + '/'} lang="es" data-language="es" aria-current={es ? 'page' : undefined}>ES</a>
      </div>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label={es ? 'Abrir menú' : 'Open menu'}><span class="menu-toggle-label">{es ? 'Menú' : 'Menu'}</span><span class="menu-icon" aria-hidden="true"><i></i><i></i></span></button>
    </div>
  </div>
</header>
<button class="menu-backdrop" tabindex="-1" aria-label={es ? 'Cerrar menú' : 'Close menu'} hidden></button>
