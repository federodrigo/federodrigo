---
const isSpanish = Astro.url.pathname.startsWith('/es');
const base = isSpanish ? '/es' : '';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const enPath = isSpanish
	? pathname.replace(/^\/es/, '') || '/'
	: pathname;

const esPath = isSpanish
	? pathname
	: `/es${pathname === '/' ? '/' : pathname}`;

const isActive = (path: string) => {
	const normalizedCurrent = pathname.replace(/\/$/, '') || '/';
	const normalizedTarget = path.replace(/\/$/, '') || '/';

	return normalizedCurrent === normalizedTarget;
};
---

<header class="site-header">
	<div class="header-inner">
		<a
			href={isSpanish ? '/es/' : '/'}
			class="brand"
			aria-label={isSpanish ? 'Página de inicio' : 'Home'}
		>
			<span class="brand-name">Fede Rodrigo</span>

		</a>

		<nav
			class="main-nav"
			aria-label={isSpanish ? 'Navegación principal' : 'Main navigation'}
		>
		

			<a
				href={`${base}/cio-office`}
				class:list={{ 'nav-active': isActive(`${base}/cio-office`) }}
				aria-current={isActive(`${base}/cio-office`) ? 'page' : undefined}
			>
				{isSpanish ? 'Oficina del CIO' : 'CIO Office'}
			</a>

			
			<a
				href={`${base}/speaking`}
				class:list={{ 'nav-active': isActive(`${base}/speaking`) }}
				aria-current={isActive(`${base}/speaking`) ? 'page' : undefined}
			>
				{isSpanish ? 'Charlas' : 'Speaking'}
			</a>

			<a
				href={`${base}/books`}
				class:list={{ 'nav-active': isActive(`${base}/books`) }}
				aria-current={isActive(`${base}/books`) ? 'page' : undefined}
			>
				{isSpanish ? 'Libros' : 'Books'}
			</a>

			<a
				href={`${base}/papers`}
				class:list={{ 'nav-active': isActive(`${base}/papers`) }}
				aria-current={isActive(`${base}/papers`) ? 'page' : undefined}
			>
				Papers
			</a>

			<a
				href={`${base}/about`}
				class:list={{ 'nav-active': isActive(`${base}/about`) }}
				aria-current={isActive(`${base}/about`) ? 'page' : undefined}
			>
				{isSpanish ? 'Sobre mí' : 'About'}
			</a>

			<a
				href={`${base}/contact`}
				class:list={{
					'contact-link': true,
					'nav-active': isActive(`${base}/contact`),
				}}
				aria-current={isActive(`${base}/contact`) ? 'page' : undefined}
			>
				{isSpanish ? 'Contacto' : 'Contact'}
			</a>

			<span
				class="lang-switch"
				aria-label={isSpanish ? 'Selector de idioma' : 'Language selector'}
			>
				<a
					href={enPath}
					class={isSpanish ? '' : 'active'}
					lang="en"
					aria-current={isSpanish ? undefined : 'page'}
				>
					EN
				</a>

				<span aria-hidden="true">|</span>

				<a
					href={esPath}
					class={isSpanish ? 'active' : ''}
					lang="es"
					aria-current={isSpanish ? 'page' : undefined}
				>
					ES
				</a>
			</span>
		</nav>
	</div>
</header>
