---
import SEO from './SEO.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SiteEffects from './SiteEffects.astro';
import Arrow from './Arrow.astro';
import Inquiry from './Inquiry.astro';
import stories from '../data/stories.json';
import storyImages from '../data/story-images.json';
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const base = es ? '/es' : '';
const featured = stories.stories[0];
const storyOptions = stories.stories.map(story => {
 const dimensions = storyImages.find(image => image.id === story.id)!;
 return { id: story.id, src: `/images/stories/${story.id}-thumb.webp?v=${story.imageVersion}`, href: `${base}/stories/#story-${story.id}`, alt: story.alt[es ? 'es' : 'en'], label: `${es ? 'Ver historia' : 'View story'}: ${story.title[es ? 'es' : 'en']}`, width: dimensions.width, height: dimensions.height };
});
---
<!doctype html>
<html lang={lang}>
<head><SEO title="Fede Rodrigo | CIO · Advisor · Speaker · Author" description={es ? 'Liderazgo, negocio y tecnología. Conocé las charlas, libros e historias de Fede Rodrigo y su enfoque para crear valor para el negocio.' : 'Leadership, business and technology. Explore Fede Rodrigo’s speaking, books and illustrated stories about creating business value.'} lang={lang} /></head>
<body>
<Header />
<main class="home-main" id="main-content">
  <section class="hero home-hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1 class="hero-title brand-outline-title" aria-label={es ? 'La tecnología nunca es el punto de partida' : 'Technology is never the starting point'}><span class="hero-line"><img src={`/images/brand/starting-point-${lang}-1.svg`} alt="" aria-hidden="true" width={es ? 19294 : 19430} height="2253" style={`width:${es ? 9.4209 : 9.4873}em`} fetchpriority="high" /></span><span class="hero-line"><img src={`/images/brand/starting-point-${lang}-2.svg`} alt="" aria-hidden="true" width={es ? 21137 : 17062} height="2253" style={`width:${es ? 10.3208 : 8.33105}em`} fetchpriority="high" /></span></h1>
        <p class="hero-description">{es ? 'Ayudo a las organizaciones a tomar decisiones tecnológicas que creen valor para el negocio, con más de 15 años de experiencia de liderazgo en Estados Unidos, Europa y Latinoamérica' : 'I help organizations make technology decisions that create business value, drawing on more than 15 years of leadership across the US, Europe and Latin America'}</p>
        <ol class="framework-flow reveal-item" aria-label={es ? 'Personas, negocio, tecnología, en ese orden' : 'People, business, technology, in that order'}>{(es ? ['Personas','Negocio','Tecnología'] : ['People','Business','Technology']).map((label,i)=><li style={`--step:${i}`}><span>{label}</span>{i<2&&<Arrow />}</li>)}</ol>
      </div>
    </div>
  </section>

  <section class="home-speaking section-space section-wash" aria-labelledby="home-speaking-title">
    <div class="wrap"><div class="home-editorial-grid"><a class="home-editorial-image reveal-item" href={`${base}/speaking/`} aria-label={es ? 'Ver la página de charlas' : 'Explore speaking'}><img src={`/images/speaking-cover${es ? '-es' : ''}.png`} alt={es ? 'Una solución tecnológica rodeada por integraciones, excepciones y dependencias' : 'A technology solution surrounded by integrations, exceptions and dependencies'} width="1672" height="941" loading="lazy" /></a><div class="home-editorial-copy"><p class="eyebrow reveal-item">{es ? 'Charlas' : 'Speaking'}</p><h2 class="reveal-item" id="home-speaking-title">{es ? '¿Y si la próxima decisión tecnológica empezara sin tecnología?' : 'What if your next technology decision started with no technology at all?'}</h2><p class="reveal-item">{es ? 'Incluso cuando funciona, un punto de partida equivocado puede generar complejidad, dependencias y menos opciones para el negocio' : 'Even when it works, the wrong starting point can create complexity, dependencies and fewer options for the business'}</p><a class="text-action reveal-item" href={`${base}/speaking/`}>{es ? 'Conocer las charlas' : 'Explore speaking'}<Arrow /></a></div></div>
    <div class="home-events" style="border-top:0;padding-top:0" role="group" aria-label={es ? 'Próximas charlas' : 'Upcoming talks'}><div class="home-events-grid"><a class="home-event event-tedx" style="border-top:0" href="https://www.tedxciudaddelacosta.com/" target="_blank" rel="noopener noreferrer"><div class="event-date"><span>NOV</span><strong>26</strong></div><div><p class="event-type">TEDx · 2026</p><h4>TEDx Ciudad de la Costa</h4></div></a><a class="home-event event-llmday" style="border-top:0" href="https://llmday.com/2026-montevideo-q4/" target="_blank" rel="noopener noreferrer"><div class="event-date"><span>{es ? 'DIC' : 'DEC'}</span><strong>05</strong></div><div><p class="event-type">{es ? 'Conferencia · 2026' : 'Conference · 2026'}</p><h4>LLMday Montevideo</h4></div></a></div></div></div>
  </section>

  <section class="home-advisory wrap section-space" aria-labelledby="home-advisory-title">
    <div class="advisory-grid">
      <div class="advisory-heading">
        <p class="eyebrow reveal-item">{es ? 'Consultoría' : 'Advisory'}</p>
        <h2 class="reveal-item" id="home-advisory-title">{es ? 'Tecnología que crea valor para el negocio' : 'Technology that creates business value'}</h2>
      </div>
      <div class="advisory-copy">
        <p class="section-intro reveal-item">{es ? 'Asesoro a directorios y equipos ejecutivos en inversiones tecnológicas, sistemas empresariales y programas de transformación.' : 'I advise boards and executive teams on technology investments, enterprise systems and transformation programs'}</p>
        <a class="text-action reveal-item advisory-action" href={`${base}/cio-office/`}>{es ? 'Conocer la propuesta de consultoría' : 'Explore advisory services'}<Arrow /></a>
      </div>
    </div>
  </section>

  <section class="home-stories wrap section-space" aria-labelledby="home-stories-title">
    <div class="home-story-feature">
      <div class="home-story-copy"><p class="eyebrow reveal-item">{es ? 'Historias' : 'Stories'}</p><h2 class="reveal-item" id="home-stories-title">{es ? 'Una historia puede cambiar' : 'A story can change how'}<span class="story-title-second-line">{es ? ' cómo miramos una decisión' : ' we look at a decision'}</span></h2><p class="section-intro reveal-item"><span class="story-intro-first-line">{es ? 'De los robles de Suecia a decisiones sobre IA, datos y seguridad.' : 'From Sweden’s oak trees to decisions about AI, data and security.'}</span>{' '}<span class="story-intro-second-line">{es ? 'Historias ilustradas sobre tecnología y negocio.' : 'Illustrated stories about technology and business'}</span></p><a class="text-action reveal-item" href={`${base}/stories/`}>{es ? 'Recorrer las historias' : 'Explore the stories'}<Arrow /></a></div>
      <a class="home-story-art reveal-item" data-home-story data-story-id={featured.id} href={`${base}/stories/#story-${featured.id}`} aria-label={`${es ? 'Ver historia' : 'View story'}: ${featured.title[es ? 'es' : 'en']}`}><img src={`/images/stories/${featured.id}-thumb.webp?v=${featured.imageVersion}`} alt={featured.alt[lang as 'en'|'es']} width={storyImages[0].width} height={storyImages[0].height} loading="lazy" decoding="async" /></a>
    </div>
  </section>

  <section class="home-books section-space section-wash" aria-labelledby="home-books-title">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow reveal-item">{es ? 'Libros' : 'Books'}</p>
          <h2 class="reveal-item" id="home-books-title">{es ? 'Lo que escribo' : 'What I write'}</h2>
        </div>
      </div>
      <div class="home-books-grid">
        <article class="home-book-card">
          <a href={`${base}/cio-book/`} class="home-book-image">
            <img src="/images/cio-book-cover.png" alt="How to Become CIO and Succeed — Fede Rodrigo" width="1300" height="1920" loading="lazy" />
          </a>
          <div>
            <h3>How to Become CIO and Succeed</h3>
            <p>{es ? 'El libro que me hubiera gustado tener al comenzar mi camino en el liderazgo de tecnología' : 'The book I wish I had when I began my technology leadership journey'}</p>
            <div class="home-book-actions">
              <a class="home-book-action-primary home-book-action-amazon" href="https://www.amazon.com/dp/B0F8MVPN4Q" target="_blank" rel="noopener noreferrer">{es ? 'Comprar en Amazon' : 'Buy on Amazon'}</a>
              <a class="home-book-action-secondary" href={`${base}/cio-book/`}>{es ? 'Explorar el libro' : 'Explore the book'}</a>
            </div>
          </div>
        </article>
        <article class="home-book-card">
          <a href={`${base}/itworks-book/`} class="home-book-image">
            <img src={`/images/funciona-book-cover-${lang}.png`} alt="It Works. That’s the Problem — Fede Rodrigo" width="1300" height="1920" loading="lazy" />
          </a>
          <div>
            <h3>{es ? 'Funciona. Ese es el problema' : 'It Works. That’s the Problem'}</h3>
            <p>{es ? 'Cómo la tecnología de la que dependemos puede limitar nuestras opciones futuras' : 'How the technology we depend on can limit what comes next'}</p>
            <div class="home-book-actions">
              <a class="home-book-action-secondary" href={`${base}/itworks-book/`}>{es ? 'Explorar el libro' : 'Explore the book'}</a>
              <p class="home-book-availability">{es ? 'Disponible a principios de 2027' : 'Coming early 2027'}</p>
            </div>
          </div>
        </article>
      </div>
      <a class="text-action home-books-more reveal-item" href={`${base}/books/`}>{es ? 'Libros e investigación' : 'Books & research'}<Arrow /></a>
    </div>
  </section>

  <section class="home-about wrap section-space" aria-labelledby="home-about-title"><div class="home-about-grid"><div><p class="eyebrow reveal-item">{es ? 'Sobre mí' : 'About me'}</p><h2 class="reveal-item" id="home-about-title">Fede Rodrigo</h2><p class="reveal-item">{es ? 'Soy CIO, asesor, speaker y autor, con experiencia liderando equipos y operaciones en Estados Unidos, Europa y Latinoamérica, combinando estrategia, ejecución y una cultura de servicio para crear valor para el negocio' : 'I am a CIO, advisor, speaker and author with experience leading teams and operations across the US, Europe and Latin America, combining strategy, execution and a culture of service to create business value'}</p><a class="text-action reveal-item" href={`${base}/about/`}>{es ? 'Conocer mi trayectoria' : 'Explore my background'}<Arrow /></a></div><a class="home-about-photo reveal-item" href={`${base}/about/`} aria-label={es ? 'Conocer mi trayectoria' : 'Explore my background'}><img src="/images/fede.png" alt="Fede Rodrigo" width="1184" height="1184" loading="lazy" /></a></div></section>


</main>
<Inquiry lang={lang} /><Footer />
<script id="home-story-options" type="application/json" is:inline set:html={JSON.stringify(storyOptions).replace(/</g,'\\u003c')} />
<SiteEffects />
</body></html>
