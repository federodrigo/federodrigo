---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type PaperItem = {
	title: string;
	date: string;
	status: string;
	description: string;
	reviewStatus: string;
};

const papers: PaperItem[] = [
	{
		title: 'When Success Hides Dependence',
		date: 'August 2026',
		status: 'Submitted',
		description:
			'Why a system that works can make it harder to know what would happen if the safeguards behind that performance were removed',
		reviewStatus: 'Under review',
	},
	{
		title: 'When Fixes Become the System',
		date: 'August 2026',
		status: 'Submitted',
		description:
			'How successful fixes become embedded around an existing technology, gradually reducing alternatives and making it harder to switch',
		reviewStatus: 'Under review',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Papers | Fede Rodrigo"
			description="Papers on technology leadership, organizational dependence, technology lock-in, and decision making"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Selected <span class="accent">Papers</span>
					</span>
				</h1>

				<div class="lead-principles">
					<div>Technology</div>
					<div>Organizations</div>
					<div>Leadership</div>
				</div>
			</section>

			{
				papers.map((paper) => (
					<section class="paper-section reveal-section">
						<div class="reveal-item">
							<p class="books-page-label">
								{paper.status} · {paper.date}
							</p>

							<h2>{paper.title}</h2>

							<p class="paper-description">
								{paper.description}
							</p>

							<p class="paper-review-status">
								{paper.reviewStatus}
							</p>
						</div>
					</section>
				))
			}
		</main>

		<Footer />

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>

		<style>
			.paper-section {
				border-top: 1px solid var(--line);
				margin-top: 0;
				padding-top: 28px;
				padding-bottom: 28px;
			}

			.paper-description {
				margin-bottom: 0;
			}

			.paper-review-status {
				display: inline-flex;
				align-items: center;
				width: fit-content;

				margin-top: 20px;
				margin-bottom: 0;
				padding: 10px 16px;

				border: 1px solid var(--line);
				background: rgba(96, 165, 250, 0.08);

				color: var(--navy);

				font-size: 0.76rem;
				font-weight: 800;
				letter-spacing: 0.09em;
				line-height: 1.2;
				text-transform: uppercase;
			}
		</style>
	</body>
</html>
