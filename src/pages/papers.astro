---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type PaperItem = {
	title: string;
	date: string;
	status: string;
	description: string;
};

const papers: PaperItem[] = [
	{
		title: 'When Success Hides Dependence',
		date: 'August 2026',
		status: 'Submitted',
		description:
			'How successful interventions can hide the dependence they create, making withdrawal decisions harder to evaluate as evidence about what would happen without the intervention gradually disappears',
	},
	{
		title: 'When Fixes Become the System',
		date: 'August 2026',
		status: 'Submitted',
		description:
			'How successful accommodations can preserve an existing technology path, become embedded over time, reduce credible alternatives, and increase the cost of switching',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Papers | Fede Rodrigo"
			description="Papers on technology leadership, organizational dependence, technology lock-in, and decision making"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Selected <span class="accent">Papers</span>
					</span>
				</h1>

				<div class="lead-principles">
					<div>Technology</div>
					<div>Organizations</div>
					<div>Leadership</div>
				</div>
			</section>

			{
				papers.map((paper) => (
					<section class="contact-section reveal-section">
						<div class="reveal-item">
							<p class="books-page-label">
								{paper.status} · {paper.date}
							</p>

							<h2>{paper.title}</h2>

							<p>
								{paper.description}
							</p>
						</div>
					</section>
				))
			}

			<section class="contact-section reveal-section">
				<div class="contact-page-response reveal-item">
					<p class="contact-page-response-label">
						Current Status
					</p>

					<p>
						Both papers were submitted in August 2026 and are
						currently under review
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>
