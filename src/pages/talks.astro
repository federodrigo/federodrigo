---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const youtubeEmbedUrl =
	'https://www.youtube.com/embed/ZN-d5W68Lp8';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Technology is Never the Starting Point | Fede Rodrigo"
			description="A talk about how reasonable technology decisions become dependencies, create lock-in, and reduce future options — and why leaders should start with people and the business problem before choosing technology"
			lang="en"
		/>

		<style>
			/* =========================================================
			   TALKS PAGE
			========================================================= */

			.talks-page {
				padding-top: 46px;
			}


			/* =========================================================
			   HERO
			========================================================= */

			.talks-hero {
				display: block;

				width: 100%;
				max-width: none;

				margin: 0 auto;

				padding: 0 0 24px;

				border-bottom: 0;

				text-align: center;
			}

			.talks-hero-title {
				width: 100%;
				max-width: 850px;

				margin: 0 auto;

				font-size: clamp(2.4rem, 4.8vw, 4.7rem);
				font-weight: 800;
				line-height: 1.03;
				letter-spacing: -0.055em;

				text-align: center;
			}

			.talks-hero-title .hero-line {
				display: block;
				width: 100%;
			}

			.talks-never {
				color: #6fa7ef;
			}


			/* =========================================================
			   PRINCIPLES
			========================================================= */

			.talks-principles {
				display: flex;
				align-items: center;
				justify-content: center;
				flex-wrap: wrap;

				gap: 8px;

				width: 100%;
				max-width: 850px;

				margin: 22px auto 0;

				color: #6f7d8f;

				font-size: 0.82rem;
				font-weight: 650;
				line-height: 1.4;
				letter-spacing: 0.045em;

				text-align: center;
				text-transform: uppercase;
			}

			.talks-principles span:nth-child(2),
			.talks-principles span:nth-child(4) {
				color: #b3bdc7;
			}


			/* =========================================================
			   INTRO
			========================================================= */

			.talks-intro {
				width: 100%;

				margin: 12px auto 30px;
				padding: 0;
			}

			.talks-intro-inner {
				display: grid;

				grid-template-columns:
					minmax(0, 0.92fr)
					minmax(0, 1.08fr);

				align-items: start;

				gap: 54px;

				width: 100%;
			}

			.talks-lead {
				max-width: none;

				margin: 0;

				color: #102b46;

				font-size: clamp(1.25rem, 1.75vw, 1.5rem);
				font-weight: 620;
				line-height: 1.42;
				letter-spacing: -0.032em;
			}

			.talks-intro-response {
				padding-top: 2px;
			}

			.talks-description {
				max-width: none;

				margin: 0;

				color: #6f7d8f;

				font-size: clamp(1.02rem, 1.35vw, 1.15rem);
				line-height: 1.62;
				letter-spacing: -0.014em;
			}

			.talks-description strong {
				color: #102b46;
				font-weight: 700;
			}


			/* =========================================================
			   SECONDARY LINKS
			========================================================= */

			.talks-secondary-links {
				display: flex;
				align-items: center;
				flex-wrap: wrap;

				gap: 24px;

				margin-top: 20px;
			}


			/* =========================================================
			   VIDEO
			========================================================= */

			.talks-video-section {
				margin: 0;
				padding: 0;
			}

			.talks-video-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				flex-wrap: wrap;

				gap: 10px;

				margin: 0 0 14px;
			}

			.talks-video-label {
				margin: 0;

				color: #102b46;

				font-size: 0.8rem;
				font-weight: 750;
				line-height: 1.3;
				letter-spacing: 0.075em;

				text-transform: uppercase;
			}

			.talks-video-note {
				margin: 0;

				color: #8b97a4;

				font-size: 0.82rem;
				line-height: 1.4;
			}

			.talks-video {
				width: 100%;

				aspect-ratio: 16 / 9;

				overflow: hidden;

				border-radius: 14px;

				background: #000000;

				box-shadow:
					0 14px 34px rgba(16, 42, 67, 0.08);
			}

			.talks-video iframe {
				display: block;

				width: 100%;
				height: 100%;

				border: 0;
			}


			/* =========================================================
			   TAKEAWAYS
			========================================================= */

			.talks-takeaways {
				margin-top: 38px;
				margin-bottom: 0;

				padding-top: 0;
				padding-bottom: 0;
			}

			.talks-takeaways > h2 {
				margin-bottom: 28px;
			}

			.talks-takeaway {
				display: grid;

				grid-template-columns:
					150px
					minmax(0, 1fr);

				align-items: center;

				gap: 28px;

				padding: 30px 0;

				border-bottom: 1px solid var(--line);
			}

			.talks-takeaway:first-of-type {
				padding-top: 4px;
			}

			.talks-takeaway:last-of-type {
				padding-bottom: 30px;
				border-bottom: 0;
			}

			.talks-takeaway-number {
				color: var(--navy);

				font-size: clamp(4rem, 7vw, 6.5rem);
				font-weight: 700;
				line-height: 0.9;
				letter-spacing: -0.06em;

				opacity: 0.16;
			}

			.talks-takeaway .media-content {
				padding-top: 0;
			}

			.talks-takeaway .media-content h3 {
				margin-bottom: 10px;
			}

			.talks-takeaway .media-description {
				max-width: 690px;
			}


			/* =========================================================
			   SPEAKING INQUIRIES
			========================================================= */

			.talks-contact {
				margin-top: var(--divider-space-before);

				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);
			}

			.talks-contact-title {
				margin-bottom: 10px;
			}

			.talks-contact-copy {
				max-width: 650px;

				margin: 0;

				color: var(--muted);
			}

			.talks-contact-link {
				margin: 18px 0 0;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 850px) {
				.talks-intro-inner {
					grid-template-columns: 1fr;

					gap: 22px;
				}

				.talks-intro {
					max-width: 720px;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.talks-page {
					padding-top: 42px;
				}

				.talks-hero {
					padding-bottom: 22px;
				}

				.talks-hero-title {
					font-size: clamp(2.3rem, 11vw, 3.15rem);
					line-height: 1.04;
				}

				.talks-principles {
					gap: 6px;

					margin-top: 18px;

					font-size: 0.74rem;
					line-height: 1.45;
				}


				/* INTRO */

				.talks-intro {
					margin-top: 6px;
					margin-bottom: 28px;
				}

				.talks-intro-inner {
					gap: 20px;
				}

				.talks-lead {
					font-size: 1.2rem;
					line-height: 1.42;
				}

				.talks-description {
					font-size: 1rem;
					line-height: 1.58;
				}

				.talks-secondary-links {
					flex-direction: column;
					align-items: flex-start;

					gap: 10px;

					margin-top: 18px;
				}


				/* VIDEO */

				.talks-video-heading {
					display: block;
					margin-bottom: 12px;
				}

				.talks-video-note {
					margin-top: 4px;
				}

				.talks-video {
					border-radius: 10px;
				}


				/* TAKEAWAYS */

				.talks-takeaways {
					margin-top: 32px;
				}

				.talks-takeaways > h2 {
					margin-bottom: 22px;
				}

				.talks-takeaway {
					grid-template-columns:
						72px
						minmax(0, 1fr);

					align-items: start;

					gap: 18px;

					padding: 26px 0;
				}

				.talks-takeaway:first-of-type {
					padding-top: 2px;
				}

				.talks-takeaway:last-of-type {
					padding-bottom: 26px;
				}

				.talks-takeaway-number {
					padding-top: 4px;

					font-size: 3.4rem;
				}

				.talks-takeaway .media-content h3 {
					font-size: 1.18rem;
				}

				.talks-takeaway .media-description {
					font-size: 0.94rem;
					line-height: 1.55;
				}


				/* SPEAKING INQUIRIES */

				.talks-contact {
					margin-top: var(--divider-space-mobile);

					padding-top: var(--divider-space-mobile);
				}
			}
		</style>
	</head>


	<body>
		<Header />


		<main class="talks-page">

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero talks-hero">

				<h1 class="hero-title talks-hero-title">

					<span class="hero-line">
						Technology is
						<span class="talks-never">
							never
						</span>
					</span>

					<span class="hero-line">
						the starting point
					</span>

				</h1>


				<div class="talks-principles">

					<span>
						People First
					</span>

					<span aria-hidden="true">
						·
					</span>

					<span>
						Business Driven
					</span>

					<span aria-hidden="true">
						·
					</span>

					<span>
						Technology Enabled
					</span>

				</div>

			</section>


			<!-- =====================================================
			     INTRO
			===================================================== -->

			<section class="talks-intro reveal-section">

				<div class="talks-intro-inner">

					<p class="talks-lead reveal-item">
						The most dangerous technology decisions are not always
						the ones that fail
					</p>


					<div
						class="talks-intro-response reveal-item reveal-delay-1"
					>

						<p class="talks-description">
							<strong>
								Sometimes, they are the ones that work
							</strong>

							<br />

							They get adopted and dependencies grow around them

							<br />

							Eventually, the organization is no longer choosing freely —
							only among the options that remain possible
						</p>


						<div class="talks-secondary-links">

							<a
								href="/contact/"
								class="animated-link"
							>
								<span>
									Speaking inquiries
								</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>


							<a
								href="/about/"
								class="animated-link"
							>
								<span>
									About Federico
								</span>
							</a>

						</div>

					</div>

				</div>

			</section>


			<!-- =====================================================
			     VIDEO
			===================================================== -->

			<section
				class="talks-video-section reveal-section"
				aria-label="Speaking sample"
			>

				<div class="talks-video-heading reveal-item">

					<p class="talks-video-label">
						Speaking Sample
					</p>

					<p class="talks-video-note">
						An earlier version of the talk
					</p>

				</div>


				<div
					class="talks-video reveal-item reveal-delay-1"
				>
					<iframe
						src={youtubeEmbedUrl}
						title="Technology is Never the Starting Point — speaking sample"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>
				</div>

			</section>


			<!-- =====================================================
			     TAKEAWAYS
			===================================================== -->

			<section
				class="talks-takeaways reveal-section"
				aria-labelledby="takeaways-title"
			>

				<h2
					id="takeaways-title"
					class="reveal-item"
				>
					What You'll Take Away
				</h2>


				<!-- 01 -->

				<article
					class="talks-takeaway reveal-item reveal-delay-1"
				>

					<div class="talks-takeaway-number">
						01
					</div>


					<div class="media-content">

						<h3>
							When a Solution Works, It Can Become the System
						</h3>

						<p class="media-description">
							Why successful fixes and reasonable technology
							choices can quietly create dependencies that become
							part of the system itself
						</p>

					</div>

				</article>


				<!-- 02 -->

				<article
					class="talks-takeaway reveal-item reveal-delay-2"
				>

					<div class="talks-takeaway-number">
						02
					</div>


					<div class="media-content">

						<h3>
							Lock-In Happens Before Anything Looks Broken
						</h3>

						<p class="media-description">
							How a system can keep working for years while the
							cost, complexity, and risk of changing it continue
							to grow — and future options slowly disappear
						</p>

					</div>

				</article>


				<!-- 03 -->

				<article
					class="talks-takeaway reveal-item reveal-delay-2"
				>

					<div class="talks-takeaway-number">
						03
					</div>


					<div class="media-content">

						<h3>
							Start With People and the Business Problem
						</h3>

						<p class="media-description">
							Why leaders should keep the decision open long enough
							to understand the people, the problem, and the outcome
							before deciding what role technology should play
						</p>

					</div>

				</article>


				<!-- =================================================
				     SPEAKING INQUIRIES
				================================================= -->

				<div class="talks-contact reveal-item">

					<h2 class="talks-contact-title">
						Speaking Inquiries
					</h2>


					<p class="talks-contact-copy">
						For conferences, leadership events, executive sessions,
						podcasts, or other speaking opportunities, please get in touch
					</p>


					<p class="talks-contact-link">

						<a
							href="/contact/"
							class="animated-link"
						>
							<span>
								Contact me
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>

					</p>

				</div>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll(
					'.reveal-section'
				);


			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}


								entry.target.classList.add(
									'is-visible'
								);


								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.08,

							rootMargin:
								'0px 0px -50px 0px',
						}
					);


				sections.forEach((section) => {

					revealObserver.observe(
						section
					);

				});

			} else {

				sections.forEach((section) => {

					section.classList.add(
						'is-visible'
					);

				});

			}
		</script>

	</body>
</html>
