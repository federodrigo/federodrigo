---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const featuredPaper = {
	status: 'Under Review',
	date: 'Submitted · August 2026',
	title: 'When Fixes Become the System',
	subtitle:
		'How Successful Accommodations Build Technology Lock-In',
	description:
		'An examination of how successful fixes can preserve an already-binding technology choice, become embedded over time, and reduce credible alternatives'
};
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Books | Fede Rodrigo"
			description="Books and research by Fede Rodrigo about technology leadership, business, incentives, institutions, and the systems that shape organizations"
			lang="en"
		/>

		<style>
			/* =========================================================
			   BOOKS PAGE
			========================================================= */

			.books-index-page {
				padding-top: 46px;
			}


			/* =========================================================
			   FEATURED BOOK
			========================================================= */

			.books-index-page .books-page-book-featured {
				margin: 0;

				padding-top: 0;
				padding-bottom: 0;
			}

			.books-page-secondary-action {
				margin-top: 10px;
			}


			/* =========================================================
			   CONTENT SECTIONS
			   Same spacing system as CIO book page
			========================================================= */

			.books-index-page .books-page-other {
				margin-top: var(--divider-space-before);
				margin-bottom: 0;

				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);
			}


			/* =========================================================
			   RESEARCH
			========================================================= */

			.research-grid {
				display: grid;

				grid-template-columns:
					minmax(150px, 0.55fr)
					minmax(0, 2.8fr);

				align-items: start;

				gap: clamp(1.5rem, 4vw, 3.5rem);
			}

			.research-meta,
			.research-content {
				min-width: 0;
			}

			.research-status {
				margin: 0;

				color: #8a6b36;

				font-size: 0.8rem;
				font-weight: 750;
				line-height: 1.3;
				letter-spacing: 0.12em;

				text-transform: uppercase;
			}

			.research-date {
				margin: 0.7rem 0 0;

				font-size: 0.86rem;
				line-height: 1.45;

				opacity: 0.58;
			}

			/*
				The content itself uses books-page-content,
				so label, title, paragraphs, font family,
				font sizes and spacing come from the same
				system as the featured book.
			*/

			.research-content .books-page-subtitle {
				max-width: 800px;
			}

			.research-description {
				max-width: 780px;
			}


			/* =========================================================
			   OTHER WORK
			========================================================= */

			.other-work-heading {
				margin-bottom: 22px;
			}

			.other-work-heading h2 {
				margin-bottom: 0;
			}

			.other-work-grid {
				display: grid;

				grid-template-columns:
					140px
					minmax(0, 1fr);

				align-items: start;

				gap: clamp(1.5rem, 4vw, 3rem);
			}

			.other-work-cover-wrapper {
				position: relative;

				width: 140px;
			}

			.other-work-cover-link {
				display: block;

				width: 140px;

				cursor: default;
			}

			.other-work-cover {
				display: block;

				width: 140px;
				max-width: 100%;
				height: auto;

				border-radius: 7px;
			}

			.other-work-content {
				min-width: 0;
			}

			.other-work-content > p {
				max-width: 740px;
			}

			.books-page-cover-static {
				cursor: default;
			}

			.coming-soon {
				display: inline-block;

				color: #6d9fdd;

				font-family: inherit;
				font-size: var(--cta-size);
				font-weight: var(--cta-weight);
				line-height: 1.3;

				letter-spacing: normal;
				text-transform: none;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 850px) {
				.research-grid {
					grid-template-columns: 1fr;

					gap: 1.2rem;
				}

				.research-meta {
					display: flex;
					flex-wrap: wrap;
					align-items: center;

					gap: 0.7rem 1rem;
				}

				.research-date {
					margin: 0;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.books-index-page {
					padding-top: 42px;
				}

				.books-index-page .books-page-book {
					grid-template-columns: 1fr;

					gap: 24px;
				}

				.books-index-page .books-page-book-featured {
					padding-top: 0;
					padding-bottom: 0;
				}

				.books-index-page .books-page-cover-wrapper,
				.books-index-page .books-page-cover-link {
					width: 180px;
				}

				.books-index-page .books-page-cover {
					width: 180px;
					max-width: 100%;

					border-radius: 8px;
				}

				.books-index-page .books-page-content h2 {
					font-size: 1.55rem;
				}

				.books-index-page .books-page-subtitle {
					margin-bottom: 18px;

					font-size: 0.92rem;
				}

				.books-index-page .books-page-content > p {
					margin-bottom: 15px;

					font-size: 0.94rem;
					line-height: 1.58;
				}

				.books-index-page .books-page-action {
					margin-top: 18px;
				}

				.books-page-secondary-action {
					margin-top: 10px;
				}


				/* CONTENT SECTIONS */

				.books-index-page .books-page-other {
					margin-top: var(--divider-space-mobile);

					padding-top: var(--divider-space-mobile);
					padding-bottom: 0;
				}


				/* RESEARCH */

				.research-grid {
					gap: 1.2rem;
				}


				/* OTHER WORK */

				.other-work-heading {
					margin-bottom: 20px;
				}

				.other-work-grid {
					grid-template-columns:
						100px
						minmax(0, 1fr);

					gap: 20px;
				}

				.other-work-cover-wrapper,
				.other-work-cover-link,
				.other-work-cover {
					width: 100px;
				}
			}


			/* =========================================================
			   SMALL MOBILE
			========================================================= */

			@media (max-width: 480px) {
				.other-work-grid {
					grid-template-columns: 1fr;

					gap: 20px;
				}

				.other-work-cover-wrapper,
				.other-work-cover-link,
				.other-work-cover {
					width: 110px;
				}
			}
		</style>
	</head>


	<body>
		<Header />


		<main class="books-index-page">

			<!-- =====================================================
			     FEATURED BOOK
			===================================================== -->

			<section
				class="books-page-book books-page-book-featured reveal-section"
				aria-labelledby="cio-book-title"
			>

				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>

					<a
						href="https://www.amazon.com/dp/B0F8MVPN4Q"
						target="_blank"
						rel="noopener noreferrer"
						class="books-page-cover-link"
						aria-label="Buy How to Become CIO and Succeed on Amazon"
					>

						<img
							src="/images/cio-book-cover.png"
							alt="Cover of How to Become CIO and Succeed"
							class="books-page-cover animated-book-cover"
						/>

					</a>

				</div>


				<div
					class="books-page-content reveal-item reveal-delay-1"
				>

					<p class="books-page-label">
						Featured Book
					</p>


					<h2 id="cio-book-title">
						How to Become CIO and Succeed
					</h2>


					<p class="books-page-subtitle">
						People, Business, Strategy
					</p>


					<p>
						This is the book
						<strong>I wish I had</strong>
						when I began my leadership journey
					</p>


					<p>
						The CIO role is not about managing systems.
						<em>There shouldn’t be an “I” in CIO.</em>
						It is about leading people, shaping strategy,
						influencing the business, and turning technology
						into a competitive advantage
					</p>


					<p>
						<strong>This is not a textbook.</strong>
						It is a practical field guide for current
						and aspiring technology leaders
					</p>


					<p class="books-page-closing">
						If you are here to maintain the status quo,
						turn back now
					</p>


					<p class="books-page-action">

						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>

							<span>
								Buy on Amazon
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>

						</a>

					</p>


					<p class="books-page-secondary-action">

						<a
							href="/cio-book/"
							class="animated-link"
						>

							<span>
								Explore the book
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>

						</a>

					</p>

				</div>

			</section>


			<!-- =====================================================
			     RESEARCH
			===================================================== -->

			<section
				id="research"
				class="books-page-other reveal-section"
				aria-labelledby="research-title"
			>

				<div class="research-grid">

					<div class="research-meta reveal-item">

						<p class="research-status">
							{featuredPaper.status}
						</p>

						<p class="research-date">
							{featuredPaper.date}
						</p>

					</div>


					<div
						class="books-page-content research-content reveal-item reveal-delay-1"
					>

						<p class="books-page-label">
							Research Paper
						</p>


						<h2 id="research-title">
							{featuredPaper.title}
						</h2>


						<p class="books-page-subtitle">
							{featuredPaper.subtitle}
						</p>


						<p class="research-description">
							{featuredPaper.description}
						</p>

					</div>

				</div>

			</section>


			<!-- =====================================================
			     OTHER WORK
			===================================================== -->

			<section
				id="other-work"
				class="books-page-other reveal-section"
				aria-labelledby="other-work-title"
			>

				<div class="other-work-heading reveal-item">

					<h2 id="other-work-title">
						Other Work
					</h2>

				</div>


				<div
					class="other-work-grid reveal-item reveal-delay-1"
				>

					<div class="other-work-cover-wrapper">

						<div
							class="other-work-cover-link books-page-cover-static"
						>

							<img
								src="/images/book-cover.jpg"
								alt="Cover of A Theory of Minimal Tolerance"
								class="other-work-cover animated-book-cover"
								loading="lazy"
							/>

						</div>

					</div>


					<div class="books-page-content other-work-content">

						<p class="books-page-label">
							Forthcoming Book
						</p>


						<h2>
							A Theory of Minimal Tolerance
						</h2>


						<p>
							A work exploring freedom, coercion, incentives,
							institutions, and the limits that should constrain
							political power
						</p>


						<p>
							It develops a practical framework for examining
							the conditions under which state coercion may
							be tolerated
						</p>


						<p class="books-page-action">

							<span class="coming-soon">
								Coming Soon
							</span>

						</p>

					</div>

				</div>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');


			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.12,
							rootMargin:
								'0px 0px -60px 0px'
						}
					);


				sections.forEach((section) => {

					revealObserver.observe(section);

				});

			} else {

				sections.forEach((section) => {

					section.classList.add(
						'is-visible'
					);

				});

			}
		</script>

	</body>
</html>
