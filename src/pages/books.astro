
---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const featuredPaper = {
  status: 'Under Review',
  title: 'The Lock-In We Create',
  subtitle: 'When Early Technology Choices Turn Adaptation into Dependence',
  description:
    "Early technology choices can solve real problems and remain successful for years. As new systems, processes, and ways of working build on them, dependencies accumulate. Each adaptation becomes more constrained by what already exists, making change increasingly costly and narrowing the organization\'s future options."
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <SEO
      title="Books | Fede Rodrigo"
      description="Books and research by Fede Rodrigo about technology leadership, business, incentives, institutions, and the systems that shape organizations"
      lang="en"
    />

    <style>
      .books-index-page {
        padding-top: 46px;
        --books-divider-gap: var(--divider-space-before);
      }

      .books-index-page .books-page-book-featured {
        margin: 0;
        padding-top: 0;
        padding-bottom: 0;
      }

      .books-page-secondary-action {
        margin-top: 10px;
      }

      /* Keep the same space before and after each divider. */
      .books-index-page .books-page-book + .books-page-book {
        margin-top: var(--books-divider-gap);
        margin-bottom: 0;
        padding-top: var(--books-divider-gap);
        padding-bottom: 0;
        border-top: 1px solid var(--line);
      }

      /* Avoid extra trailing paragraph margins below the first book. */
      .books-index-page .books-page-content > :last-child {
        margin-bottom: 0;
      }

      .research-content .books-page-subtitle {
        max-width: 800px;
      }

      .research-description {
        max-width: 780px;
      }

      .research-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem 1.2rem;
        margin-top: 1.6rem;
      }

      /* All actions and publication statuses share one typographic style. */
      .books-index-page .books-page-action a,
      .books-index-page .books-page-secondary-action a,
      .books-index-page .coming-soon,
      .books-index-page .research-status {
        color: var(--blue);
        font-family: inherit;
        font-size: var(--cta-size);
        font-weight: var(--cta-weight);
        line-height: 1.3;
        letter-spacing: normal;
        text-transform: none;
      }

      .books-index-page .research-status {
        margin: 0;
      }

      .books-page-cover-static {
        cursor: default;
      }

      .books-index-page .coming-soon {
        display: inline-block;
      }

      @media (max-width: 720px) {
        .books-index-page {
          padding-top: 42px;
          --books-divider-gap: var(--divider-space-mobile);
        }

        .books-index-page .books-page-book {
          grid-template-columns: 1fr;
          gap: 24px;
        }

        .books-index-page .books-page-book-featured {
          padding-top: 0;
          padding-bottom: 0;
        }

        .books-index-page .books-page-cover-wrapper,
        .books-index-page .books-page-cover-link {
          width: 180px;
        }

        .books-index-page .books-page-cover {
          width: 180px;
          max-width: 100%;
          border-radius: 8px;
        }

        .books-index-page .books-page-content h2 {
          font-size: 1.55rem;
        }

        .books-index-page .books-page-subtitle {
          margin-bottom: 18px;
          font-size: 0.92rem;
        }

        .books-index-page .books-page-content > p {
          margin-bottom: 15px;
          font-size: 0.94rem;
          line-height: 1.58;
        }

        .books-index-page .books-page-action {
          margin-top: 18px;
        }

        .books-page-secondary-action {
          margin-top: 10px;
        }

      }
    </style>
  </head>

  <body>
    <Header />

    <main class="books-index-page">
      <!-- Featured book -->
      <section
        class="books-page-book books-page-book-featured reveal-section"
        aria-labelledby="cio-book-title"
      >
        <div class="books-page-cover-wrapper reveal-item reveal-from-left">
          <a
            href="https://www.amazon.com/dp/B0F8MVPN4Q"
            target="_blank"
            rel="noopener noreferrer"
            class="books-page-cover-link"
            aria-label="Buy How to Become CIO and Succeed on Amazon"
          >
            <img
              src="/images/cio-book-cover.png"
              alt="Cover of How to Become CIO and Succeed"
              class="books-page-cover animated-book-cover"
            />
          </a>
        </div>

        <div class="books-page-content reveal-item reveal-delay-1">
          <p class="books-page-label">Featured Book</p>
          <h2 id="cio-book-title">How to Become CIO and Succeed</h2>
          <p class="books-page-subtitle">People, Business, Strategy</p>

          <p>
            This is the book <strong>I wish I had</strong>
            when I began my leadership journey
          </p>
          <p>
            The CIO role is not about managing systems.
            <em>There shouldn’t be an “I” in CIO.</em>
            It is about leading people, shaping strategy,
            influencing the business, and turning technology
            into a competitive advantage
          </p>
          <p>
            <strong>This is not a textbook.</strong>
            It is a practical field guide for current
            and aspiring technology leaders
          </p>
          <p class="books-page-closing">
            If you are here to maintain the status quo, turn back now
          </p>

          <p class="books-page-action">
            <a
              href="https://www.amazon.com/dp/B0F8MVPN4Q"
              target="_blank"
              rel="noopener noreferrer"
              class="animated-link"
            >
              <span>Buy on Amazon</span>
              <span class="animated-link-arrow" aria-hidden="true">→</span>
            </a>
          </p>

          <p class="books-page-secondary-action">
            <a href="/cio-book/" class="animated-link">
              <span>Explore the book</span>
              <span class="animated-link-arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>

      <!-- Forthcoming book -->
      <section
        class="books-page-book books-page-other reveal-section"
        aria-labelledby="funciona-book-title"
      >
        <div class="books-page-cover-wrapper reveal-item reveal-from-left">
          <a href="/itworks-book/" class="books-page-cover-link" aria-label="Explore It Works. That's the Problem">
            <img
              src="/images/funciona-book-cover-en.png"
              alt="Cover of It Works. That's the Problem"
              class="books-page-cover animated-book-cover"
              loading="lazy"
            />
          </a>
        </div>

        <div class="books-page-content reveal-item reveal-delay-1">
          <p class="books-page-label">Forthcoming Book</p>
          <h2 id="funciona-book-title">It Works. That's the Problem</h2>
          <p class="books-page-subtitle">How Technology Solutions Can Trap Us</p>
          <p>
            Sometimes the biggest risk does not appear when something fails, but when it works.
            This book explores how well-intentioned technology decisions, short-term fixes,
            and operational successes can harden into complexity, dependence, and lock-in over time
          </p>
          <p>
            Through stories, examples, and a practical leadership lens, it shows why technology
            is never the starting point and how organizations can preserve their ability to choose
            before their systems choose for them
          </p>
          <p class="books-page-action">
            <span class="coming-soon">Coming 2027</span>
          </p>
          <p class="books-page-secondary-action">
            <a href="/itworks-book/" class="animated-link">
              <span>Explore the book</span>
              <span class="animated-link-arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>

      <!-- Research paper -->
      <section
        id="research"
        class="books-page-book books-page-other reveal-section"
        aria-labelledby="research-title"
      >
        <div class="books-page-cover-wrapper reveal-item reveal-from-left">
          <img
            src="/images/paper-en.png"
            alt="Cover of the research paper The Lock-In We Create"
            class="books-page-cover animated-book-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="books-page-content research-content reveal-item reveal-delay-1">
          <p class="books-page-label">Research Paper</p>
          <h2 id="research-title">{featuredPaper.title}</h2>
          <p class="books-page-subtitle">{featuredPaper.subtitle}</p>
          <p class="research-description">{featuredPaper.description}</p>
          <div class="research-meta">
            <p class="research-status">{featuredPaper.status}</p>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const sections = document.querySelectorAll('.reveal-section');

      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -60px 0px'
        });

        sections.forEach((section) => revealObserver.observe(section));
      } else {
        sections.forEach((section) => section.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
