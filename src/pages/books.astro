---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const papers = [
	{
		status: 'Available on SSRN',
		date: 'SSRN Preprint · December 2025',
		title: 'The Theorem of Minimal Tolerance',
		subtitle:
			'Free Riders, the State, and the “Institutional Technology of Last Resort”',
		description:
			'The paper presents the theory, the formal theorem, its evidentiary standard, and its corollary',
		href: 'https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5984574',
		action: 'Open on SSRN'
	},
	{
		status: 'Under Review',
		date: 'Submitted · August 2026',
		title: 'When Success Hides Dependence',
		subtitle:
			'Why a system that works can make it harder to know what would happen if the safeguards behind that performance were removed',
		description:
			'An examination of how apparent operational success can conceal structural dependence and weaken the ability to evaluate credible alternatives',
		href: null,
		action: 'Under Review'
	},
	{
		status: 'Under Review',
		date: 'Submitted · August 2026',
		title: 'When Fixes Become the System',
		subtitle:
			'How successful accommodations can preserve an existing technology path, become embedded over time, and reduce credible alternatives',
		description:
			'An examination of how effective short-term fixes can become permanent features of an organization and reinforce technological lock-in',
		href: null,
		action: 'Under Review'
	}
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Books & Papers | Fede Rodrigo"
			description="Books and research papers by Fede Rodrigo about technology leadership, business, incentives, institutions, and the systems that shape organizations"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Books & <span class="accent">Papers</span>
					</span>
				</h1>

				<div class="lead-principles">
					<div>I Wrote the Book I Wish I'd Had</div>
					<div>Twenty Years Earlier</div>
				</div>
			</section>

			<!-- FEATURED BOOK -->

			<section
				class="books-page-book books-page-book-featured reveal-section"
				aria-labelledby="cio-book-title"
			>
				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>
					<a
						href="https://www.amazon.com/dp/B0F8MVPN4Q"
						target="_blank"
						rel="noopener noreferrer"
						class="books-page-cover-link"
						aria-label="View How to Become CIO and Succeed on Amazon"
					>
						<img
							src="/images/cio-book-cover.png"
							alt="Cover of How to Become CIO and Succeed"
							class="books-page-cover animated-book-cover"
						/>
					</a>
				</div>

				<div class="books-page-content reveal-item reveal-delay-1">
					<p class="books-page-label">
						Featured Book
					</p>

					<h2 id="cio-book-title">
						How to Become CIO and Succeed
					</h2>

					<p class="books-page-subtitle">
						People, Business, Strategy
					</p>

					<p>
						This is the book <strong>I wish I had</strong> when I began
						my leadership journey
					</p>

					<p>
						The CIO role is not about managing systems.
						<em>There shouldn’t be an “I” in CIO.</em> It is about
						leading people, shaping strategy, influencing the business,
						and turning technology into a competitive advantage
					</p>

					<p>
						<strong>This is not a textbook.</strong> It is a practical
						field guide for current and aspiring technology leaders
					</p>

					<p class="books-page-closing">
						If you are here to maintain the status quo, turn back now
					</p>

					<p class="books-page-action">
						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>View on Amazon</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>

			<!-- FORTHCOMING BOOK -->

			<section
				class="books-page-other reveal-section"
				aria-labelledby="forthcoming-book-heading"
			>
				<h2
					id="forthcoming-book-heading"
					class="reveal-item"
				>
					Forthcoming Book
				</h2>

				<article
					class="books-page-book books-page-book-secondary"
					aria-labelledby="minimal-tolerance-book-title"
				>
					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/theory"
							class="books-page-cover-link"
							aria-label="Explore A Theory of Minimal Tolerance"
						>
							<img
								src="/images/book-cover.jpg"
								alt="Cover of A Theory of Minimal Tolerance"
								class="books-page-cover animated-book-cover"
								loading="lazy"
							/>
						</a>
					</div>

					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<p class="books-page-label">
							Forthcoming Book
						</p>

						<h2 id="minimal-tolerance-book-title">
							A Theory of Minimal Tolerance
						</h2>

						<p>
							A work exploring freedom, coercion, incentives,
							institutions, and the limits that should constrain
							political power
						</p>

						<p>
							It develops a practical framework for examining the
							conditions under which state coercion may be tolerated
						</p>

						<p class="books-page-action">
							<a
								href="/theory"
								class="animated-link"
							>
								<span>Explore Minimal Tolerance</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>
				</article>
			</section>

			<!-- PAPERS -->

			<section
				id="papers"
				class="papers-section reveal-section"
				aria-labelledby="papers-heading"
			>
				<div class="papers-heading reveal-item">
					<p class="papers-eyebrow">
						Selected Research
					</p>

					<h2 id="papers-heading">
						Papers
					</h2>

					<p class="papers-introduction">
						Technology. Organizations. Institutions
					</p>
				</div>

				<div class="papers-list">
					{
						papers.map((paper) => (
							<article class="paper-row reveal-item">
								<div class="paper-meta">
									<p
										class:list={[
											'paper-status',
											{
												'paper-status-review':
													paper.status === 'Under Review'
											}
										]}
									>
										{paper.status}
									</p>

									<p class="paper-date">
										{paper.date}
									</p>
								</div>

								<div class="paper-content">
									<h3 class="paper-title">
										{paper.title}
									</h3>

									<p class="paper-subtitle">
										{paper.subtitle}
									</p>

									<p class="paper-description">
										{paper.description}
									</p>
								</div>

								<div class="paper-action">
									{
										paper.href ? (
											<a
												href={paper.href}
												target="_blank"
												rel="noopener noreferrer"
												class="paper-link"
											>
												<span>{paper.action}</span>

												<span
													class="paper-link-arrow"
													aria-hidden="true"
												>
													→
												</span>
											</a>
										) : (
											<span class="paper-action-static">
												{paper.action}
											</span>
										)
									}
								</div>
							</article>
						))
					}
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			if ('IntersectionObserver' in window) {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;

							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{
						threshold: 0.12,
						rootMargin: '0px 0px -60px 0px'
					}
				);

				sections.forEach((section) => {
					revealObserver.observe(section);
				});
			} else {
				sections.forEach((section) => {
					section.classList.add('is-visible');
				});
			}
		</script>
	</body>
</html>

<style>
	.papers-section {
		width: min(1180px, calc(100% - 3rem));
		margin: clamp(7rem, 12vw, 11rem) auto;
		scroll-margin-top: 8rem;
	}

	.papers-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 1.5rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.papers-eyebrow {
		grid-column: 1 / -1;
		margin: 0 0 0.35rem;
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #6d9fdd;
	}

	.papers-heading h2 {
		margin: 0;
		font-size: clamp(2.7rem, 6vw, 5rem);
		line-height: 0.95;
		letter-spacing: -0.055em;
	}

	.papers-introduction {
		margin: 0 0 0.35rem;
		font-size: 0.82rem;
		font-weight: 650;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.54;
	}

	.papers-list {
		border-top: 1px solid rgba(52, 65, 86, 0.2);
	}

	.paper-row {
		display: grid;
		grid-template-columns:
			minmax(145px, 0.62fr)
			minmax(0, 2.5fr)
			minmax(135px, 0.65fr);
		align-items: start;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		padding: clamp(2rem, 4vw, 3.25rem) 0;
		border-bottom: 1px solid rgba(52, 65, 86, 0.2);
	}

	.paper-meta,
	.paper-content,
	.paper-action {
		min-width: 0;
	}

	.paper-status {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 750;
		line-height: 1.25;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: #4f87cd;
	}

	.paper-status-review {
		color: #8a6b36;
	}

	.paper-date {
		margin: 0.65rem 0 0;
		font-size: 0.78rem;
		line-height: 1.45;
		opacity: 0.52;
	}

	.paper-title {
		margin: 0;
		font-size: clamp(1.45rem, 2.4vw, 2.05rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.paper-subtitle {
		max-width: 760px;
		margin: 0.85rem 0 0;
		font-size: clamp(1rem, 1.4vw, 1.12rem);
		font-weight: 580;
		line-height: 1.48;
	}

	.paper-description {
		max-width: 750px;
		margin: 1rem 0 0;
		font-size: 0.94rem;
		line-height: 1.65;
		opacity: 0.66;
	}

	.paper-action {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		align-self: center;
	}

	.paper-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		padding-bottom: 0.28rem;
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: 0.03em;
		color: inherit;
		text-decoration: none;
		white-space: nowrap;
	}

	.paper-link::after {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 1px;
		background: #6d9fdd;
		transform: scaleX(0.28);
		transform-origin: left;
		transition: transform 220ms ease;
	}

	.paper-link:hover::after,
	.paper-link:focus-visible::after {
		transform: scaleX(1);
	}

	.paper-link-arrow {
		color: #6d9fdd;
		transition: transform 220ms ease;
	}

	.paper-link:hover .paper-link-arrow,
	.paper-link:focus-visible .paper-link-arrow {
		transform: translateX(0.25rem);
	}

	.paper-action-static {
		font-size: 0.74rem;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.38;
	}

	@media (max-width: 850px) {
		.papers-section {
			width: min(100% - 2rem, 720px);
		}

		.papers-heading {
			grid-template-columns: 1fr;
			gap: 0.7rem;
		}

		.papers-eyebrow {
			grid-column: auto;
		}

		.papers-introduction {
			margin: 0;
		}

		.paper-row {
			grid-template-columns: 1fr;
			gap: 1.4rem;
		}

		.paper-meta {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.7rem 1rem;
		}

		.paper-date {
			margin: 0;
		}

		.paper-action {
			justify-content: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.paper-link::after,
		.paper-link-arrow {
			transition: none;
		}
	}
</style>
