---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const papers = [
	{
		status: 'Under Review',
		date: 'Submitted · August 2026',
		title: 'When Success Hides Dependence',
		subtitle:
			'Why a system that works can make it harder to know what would happen if the safeguards behind that performance were removed',
		description:
			'An examination of how apparent operational success can conceal structural dependence and weaken the ability to evaluate credible alternatives'
	},
	{
		status: 'Under Review',
		date: 'Submitted · August 2026',
		title: 'When Fixes Become the System',
		subtitle:
			'How successful accommodations can preserve an existing technology path, become embedded over time, and reduce credible alternatives',
		description:
			'An examination of how effective short-term fixes can become permanent features of an organization and reinforce technological lock-in'
	}
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Books & Papers | Fede Rodrigo"
			description="Books and research papers by Fede Rodrigo about technology leadership, business, incentives, institutions, and the systems that shape organizations"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- TAGLINE -->

			<section class="books-page-heading reveal-section">
				<h2
					class="cio-office-capabilities-tagline books-page-tagline reveal-item"
					aria-label="Writing on technology, leadership, institutions, and power"
				>
					<span
						class="tagline-part tagline-part-1"
						aria-hidden="true"
					>
						Writing on technology,
					</span>

					<span
						class="tagline-part tagline-part-2"
						aria-hidden="true"
					>
						leadership,
					</span>

					<span
						class="tagline-part tagline-part-3"
						aria-hidden="true"
					>
						institutions,
					</span>

					<span
						class="tagline-part tagline-part-4"
						aria-hidden="true"
					>
						and power
					</span>
				</h2>
			</section>

			<!-- FEATURED BOOK -->

			<section
				class="books-page-book books-page-book-featured reveal-section"
				aria-labelledby="cio-book-title"
			>
				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>
					<a
						href="https://www.amazon.com/dp/B0F8MVPN4Q"
						target="_blank"
						rel="noopener noreferrer"
						class="books-page-cover-link"
						aria-label="Buy How to Become CIO and Succeed on Amazon"
					>
						<img
							src="/images/cio-book-cover.png"
							alt="Cover of How to Become CIO and Succeed"
							class="books-page-cover animated-book-cover"
						/>
					</a>
				</div>

				<div class="books-page-content reveal-item reveal-delay-1">
					<p class="books-page-label">
						Featured Book
					</p>

					<h2 id="cio-book-title">
						How to Become CIO and Succeed
					</h2>

					<p class="books-page-subtitle">
						People, Business, Strategy
					</p>

					<p>
						This is the book <strong>I wish I had</strong> when I began
						my leadership journey
					</p>

					<p>
						The CIO role is not about managing systems.
						<em>There shouldn’t be an “I” in CIO.</em> It is about
						leading people, shaping strategy, influencing the business,
						and turning technology into a competitive advantage
					</p>

					<p>
						<strong>This is not a textbook.</strong> It is a practical
						field guide for current and aspiring technology leaders
					</p>

					<p class="books-page-closing">
						If you are here to maintain the status quo, turn back now
					</p>

					<p class="books-page-action">
						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>Buy on Amazon</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>

			<!-- FORTHCOMING BOOK -->

			<section
				class="books-page-book books-page-book-secondary minimal-tolerance-book reveal-section"
				aria-labelledby="minimal-tolerance-book-title"
			>
				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>
					<div
						class="books-page-cover-link books-page-cover-static"
					>
						<img
							src="/images/book-cover.jpg"
							alt="Cover of A Theory of Minimal Tolerance"
							class="books-page-cover animated-book-cover"
							loading="lazy"
						/>
					</div>
				</div>

				<div class="books-page-content reveal-item reveal-delay-1">
					<p class="books-page-label">
						Forthcoming Book
					</p>

					<h2 id="minimal-tolerance-book-title">
						A Theory of Minimal Tolerance
					</h2>

					<p>
						A work exploring freedom, coercion, incentives,
						institutions, and the limits that should constrain
						political power
					</p>

					<p>
						It develops a practical framework for examining the
						conditions under which state coercion may be tolerated
					</p>

					<p class="books-page-action">
						<span class="coming-soon">
							Coming Soon
						</span>
					</p>
				</div>
			</section>

			<!-- PAPERS -->

			<section
				id="papers"
				class="papers-section reveal-section"
				aria-label="Technology papers"
			>
				<div class="papers-list">
					{
						papers.map((paper) => (
							<article class="paper-row reveal-item">
								<div class="paper-meta">
									<p class="paper-status">
										{paper.status}
									</p>

									<p class="paper-date">
										{paper.date}
									</p>
								</div>

								<div class="paper-content">
									<p class="books-page-label paper-type">
										Paper
									</p>

									<h2 class="paper-title">
										{paper.title}
									</h2>

									<p class="paper-subtitle">
										{paper.subtitle}
									</p>

									<p class="paper-description">
										{paper.description}
									</p>
								</div>
							</article>
						))
					}
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			if ('IntersectionObserver' in window) {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;

							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{
						threshold: 0.12,
						rootMargin: '0px 0px -60px 0px'
					}
				);

				sections.forEach((section) => {
					revealObserver.observe(section);
				});
			} else {
				sections.forEach((section) => {
					section.classList.add('is-visible');
				});
			}
		</script>

		<style>
			main {
				padding-bottom: 0;
			}

			/* TAGLINE */

			.books-page-heading {
				width: min(1180px, calc(100% - 3rem));
				margin: 0 auto;
				padding-top: clamp(4.5rem, 8vw, 7rem);
				padding-bottom: clamp(4.75rem, 7vw, 6.5rem);
			}

			.books-page-tagline {
				margin: 0;
			}

			.books-page-tagline span {
				display: inline-block;
			}

			.js .books-page-tagline span {
				opacity: 0;
				transform: translateY(12px);
			}

			.books-page-heading.is-visible
				.books-page-tagline
				span {
				animation: tagline-reveal 0.7s
					cubic-bezier(0.22, 1, 0.36, 1) forwards;
			}

			.books-page-heading.is-visible .tagline-part-1 {
				animation-delay: 0.15s;
			}

			.books-page-heading.is-visible .tagline-part-2 {
				animation-delay: 0.25s;
			}

			.books-page-heading.is-visible .tagline-part-3 {
				animation-delay: 0.35s;
			}

			.books-page-heading.is-visible .tagline-part-4 {
				animation-delay: 0.45s;
			}

			@keyframes tagline-reveal {
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			/* FEATURED BOOK */

			.books-page-book-featured {
				margin-top: 0;
				margin-bottom: 0;
				padding-top: clamp(1.5rem, 3vw, 2.5rem);
				padding-bottom: clamp(2.25rem, 4vw, 3.5rem);
			}

			/* FORTHCOMING BOOK */

			.minimal-tolerance-book {
				margin-top: 0;
				margin-bottom: 0;
				padding-top: clamp(2.25rem, 4vw, 3.5rem);
				padding-bottom: clamp(2.25rem, 4vw, 3.5rem);
				border-top: 1px solid rgba(52, 65, 86, 0.2);
			}

			.books-page-cover-static {
				cursor: default;
			}

			.coming-soon {
				display: inline-block;
				font-size: 0.76rem;
				font-weight: 750;
				line-height: 1.2;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #6d9fdd;
			}

			/* PAPERS */

			.papers-section {
				width: min(1180px, calc(100% - 3rem));
				margin: 0 auto;
				padding-bottom: 0;
				scroll-margin-top: 8rem;
			}

			.papers-list {
				border-top: 1px solid rgba(52, 65, 86, 0.2);
			}

			.paper-row {
				display: grid;
				grid-template-columns: minmax(170px, 0.6fr) minmax(0, 2.8fr);
				align-items: start;
				gap: clamp(1.5rem, 4vw, 3.5rem);
				padding: clamp(2rem, 4vw, 3.25rem) 0;
				border-bottom: 1px solid rgba(52, 65, 86, 0.2);
			}

			.paper-row:last-child {
				padding-bottom: clamp(1.5rem, 2.5vw, 2rem);
				border-bottom: 0;
			}

			.paper-meta,
			.paper-content {
				min-width: 0;
			}

			.paper-type {
				margin: 0 0 0.8rem;
			}

			.paper-status {
				margin: 0;
				font-size: 0.8rem;
				font-weight: 750;
				line-height: 1.3;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #8a6b36;
			}

			.paper-date {
				margin: 0.7rem 0 0;
				font-size: 0.86rem;
				line-height: 1.45;
				opacity: 0.58;
			}

			.paper-title {
				margin: 0;
				font-size: clamp(1.45rem, 2.4vw, 2.05rem);
				font-weight: 700;
				line-height: 1.08;
				letter-spacing: -0.035em;
			}

			.paper-subtitle {
				max-width: 800px;
				margin: 0.85rem 0 0;
				font-size: clamp(1rem, 1.4vw, 1.12rem);
				font-weight: 580;
				line-height: 1.48;
			}

			.paper-description {
				max-width: 780px;
				margin: 1rem 0 0;
				font-size: 0.94rem;
				line-height: 1.65;
				opacity: 0.66;
			}

			@media (prefers-reduced-motion: reduce) {
				.js .books-page-tagline span {
					opacity: 1;
					transform: none;
					animation: none;
				}
			}

			@media (max-width: 850px) {
				.books-page-heading {
					width: min(100% - 2rem, 720px);
					padding-top: 3.5rem;
					padding-bottom: 3.5rem;
				}

				.books-page-book-featured {
					margin-top: 0;
					margin-bottom: 0;
					padding-top: 1.5rem;
					padding-bottom: 2rem;
				}

				.minimal-tolerance-book {
					margin-top: 0;
					margin-bottom: 0;
					padding-top: 2rem;
					padding-bottom: 2rem;
				}

				.papers-section {
					width: min(100% - 2rem, 720px);
					margin: 0 auto;
				}

				.paper-row {
					grid-template-columns: 1fr;
					gap: 1.4rem;
				}

				.paper-meta {
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					gap: 0.7rem 1rem;
				}

				.paper-date {
					margin: 0;
				}
			}
		</style>
	</body>
</html>
