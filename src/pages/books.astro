---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const papers = [
	{
		status: 'Under Review',
		date: 'Submitted · August 2026',
		title: 'When Fixes Become the System',
		subtitle:
			'How Successful Accommodations Build Technology Lock-In',
		description:
			'An examination of how successful fixes can preserve an already-binding technology choice, become embedded over time, and reduce credible alternatives'
	},
	{
		status: 'Under Review',
		date: 'Submitted · August 2026',
		title: 'When Success Erodes the Capacity to Know',
		subtitle:
			'How sustained success can make it harder to determine whether an intervention is still necessary',
		description:
			'An examination of how organizations can lose the ability to test safe withdrawal even while operating performance remains strong'
	}
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Books & Papers | Fede Rodrigo"
			description="Books and research papers by Fede Rodrigo about technology leadership, business, incentives, institutions, and the systems that shape organizations"
			lang="en"
		/>

		<style>
			/* =========================================================
			   BOOKS PAGE
			========================================================= */

			.books-index-page {
				padding-top: 46px;
			}


			/* =========================================================
			   FEATURED BOOK
			========================================================= */

			.books-index-page .books-page-book-featured {
				margin: 0;

				padding-top: 0;
				padding-bottom: 0;
			}

			.books-page-secondary-action {
				margin-top: 10px;
			}


			/* =========================================================
			   FORTHCOMING BOOK
			========================================================= */

			.books-index-page .minimal-tolerance-book {
				margin-top: var(--divider-space-before);
				margin-bottom: 0;

				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);
			}

			.books-page-cover-static {
				cursor: default;
			}

			.coming-soon {
				display: inline-block;

				color: #6d9fdd;

				font-family: inherit;
				font-size: var(--cta-size);
				font-weight: var(--cta-weight);
				line-height: 1.3;

				letter-spacing: normal;
				text-transform: none;
			}


			/* =========================================================
			   PAPERS
			========================================================= */

			.papers-section {
				width: 100%;

				margin-top: var(--divider-space-before);
				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);

				scroll-margin-top: 8rem;
			}

			.papers-list {
				width: 100%;
			}

			.paper-row {
				display: grid;

				grid-template-columns:
					minmax(150px, 0.55fr)
					minmax(0, 2.8fr);

				align-items: start;

				gap: clamp(1.5rem, 4vw, 3.5rem);

				padding: 34px 0;

				border-bottom: 1px solid var(--line);
			}

			.paper-row:first-child {
				padding-top: 0;
			}

			.paper-row:last-child {
				padding-bottom: 0;

				border-bottom: 0;
			}

			.paper-meta,
			.paper-content {
				min-width: 0;
			}

			.paper-content > .books-page-label {
				margin: 0 0 0.8rem;
			}

			.paper-status {
				margin: 0;

				color: #8a6b36;

				font-size: 0.8rem;
				font-weight: 750;
				line-height: 1.3;
				letter-spacing: 0.12em;

				text-transform: uppercase;
			}

			.paper-date {
				margin: 0.7rem 0 0;

				font-size: 0.86rem;
				line-height: 1.45;

				opacity: 0.58;
			}

			.paper-title {
				margin: 0;

				font-size: clamp(1.45rem, 2.4vw, 2.05rem);
				font-weight: 700;
				line-height: 1.08;
				letter-spacing: -0.035em;
			}

			.paper-subtitle {
				max-width: 800px;

				margin: 0.85rem 0 0;

				font-size: clamp(1rem, 1.4vw, 1.12rem);
				font-weight: 580;
				line-height: 1.48;
			}

			.paper-description {
				max-width: 780px;

				margin: 1rem 0 0;

				font-size: 0.94rem;
				line-height: 1.65;

				opacity: 0.66;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 850px) {
				.paper-row {
					grid-template-columns: 1fr;

					gap: 1.2rem;
				}

				.paper-meta {
					display: flex;
					flex-wrap: wrap;
					align-items: center;

					gap: 0.7rem 1rem;
				}

				.paper-date {
					margin: 0;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.books-index-page {
					padding-top: 42px;
				}

				.books-index-page .books-page-book {
					grid-template-columns: 1fr;

					gap: 24px;
				}

				.books-index-page .books-page-book-featured {
					padding-top: 0;
					padding-bottom: 0;
				}

				.books-index-page .minimal-tolerance-book {
					margin-top: var(--divider-space-mobile);

					padding-top: var(--divider-space-mobile);
				}

				.books-index-page .books-page-cover-wrapper,
				.books-index-page .books-page-cover-link {
					width: 180px;
				}

				.books-index-page .books-page-cover {
					width: 180px;
					max-width: 100%;

					border-radius: 8px;
				}

				.books-index-page .books-page-content h2 {
					font-size: 1.55rem;
				}

				.books-index-page .books-page-subtitle {
					margin-bottom: 18px;

					font-size: 0.92rem;
				}

				.books-index-page .books-page-content > p {
					margin-bottom: 15px;

					font-size: 0.94rem;
					line-height: 1.58;
				}

				.books-index-page .books-page-action {
					margin-top: 18px;
				}

				.books-page-secondary-action {
					margin-top: 10px;
				}

				.papers-section {
					margin-top: var(--divider-space-mobile);

					padding-top: var(--divider-space-mobile);
				}

				.paper-row {
					gap: 1rem;

					padding: 28px 0;
				}

				.paper-title {
					font-size: 1.45rem;
				}

				.paper-subtitle {
					font-size: 1rem;
				}

				.paper-description {
					font-size: 0.94rem;
					line-height: 1.58;
				}
			}
		</style>
	</head>


	<body>
		<Header />


		<main class="books-index-page">

			<!-- =====================================================
			     FEATURED BOOK
			===================================================== -->

			<section
				class="books-page-book books-page-book-featured reveal-section"
				aria-labelledby="cio-book-title"
			>

				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>

					<a
						href="https://www.amazon.com/dp/B0F8MVPN4Q"
						target="_blank"
						rel="noopener noreferrer"
						class="books-page-cover-link"
						aria-label="Buy How to Become CIO and Succeed on Amazon"
					>

						<img
							src="/images/cio-book-cover.png"
							alt="Cover of How to Become CIO and Succeed"
							class="books-page-cover animated-book-cover"
						/>

					</a>

				</div>


				<div
					class="books-page-content reveal-item reveal-delay-1"
				>

					<p class="books-page-label">
						Featured Book
					</p>


					<h2 id="cio-book-title">
						How to Become CIO and Succeed
					</h2>


					<p class="books-page-subtitle">
						People, Business, Strategy
					</p>


					<p>
						This is the book <strong>I wish I had</strong> when I began
						my leadership journey
					</p>


					<p>
						The CIO role is not about managing systems.
						<em>There shouldn’t be an “I” in CIO.</em> It is about
						leading people, shaping strategy, influencing the business,
						and turning technology into a competitive advantage
					</p>


					<p>
						<strong>This is not a textbook.</strong> It is a practical
						field guide for current and aspiring technology leaders
					</p>


					<p class="books-page-closing">
						If you are here to maintain the status quo, turn back now
					</p>


					<p class="books-page-action">

						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>

							<span>
								Buy on Amazon
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>

						</a>

					</p>


					<p class="books-page-secondary-action">

						<a
							href="/cio-book/"
							class="animated-link"
						>

							<span>
								Explore the book
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>

						</a>

					</p>

				</div>

			</section>


			<!-- =====================================================
			     FORTHCOMING BOOK
			===================================================== -->

			<section
				class="books-page-book books-page-book-secondary minimal-tolerance-book reveal-section"
				aria-labelledby="minimal-tolerance-book-title"
			>

				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>

					<div
						class="books-page-cover-link books-page-cover-static"
					>

						<img
							src="/images/book-cover.jpg"
							alt="Cover of A Theory of Minimal Tolerance"
							class="books-page-cover animated-book-cover"
							loading="lazy"
						/>

					</div>

				</div>


				<div
					class="books-page-content reveal-item reveal-delay-1"
				>

					<p class="books-page-label">
						Forthcoming Book
					</p>


					<h2 id="minimal-tolerance-book-title">
						A Theory of Minimal Tolerance
					</h2>


					<p>
						A work exploring freedom, coercion, incentives,
						institutions, and the limits that should constrain
						political power
					</p>


					<p>
						It develops a practical framework for examining the
						conditions under which state coercion may be tolerated
					</p>


					<p class="books-page-action">

						<span class="coming-soon">
							Coming Soon
						</span>

					</p>

				</div>

			</section>


			<!-- =====================================================
			     PAPERS
			===================================================== -->

			<section
				id="papers"
				class="papers-section reveal-section"
				aria-label="Technology papers"
			>

				<div class="papers-list">

					{
						papers.map((paper) => (

							<article class="paper-row reveal-item">

								<div class="paper-meta">

									<p class="paper-status">
										{paper.status}
									</p>


									<p class="paper-date">
										{paper.date}
									</p>

								</div>


								<div class="paper-content">

									<p class="books-page-label">
										Paper
									</p>


									<h2 class="paper-title">
										{paper.title}
									</h2>


									<p class="paper-subtitle">
										{paper.subtitle}
									</p>


									<p class="paper-description">
										{paper.description}
									</p>

								</div>

							</article>

						))
					}

				</div>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.12,
							rootMargin:
								'0px 0px -60px 0px'
						}
					);


				sections.forEach((section) => {

					revealObserver.observe(section);

				});

			} else {

				sections.forEach((section) => {

					section.classList.add(
						'is-visible'
					);

				});

			}
		</script>

	</body>
</html>
