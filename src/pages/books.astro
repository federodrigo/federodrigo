---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const featuredPaper = {
	status: 'Under Review',
	date: 'Submitted · August 2026',
	title: 'When Fixes Become the System',
	subtitle:
		'How Successful Accommodations Build Technology Lock-In',
	description:
		'An examination of how successful fixes can preserve an already-binding technology choice, become embedded over time, and reduce credible alternatives'
};
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Books & Research | Fede Rodrigo"
			description="Books and research by Fede Rodrigo about technology leadership, business, incentives, institutions, and the systems that shape organizations"
			lang="en"
		/>

		<style>
			/* =========================================================
			   PAGE
			========================================================= */

			.books-index-page {
				padding-top: 46px;
			}


			/* =========================================================
			   FEATURED BOOK
			========================================================= */

			.books-index-page .books-page-book-featured {
				margin: 0;

				padding-top: 0;
				padding-bottom: 0;
			}

			.books-page-secondary-action {
				margin-top: 10px;
			}


			/* =========================================================
			   FEATURED RESEARCH
			========================================================= */

			.featured-research {
				width: 100%;

				margin-top: var(--divider-space-before);
				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);

				scroll-margin-top: 8rem;
			}

			.featured-research-grid {
				display: grid;

				grid-template-columns:
					minmax(150px, 0.55fr)
					minmax(0, 2.8fr);

				align-items: start;

				gap: clamp(1.5rem, 4vw, 3.5rem);
			}

			.research-meta,
			.research-content {
				min-width: 0;
			}

			.research-status {
				margin: 0;

				color: #8a6b36;

				font-size: 0.8rem;
				font-weight: 750;
				line-height: 1.3;
				letter-spacing: 0.12em;

				text-transform: uppercase;
			}

			.research-date {
				margin: 0.7rem 0 0;

				font-size: 0.86rem;
				line-height: 1.45;

				opacity: 0.58;
			}

			.research-content > .books-page-label {
				margin: 0 0 0.8rem;

				font-size: 0.97rem;
				line-height: 1.2;
			}

			.research-title {
				max-width: 900px;

				margin: 0;

				font-size: clamp(1.8rem, 3vw, 2.65rem);
				font-weight: 700;
				line-height: 1.05;
				letter-spacing: -0.04em;
			}

			.research-subtitle {
				max-width: 800px;

				margin: 0.9rem 0 0;

				font-size: clamp(1.05rem, 1.5vw, 1.18rem);
				font-weight: 580;
				line-height: 1.48;
			}

			.research-description {
				max-width: 780px;

				margin: 1rem 0 0;

				font-size: 0.97rem;
				line-height: 1.65;

				opacity: 0.68;
			}


			/* =========================================================
			   OTHER WORK
			========================================================= */

			.other-work-section {
				width: 100%;

				margin-top: var(--divider-space-before);
				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);
			}

			.other-work-heading {
				margin: 0 0 30px;

				font-size: 0.97rem;
				font-weight: 600;
				line-height: 1.2;
			}

			.other-work-item {
				display: grid;

				grid-template-columns:
					140px
					minmax(0, 1fr);

				align-items: start;

				gap: clamp(1.5rem, 4vw, 3rem);
			}

			.other-work-cover-wrapper {
				width: 140px;
			}

			.other-work-cover {
				display: block;

				width: 140px;
				max-width: 100%;
				height: auto;

				border-radius: 7px;
			}

			.other-work-content {
				min-width: 0;

				padding-top: 2px;
			}

			.other-work-meta {
				margin: 0 0 0.75rem;

				color: #6d9fdd;

				font-size: 0.8rem;
				font-weight: 700;
				line-height: 1.3;
			}

			.other-work-title {
				margin: 0;

				font-size: clamp(1.35rem, 2.2vw, 1.85rem);
				font-weight: 700;
				line-height: 1.1;
				letter-spacing: -0.03em;
			}

			.other-work-description {
				max-width: 680px;

				margin: 1rem 0 0;

				font-size: 0.94rem;
				line-height: 1.62;

				opacity: 0.66;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 850px) {
				.featured-research-grid {
					grid-template-columns: 1fr;

					gap: 1.2rem;
				}

				.research-meta {
					display: flex;
					flex-wrap: wrap;
					align-items: center;

					gap: 0.7rem 1rem;
				}

				.research-date {
					margin: 0;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.books-index-page {
					padding-top: 42px;
				}

				.books-index-page .books-page-book {
					grid-template-columns: 1fr;

					gap: 24px;
				}

				.books-index-page .books-page-book-featured {
					padding-top: 0;
					padding-bottom: 0;
				}

				.books-index-page .books-page-cover-wrapper,
				.books-index-page .books-page-cover-link {
					width: 180px;
				}

				.books-index-page .books-page-cover {
					width: 180px;
					max-width: 100%;

					border-radius: 8px;
				}

				.books-index-page .books-page-content h2 {
					font-size: 1.55rem;
				}

				.books-index-page .books-page-subtitle {
					margin-bottom: 18px;

					font-size: 0.92rem;
				}

				.books-index-page .books-page-content > p {
					margin-bottom: 15px;

					font-size: 0.94rem;
					line-height: 1.58;
				}

				.books-index-page .books-page-action {
					margin-top: 18px;
				}

				.books-page-secondary-action {
					margin-top: 10px;
				}


				/* Research */

				.featured-research {
					margin-top: var(--divider-space-mobile);

					padding-top: var(--divider-space-mobile);
				}

				.research-content > .books-page-label {
					font-size: 0.94rem;
					line-height: 1.2;
				}

				.research-title {
					font-size: 1.6rem;
				}

				.research-subtitle {
					font-size: 1rem;
				}

				.research-description {
					font-size: 0.94rem;
					line-height: 1.58;
				}


				/* Other Work */

				.other-work-section {
					margin-top: var(--divider-space-mobile);

					padding-top: var(--divider-space-mobile);
				}

				.other-work-heading {
					margin-bottom: 24px;
				}

				.other-work-item {
					grid-template-columns: 100px minmax(0, 1fr);

					gap: 20px;
				}

				.other-work-cover-wrapper,
				.other-work-cover {
					width: 100px;
				}

				.other-work-title {
					font-size: 1.3rem;
				}

				.other-work-description {
					font-size: 0.92rem;
					line-height: 1.55;
				}
			}


			/* =========================================================
			   SMALL MOBILE
			========================================================= */

			@media (max-width: 480px) {
				.other-work-item {
					grid-template-columns: 1fr;

					gap: 18px;
				}

				.other-work-cover-wrapper,
				.other-work-cover {
					width: 110px;
				}
			}
		</style>
	</head>


	<body>
		<Header />


		<main class="books-index-page">

			<!-- =====================================================
			     FEATURED BOOK
			===================================================== -->

			<section
				class="books-page-book books-page-book-featured reveal-section"
				aria-labelledby="cio-book-title"
			>

				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>

					<a
						href="https://www.amazon.com/dp/B0F8MVPN4Q"
						target="_blank"
						rel="noopener noreferrer"
						class="books-page-cover-link"
						aria-label="Buy How to Become CIO and Succeed on Amazon"
					>

						<img
							src="/images/cio-book-cover.png"
							alt="Cover of How to Become CIO and Succeed"
							class="books-page-cover animated-book-cover"
						/>

					</a>

				</div>


				<div
					class="books-page-content reveal-item reveal-delay-1"
				>

					<p class="books-page-label">
						Featured Book
					</p>


					<h2 id="cio-book-title">
						How to Become CIO and Succeed
					</h2>


					<p class="books-page-subtitle">
						People, Business, Strategy
					</p>


					<p>
						This is the book <strong>I wish I had</strong> when I began
						my leadership journey
					</p>


					<p>
						The CIO role is not about managing systems.
						<em>There shouldn’t be an “I” in CIO.</em> It is about
						leading people, shaping strategy, influencing the business,
						and turning technology into a competitive advantage
					</p>


					<p>
						<strong>This is not a textbook.</strong> It is a practical
						field guide for current and aspiring technology leaders
					</p>


					<p class="books-page-closing">
						If you are here to maintain the status quo, turn back now
					</p>


					<p class="books-page-action">

						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>

							<span>
								Buy on Amazon
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>

						</a>

					</p>


					<p class="books-page-secondary-action">

						<a
							href="/cio-book/"
							class="animated-link"
						>

							<span>
								Explore the book
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>

						</a>

					</p>

				</div>

			</section>


			<!-- =====================================================
			     FEATURED RESEARCH
			===================================================== -->

			<section
				id="research"
				class="featured-research reveal-section"
				aria-labelledby="featured-research-title"
			>

				<div class="featured-research-grid">

					<div class="research-meta reveal-item">

						<p class="research-status">
							{featuredPaper.status}
						</p>

						<p class="research-date">
							{featuredPaper.date}
						</p>

					</div>


					<div
						class="research-content reveal-item reveal-delay-1"
					>

						<p class="books-page-label">
							Research Paper
						</p>


						<h2
							id="featured-research-title"
							class="research-title"
						>
							{featuredPaper.title}
						</h2>


						<p class="research-subtitle">
							{featuredPaper.subtitle}
						</p>


						<p class="research-description">
							{featuredPaper.description}
						</p>

					</div>

				</div>

			</section>


			<!-- =====================================================
			     OTHER WORK
			===================================================== -->

			<section
				class="other-work-section reveal-section"
				aria-labelledby="other-work-heading"
			>

				<p
					id="other-work-heading"
					class="other-work-heading reveal-item"
				>
					Other Work
				</p>


				<article class="other-work-item reveal-item reveal-delay-1">

					<div class="other-work-cover-wrapper">

						<img
							src="/images/book-cover.jpg"
							alt="Cover of A Theory of Minimal Tolerance"
							class="other-work-cover"
							loading="lazy"
						/>

					</div>


					<div class="other-work-content">

						<p class="other-work-meta">
							Forthcoming Book
						</p>


						<h2 class="other-work-title">
							A Theory of Minimal Tolerance
						</h2>


						<p class="other-work-description">
							A work exploring freedom, coercion, incentives,
							institutions, and the limits that should constrain
							political power. It develops a framework for examining
							the conditions under which state coercion may be
							tolerated.
						</p>

					</div>

				</article>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.12,
							rootMargin:
								'0px 0px -60px 0px'
						}
					);


				sections.forEach((section) => {

					revealObserver.observe(section);

				});

			} else {

				sections.forEach((section) => {

					section.classList.add(
						'is-visible'
					);

				});

			}
		</script>

	</body>
</html>
