---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Contact | Fede Rodrigo"
			description="Contact Fede Rodrigo for CIO advisory, speaking engagements, podcasts, media inquiries, and general questions"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Get in <span class="accent">Touch</span>
					</span>
				</h1>

				<div class="lead-principles">
					<div>Stay Hands-on</div>
					<div>Lead by Example</div>
				</div>
			</section>

			<section class="contact-page reveal-section">
				<div
					class="contact-page-info reveal-item reveal-from-left"
				>
					<h2>Contact information</h2>

					<p class="contact-page-intro">
						For advisory, speaking engagements, podcasts, media, or
						general inquiries
					</p>

					<div class="contact-page-links">
						<div
							class="contact-page-item"
							style="--contact-index: 0;"
						>
							<span
								class="contact-page-icon"
								aria-hidden="true"
							>
								✉
							</span>

							<div>
								<p class="contact-page-item-label">
									Email
								</p>

								<a href="mailto:contact@federodrigo.com">
									contact@federodrigo.com
								</a>
							</div>
						</div>

						<div
							class="contact-page-item"
							style="--contact-index: 1;"
						>
							<span
								class="contact-page-icon contact-page-linkedin-icon"
								aria-hidden="true"
							>
								in
							</span>

							<div>
								<p class="contact-page-item-label">
									LinkedIn
								</p>

								<a
									href="https://www.linkedin.com/in/fede-rodrigo/"
									target="_blank"
									rel="noopener noreferrer"
								>
									linkedin.com/in/fede-rodrigo
								</a>
							</div>
						</div>
					</div>

					<div class="contact-page-response">
						<p class="contact-page-response-label">
							Response Time
						</p>

						<p>
							I typically respond within 2–3 business days
						</p>
					</div>
				</div>

				<div
					class="contact-page-form-wrapper reveal-item reveal-from-right reveal-delay-1"
				>
					<form
						id="contact-form"
						class="contact-page-form"
						method="POST"
						action="/api/contact"
					>
						<div
							class="contact-page-form-row contact-animated-field"
							style="--field-index: 0;"
						>
							<div class="contact-page-field">
								<label for="first-name">
									First Name
								</label>

								<input
									id="first-name"
									name="firstName"
									type="text"
									autocomplete="given-name"
									placeholder="Jane"
									required
								/>
							</div>

							<div class="contact-page-field">
								<label for="last-name">
									Last Name
								</label>

								<input
									id="last-name"
									name="lastName"
									type="text"
									autocomplete="family-name"
									placeholder="Smith"
									required
								/>
							</div>
						</div>

						<div
							class="contact-page-field contact-animated-field"
							style="--field-index: 1;"
						>
							<label for="email">
								Email
							</label>

							<input
								id="email"
								name="email"
								type="email"
								autocomplete="email"
								placeholder="jane@company.com"
								required
							/>
						</div>

						<div
							class="contact-page-field contact-animated-field"
							style="--field-index: 2;"
						>
							<label for="subject">
								Subject
							</label>

							<select
								id="subject"
								name="subject"
								required
							>
								<option value="" selected disabled>
									Select a topic...
								</option>

								<option value="executive-opportunity">
									Executive Opportunity
								</option>

								<option value="fractional-cio">
									Fractional CIO
								</option>

								<option value="cio-advisory">
									CIO Advisory
								</option>

								<option value="speaking">
									Speaking Engagement
								</option>

								<option value="podcast-media">
									Podcast or Media Inquiry
								</option>

								<option value="books">
									Books and Publications
								</option>

								<option value="general">
									General Inquiry
								</option>
							</select>
						</div>

						<div
							class="contact-page-field contact-animated-field"
							style="--field-index: 3;"
						>
							<label for="message">
								Message
							</label>

							<textarea
								id="message"
								name="message"
								rows="7"
								placeholder="How can I help?"
								required
							></textarea>
						</div>

						<button
							id="contact-submit"
							type="submit"
							class="contact-page-submit contact-animated-field"
							style="--field-index: 4;"
						>
							<span class="contact-page-submit-text">
								Send Message
							</span>

							<span
								class="contact-page-submit-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</button>

						<p
							id="contact-status"
							class="contact-page-status"
							role="status"
							aria-live="polite"
							hidden
						></p>
					</form>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.12,
					rootMargin: '0px 0px -60px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});

			const form = document.querySelector<HTMLFormElement>(
				'#contact-form'
			);

			const submitButton =
				document.querySelector<HTMLButtonElement>('#contact-submit');

			const submitText = document.querySelector<HTMLElement>(
				'.contact-page-submit-text'
			);

			const status =
				document.querySelector<HTMLElement>('#contact-status');

			if (form && submitButton && submitText && status) {
				form.addEventListener('submit', async (event) => {
					event.preventDefault();

					if (!form.reportValidity()) {
						return;
					}

					submitButton.disabled = true;
					submitButton.setAttribute('aria-busy', 'true');
					submitText.textContent = 'Sending...';

					status.hidden = true;
					status.textContent = '';
					status.classList.remove(
						'contact-page-status-success',
						'contact-page-status-error'
					);

					try {
						const response = await fetch(form.action, {
							method: 'POST',
							body: new FormData(form),
							headers: {
								Accept: 'application/json',
							},
						});

						const result = await response
							.json()
							.catch(() => null);

						if (!response.ok) {
							throw new Error(
								result?.message ||
									'Your message could not be sent'
							);
						}

						form.reset();

						status.textContent =
							'Thank you. Your message has been sent.';

						status.classList.add(
							'contact-page-status-success'
						);

						status.hidden = false;
					} catch (error) {
						status.textContent =
							error instanceof Error
								? error.message
								: 'Your message could not be sent. Please try again.';

						status.classList.add(
							'contact-page-status-error'
						);

						status.hidden = false;
					} finally {
						submitButton.disabled = false;
						submitButton.removeAttribute('aria-busy');
						submitText.textContent = 'Send Message';
					}
				});
			}
		</script>
	</body>
</html>
