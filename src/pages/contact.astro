---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import SiteEffects from '../components/SiteEffects.astro';
---
<!doctype html>
<html lang="en"><head><SEO
			title="Contact | Fede Rodrigo"
			description="Contact Fede Rodrigo for CIO advisory, speaking engagements, podcasts, media inquiries, and general questions"
			lang="en"
		/></head><body><Header />
<main id="main-content" class="contact-page-main"><section class="page-intro"><h1>Let’s talk</h1><p>For advisory, speaking, podcasts, media and other inquiries</p></section>
			<section
				class="contact-page contact-page-direct reveal-section"
			>
				<div
					class="contact-page-info reveal-item reveal-from-left"
				>
					<h2>
						Contact information
					</h2>
					<p class="contact-page-intro">
						For advisory, speaking engagements, podcasts, media, or
						general inquiries
					</p>
					<div class="contact-page-links">
						<div
							class="contact-page-item"
							style="--contact-index: 0;"
						>
							<span
								class="contact-page-icon"
								aria-hidden="true"
							>
								✉
							</span>
							<div>
								<p class="contact-page-item-label">
									Email
								</p>
								<a href="mailto:contact@federodrigo.com">
									contact@federodrigo.com
								</a>
							</div>
						</div>
						<div
							class="contact-page-item"
							style="--contact-index: 1;"
						>
							<span
								class="contact-page-icon contact-page-linkedin-icon"
								aria-hidden="true"
							>
								in
							</span>
							<div>
								<p class="contact-page-item-label">
									LinkedIn
								</p>
								<a
									href="https://www.linkedin.com/in/fede-rodrigo/"
									target="_blank"
									rel="noopener noreferrer"
								>
									linkedin.com/in/fede-rodrigo
								</a>
							</div>
						</div>
					</div>
					<div class="contact-page-response">
						<p class="contact-page-response-label">
							Response Time
						</p>
						<p>
							I typically respond within 2–3 business days
						</p>
					</div>
				</div>
				<div
					class="contact-page-form-wrapper reveal-item reveal-from-right reveal-delay-1"
				>
					<form
						id="contact-form"
						class="contact-page-form"
						method="POST"
						data-preview={import.meta.env.PUBLIC_SITE_PREVIEW === '1' ? 'true' : 'false'} action={import.meta.env.PUBLIC_SITE_PREVIEW === '1' ? 'mailto:contact@federodrigo.com' : '/api/contact'}
					>
						<div
							class="contact-page-form-row contact-animated-field"
							style="--field-index: 0;"
						>
							<div class="contact-page-field">
								<label for="first-name">
									First Name
								</label>
								<input
									id="first-name"
									name="firstName"
									type="text"
									autocomplete="given-name"
									placeholder="Jane"
									required
								/>
							</div>
							<div class="contact-page-field">
								<label for="last-name">
									Last Name
								</label>
								<input
									id="last-name"
									name="lastName"
									type="text"
									autocomplete="family-name"
									placeholder="Smith"
									required
								/>
							</div>
						</div>
						<div
							class="contact-page-field contact-animated-field"
							style="--field-index: 1;"
						>
							<label for="email">
								Email
							</label>
							<input
								id="email"
								name="email"
								type="email"
								autocomplete="email"
								placeholder="jane@company.com"
								required
							/>
						</div>
						<div
							class="contact-page-field contact-animated-field"
							style="--field-index: 2;"
						>
							<label for="subject">
								Subject
							</label>
							<select
								id="subject"
								name="subject"
								required
							>
								<option
									value=""
									selected
									disabled
								>
									Select a topic...
								</option>
								<option value="cio-advisory">
									Advisory and Fractional CIO
								</option>
								<option value="speaking">
									Speaking, Webinar, Podcast
								</option>
								<option value="general">
									General Inquiry
								</option>
							</select>
						</div>
						<div
							class="contact-page-field contact-animated-field"
							style="--field-index: 3;"
						>
							<label for="message">
								Message
							</label>
							<textarea
								id="message"
								name="message"
								rows="7"
								placeholder="How can I help?"
								required
							></textarea>
						</div>
						<button
							id="contact-submit"
							type="submit"
							class="contact-page-submit contact-animated-field"
							style="--field-index: 4;"
						>
							<span class="contact-page-submit-text">{import.meta.env.PUBLIC_SITE_PREVIEW === '1' ? 'Continue by email' : 'Send message'}</span>
							<span
								class="contact-page-submit-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</button>
						<p
							id="contact-status"
							class="contact-page-status"
							role="status"
							aria-live="polite"
							hidden
						></p>
					</form>
				</div>
			</section>
		</main>
<Footer /><SiteEffects /></body></html>
