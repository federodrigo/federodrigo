---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="CIO Book | How to Become CIO and Succeed"
			description="How to Become CIO and Succeed is a practical CIO leadership book for aspiring and current CIOs, focused on people, business, strategy, IT leadership, and creating value through technology."
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section
				id="book"
				class="books-page-book books-page-book-featured reveal-section"
				aria-labelledby="cio-book-title"
			>
				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>
					<a
						href="https://www.amazon.com/dp/B0F8MVPN4Q"
						target="_blank"
						rel="noopener noreferrer"
						class="books-page-cover-link"
						aria-label="View How to Become CIO and Succeed on Amazon"
					>
						<img
							src="/images/cio-book-cover.jpg"
							alt="Cover of the CIO book How to Become CIO and Succeed by Fede Rodrigo"
							class="books-page-cover animated-book-cover"
						/>
					</a>

					<div
						class="cio-duck"
						tabindex="0"
						aria-describedby="cio-duck-tooltip"
					>
						<img
							src="/images/duckcio.png"
							alt="A skeptical yellow duck wearing glasses"
						/>

						<span
							id="cio-duck-tooltip"
							class="cio-duck-tooltip"
							role="tooltip"
						>
							He has seen too many IT projects.
						</span>
					</div>
				</div>

				<div class="books-page-content reveal-item reveal-delay-1">
					<p class="books-page-label">
						CIO Leadership Book
					</p>

					<h2 id="cio-book-title">
						How to Become CIO and Succeed
					</h2>

					<p class="books-page-subtitle">
						People, Business, Strategy
					</p>

					<p>
						The Chief Information Officer role is not about managing
						systems. <em>There shouldn’t be an “I” in CIO.</em>
						It is about leading people, shaping strategy, influencing
						the business, and turning technology into a competitive
						advantage
					</p>

					<p>
						<strong>This is not a textbook.</strong>
						It is a practical field guide for current and aspiring
						technology leaders
					</p>

					<p class="books-page-closing">
						If you are here to maintain the status quo,
						turn back now
					</p>

					<p class="books-page-action">
						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>Buy the book on Amazon</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>

			<section
				id="what-you-will-learn"
				class="books-page-other reveal-section"
				aria-labelledby="what-you-will-learn-title"
			>
				<div class="reveal-item">
					<h2 id="what-you-will-learn-title">
						What You Will Learn
					</h2>
				</div>

				<div class="reveal-item reveal-delay-1">
					<p>
						How to build effective teams, create a service-oriented
						culture, earn credibility, influence executive decisions,
						improve operations, shape technology strategy, and
						consistently create business value
					</p>

					<p>
						You will also learn how to lead across the full scope of
						modern IT, from infrastructure and enterprise systems to
						cybersecurity, transformation, and continuous change
					</p>
				</div>
			</section>

			<section
				id="who-is-this-book-for"
				class="books-page-other reveal-section"
				aria-labelledby="who-is-this-book-for-title"
			>
				<div class="reveal-item">
					<h2 id="who-is-this-book-for-title">
						Who This CIO Book Is For
					</h2>
				</div>

				<div class="reveal-item reveal-delay-1">
					<p>
						This practical book for aspiring CIOs is also written for
						current CIOs, IT managers, technology directors, and
						business leaders who want to understand and strengthen
						the modern CIO role
					</p>
				</div>
			</section>

			<section
				id="buy"
				class="books-page-other reveal-section"
				aria-labelledby="get-the-book-title"
			>
				<div class="reveal-item">
					<h2 id="get-the-book-title">
						Get the Book
					</h2>
				</div>

				<div class="books-page-content reveal-item reveal-delay-1">
					<p>
						Discover a practical approach to CIO leadership built
						around people, business, strategy, and technology
					</p>

					<p class="books-page-action">
						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>Buy How to Become CIO on Amazon</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.12,
					rootMargin: '0px 0px -60px 0px'
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>

		<style>
			.books-page-cover-wrapper {
				position: relative;
			}

			.cio-duck {
				position: absolute;
				right: -3rem;
				bottom: -1.5rem;
				width: clamp(5rem, 8vw, 7rem);
				z-index: 2;
				cursor: default;
				outline: none;
			}

			.cio-duck img {
				display: block;
				width: 100%;
				height: auto;
				transition:
					transform 180ms ease,
					filter 180ms ease;
			}

			.cio-duck-tooltip {
				position: absolute;
				z-index: 9999;
				left: 50%;
				bottom: calc(100% + 0.75rem);
				width: max-content;
				max-width: 15rem;
				padding: 0.55rem 0.75rem;
				border-radius: 0.4rem;
				background: #102a46;
				color: #fff;
				font-size: 0.85rem;
				font-weight: 600;
				line-height: 1.3;
				text-align: center;
				opacity: 0;
				visibility: hidden;
				transform: translate(-50%, 0.4rem);
				transition:
					opacity 160ms ease,
					transform 160ms ease,
					visibility 160ms ease;
				pointer-events: none;
				white-space: nowrap;
			}

			.cio-duck-tooltip::after {
				content: '';
				position: absolute;
				top: 100%;
				left: 50%;
				border: 0.4rem solid transparent;
				border-top-color: #102a46;
				transform: translateX(-50%);
			}

			.cio-duck:hover img,
			.cio-duck:focus-visible img {
				transform: translateY(-0.2rem) rotate(-2deg);
				filter: drop-shadow(
					0 0.5rem 0.6rem rgb(16 42 70 / 20%)
				);
			}

			.cio-duck:hover .cio-duck-tooltip,
			.cio-duck:focus-visible .cio-duck-tooltip {
				opacity: 1;
				visibility: visible;
				transform: translate(-50%, 0);
			}

			@media (max-width: 768px) {
				.cio-duck {
					right: -0.75rem;
					bottom: -1rem;
					width: 5rem;
				}

				.cio-duck-tooltip {
					left: auto;
					right: 0;
					white-space: normal;
					width: 12rem;
					transform: translateY(0.4rem);
				}

				.cio-duck:hover .cio-duck-tooltip,
				.cio-duck:focus-visible .cio-duck-tooltip {
					transform: translateY(0);
				}

				.cio-duck-tooltip::after {
					left: auto;
					right: 1.5rem;
					transform: none;
				}
			}
		</style>
	</body>
</html>
