---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<SEO
			title="CIO Book | How to Become CIO and Succeed"
			description="How to Become CIO and Succeed is a practical CIO book about leadership, people, business, strategy, and creating value through technology."
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section id="book">
				<article
					class="books-page-book books-page-book-featured"
					aria-label="How to Become CIO and Succeed"
				>
					<div class="books-page-cover-wrapper">
						<img
							src="/images/cio-book-cover.jpg"
							alt="Cover of the CIO book How to Become CIO and Succeed by Fede Rodrigo"
							class="books-page-cover"
						/>
					</div>

					<div class="books-page-content">
						<p class="books-page-label">
							CIO Leadership Book
						</p>

						<p class="books-page-subtitle">
							People, Business, Strategy
						</p>

						<p>
							The CIO role is not about managing systems.
							<em>There shouldn’t be an “I” in CIO.</em>
							It is about leading people, shaping strategy,
							influencing the business, and turning technology
							into a competitive advantage
						</p>

						<p>
							<strong>This is not a textbook.</strong>
							It is a practical field guide for current and
							aspiring technology leaders
						</p>

						<p class="books-page-closing">
							If you are here to maintain the status quo,
							turn back now.
						</p>

						<p class="books-page-action">
							<a
								href="https://www.amazon.com/dp/B0F8MVPN4Q"
								target="_blank"
								rel="noopener noreferrer"
							>
								Buy the book on Amazon →
							</a>
						</p>
					</div>
				</article>
			</section>

			<section id="what-you-will-learn">
				<h2>What You Will Learn</h2>

				<div class="about-content">
					<p>
						How to build effective teams, create a service-oriented
						culture, earn credibility, influence executive decisions,
						improve operations, shape technology strategy, and
						consistently create business value
					</p>

					<p>
						You will also learn how to lead across the full scope of
						modern IT, from infrastructure and enterprise systems to
						cybersecurity, transformation, and continuous change
					</p>
				</div>
			</section>

			<section id="who-is-this-book-for">
				<h2>Who This CIO Book Is For</h2>

				<div class="about-content">
					<p>
						For aspiring and current CIOs, IT managers, technology
						directors, and business leaders who want to understand
						and strengthen the modern CIO role
					</p>
				</div>
			</section>

			<section id="buy">
				<h2>Get the Book</h2>

				<div class="about-content">
					<p>
						Discover a practical approach to CIO leadership built
						around people, business, strategy, and technology
					</p>

					<p class="books-page-action">
						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
						>
							Buy How to Become CIO and Succeed →
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
