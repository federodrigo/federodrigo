---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

{
	type: 'Webinar',
	status: 'upcoming',
	title: 'Technology is Never the Starting Point — Xseed',
	date: 'August 20, 2026',
	image: '/images/xseed-webinar.png',
	imageAlt: 'Technology is Never the Starting Point webinar with Federico Rodrigo',
	description:
		'A free, practical session on how IT becomes a true driver of business value by starting with people, aligning with the business, and letting technology enable the outcome—not define it.',
	url: '/webinar/',
	linkLabel: 'Learn more & save my spot',
},

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<SEO
			title="Media & Events | Fede Rodrigo"
			description="Interviews, podcasts, professional recognitions, executive roundtables, and events"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Media & <span class="accent">Events</span>
					</span>
				</h1>

				<div class="lead-principles">
					<div>Technology Is Part of the Job</div>
					<div>Leadership Is the Job</div>
				</div>
			</section>

			<section
				class="media-list reveal-section"
				aria-labelledby="media-list-title"
			>
				<h2
					id="media-list-title"
					class="reveal-item"
				>
					Highlights
				</h2>

				{
					mediaItems.map((item, index) => (
						<article
							class="media-item"
							style={`--media-index: ${index};`}
						>
							<div class="media-image-wrapper">
								{
									item.href ? (
										<a
											href={item.href}
											class="media-image-link"
											aria-label={item.linkLabel || item.title}
										>
											<img
												src={item.image}
												alt={item.imageAlt}
												class="media-image"
												loading="lazy"
											/>
										</a>
									) : item.url ? (
										<a
											href={item.url}
											target="_blank"
											rel="noopener noreferrer"
											class="media-image-link"
											aria-label={item.linkLabel || item.title}
										>
											<img
												src={item.image}
												alt={item.imageAlt}
												class="media-image"
												loading="lazy"
											/>
										</a>
									) : (
										<img
											src={item.image}
											alt={item.imageAlt}
											class="media-image"
											loading="lazy"
										/>
									)
								}
							</div>

							<div class="media-content">
								<p class="media-meta">
									<span>{item.type}</span>
									<span aria-hidden="true">·</span>
									<span>{item.date}</span>
								</p>

								<h3>{item.title}</h3>

								<p class="media-description">
									{item.description}
								</p>

								{
									item.href ? (
										<div class="media-action">
											<a
												href={item.href}
												class="animated-link"
											>
												<span>
													{item.linkLabel}
												</span>

												<span
													class="animated-link-arrow"
													aria-hidden="true"
												>
													→
												</span>
											</a>
										</div>
									) : item.url ? (
										<div class="media-action">
											{
												item.pdfUrl && (
													<a
														href={item.pdfUrl}
														target="_blank"
														rel="noopener noreferrer"
														class="animated-link"
													>
														<span>
															{item.pdfLabel}
														</span>

														<span
															class="animated-link-arrow"
															aria-hidden="true"
														>
															→
														</span>
													</a>
												)
											}

											<a
												href={item.url}
												target="_blank"
												rel="noopener noreferrer"
												class="animated-link"
											>
												<span>
													{item.linkLabel}
												</span>

												<span
													class="animated-link-arrow"
													aria-hidden="true"
												>
													→
												</span>
											</a>
										</div>
									) : (
										item.status === 'upcoming' && (
											<p class="media-coming-soon">
												Coming soon
											</p>
										)
									)
								}
							</div>
						</article>
					))
				}
			</section>

			<section class="media-contact reveal-section">
				<h2 class="reveal-item">
					Media Inquiries
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						For interviews, podcasts, speaking engagements, or other
						media opportunities, please get in touch
					</p>

					<p class="media-contact-link">
						<a href="/contact/" class="animated-link">
							<span>Contact me</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>

<style>
	.media-image-link {
		display: block;
		width: 100%;
		text-decoration: none;
	}

	.media-image-link .media-image {
		transition:
			transform 220ms ease,
			opacity 220ms ease;
	}

	.media-image-link:hover .media-image {
		transform: scale(1.015);
		opacity: 0.92;
	}
</style>
