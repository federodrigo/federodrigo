---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const mediaItems = [
	{
		type: 'Podcast',
		status: 'upcoming',
		title: 'The Technology Vanguard',
		date: 'August 2026',
		image: '/images/vanguard.jpg',
		imageAlt: 'Fede Rodrigo appearing on The Technology Vanguard podcast',
		description:
			'An upcoming conversation exploring technology leadership, career development, AI, business strategy, and the personal journey behind today’s IT leaders',
	},
	{
		type: 'Written Interview',
		status: 'published',
		title: 'Interview with Nublit',
		date: 'January 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt: 'Interview with Fede Rodrigo published by Nublit',
		description:
			'Interview with Nublit discussing cloud strategy, governance, business outcomes, and how organizations can avoid turning the cloud into just another expensive data center',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'Read Interview',
	},
	{
		type: 'Recognition',
		status: 'published',
		title: '2024 Central Texas ORBIE Awards',
		date: 'September 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'ORBIE Awards logo',
		description:
			'Named a Global Finalist at the 2024 Central Texas ORBIE Awards, recognizing technology executives for leadership and business impact',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'View Recognition',
	},
	{
		type: 'Executive Roundtable',
		status: 'published',
		title: 'Industrial Reinvention',
		date: 'September 2024',
		image: '/images/Impact.png',
		imageAlt: 'Economist Impact logo',
		description:
			'Invited participant in The Economist Impact executive roundtable held in Houston, Texas, bringing together technology leaders to discuss industrial reinvention, emerging business models, and the future of work',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>

		<title>Media & Appearances | Fede Rodrigo</title>

		<meta
			name="description"
			content="Interviews, podcasts, professional recognitions, executive roundtables, and public appearances featuring Fede Rodrigo."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="media-hero">
				<h1>
					Media &
					<span class="accent">Appearances</span>
				</h1>

				<p class="lead">
					A chronological collection of interviews, podcast
					appearances, professional recognitions, executive
					roundtables, and other public engagements.
				</p>
			</section>

			<section
				class="media-list"
				aria-labelledby="media-list-title"
			>
				<h2 id="media-list-title">Highlights</h2>

				{
					mediaItems.map((item) => (
						<article class="media-item">
							<div class="media-image-wrapper">
								<img
									src={item.image}
									alt={item.imageAlt}
									class="media-image"
									loading="lazy"
								/>
							</div>

							<div class="media-content">
								<p class="media-meta">
									<span>{item.type}</span>
									<span aria-hidden="true">·</span>
									<span>{item.date}</span>
								</p>

								<h3>{item.title}</h3>

								<p class="media-description">
									{item.description}
								</p>

								{
									item.url ? (
										<p class="media-action">
											<a
												href={item.url}
												target="_blank"
												rel="noopener noreferrer"
											>
												{item.linkLabel} →
											</a>
										</p>
									) : (
										item.status === 'upcoming' && (
											<p class="media-coming-soon">
												Coming Soon
											</p>
										)
									)
								}
							</div>
						</article>
					))
				}
			</section>

			<section class="media-contact">
				<h2>Media Inquiries</h2>

				<p>
					For interviews, podcasts, speaking engagements, or other
					media opportunities, please get in touch.
				</p>

				<p class="media-contact-link">
					<a href="/#contact">Contact Me →</a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
