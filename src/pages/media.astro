---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const mediaItems = [
	{
		type: 'Webinar',
		status: 'upcoming',
		title: 'Technology is Never the Starting Point — Xseed',
		date: 'August 20, 2026',
		image: '/images/xseed-webinar.png',
		imageAlt: 'Technology is Never the Starting Point webinar with Federico Rodrigo',
		description:
			'A free, practical session on how IT becomes a true driver of business value by starting with people, aligning with the business, and letting technology enable the outcome—not define it.',
		href: '/webinar/',
		linkLabel: 'Learn more & save my spot',
	},
	{
		type: 'Podcast',
		status: 'upcoming',
		title: 'The Technology Vanguard',
		date: 'August 2026',
		image: '/images/vanguard.jpg',
		imageAlt: 'Fede Rodrigo appearing on The Technology Vanguard podcast',
		description:
			'An upcoming conversation exploring technology leadership, career development, AI, business strategy, and the personal journey behind today’s IT leaders',
	},
	{
		type: 'Written Interview',
		status: 'published',
		title: 'Turning Cloud Investment into Business Value — Nublit',
		date: 'January 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt: 'Interview with Fede Rodrigo published by Nublit',
		description:
			'A conversation with Nublit about cloud strategy in Latin America, hybrid adoption, cultural and regulatory barriers, and the role of technology as a driver of growth, innovation, and operational resilience',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'View full report',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Read my interview',
	},
	{
		type: 'Award Finalist',
		status: 'published',
		title: 'ORBIE CIO Awards',
		date: 'September 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'ORBIE Awards CIO Central Texas',
		description:
			'Recognized as a finalist in the Global CIO category at the Central Texas awards',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'View recognition',
	},
	{
		type: 'Executive Roundtable',
		status: 'published',
		title: 'Industrial Reinvention — The Economist',
		date: 'September 2024',
		image: '/images/impact.png',
		imageAlt: 'The Economist Impact',
		description:
			'Invited participant in Industrial Reinvention: New Business Models and Jobs for Tomorrow’s Technology, hosted by The Economist Impact, with fellow CIOs in Houston, Texas',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Media & Events | Fede Rodrigo"
			description="Interviews, podcasts, professional recognitions, executive roundtables, and events"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Media & <span class="accent">Events</span>
					</span>
				</h1>

				<div class="lead-principles">
					<div>Technology Is Part of the Job</div>
					<div>Leadership Is the Job</div>
				</div>
			</section>

			<section
				class="media-list reveal-section"
				aria-labelledby="media-list-title"
			>
				<h2
					id="media-list-title"
					class="reveal-item"
				>
					Highlights
				</h2>

				{
					mediaItems.map((item, index) => (
						<article
							class="media-item"
							style={`--media-index: ${index};`}
						>
							<div class="media-image-wrapper">
								<img
									src={item.image}
									alt={item.imageAlt}
									class="media-image"
									loading="lazy"
								/>
							</div>

							<div class="media-content">
								<p class="media-meta">
									<span>{item.type}</span>
									<span aria-hidden="true">·</span>
									<span>{item.date}</span>
								</p>

								<h3>{item.title}</h3>

								<p class="media-description">
									{item.description}
								</p>

								{
									item.url ? (
										<div class="media-action">
											{
												item.pdfUrl && (
													<a
														href={item.pdfUrl}
														target="_blank"
														rel="noopener noreferrer"
														class="animated-link"
													>
														<span>
															{item.pdfLabel}
														</span>

														<span
															class="animated-link-arrow"
															aria-hidden="true"
														>
															→
														</span>
													</a>
												)
											}

											<a
												href={item.url}
												target="_blank"
												rel="noopener noreferrer"
												class="animated-link"
											>
												<span>
													{item.linkLabel}
												</span>

												<span
													class="animated-link-arrow"
													aria-hidden="true"
												>
													→
												</span>
											</a>
										</div>
									) : (
										item.status === 'upcoming' && (
											<p class="media-coming-soon">
												Coming soon
											</p>
										)
									)
								}
							</div>
						</article>
					))
				}
			</section>

			<section class="media-contact reveal-section">
				<h2 class="reveal-item">
					Media Inquiries
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						For interviews, podcasts, speaking engagements, or other
						media opportunities, please get in touch
					</p>

					<p class="media-contact-link">
						<a href="/contact/" class="animated-link">
							<span>Contact me</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>

