---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const mediaItems = [
	{
		type: 'Written Interview',
		status: 'published',
		title: 'Interview with Nublit',
		date: '2026',
		image: '/images/cloud-interview.jpg',
		imageAlt: 'Interview with Fede Rodrigo published by Nublit',
		description:
			'Interview with Nublit discussing cloud strategy, governance, business outcomes, and how organizations can avoid turning the cloud into just another expensive data center.',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'Read Interview',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>

		<title>Media | Fede Rodrigo</title>

		<meta
			name="description"
			content="Interviews, podcasts, and public appearances featuring Fede Rodrigo."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="media-hero">
				<p class="section-intro">Media</p>

				<h1>
					Media &
					<span class="accent">Appearances.</span>
				</h1>

				<p class="lead">
					A collection of interviews, podcast appearances, and public
					conversations.
				</p>
			</section>

			<section class="media-list" aria-labelledby="media-list-title">
				<h2 id="media-list-title">Featured</h2>

				{
					mediaItems.map((item) => (
						<article class="media-item">
							<div class="media-image-wrapper">
								<img
									src={item.image}
									alt={item.imageAlt}
									class="media-image"
									loading="lazy"
								/>
							</div>

							<div class="media-content">
								<p class="media-meta">
									<span>{item.type}</span>
									<span aria-hidden="true">·</span>
									<span>{item.date}</span>
								</p>

								<h3>{item.title}</h3>

								<p class="media-description">
									{item.description}
								</p>

								<p class="media-action">
									<a
										href={item.url}
										target="_blank"
										rel="noopener noreferrer"
									>
										{item.linkLabel} →
									</a>
								</p>
							</div>
						</article>
					))
				}
			</section>

			<section class="media-contact">
				<h2>Media Inquiries</h2>

				<p>
					For interviews, podcasts, speaking engagements, or other
					media opportunities, please get in touch.
				</p>

				<p class="media-contact-link">
					<a href="/#contact">Contact Me →</a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
