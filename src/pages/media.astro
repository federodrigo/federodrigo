---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const mediaItems = [
	{
		type: 'Written Interview',
		status: 'published',
		title: 'Cloud Computing Interview',
		date: '2026',
		image: '/images/media/cloud-interview.jpg',
		imageAlt: 'Cloud Computing Interview with Fede Rodrigo',
		description:
			'A written interview about cloud computing, technology strategy, and the role of cloud services in modern organizations.',
		primaryUrl: 'https://REPLACE-WITH-INTERVIEW-LINK.com',
		primaryLabel: 'View Interview',
		pdfUrl: '/documents/cloud-interview.pdf',
		pdfLabel: 'Read PDF',
	},
	{
		type: 'Podcast',
		status: 'upcoming',
		title: 'Podcast 1',
		date: 'Coming Soon',
		image: '/images/media/podcast-1.jpg',
		imageAlt: 'Podcast 1',
		description:
			'An upcoming podcast conversation. Episode details and publication links will be added after release.',
	},
	{
		type: 'Podcast',
		status: 'upcoming',
		title: 'Podcast 2',
		date: 'Coming Soon',
		image: '/images/media/podcast-2.jpg',
		imageAlt: 'Podcast 2',
		description:
			'An upcoming podcast conversation. Episode details and publication links will be added after release.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Media | Fede Rodrigo"
			description="Interviews, podcasts, and public conversations featuring Fede Rodrigo."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="media-hero">
				<p class="eyebrow">MEDIA</p>

				<h1>
					Interviews, podcasts,<br />
					and <span class="accent">conversations</span>
				</h1>

				<p class="hero-description">
					A collection of published interviews, podcast appearances,
					and public conversations
				</p>
			</section>

			<section class="media-section" aria-labelledby="media-heading">
				<h2 id="media-heading" class="visually-hidden">
					Media appearances
				</h2>

				<div class="media-grid">
					{
						mediaItems.map((item) => (
							<article class="media-card">
								<div class="media-image-wrapper">
									<img
										src={item.image}
										alt={item.imageAlt}
										class="media-image"
										loading="lazy"
									/>

									<span
										class:list={[
											'status-badge',
											{ upcoming: item.status === 'upcoming' },
										]}
									>
										{item.status === 'published'
											? item.type
											: 'Coming Soon'}
									</span>
								</div>

								<div class="media-content">
									<div class="media-meta">
										<span>{item.type}</span>
										<span>{item.date}</span>
									</div>

									<h2>{item.title}</h2>

									<p class="media-description">
										{item.description}
									</p>

									{
										item.status === 'published' ? (
											<div class="media-actions">
												{item.primaryUrl && (
													<a
														href={item.primaryUrl}
														target="_blank"
														rel="noopener noreferrer"
														class="media-link primary"
													>
														{item.primaryLabel} →
													</a>
												)}

												{item.pdfUrl && (
													<a
														href={item.pdfUrl}
														target="_blank"
														rel="noopener noreferrer"
														class="media-link secondary"
													>
														{item.pdfLabel} →
													</a>
												)}
											</div>
										) : (
											<p class="upcoming-message">
												Details will be added after publication
											</p>
										)
									}
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section class="media-contact">
				<p class="eyebrow">CONTACT</p>

				<h2>Interested in a conversation?</h2>

				<p>
					For podcasts, interviews, speaking engagements, or media
					inquiries, please reach out directly
				</p>

				<a href="mailto:contact@federodrigo.com">
					contact@federodrigo.com →
				</a>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: min(1180px, calc(100% - 48px));
		margin: 0 auto;
	}

	.media-hero {
		padding: 150px 0 105px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}

	.eyebrow {
		margin: 0 0 24px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.17em;
		text-transform: uppercase;
		opacity: 0.58;
	}

	.media-hero h1 {
		max-width: 980px;
		margin: 0;
		font-size: clamp(3rem, 7vw, 6.4rem);
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	.accent {
		color: var(--accent-color, #c9ff36);
	}

	.hero-description {
		max-width: 670px;
		margin: 38px 0 0;
		font-size: clamp(1.05rem, 2vw, 1.3rem);
		line-height: 1.65;
		opacity: 0.7;
	}

	.media-section {
		padding: 90px 0 120px;
	}

	.media-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 28px;
	}

	.media-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.025);
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			background 180ms ease;
	}

	.media-card:hover {
		transform: translateY(-3px);
		border-color: rgba(255, 255, 255, 0.23);
		background: rgba(255, 255, 255, 0.04);
	}

	.media-image-wrapper {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: rgba(255, 255, 255, 0.04);
	}

	.media-image {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		transition: transform 300ms ease;
	}

	.media-card:hover .media-image {
		transform: scale(1.02);
	}

	.status-badge {
		position: absolute;
		top: 18px;
		left: 18px;
		padding: 8px 11px;
		border-radius: 100px;
		background: rgba(0, 0, 0, 0.78);
		color: #ffffff;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		backdrop-filter: blur(8px);
	}

	.status-badge.upcoming {
		background: var(--accent-color, #c9ff36);
		color: #111111;
	}

	.media-content {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 32px;
	}

	.media-meta {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 20px;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		opacity: 0.5;
	}

	.media-content h2 {
		margin: 0;
		font-size: clamp(1.7rem, 3vw, 2.5rem);
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.media-description {
		margin: 20px 0 0;
		font-size: 1rem;
		line-height: 1.7;
		opacity: 0.7;
	}

	.media-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		margin-top: auto;
		padding-top: 32px;
	}

	.media-link {
		display: inline-block;
		padding-bottom: 4px;
		font-weight: 700;
		text-decoration: none;
		color: inherit;
		border-bottom: 1px solid currentColor;
	}

	.media-link:hover {
		color: var(--accent-color, #c9ff36);
	}

	.media-link.secondary {
		opacity: 0.68;
	}

	.media-link.secondary:hover {
		opacity: 1;
	}

	.upcoming-message {
		margin: auto 0 0;
		padding-top: 32px;
		font-size: 0.85rem;
		font-weight: 600;
		opacity: 0.42;
	}

	.media-contact {
		padding: 100px 0 140px;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.media-contact h2 {
		max-width: 800px;
		margin: 0;
		font-size: clamp(2.5rem, 5vw, 4.8rem);
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.media-contact > p:not(.eyebrow) {
		max-width: 650px;
		margin: 28px 0 0;
		font-size: 1.08rem;
		line-height: 1.7;
		opacity: 0.7;
	}

	.media-contact a {
		display: inline-block;
		margin-top: 30px;
		padding-bottom: 4px;
		font-weight: 700;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}

	.media-contact a:hover {
		color: var(--accent-color, #c9ff36);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 900px) {
		.media-card:first-child {
			grid-column: span 2;
			display: grid;
			grid-template-columns: minmax(0, 1.2fr) minmax(340px, 0.8fr);
		}

		.media-card:first-child .media-image-wrapper {
			aspect-ratio: auto;
			min-height: 470px;
		}

		.media-card:first-child .media-content {
			padding: 48px;
		}
	}

	@media (max-width: 800px) {
		.media-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		main {
			width: min(100% - 32px, 1180px);
		}

		.media-hero {
			padding: 110px 0 75px;
		}

		.media-section {
			padding: 56px 0 80px;
		}

		.media-content {
			padding: 25px 22px 28px;
		}

		.media-meta {
			flex-direction: column;
			gap: 7px;
		}

		.media-actions {
			flex-direction: column;
			align-items: flex-start;
			gap: 17px;
		}

		.media-contact {
			padding: 75px 0 100px;
		}
	}
</style>
