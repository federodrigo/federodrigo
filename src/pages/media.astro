---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const mediaItems = [
	{
		type: 'Written Interview',
		status: 'published',
		title: 'Cloud Computing Interview',
		date: '2026',
		image: '/images/media/cloud-interview.jpg',
		imageAlt: 'Cloud Computing Interview with Fede Rodrigo',
		description:
			'An interview about cloud computing, technology strategy, and the role of the CIO in modern organizations',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'Read interview',
	},
	{
		type: 'Podcast',
		status: 'upcoming',
		title: 'Upcoming Podcast',
		date: 'Recording soon',
		image: '/images/media/podcast-1.jpg',
		imageAlt: 'Upcoming podcast featuring Fede Rodrigo',
		description:
			'A new podcast conversation will be recorded shortly. Episode details and publication links will be added once available',
	},
	{
		type: 'Podcast',
		status: 'upcoming',
		title: 'Upcoming Podcast',
		date: 'Coming soon',
		image: '/images/media/podcast-2.jpg',
		imageAlt: 'Upcoming podcast featuring Fede Rodrigo',
		description:
			'Another podcast appearance is currently being prepared. More information will be published after its release',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>

		<title>Media | Fede Rodrigo</title>

		<meta
			name="description"
			content="Interviews, podcasts, and public conversations featuring Fede Rodrigo"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="media-hero">
				<p class="section-intro">Media</p>

				<h1>
					Interviews, podcasts and
					<span class="accent">conversations.</span>
				</h1>

				<p class="lead">
					A collection of interviews, podcast appearances, and public
					conversations about technology, leadership, business, and
					other topics
				</p>
			</section>

			<section class="media-list" aria-labelledby="media-list-title">
				<h2 id="media-list-title">Appearances</h2>

				{
					mediaItems.map((item) => (
						<article class="media-item">
							<div class="media-image-wrapper">
								<img
									src={item.image}
									alt={item.imageAlt}
									class="media-image"
									loading="lazy"
								/>
							</div>

							<div class="media-content">
								<p class="media-meta">
									<span>{item.type}</span>
									<span aria-hidden="true">·</span>
									<span>{item.date}</span>
								</p>

								<h3>{item.title}</h3>

								<p class="media-description">
									{item.description}
								</p>

								{
									item.status === 'published' && item.url ? (
										<p class="media-action">
											<a
												href={item.url}
												target="_blank"
												rel="noopener noreferrer"
											>
												{item.linkLabel} →
											</a>
										</p>
									) : (
										<p class="media-coming-soon">
											Coming soon
										</p>
									)
								}
							</div>
						</article>
					))
				}
			</section>

			<section class="media-contact">
				<h2>Media inquiries</h2>

				<p>
					For podcasts, interviews, speaking engagements, or other
					media inquiries, please get in touch
				</p>

				<p class="media-contact-link">
					<a href="/#contact">Contact me →</a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
