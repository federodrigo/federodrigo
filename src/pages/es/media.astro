---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const mediaItems = [
	{
		type: 'Webinar',
		status: 'upcoming',
		title: 'La tecnología nunca es el punto de partida — Xseed',
		date: 'Agosto de 2026',
		image: '/images/xseed.jpg',
		imageAlt: 'Fede Rodrigo presentando un webinar de Xseed',
		description:
			'La mayoría de las organizaciones comienza su transformación por la tecnología. Creo que ese es precisamente el problema. Esta sesión presenta un enfoque práctico para crear valor para el negocio a partir de las personas, alinearse con la empresa y permitir que la tecnología habilite el resultado, en lugar de definirlo',
	},
	{
		type: 'Podcast',
		status: 'upcoming',
		title: 'The Technology Vanguard',
		date: 'Agosto de 2026',
		image: '/images/vanguard.jpg',
		imageAlt: 'Fede Rodrigo participando en el podcast The Technology Vanguard',
		description:
			'Una próxima conversación sobre liderazgo tecnológico, desarrollo profesional, inteligencia artificial, estrategia de negocios y el recorrido personal detrás de los líderes de tecnología actuales',
	},
	{
		type: 'Entrevista escrita',
		status: 'published',
		title: 'Cómo convertir la inversión en la nube en valor para el negocio — Nublit',
		date: 'Enero de 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt: 'Entrevista con Fede Rodrigo publicada por Nublit',
		description:
			'Una conversación con Nublit sobre estrategia cloud en Latinoamérica, adopción híbrida, barreras culturales y regulatorias, y el papel de la tecnología como impulsora del crecimiento, la innovación y la resiliencia operativa',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'Ver informe completo',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Leer mi entrevista',
	},
	{
		type: 'Finalista de premio',
		status: 'published',
		title: 'Premios ORBIE 2024',
		date: 'Septiembre de 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'Logo de los Premios ORBIE',
		description:
			'Reconocido como finalista en la categoría Global CIO de los Central Texas CIO Awards 2024',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'Ver reconocimiento',
	},
	{
		type: 'Mesa redonda ejecutiva',
		status: 'published',
		title: 'Reinvención industrial — The Economist',
		date: 'Septiembre de 2024',
		image: '/images/impact.png',
		imageAlt: 'The Economist Impact',
		description:
			'Participante invitado en Industrial Reinvention: New Business Models and Jobs for Tomorrow’s Technology, organizado por The Economist Impact junto con otros CIOs en Houston, Texas',
	},
];
---

<!doctype html>

<html lang="es">
	<head>
		<SEO
			title="Medios & Entrevistas | Fede Rodrigo"
			description="Entrevistas, podcasts, reconocimientos profesionales, mesas redondas ejecutivas y participaciones públicas de Fede Rodrigo."
			lang="es"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1>
					Medios &
					<span class="accent">Entrevistas</span>
				</h1>

				<div class="lead-principles">
					<div>La Tecnología es Solo una Parte del Trabajo</div>
					<div>El Liderazgo es el Trabajo</div>
				</div>
			</section>

			<section
				class="media-list"
				aria-labelledby="media-list-title"
			>
				<h2 id="media-list-title">
					Destacados
				</h2>

				{
					mediaItems.map((item) => (
						<article class="media-item">
							<div class="media-image-wrapper">
								<img
									src={item.image}
									alt={item.imageAlt}
									class="media-image"
									loading="lazy"
								/>
							</div>

							<div class="media-content">
								<p class="media-meta">
									<span>{item.type}</span>
									<span aria-hidden="true">·</span>
									<span>{item.date}</span>
								</p>

								<h3>{item.title}</h3>

								<p class="media-description">
									{item.description}
								</p>

								{
									item.url ? (
										<div class="media-action">
											{
												item.pdfUrl && (
													<a
														href={item.pdfUrl}
														target="_blank"
														rel="noopener noreferrer"
													>
														{item.pdfLabel} →
													</a>
												)
											}

											<a
												href={item.url}
												target="_blank"
												rel="noopener noreferrer"
											>
												{item.linkLabel} →
											</a>
										</div>
									) : (
										item.status === 'upcoming' && (
											<p class="media-coming-soon">
												Próximamente
											</p>
										)
									)
								}
							</div>
						</article>
					))
				}
			</section>

			<section class="media-contact">
				<h2>Consultas de Prensa</h2>

				<p>
					Para entrevistas, podcasts, conferencias u otras
					oportunidades en medios, podés contactarme
				</p>

				<p class="media-contact-link">
					<a href="/es/contact">
						Contactarme →
					</a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
