---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

type MediaItem = {
	type: string;
	status: 'upcoming' | 'published';
	title: string;
	date: string;
	image: string;
	imageAlt: string;
	description: string;
	url?: string;
	linkLabel?: string;
	pdfUrl?: string;
	pdfLabel?: string;
	internal?: boolean;
};

const mediaItems: MediaItem[] = [
	{
		type: 'Webinar',
		status: 'upcoming',
		title: 'La tecnología nunca es el punto de partida — Xseed',
		date: '20 de agosto de 2026',
		image: '/images/xseed-webinar.png',
		imageAlt:
			'Webinar Technology is Never the Starting Point con Federico Rodrigo',
		description:
			'Una sesión práctica sobre cómo comenzar por las personas y las prioridades del negocio, y usar la tecnología para habilitar el resultado',
		url: '/es/webinar/',
		linkLabel: 'Más información y reservar mi lugar',
		internal: true,
	},

	{
		type: 'Podcast',
		status: 'upcoming',
		title: 'The Technology Vanguard',
		date: 'Agosto de 2026',
		image: '/images/vanguard.jpg',
		imageAlt:
			'Fede Rodrigo participando en el podcast The Technology Vanguard',
		description:
			'Una próxima conversación sobre liderazgo tecnológico, desarrollo profesional, IA, estrategia de negocio y el recorrido personal detrás de los líderes de IT de hoy',
	},

	{
		type: 'Entrevista Escrita',
		status: 'published',
		title: 'Convertir la inversión en la nube en valor para el negocio — Nublit',
		date: 'Enero de 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt: 'Entrevista con Fede Rodrigo publicada por Nublit',
		description:
			'Una conversación con Nublit sobre estrategia cloud en América Latina, adopción híbrida, barreras culturales y regulatorias, y el papel de la tecnología como motor de crecimiento, innovación y resiliencia operativa',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'Ver informe completo',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Leer mi entrevista',
	},

	{
		type: 'Finalista de Premio',
		status: 'published',
		title: 'Premios ORBIE CIO',
		date: 'Septiembre de 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'Premios ORBIE CIO Central Texas',
		description:
			'Reconocido como finalista en la categoría Global CIO de los premios Central Texas',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'Ver reconocimiento',
	},

	{
		type: 'Mesa Redonda Ejecutiva',
		status: 'published',
		title: 'Reinvención Industrial — The Economist',
		date: 'Septiembre de 2024',
		image: '/images/impact.png',
		imageAlt: 'The Economist Impact',
		description:
			'Participante invitado en Industrial Reinvention: New Business Models and Jobs for Tomorrow’s Technology, organizado por The Economist Impact junto a otros CIOs en Houston, Texas',
	},
];
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Medios & Eventos | Fede Rodrigo"
			description="Entrevistas, podcasts, reconocimientos profesionales, mesas redondas ejecutivas y eventos"
			lang="es"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Medios & <span class="accent">Eventos</span>
					</span>
				</h1>

				<div class="lead-principles">
					<div>La Tecnología es Solo una Parte del Trabajo</div>
					<div>El Liderazgo es el Trabajo</div>
				</div>
			</section>

			<section
				class="media-list reveal-section"
				aria-labelledby="media-list-title"
			>
				<h2
					id="media-list-title"
					class="reveal-item"
				>
					Destacados
				</h2>

				{
					mediaItems.map((item, index) => (
						<article
							class="media-item"
							style={`--media-index: ${index};`}
						>
							<div class="media-image-wrapper">
								{
									item.url ? (
										<a
											href={item.url}
											target={item.internal ? undefined : '_blank'}
											rel={item.internal ? undefined : 'noopener noreferrer'}
											aria-label={item.linkLabel ?? item.title}
										>
											<img
												src={item.image}
												alt={item.imageAlt}
												class="media-image"
												loading="lazy"
											/>
										</a>
									) : (
										<img
											src={item.image}
											alt={item.imageAlt}
											class="media-image"
											loading="lazy"
										/>
									)
								}
							</div>

							<div class="media-content">
								<p class="media-meta">
									<span>{item.type}</span>
									<span aria-hidden="true">·</span>
									<span>{item.date}</span>
								</p>

								<h3>{item.title}</h3>

								<p class="media-description">
									{item.description}
								</p>

								{
									item.url ? (
										<div class="media-action">
											{
												item.pdfUrl && item.pdfLabel && (
													<a
														href={item.pdfUrl}
														target="_blank"
														rel="noopener noreferrer"
														class="animated-link"
													>
														<span>{item.pdfLabel}</span>

														<span
															class="animated-link-arrow"
															aria-hidden="true"
														>
															→
														</span>
													</a>
												)
											}

											<a
												href={item.url}
												target={item.internal ? undefined : '_blank'}
												rel={item.internal ? undefined : 'noopener noreferrer'}
												class="animated-link"
											>
												<span>{item.linkLabel ?? 'Learn more'}</span>

												<span
													class="animated-link-arrow"
													aria-hidden="true"
												>
													→
												</span>
											</a>
										</div>
									) : (
										item.status === 'upcoming' && (
											<p class="media-coming-soon">
												Próximamente
											</p>
										)
									)
								}
							</div>
						</article>
					))
				}
			</section>

			<section class="media-contact reveal-section">
				<h2 class="reveal-item">
					Consultas de Prensa
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						Para entrevistas, podcasts, conferencias u otras
						oportunidades en medios, podés contactarme
					</p>

					<p class="media-contact-link">
						<a href="/es/contact/" class="animated-link">
							<span>Contactarme</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>

