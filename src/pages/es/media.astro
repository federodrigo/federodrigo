---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const mediaItems = [
	{
		type: 'Podcast',
		status: 'upcoming',
		title: 'The Technology Vanguard',
		date: 'Agosto de 2026',
		image: '/images/vanguard.jpg',
		imageAlt: 'Fede Rodrigo en el podcast The Technology Vanguard',
		description:
			'Próxima conversación sobre liderazgo tecnológico, desarrollo profesional, inteligencia artificial, estrategia empresarial y el recorrido personal detrás de los líderes de tecnología actuales',
	},
	{
		type: 'Entrevista',
		status: 'published',
		title: 'Entrevista con Nublit',
		date: 'Enero de 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt: 'Entrevista con Fede Rodrigo publicada por Nublit',
		description:
			'Entrevista con Nublit sobre estrategia de nube, gobierno, resultados de negocio y cómo evitar que la nube se convierta simplemente en otro centro de datos costoso',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'Leer entrevista',
	},
	{
		type: 'Reconocimiento',
		status: 'published',
		title: 'Central Texas ORBIE Awards 2024',
		date: 'Septiembre de 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'Logo de los ORBIE Awards',
		description:
			'Seleccionado como Global Finalist en los Central Texas ORBIE Awards 2024, un reconocimiento al liderazgo y al impacto empresarial de ejecutivos de tecnología',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'Ver reconocimiento',
	},
	{
		type: 'Mesa redonda ejecutiva',
		status: 'published',
		title: 'The Economist Impact',
		date: 'Septiembre de 2024',
		image: '/images/impact.png',
		imageAlt: 'The Economist Impact',
		description:
			"Participación por invitación en Industrial Reinvention: New Business Models and Jobs for Tomorrow's Technology, organizado por The Economist Impact, junto a CIOs de otras organizaciones en Houston, Texas",
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>

		<title>Medios y Participaciones | Fede Rodrigo</title>

		<meta
			name="description"
			content="Entrevistas, podcasts, reconocimientos profesionales, mesas redondas ejecutivas y otras participaciones públicas de Fede Rodrigo"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="media-hero">
				<h1>
					Medios y
					<span class="accent">Participaciones</span>
				</h1>

				<p class="lead">
					Una recopilación cronológica de entrevistas, participaciones en podcasts, reconocimientos profesionales, mesas redondas ejecutivas y otras actividades públicas
				</p>
			</section>

			<section
				class="media-list"
				aria-labelledby="media-list-title"
			>
				<h2 id="media-list-title">Destacados</h2>

				{
					mediaItems.map((item) => (
						<article class="media-item">
							<div class="media-image-wrapper">
								<img
									src={item.image}
									alt={item.imageAlt}
									class="media-image"
									loading="lazy"
								/>
							</div>

							<div class="media-content">
								<p class="media-meta">
									<span>{item.type}</span>
									<span aria-hidden="true">·</span>
									<span>{item.date}</span>
								</p>

								<h3>{item.title}</h3>

								<p class="media-description">
									{item.description}
								</p>

								{
									item.url ? (
										<p class="media-action">
											<a
												href={item.url}
												target="_blank"
												rel="noopener noreferrer"
											>
												{item.linkLabel} →
											</a>
										</p>
									) : (
										item.status === 'upcoming' && (
											<p class="media-coming-soon">
												Próximamente
											</p>
										)
									)
								}
							</div>
						</article>
					))
				}
			</section>

			<section class="media-contact">
				<h2>Contacto para medios</h2>

				<p>
					Para entrevistas, podcasts, conferencias u otras oportunidades en medios, no dudes en ponerte en contacto
				</p>

				<p class="media-contact-link">
					<a href="/es/#contact">Contáctame →</a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
