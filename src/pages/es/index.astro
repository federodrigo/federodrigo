---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Fede Rodrigo | CIO, autor, speaker y líder tecnológico"
			description="Fede Rodrigo es Chief Information Officer, autor y líder tecnológico, enfocado en la creación de valor para el negocio, el liderazgo, la estrategia tecnológica, la excelencia operacional y la transformación"
			lang="es"
		/>

		<style>
			/* =========================================================
			   HOME
			========================================================= */

			.home-main {
				padding-bottom: var(--divider-space-before);
			}

			.home-hero {
				padding-bottom: 0;
				border-bottom: 0;
			}

			.home-feature {
				padding-bottom: 0;
			}

			#about.home-feature {
				padding-top: var(--divider-space-after);
			}


			/* =========================================================
			   FEATURE LAYOUT
			========================================================= */

			#speaking.home-feature .books-page-book-featured,
			#cio-office.home-feature .books-page-book-featured,
			#books.home-feature .books-page-book-featured {
				padding-top: 0;
				padding-bottom: 0;
			}

			.home-feature .books-page-content {
				align-self: center;
			}


			/* =========================================================
			   FEATURE TITLES
			========================================================= */

			.home-feature .books-page-content h2 {
				margin: 0 0 0.85rem;
				padding: 0;

				font-size: clamp(1.55rem, 1.8vw, 1.85rem);
				font-weight: 500;
				line-height: 1.18;
				letter-spacing: -0.015em;
			}

			.home-feature .books-page-content h2::after {
				content: none;
				display: none;
			}


			/* =========================================================
			   FEATURE TEXT
			========================================================= */

			.home-feature
				.books-page-content
				> p:not(.books-page-subtitle):not(.books-page-action) {
				max-width: 680px;
				margin-top: 0;
				margin-bottom: 0;

				font-size: 1rem;
				line-height: 1.6;
			}

			.home-feature .books-page-action {
				margin-top: 20px;
				margin-bottom: 0;
			}


			/* =========================================================
			   SPEAKING
			========================================================= */

			#speaking .books-page-book {
				align-items: center;
			}

			#speaking .books-page-cover-wrapper {
				display: flex;
				align-items: center;
				justify-content: center;

				padding: 0;
				margin: 0;

				border: 0;
			}

			.speaking-cover-link {
				display: block;

				width: 100%;
				max-width: 390px;

				border: 0;
				text-decoration: none;
			}

			.speaking-cover-frame {
				overflow: hidden;

				border: 1px solid rgba(36, 55, 92, 0.07);
				border-radius: 20px;

				background: #ffffff;

				box-shadow: 0 12px 30px rgba(28, 44, 76, 0.06);
			}

			.speaking-cover-image {
				display: block;

				width: 100%;
				height: auto;

				border-radius: 0;
			}


			/* =========================================================
			   CIO OFFICE
			========================================================= */

			#cio-office .cio-office-capabilities-logo {
				transform: none;
			}

			#cio-office .cio-office-capabilities-logo:hover {
				transform: translateY(-4px) scale(1.015);
				filter: drop-shadow(
					0 16px 18px rgba(16, 42, 67, 0.12)
				);
			}


			/* =========================================================
			   BOOK
			========================================================= */

			#books .books-page-cover {
				display: block;

				width: 85%;
				max-width: 85%;

				height: auto;

				margin-left: auto;
				margin-right: auto;
			}


			/* =========================================================
			   ABOUT
			========================================================= */

			#about .about-photo-wrapper {
				align-self: start;

				padding-top: 0;
				margin-top: 0;

				transform: none;

				border: 0;
				box-shadow: none;

				text-align: right;
			}

			#about .about-photo-wrapper a {
				display: block;

				border: 0;
				box-shadow: none;
				text-decoration: none;
			}

			#about .about-photo {
				display: block;

				width: 81%;
				max-width: 81%;

				margin-left: auto;

				border: 0;
				box-shadow: none;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 900px) {
				.home-feature .books-page-content h2 {
					font-size: 1.65rem;
				}

				#about .about-photo-wrapper {
					text-align: center;
				}

				#about .about-photo {
					margin-left: auto;
					margin-right: auto;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.home-main {
					padding-bottom: var(--divider-space-mobile);
				}

				.home-hero {
					padding-bottom: 0;
					border-bottom: 0;
				}

				#about.home-feature {
					padding-top: var(--divider-space-mobile);
				}

				#speaking .books-page-book,
				#cio-office .books-page-book,
				#books .books-page-book {
					grid-template-columns: 1fr;
					gap: 20px;
				}

				.home-feature .books-page-content h2 {
					font-size: 1.5rem;
				}

				.home-feature
					.books-page-content
					> p:not(.books-page-subtitle):not(.books-page-action) {
					font-size: 1rem;
					line-height: 1.58;
				}

				.home-feature .books-page-action {
					margin-top: 18px;
				}

				#speaking .books-page-cover-wrapper {
					width: 100%;
					justify-content: flex-start;
				}

				.speaking-cover-link {
					max-width: 320px;
				}

				#cio-office .books-page-cover-wrapper,
				#cio-office .books-page-cover-link {
					width: 170px;
				}

				#cio-office .cio-office-capabilities-logo {
					width: 170px;
					transform: none;
				}

				#cio-office .cio-office-capabilities-logo:hover {
					transform: translateY(-4px) scale(1.015);
				}

				#books .books-page-cover-wrapper,
				#books .books-page-cover-link {
					width: 170px;
				}

				#books .books-page-cover {
					width: 100%;
					max-width: 100%;
					margin: 0;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main class="home-main">

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero home-hero">
				<h1 class="hero-title">

					<span class="hero-line">
						La tecnología <span class="accent">nunca</span> es
					</span>

					<span class="hero-line">
						el punto de partida
					</span>

				</h1>

				<div class="lead-principles">
					<div>Personas Primero</div>
					<div>Orientado al Negocio</div>
					<div>Tecnología como Habilitador</div>
				</div>
			</section>


			<!-- =====================================================
			     SPEAKING
			===================================================== -->

			<section
				id="speaking"
				class="page-divider home-feature reveal-section"
			>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-speaking-title"
				>

					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/es/speaking/"
							class="speaking-cover-link"
							aria-label="Explorar speaking"
						>
							<div class="speaking-cover-frame">
								<img
									src="/images/speaking-cover.png"
									alt="Imagen sobre decisiones tecnológicas que comienzan sin tecnología"
									class="speaking-cover-image animated-image"
								/>
							</div>
						</a>
					</div>


					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-speaking-title">
							Speaking
						</h2>

						<p>
							Charlas y conversaciones sobre liderazgo tecnológico,
							valor para el negocio, transformación, cambio
							organizacional y las decisiones que determinan cómo
							la tecnología genera impacto
						</p>

						<p class="books-page-action">
							<a
								href="/es/speaking/"
								class="animated-link"
							>
								<span>
									Explorar speaking
								</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

				</article>
			</section>


			<!-- =====================================================
			     CIO OFFICE
			===================================================== -->

			<section
				id="cio-office"
				class="page-divider home-feature reveal-section"
			>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-office-title"
				>

					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/es/cio-office/"
							class="books-page-cover-link"
							aria-label="Explorar la CIO Office"
						>
							<img
								src="/images/cio-office-logo.png"
								alt="CIO Office"
								class="cio-office-capabilities-logo animated-image"
							/>
						</a>
					</div>


					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-cio-office-title">
							Tecnología que crea valor para el negocio
						</h2>

						<p>
							Asesoramiento para organizaciones que buscan alinear la
							tecnología con los objetivos del negocio, fortalecer sus
							operaciones y acelerar la transformación
						</p>

						<p class="books-page-action">
							<a
								href="/es/cio-office/"
								class="animated-link"
							>
								<span>
									Conoce la CIO Office
								</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

				</article>
			</section>


			<!-- =====================================================
			     BOOK
			===================================================== -->

			<section
				id="books"
				class="page-divider home-feature reveal-section"
			>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-book-title"
				>

					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/es/cio-book/"
							class="books-page-cover-link"
							aria-label="Conoce más sobre How to Become CIO and Succeed"
						>
							<img
								src="/images/cio-book-cover.png"
								alt="Portada de How to Become CIO and Succeed"
								class="books-page-cover animated-book-cover"
							/>
						</a>
					</div>


					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-cio-book-title">
							How to Become CIO and Succeed
						</h2>

						<p class="books-page-subtitle">
							Personas, Negocio, Estrategia
						</p>

						<p>
							El rol del CIO no consiste en gestionar sistemas. Consiste
							en liderar personas, definir la estrategia, influir en el
							negocio y convertir la tecnología en una ventaja
							competitiva. Este es el libro que me habría gustado tener
							cuando comencé mi camino en el liderazgo
						</p>

						<p class="books-page-action">
							<a
								href="/es/cio-book/"
								class="animated-link"
							>
								<span>
									Explorar el libro
								</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

				</article>
			</section>


			<!-- =====================================================
			     ABOUT
			===================================================== -->

			<section
				id="about"
				class="page-divider home-feature reveal-section"
			>
				<div class="about-layout">

					<div
						class="about-content reveal-item reveal-delay-1"
					>
						<p>
							Soy Chief Information Officer (CIO) con más de 15 años
							de experiencia internacional en liderazgo de TI,
							ayudando a organizaciones globales a generar valor para
							el negocio
						</p>

						<p>
							Mi enfoque combina pensamiento estratégico, ejecución
							práctica, relaciones sólidas y una cultura orientada al
							servicio, enfocada en la excelencia operacional y la
							mejora continua
						</p>

						<p class="books-page-action">
							<a
								href="/es/about/"
								class="animated-link"
							>
								<span>
									Mi trayectoria
								</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>


					<div
						class="about-photo-wrapper reveal-item reveal-from-right reveal-delay-2"
					>
						<a
							href="/es/about/"
							aria-label="Conoce más sobre Fede Rodrigo"
						>
							<img
								src="/images/fede.png"
								alt="Fede Rodrigo, Chief Information Officer, autor y speaker"
								class="about-photo animated-image"
							/>
						</a>
					</div>

				</div>
			</section>

		</main>


		<Footer />


		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver =
				new IntersectionObserver(
					(entries, observer) => {

						entries.forEach((entry) => {

							if (!entry.isIntersecting) {
								return;
							}

							entry.target.classList.add(
								'is-visible'
							);

							observer.unobserve(
								entry.target
							);

						});

					},
					{
						threshold: 0.12,
						rootMargin:
							'0px 0px -60px 0px'
					}
				);


			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>

	</body>
</html>
