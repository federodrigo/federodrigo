---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Fede Rodrigo | CIO"
			description="Fede Rodrigo es CIO, asesor, speaker y autor. Ayuda a las organizaciones a crear valor mediante la estrategia tecnológica, el liderazgo y la excelencia operacional."
			lang="es"
		/>

		<style>
			/* =========================================================
			   HOME
			========================================================= */

			.home-main {
				padding-bottom: var(--divider-space-before);
			}

			.home-hero {
				padding-bottom: 0;
				border-bottom: 0;
			}

			.home-feature {
				padding-bottom: 0;
			}

			#about.home-feature {
				padding-top: var(--divider-space-after);
			}

			/*
				CIO Office has a taller visual block than the other
				home features. Remove the additional margin before
				Book so the divider has the same optical spacing.
			*/
			#books.home-feature {
				margin-top: 0;
			}


			/* =========================================================
			   FEATURE LAYOUT
			========================================================= */

			#speaking.home-feature .books-page-book-featured,
			#cio-office.home-feature .books-page-book-featured,
			#books.home-feature .books-page-book-featured {
				padding-top: 0;
				padding-bottom: 0;
			}

			/*
				Keep the three main home features on exactly the same
				two-column grid so every text block starts at the same X.
			*/
			#speaking .books-page-book,
			#cio-office .books-page-book,
			#books .books-page-book {
				grid-template-columns: 260px minmax(0, 1fr);
				column-gap: 53px;
			}

			.home-feature .books-page-content {
				align-self: center;
			}


			/* =========================================================
			   FEATURE TITLES
			========================================================= */

			.home-feature .books-page-content h2 {
				margin: 0 0 0.85rem;
				padding: 0;

				font-size: clamp(1.55rem, 1.8vw, 1.85rem);
				font-weight: 500;
				line-height: 1.18;
				letter-spacing: -0.015em;
			}

			.home-feature .books-page-content h2::after {
				content: none;
				display: none;
			}

			#speaking .books-page-content h2 {
				max-width: 900px;
				text-wrap: balance;
			}

			#speaking .books-page-content
				> p:not(.books-page-subtitle):not(.books-page-action) {
				max-width: 820px;
			}


			/* =========================================================
			   FEATURE TEXT
			========================================================= */

			.home-feature
				.books-page-content
				> p:not(.books-page-subtitle):not(.books-page-action) {
				max-width: 680px;
				margin-top: 0;
				margin-bottom: 0;

				font-size: 1rem;
				line-height: 1.6;
			}

			.home-feature .books-page-action {
				margin-top: 20px;
				margin-bottom: 0;
			}

			/* Keep the purchase option close to the explore link on the landing. */
			#books .home-book-buy-action {
				margin-top: 10px;
			}


			/* =========================================================
			   SPEAKING
			========================================================= */

			#speaking .books-page-book {
				align-items: center;
			}

			#speaking .books-page-cover-wrapper {
				display: flex;
				align-items: center;
				justify-content: center;

				padding: 0;
				margin: 0;

				border: 0;
				background: transparent;
				mix-blend-mode: multiply;
			}

			.speaking-cover-link {
				display: block;

				width: 100%;
				max-width: 390px;

				border: 0;
				text-decoration: none;

				transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
			}

			.speaking-cover-link:hover {
				transform: translateY(-4px) scale(1.015);
				border-bottom: 0;
			}

			.speaking-cover-frame {
				/*
				 * No card behind the Speaking artwork.
				 * The PNG is transparent, so the site's own page background
				 * shows through exactly like the CIO Office and book assets.
				 */
				overflow: visible;

				border: 0;
				border-radius: 0;

				background: transparent;

				box-shadow: none;
			}

			.speaking-cover-image {
				display: block;

				width: 100%;
				height: auto;

				border: 0;
				border-radius: 0;
				background: transparent;
			}




			/* Consistent labels for speaking, advisory and books. */
			.home-section-label { margin: 0 0 20px; color: var(--muted); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.09em; line-height: 1.4; text-transform: uppercase; }
			.home-section-label::after { content: ""; display: block; width: 38px; height: 2px; margin-top: 8px; background: var(--red); border-radius: 3px; }

			/* Small event strip inside the Speaking section. */
			.home-speaking-events { margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--line); }
			.home-events-heading { margin: 0 0 16px; color: var(--muted); font-size: 0.73rem; font-weight: 700; letter-spacing: 0.09em; line-height: 1.4; text-transform: uppercase; }
			.home-events-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 32px; }
			.home-event { display: grid; grid-template-columns: 160px minmax(0, 1fr); column-gap: 14px; align-items: center; min-width: 0; }
			.home-event-image-link { display: flex; width: 160px; height: 108px; align-items: center; justify-content: center; border: 0; }
			.home-event-image-link:hover { border: 0; }
			.home-event-image { display: block; width: 100%; height: auto; max-width: 160px; max-height: 104px; object-fit: contain; border-radius: 5px; transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1); }
			.home-event-image-link:hover .home-event-image { transform: translateY(-2px); }
			.home-event-details { min-width: 0; }
			.home-event-title { margin: 0 0 3px; font-size: 0.98rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; }
			.home-event-date { margin: 0; color: var(--muted); font-size: 0.82rem; line-height: 1.4; }
			.home-event-action { margin: 6px 0 0; }
			.home-event-action a { color: var(--blue); font-size: 0.84rem; font-weight: 700; }
			.home-event-action a:hover { color: var(--red); }


						/* =========================================================
			   CIO OFFICE
			========================================================= */

			/* Compensate for whitespace inside the CIO Office logo artwork. */
			#cio-office .books-page-cover-wrapper {
				margin-left: -12px;
			}

			#cio-office .cio-office-capabilities-logo {
				transform: none;
			}

			#cio-office .cio-office-capabilities-logo:hover {
				transform: translateY(-4px) scale(1.015);

				filter:
					drop-shadow(
						0 16px 18px rgba(16, 42, 67, 0.12)
					);
			}


			/* =========================================================
			   BOOK
			========================================================= */

			#books .books-page-cover {
				display: block;

				width: 85%;
				max-width: 85%;
				height: auto;

				/* Align the book's visible edge with the section label. */
				margin-left: 0;
				margin-right: auto;
			}

			/* One book per row, keeping the existing editorial layout. */
			#books .home-book-entry + .home-book-entry {
				margin-top: var(--divider-space-before);
				padding-top: var(--divider-space-after);
				border-top: 1px solid var(--line);
			}

			#books .home-book-availability {
				margin: 14px 0 0;
				color: var(--blue);
				font-size: var(--cta-size);
				font-weight: var(--cta-weight);
				line-height: 1.3;
			}

			#books .home-book-availability + .books-page-action {
				margin-top: 12px;
			}


			/* =========================================================
			   ABOUT
			========================================================= */

			#about .about-photo-wrapper {
				align-self: start;

				padding-top: 0;
				margin-top: 0;

				transform: none;

				border: 0;
				box-shadow: none;

				text-align: right;
			}

			#about .about-photo-wrapper a {
				display: block;

				border: 0;
				box-shadow: none;
				text-decoration: none;
			}

			#about .about-photo {
				display: block;

				width: 81%;
				max-width: 81%;

				margin-left: auto;

				border: 0;
				box-shadow: none;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 900px) {
				.home-feature .books-page-content h2 {
					font-size: 1.65rem;
				}

				#about .about-photo-wrapper {
					text-align: center;
				}

				#about .about-photo {
					margin-left: auto;
					margin-right: auto;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.home-main {
					padding-bottom: var(--divider-space-mobile);
				}

				.home-hero {
					padding-bottom: 0;
					border-bottom: 0;
				}

				#about.home-feature {
					padding-top: var(--divider-space-mobile);
				}

				#about .about-photo {
					width: 205px;
					max-width: 100%;
				}

				/*
					On mobile the layout is stacked and the CIO logo
					no longer creates the same height imbalance.
				*/
				#books.home-feature {
					margin-top: var(--divider-space-mobile);
				}

				#speaking .books-page-book,
				#cio-office .books-page-book,
				#books .books-page-book {
					grid-template-columns: 1fr;
					gap: 20px;
				}

				.home-feature .books-page-content h2 {
					font-size: 1.5rem;
				}

				.home-feature
					.books-page-content
					> p:not(.books-page-subtitle):not(.books-page-action) {
					font-size: 1rem;
					line-height: 1.58;
				}

				.home-feature .books-page-action {
					margin-top: 18px;
				}

				#speaking .books-page-cover-wrapper {
					width: 100%;
					justify-content: flex-start;
				}

				.speaking-cover-link {
					max-width: 320px;
				}

				#cio-office .books-page-cover-wrapper,
				#cio-office .books-page-cover-link {
					width: 170px;
				}

				/* Scale the optical alignment adjustment with the smaller logo. */
				#cio-office .books-page-cover-wrapper {
					margin-left: -8px;
				}

				#cio-office .cio-office-capabilities-logo {
					width: 170px;
					transform: none;
				}

				#cio-office .cio-office-capabilities-logo:hover {
					transform: translateY(-4px) scale(1.015);
				}

				#books .books-page-cover-wrapper,
				#books .books-page-cover-link {
					width: 170px;
				}

				#books .books-page-cover {
					width: 100%;
					max-width: 100%;
					margin: 0;
				}

				#books .home-book-entry + .home-book-entry {
					margin-top: var(--divider-space-mobile);
					padding-top: var(--divider-space-mobile);
				}

				.home-section-label { margin-bottom: 18px; }
				.home-speaking-events { margin-top: 24px; padding-top: 20px; }
				.home-events-grid { grid-template-columns: 1fr; gap: 20px; }
				.home-event { grid-template-columns: 96px minmax(0, 1fr); column-gap: 12px; }
				.home-event-image-link { width: 96px; height: 70px; }
				.home-event-image { max-width: 96px; max-height: 67px; }
				.home-event-title { font-size: 0.95rem; }
				.home-event-action a { font-size: 0.84rem; }

			}

		</style>
	</head>

	<body>
		<Header />

		<main class="home-main">

			<section class="hero home-hero">
				<h1 class="hero-title">

					<span class="hero-line">
						La tecnología <span class="accent">nunca</span> es
					</span>

					<span class="hero-line">
						el punto de partida
					</span>

				</h1>

				<div class="lead-principles lead-principles--sequenced">
					<div><span class="principle-word" data-word="Personas"><span class="principle-word-label">Personas</span></span></div>
					<div><span class="principle-word" data-word="Negocio"><span class="principle-word-label">Negocio</span></span></div>
					<div><span class="principle-word" data-word="Tecnología"><span class="principle-word-label">Tecnología</span></span></div>
				</div>
			</section>






			<section
				id="speaking"
				class="page-divider home-feature reveal-section"
			>
				<p class="home-section-label reveal-item">Charlas</p>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-speaking-title"
				>

					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/es/speaking/"
							class="speaking-cover-link"
							aria-label="Explorar speaking"
						>
							<div class="speaking-cover-frame">
								<img
									src="/images/speaking-cover-es.png"
									alt="Imagen sobre decisiones tecnológicas que comienzan sin tecnología"
									class="speaking-cover-image"
								/>
							</div>
						</a>
					</div>


					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-speaking-title">
							¿Y si tu próxima decisión tecnológica empezara con… nada de tecnología?
						</h2>

						<p>
							Incluso cuando funciona, empezar por el lugar equivocado puede crear complejidad, dependencias y lock-in
						</p>


						<p class="books-page-action">
							<a
								href="/es/speaking/"
								class="animated-link"
							>
								<span>Explorar speaking</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

				</article>
				<div class="home-speaking-events reveal-item" aria-labelledby="home-events-title">
					<h3 id="home-events-title" class="home-events-heading">Próximas charlas</h3>
					<div class="home-events-grid">
						<article class="home-event" aria-labelledby="home-event-tedx-title">
							<a href="https://redtickets.uy/evento/TEDx-Ciudad-de-la-Costa/34038/" class="home-event-image-link" target="_blank" rel="noopener noreferrer" aria-label="Entradas e información de TEDx Ciudad de la Costa">
								<img src="/images/TEDx-Logo-v2.png" alt="TEDx" class="home-event-image" loading="lazy" decoding="async" />
							</a>
							<div class="home-event-details">
								<h4 id="home-event-tedx-title" class="home-event-title">TEDx Ciudad de la Costa</h4>
								<p class="home-event-date"><time datetime="2026-11-26">26 de noviembre de 2026</time></p>
								<p class="home-event-action">
									<a href="https://redtickets.uy/evento/TEDx-Ciudad-de-la-Costa/34038/" class="animated-link" target="_blank" rel="noopener noreferrer">
										<span>Entradas e información</span>
										<span class="animated-link-arrow" aria-hidden="true">→</span>
									</a>
								</p>
							</div>
						</article>
						<article class="home-event" aria-labelledby="home-event-llmday-title">
							<a href="https://llmday.com/2026-montevideo-q4/" class="home-event-image-link" target="_blank" rel="noopener noreferrer" aria-label="Entradas e información de LLMday Montevideo 2026">
								<img src="https://llmday.com/assets/images/events/llmday-2026-montevideo-q4.png" alt="LLMday Montevideo 2026" class="home-event-image" loading="lazy" decoding="async" />
							</a>
							<div class="home-event-details">
								<h4 id="home-event-llmday-title" class="home-event-title">LLMday Montevideo 2026</h4>
								<p class="home-event-date"><time datetime="2026-12-05">5 de diciembre de 2026</time></p>
								<p class="home-event-action">
									<a href="https://llmday.com/2026-montevideo-q4/" class="animated-link" target="_blank" rel="noopener noreferrer">
										<span>Entradas e información</span>
										<span class="animated-link-arrow" aria-hidden="true">→</span>
									</a>
								</p>
							</div>
						</article>
					</div>
				</div>
			</section>


			<section
				id="cio-office"
				class="page-divider home-feature reveal-section"
			>
				<p class="home-section-label reveal-item">Oficina del CIO / Asesoramiento</p>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-office-title"
				>

					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/es/cio-office/"
							class="books-page-cover-link"
							aria-label="Explorar la CIO Office"
						>
							<img
								src="/images/cio-office-logo.png"
								alt="CIO Office"
								class="cio-office-capabilities-logo animated-image"
							/>
						</a>
					</div>


					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-cio-office-title">
							Tecnología que crea valor para el negocio
						</h2>

						<p>
							Asesoramiento para organizaciones que buscan alinear la
							tecnología con los objetivos del negocio, fortalecer sus
							operaciones y acelerar la transformación
						</p>

						<p class="books-page-action">
							<a
								href="/es/cio-office/"
								class="animated-link"
							>
								<span>Conoce la CIO Office</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

				</article>
			</section>


			<section
				id="books"
				class="page-divider home-feature reveal-section"
			>
				<p class="home-section-label reveal-item">Libros</p>
				<article
					class="books-page-book books-page-book-featured home-book-entry"
					aria-labelledby="home-cio-book-title"
				>

					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/es/cio-book/"
							class="books-page-cover-link"
							aria-label="Conoce más sobre How to Become CIO and Succeed"
						>
							<img
								src="/images/cio-book-cover.png"
								alt="Portada de How to Become CIO and Succeed"
								class="books-page-cover animated-book-cover"
							/>
						</a>
					</div>


					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-cio-book-title">
							How to Become CIO and Succeed
						</h2>

						<p class="books-page-subtitle">
							Personas, Negocio, Estrategia
						</p>

						<p>
							El rol del CIO no consiste en gestionar sistemas. Consiste
							en liderar personas, definir la estrategia, influir en el
							negocio y convertir la tecnología en una ventaja
							competitiva. Este es el libro que me habría gustado tener
							cuando comencé mi camino en el liderazgo
						</p>

						<p class="books-page-action">
							<a
								href="/es/cio-book/"
								class="animated-link"
							>
								<span>Explorar el libro</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>

						<p class="books-page-action home-book-buy-action">
							<a
								href="https://www.amazon.com/dp/B0F8MVPN4Q"
								target="_blank"
								rel="noopener noreferrer"
								class="animated-link"
							>
								<span>Comprar en Amazon</span>
								<span class="animated-link-arrow" aria-hidden="true">→</span>
							</a>
						</p>
					</div>

				</article>

				<article
					class="books-page-book books-page-book-featured home-book-entry"
					aria-labelledby="home-itworks-book-title"
				>
					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/es/itworks-book/"
							class="books-page-cover-link"
							aria-label="Explorar Funciona. Ese es el problema"
						>
							<img
								src="/images/funciona-book-cover-es.png"
								alt="Portada de Funciona. Ese es el problema"
								class="books-page-cover animated-book-cover"
								loading="lazy"
								decoding="async"
							/>
						</a>
					</div>

					<div class="books-page-content reveal-item reveal-delay-2">
						<h2 id="home-itworks-book-title">
							Funciona. Ese es el problema
						</h2>

						<p class="books-page-subtitle">
							Cómo las soluciones tecnológicas pueden atraparnos
						</p>

						<p>
							Las soluciones tecnológicas que funcionan pueden
							acumular dependencias, complejidad y lock-in.
							Este libro explora cómo decisiones que resuelven
							los problemas de hoy pueden dificultar los cambios
							de mañana y limitar las opciones de una organización
						</p>

						<p class="home-book-availability">Disponible en 2027</p>

						<p class="books-page-action">
							<a href="/es/itworks-book/" class="animated-link">
								<span>Explorar el libro</span>
								<span class="animated-link-arrow" aria-hidden="true">→</span>
							</a>
						</p>
					</div>
				</article>
			</section>


			<section
				id="about"
				class="page-divider home-feature reveal-section"
			>
				<p class="home-section-label reveal-item">Sobre mí</p>
				<div class="about-layout">

					<div
						class="about-content reveal-item reveal-delay-1"
					>
						<p>
							Soy Chief Information Officer (CIO) con más de 15 años
							de experiencia internacional en liderazgo de TI,
							ayudando a organizaciones globales a generar valor para
							el negocio
						</p>

						<p>
							Mi enfoque combina pensamiento estratégico, ejecución
							práctica, relaciones sólidas y una cultura orientada al
							servicio, enfocada en la excelencia operacional y la
							mejora continua
						</p>

						<p class="books-page-action">
							<a
								href="/es/about/"
								class="animated-link"
							>
								<span>Mi trayectoria</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>


					<div
						class="about-photo-wrapper reveal-item reveal-from-right reveal-delay-2"
					>
						<a
							href="/es/about/"
							aria-label="Conoce más sobre Fede Rodrigo"
						>
							<img
								src="/images/fede.png"
								alt="Fede Rodrigo, Chief Information Officer, autor y speaker"
								class="about-photo animated-image"
							/>
						</a>
					</div>

				</div>
			</section>

		</main>


		<Footer />


		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver =
				new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;

							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{
						threshold: 0.12,
						rootMargin: '0px 0px -60px 0px'
					}
				);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>

	</body>
</html>
