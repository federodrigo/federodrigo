---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Fede Rodrigo | CIO, autor, speaker y líder tecnológico"
			description="Fede Rodrigo es Chief Information Officer, autor y líder tecnológico, enfocado en la creación de valor para el negocio, el liderazgo, la estrategia tecnológica, la excelencia operacional y la transformación"
			lang="es"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						La tecnología <span class="accent">nunca</span> es
					</span>

					<span class="hero-line">
						el punto de partida
					</span>
				</h1>

				<div class="lead-principles">
					<div>Personas Primero</div>
					<div>Orientado al Negocio</div>
					<div>Tecnología como Habilitador</div>
				</div>
			</section>
			
			<!-- ABOUT -->
			<section
				id="about"
				class="contact-section reveal-section"
			>
				<h2 class="reveal-item">
					Sobre mí
				</h2>

				<div class="about-layout">
					<div class="about-content reveal-item reveal-delay-1">
						<p>
						Soy Gerente de TI (CIO) con más de 15 años de experiencia internacional en liderazgo de TI, ayudando a organizaciones globales a generar valor para el negocio
						</p>

						<p>
							Mi enfoque combina pensamiento estratégico, ejecución
							práctica, relaciones sólidas y una cultura orientada al
							servicio, enfocada en la excelencia operacional y la
							mejora continua
						</p>

						<p class="books-page-action">
							<a
								href="/es/about/"
								class="animated-link"
							>
								<span>Mi trayectoria</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

					<div
						class="about-photo-wrapper reveal-item reveal-from-right reveal-delay-2"
					>
						<img
							src="/images/fede.png"
							alt="Fede Rodrigo, Chief Information Officer y autor"
							class="about-photo animated-image"
						/>
					</div>
				</div>
			</section>


			<!-- CIO OFFICE -->
			<section
				id="cio-office"
				class="contact-section reveal-section"
			>
				<h2 class="reveal-item">
					The CIO Office
				</h2>

				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-office-title"
				>
					<div
						class="books-page--wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/es/cio-office/"
							class="books-page--link"
							aria-label="Explorar The CIO Office"
						>
							<img
								src="/images/cio-office-logo.png"
								alt="The CIO Office"
								class="cio-office-capabilities-logo animated-image"
							/>
						</a>
					</div>

					<div class="books-page-content reveal-item reveal-delay-2">
						<p class="books-page-label">
							Liderazgo Ejecutivo en Tecnología
						</p>

						<h3 id="home-cio-office-title">
							Tecnología que crea valor para el negocio
						</h3>

						<p>
							Asesoramiento para organizaciones que buscan alinear la
							tecnología con los objetivos del negocio, fortalecer sus
							operaciones y acelerar la transformación
						</p>

						<p class="books-page-action">
							<a
								href="/es/cio-office/"
								class="animated-link"
							>
								<span>Conoce The CIO Office</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>
				</article>
			</section>


			<!-- BOOK -->
			<section
				id="books"
				class="contact-section reveal-section"
			>
				<h2 class="reveal-item">
					Libro
				</h2>

				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-book-title"
				>
					<div
						class="books-page--wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/es/books/"
							class="books-page-cover-link"
							aria-label="Conoce más sobre How to Become CIO and Succeed"
						>
							<img
								src="/images/cio-book-cover.png"
								alt="Portada de How to Become CIO and Succeed"
								class="books-page-cover animated-book-cover"
							/>
						</a>
					</div>

					<div class="books-page-content reveal-item reveal-delay-2">
						<p class="books-page-label">
							Libro destacado
						</p>

						<h3 id="home-cio-book-title">
							How to Become CIO and Succeed
						</h3>

						<p class="books-page-subtitle">
							Personas, Negocio, Estrategia
						</p>

						<p>
							El rol del CIO no consiste en gestionar sistemas
							Consiste en liderar personas, definir la estrategia,
							influir en el negocio y convertir la tecnología en una
							ventaja competitiva. Este es el libro que me habría
							gustado tener cuando comencé mi camino en el liderazgo
						</p>

						<p class="books-page-action">
							<a
								href="/es/cio-book/"
								class="animated-link"
							>
								<span>Explorar el libro</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>
				</article>
			</section>
		</main>

		<Footer />

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.12,
					rootMargin: '0px 0px -60px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>

