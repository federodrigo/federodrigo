---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const papers = [
	{
		status: 'En revisión',
		date: 'Enviado · Agosto 2026',
		title: 'When Success Hides Dependence',
		subtitle:
			'Por qué un sistema que funciona puede hacer más difícil saber qué ocurriría si se eliminaran las salvaguardas que sostienen ese desempeño',
		description:
			'Un análisis de cómo el éxito operacional aparente puede ocultar dependencias estructurales y debilitar la capacidad de evaluar alternativas creíbles'
	},
	{
		status: 'En revisión',
		date: 'Enviado · Agosto 2026',
		title: 'When Fixes Become the System',
		subtitle:
			'Cómo las soluciones exitosas pueden preservar una trayectoria tecnológica existente, incorporarse con el tiempo y reducir las alternativas creíbles',
		description:
			'Un análisis de cómo soluciones efectivas de corto plazo pueden convertirse en características permanentes de una organización y reforzar el lock-in tecnológico'
	}
];
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Libros y Papers | Fede Rodrigo"
			description="Libros y papers de Fede Rodrigo sobre liderazgo tecnológico, negocios, incentivos, instituciones y los sistemas que moldean las organizaciones"
			lang="es"
		/>

		<style>
			/* =========================================================
			   BOOKS PAGE
			========================================================= */

			.books-index-page {
				padding-top: 46px;
			}


			/* =========================================================
			   FEATURED BOOK
			========================================================= */

			.books-index-page .books-page-book-featured {
				margin: 0;
				padding-top: 0;
				padding-bottom: 0;
			}


			/* =========================================================
			   FORTHCOMING BOOK
			========================================================= */

			.books-index-page .minimal-tolerance-book {
				margin-top: var(--divider-space-before);
				margin-bottom: 0;

				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);
			}

			.books-page-cover-static {
				cursor: default;
			}

			.coming-soon {
				display: inline-block;

				color: #6d9fdd;

				font-size: 0.76rem;
				font-weight: 750;
				line-height: 1.2;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}


			/* =========================================================
			   PAPERS
			========================================================= */

			.papers-section {
				width: 100%;

				margin-top: var(--divider-space-before);
				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);

				scroll-margin-top: 8rem;
			}

			.papers-list {
				width: 100%;
			}

			.paper-row {
				display: grid;

				grid-template-columns:
					minmax(150px, 0.55fr)
					minmax(0, 2.8fr);

				align-items: start;

				gap: clamp(1.5rem, 4vw, 3.5rem);

				padding: 34px 0;

				border-bottom: 1px solid var(--line);
			}

			.paper-row:first-child {
				padding-top: 0;
			}

			.paper-row:last-child {
				padding-bottom: 0;
				border-bottom: 0;
			}

			.paper-meta,
			.paper-content {
				min-width: 0;
			}

			.paper-type {
				margin: 0 0 0.8rem;
			}

			.paper-status {
				margin: 0;

				color: #8a6b36;

				font-size: 0.8rem;
				font-weight: 750;
				line-height: 1.3;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			.paper-date {
				margin: 0.7rem 0 0;

				font-size: 0.86rem;
				line-height: 1.45;

				opacity: 0.58;
			}

			.paper-title {
				margin: 0;

				font-size: clamp(1.45rem, 2.4vw, 2.05rem);
				font-weight: 700;
				line-height: 1.08;
				letter-spacing: -0.035em;
			}

			.paper-subtitle {
				max-width: 800px;

				margin: 0.85rem 0 0;

				font-size: clamp(1rem, 1.4vw, 1.12rem);
				font-weight: 580;
				line-height: 1.48;
			}

			.paper-description {
				max-width: 780px;

				margin: 1rem 0 0;

				font-size: 0.94rem;
				line-height: 1.65;

				opacity: 0.66;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 850px) {
				.paper-row {
					grid-template-columns: 1fr;
					gap: 1.2rem;
				}

				.paper-meta {
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					gap: 0.7rem 1rem;
				}

				.paper-date {
					margin: 0;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.books-index-page {
					padding-top: 42px;
				}

				.books-index-page .books-page-book {
					grid-template-columns: 1fr;
					gap: 24px;
				}

				.books-index-page .books-page-book-featured {
					padding-top: 0;
					padding-bottom: 0;
				}

				.books-index-page .minimal-tolerance-book {
					margin-top: var(--divider-space-mobile);
					padding-top: var(--divider-space-mobile);
				}

				.books-index-page .books-page-cover-wrapper,
				.books-index-page .books-page-cover-link {
					width: 180px;
				}

				.books-index-page .books-page-cover {
					width: 180px;
					max-width: 100%;
					border-radius: 8px;
				}

				.books-index-page .books-page-content h2 {
					font-size: 1.55rem;
				}

				.books-index-page .books-page-subtitle {
					margin-bottom: 18px;
					font-size: 0.92rem;
				}

				.books-index-page .books-page-content > p {
					margin-bottom: 15px;

					font-size: 0.94rem;
					line-height: 1.58;
				}

				.books-index-page .books-page-action {
					margin-top: 18px;
				}

				.papers-section {
					margin-top: var(--divider-space-mobile);
					padding-top: var(--divider-space-mobile);
				}

				.paper-row {
					gap: 1rem;
					padding: 28px 0;
				}

				.paper-title {
					font-size: 1.45rem;
				}

				.paper-subtitle {
					font-size: 1rem;
				}

				.paper-description {
					font-size: 0.94rem;
					line-height: 1.58;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main class="books-index-page">

			<!-- =====================================================
			     FEATURED BOOK
			===================================================== -->

			<section
				class="books-page-book books-page-book-featured reveal-section"
				aria-labelledby="cio-book-title"
			>
				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>
					<a
						href="https://www.amazon.com/dp/B0F8MVPN4Q"
						target="_blank"
						rel="noopener noreferrer"
						class="books-page-cover-link"
						aria-label="Comprar How to Become CIO and Succeed en Amazon"
					>
						<img
							src="/images/cio-book-cover.png"
							alt="Portada de How to Become CIO and Succeed"
							class="books-page-cover animated-book-cover"
						/>
					</a>
				</div>

				<div
					class="books-page-content reveal-item reveal-delay-1"
				>
					<p class="books-page-label">
						Libro Destacado
					</p>

					<h2 id="cio-book-title">
						How to Become CIO and Succeed
					</h2>

					<p class="books-page-subtitle">
						Personas, Negocio, Estrategia
					</p>

					<p>
						Este es el libro que <strong>me habría gustado tener</strong>
						cuando comencé mi camino en el liderazgo
					</p>

					<p>
						El rol del CIO no consiste en gestionar sistemas.
						<em>No debería haber una “I” en CIO.</em> Se trata de
						liderar personas, definir la estrategia, influir en el
						negocio y convertir la tecnología en una ventaja
						competitiva
					</p>

					<p>
						<strong>Este no es un libro de texto.</strong> Es una guía
						práctica para líderes tecnológicos actuales y futuros
					</p>

					<p class="books-page-closing">
						Si estás acá para mantener el status quo, mejor da la vuelta
					</p>

					<p class="books-page-action">
						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>Comprar en Amazon</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>


			<!-- =====================================================
			     FORTHCOMING BOOK
			===================================================== -->

			<section
				class="books-page-book books-page-book-secondary minimal-tolerance-book reveal-section"
				aria-labelledby="minimal-tolerance-book-title"
			>
				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>
					<div
						class="books-page-cover-link books-page-cover-static"
					>
						<img
							src="/images/book-cover.jpg"
							alt="Portada de A Theory of Minimal Tolerance"
							class="books-page-cover animated-book-cover"
							loading="lazy"
						/>
					</div>
				</div>

				<div
					class="books-page-content reveal-item reveal-delay-1"
				>
					<p class="books-page-label">
						Próximo Libro
					</p>

					<h2 id="minimal-tolerance-book-title">
						A Theory of Minimal Tolerance
					</h2>

					<p>
						Un trabajo sobre libertad, coerción, incentivos,
						instituciones y los límites que deberían restringir
						el poder político
					</p>

					<p>
						Desarrolla un marco práctico para examinar las condiciones
						bajo las cuales la coerción estatal puede ser tolerada
					</p>

					<p class="books-page-action">
						<span class="coming-soon">
							Próximamente
						</span>
					</p>
				</div>
			</section>


			<!-- =====================================================
			     PAPERS
			===================================================== -->

			<section
				id="papers"
				class="papers-section reveal-section"
				aria-label="Papers de tecnología"
			>
				<div class="papers-list">

					{
						papers.map((paper) => (

							<article class="paper-row reveal-item">

								<div class="paper-meta">

									<p class="paper-status">
										{paper.status}
									</p>

									<p class="paper-date">
										{paper.date}
									</p>

								</div>


								<div class="paper-content">

									<p class="books-page-label paper-type">
										Paper
									</p>

									<h2 class="paper-title">
										{paper.title}
									</h2>

									<p class="paper-subtitle">
										{paper.subtitle}
									</p>

									<p class="paper-description">
										{paper.description}
									</p>

								</div>

							</article>

						))
					}

				</div>
			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.12,
							rootMargin:
								'0px 0px -60px 0px'
						}
					);


				sections.forEach((section) => {
					revealObserver.observe(section);
				});

			} else {

				sections.forEach((section) => {
					section.classList.add(
						'is-visible'
					);
				});

			}
		</script>

	</body>
</html>
