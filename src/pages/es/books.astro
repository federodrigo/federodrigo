---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const papers = [
	{
		status: 'En revisión',
		date: 'Enviado · agosto de 2026',
		title: 'Cuando el Éxito Oculta la Dependencia',
		subtitle:
			'Por qué un sistema que funciona puede dificultar saber qué ocurriría si se eliminaran las salvaguardas que sostienen ese desempeño',
		description:
			'Un análisis de cómo el éxito operativo aparente puede ocultar una dependencia estructural y debilitar la capacidad de evaluar alternativas creíbles'
	},
	{
		status: 'En revisión',
		date: 'Enviado · agosto de 2026',
		title: 'Cuando las Soluciones se Convierten en el Sistema',
		subtitle:
			'Cómo las adaptaciones exitosas pueden preservar una trayectoria tecnológica, arraigarse con el tiempo y reducir las alternativas creíbles',
		description:
			'Un análisis de cómo las soluciones efectivas de corto plazo pueden convertirse en elementos permanentes de una organización y reforzar la dependencia tecnológica'
	}
];
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Libros y Papers | Fede Rodrigo"
			description="Libros y papers de Fede Rodrigo sobre liderazgo tecnológico, negocios, incentivos, instituciones y los sistemas que moldean las organizaciones"
			lang="es"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- LIBRO DESTACADO -->

			<section
				class="books-page-book books-page-book-featured reveal-section"
				aria-labelledby="cio-book-title"
			>
				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>
					<a
						href="https://www.amazon.com/dp/B0F8MVPN4Q"
						target="_blank"
						rel="noopener noreferrer"
						class="books-page-cover-link"
						aria-label="Ver How to Become CIO and Succeed en Amazon"
					>
						<img
							src="/images/cio-book-cover.png"
							alt="Portada de How to Become CIO and Succeed"
							class="books-page-cover animated-book-cover"
						/>
					</a>
				</div>

				<div class="books-page-content reveal-item reveal-delay-1">
					<p class="books-page-label">
						Libro destacado
					</p>

					<h2 id="cio-book-title">
						How to Become CIO and Succeed
					</h2>

					<p class="books-page-subtitle">
						Personas, Negocio, Estrategia
					</p>

					<p>
						Este es el libro que
						<strong>me habría gustado tener</strong>
						cuando comencé mi camino en el liderazgo
					</p>

					<p>
						El rol del CIO no consiste en gestionar sistemas.
						<em>No debería haber un “yo” en CIO.</em> Consiste en
						liderar personas, definir la estrategia, influir en el
						negocio y convertir la tecnología en una ventaja
						competitiva
					</p>

					<p>
						<strong>Este no es un libro de texto.</strong> Es una guía
						práctica para líderes tecnológicos actuales y futuros
					</p>

					<p class="books-page-closing">
						Si estás aquí para mantener el statu quo, da la vuelta ahora
					</p>

					<p class="books-page-action">
						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>Ver en Amazon</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>

			<!-- PRÓXIMO LIBRO -->

			<section
				class="books-page-book books-page-book-secondary minimal-tolerance-book reveal-section"
				aria-labelledby="minimal-tolerance-book-title"
			>
				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>
					<div
						class="books-page-cover-link books-page-cover-static"
					>
						<img
							src="/images/book-cover-esp.jpg"
							alt="Portada de Una Teoría de Tolerancia Mínima"
							class="books-page-cover animated-book-cover"
							loading="lazy"
						/>
					</div>
				</div>

				<div class="books-page-content reveal-item reveal-delay-1">
					<p class="books-page-label">
						Próximo libro
					</p>

					<h2 id="minimal-tolerance-book-title">
						Una Teoría de Tolerancia Mínima
					</h2>

					<p>
						Una obra que explora la libertad, la coerción, los
						incentivos, las instituciones y los límites que deberían
						restringir el poder político
					</p>

					<p>
						Desarrolla un marco práctico para examinar las condiciones
						bajo las cuales la coerción estatal puede ser tolerada
					</p>

					<p class="books-page-action">
						<span class="coming-soon">
							Próximamente
						</span>
					</p>
				</div>
			</section>

			<!-- PAPERS -->

			<section
				id="papers"
				class="papers-section reveal-section"
				aria-label="Papers sobre tecnología"
			>
				<div class="papers-list">
					{
						papers.map((paper) => (
							<article class="paper-row reveal-item">
								<div class="paper-meta">
									<p class="paper-status">
										{paper.status}
									</p>

									<p class="paper-date">
										{paper.date}
									</p>
								</div>

								<div class="paper-content">
									<p class="books-page-label paper-type">
										Paper
									</p>

									<h2 class="paper-title">
										{paper.title}
									</h2>

									<p class="paper-subtitle">
										{paper.subtitle}
									</p>

									<p class="paper-description">
										{paper.description}
									</p>
								</div>
							</article>
						))
					}
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			if ('IntersectionObserver' in window) {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;

							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{
						threshold: 0.12,
						rootMargin: '0px 0px -60px 0px'
					}
				);

				sections.forEach((section) => {
					revealObserver.observe(section);
				});
			} else {
				sections.forEach((section) => {
					section.classList.add('is-visible');
				});
			}
		</script>

		<style>
			main {
				padding-top: 0 !important;
				padding-bottom: 0;
			}

			/* LIBRO DESTACADO */

			.books-page-book-featured {
				margin-top: 0;
				margin-bottom: 0;
				padding-top: clamp(3rem, 5vw, 4.25rem);
				padding-bottom: clamp(2.25rem, 4vw, 3.5rem);
			}

			/* PRÓXIMO LIBRO */

			.minimal-tolerance-book {
				margin-top: 0;
				margin-bottom: 0;
				padding-top: clamp(2.25rem, 4vw, 3.5rem);
				padding-bottom: clamp(2.25rem, 4vw, 3.5rem);
				border-top: 1px solid rgba(52, 65, 86, 0.2);
			}

			.books-page-cover-static {
				cursor: default;
			}

			.coming-soon {
				display: inline-block;
				font-size: 0.76rem;
				font-weight: 750;
				line-height: 1.2;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #6d9fdd;
			}

			/* PAPERS */

			.papers-section {
				width: min(1180px, calc(100% - 3rem));
				margin: 0 auto;
				padding-bottom: 0;
				scroll-margin-top: 8rem;
			}

			.papers-list {
				border-top: 1px solid rgba(52, 65, 86, 0.2);
			}

			.paper-row {
				display: grid;
				grid-template-columns: minmax(170px, 0.6fr) minmax(0, 2.8fr);
				align-items: start;
				gap: clamp(1.5rem, 4vw, 3.5rem);
				padding: clamp(2rem, 4vw, 3.25rem) 0;
				border-bottom: 1px solid rgba(52, 65, 86, 0.2);
			}

			.paper-row:last-child {
				padding-bottom: clamp(1.5rem, 2.5vw, 2rem);
				border-bottom: 0;
			}

			.paper-meta,
			.paper-content {
				min-width: 0;
			}

			.paper-type {
				margin: 0 0 0.8rem;
			}

			.paper-status {
				margin: 0;
				font-size: 0.8rem;
				font-weight: 750;
				line-height: 1.3;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #8a6b36;
			}

			.paper-date {
				margin: 0.7rem 0 0;
				font-size: 0.86rem;
				line-height: 1.45;
				opacity: 0.58;
			}

			.paper-title {
				margin: 0;
				font-size: clamp(1.45rem, 2.4vw, 2.05rem);
				font-weight: 700;
				line-height: 1.08;
				letter-spacing: -0.035em;
			}

			.paper-subtitle {
				max-width: 800px;
				margin: 0.85rem 0 0;
				font-size: clamp(1rem, 1.4vw, 1.12rem);
				font-weight: 580;
				line-height: 1.48;
			}

			.paper-description {
				max-width: 780px;
				margin: 1rem 0 0;
				font-size: 0.94rem;
				line-height: 1.65;
				opacity: 0.66;
			}

			@media (max-width: 850px) {
				.books-page-book-featured {
					margin-top: 0;
					margin-bottom: 0;
					padding-top: 2.5rem;
					padding-bottom: 2rem;
				}

				.minimal-tolerance-book {
					margin-top: 0;
					margin-bottom: 0;
					padding-top: 2rem;
					padding-bottom: 2rem;
				}

				.papers-section {
					width: min(100% - 2rem, 720px);
					margin: 0 auto;
				}

				.paper-row {
					grid-template-columns: 1fr;
					gap: 1.4rem;
				}

				.paper-meta {
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					gap: 0.7rem 1rem;
				}

				.paper-date {
					margin: 0;
				}
			}
		</style>
	</body>
</html>
