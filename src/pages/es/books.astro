---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Libros | Fede Rodrigo"
			description="Libros de Fede Rodrigo sobre liderazgo tecnológico, negocios, incentivos, instituciones y los sistemas que moldean las organizaciones"
			lang="es"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Libros y <span class="accent">Publicaciones</span>
					</span>
				</h1>

				<div class="lead-principles">
					<div>Escribí el Libro que me Hubiera Gustado Tener</div>
					<div>Hace Veinte Años</div>
				</div>
			</section>

			<section
				class="books-page-book books-page-book-featured reveal-section"
				aria-labelledby="cio-book-title"
			>
				<div
					class="books-page-cover-wrapper reveal-item reveal-from-left"
				>
					<a
						href="https://www.amazon.com/dp/B0F8MVPN4Q"
						target="_blank"
						rel="noopener noreferrer"
						class="books-page-cover-link"
						aria-label="Ver How to Become CIO and Succeed en Amazon"
					>
						<img
							src="/images/cio-book-cover.png"
							alt="Portada de How to Become CIO and Succeed"
							class="books-page-cover animated-book-cover"
						/>
					</a>
				</div>

				<div class="books-page-content reveal-item reveal-delay-1">
					<p class="books-page-label">
						Libro destacado
					</p>

					<h2 id="cio-book-title">
						How to Become CIO and Succeed
					</h2>

					<p class="books-page-subtitle">
						Personas, Negocio, Estrategia
					</p>

					<p>
						Este es el libro que
						<strong>me habría gustado tener</strong>
						cuando comencé mi camino en el liderazgo
					</p>

					<p>
						El rol del CIO no consiste en gestionar sistemas.
						<em>No debería haber un “yo” en CIO.</em> Consiste en
						liderar personas, definir la estrategia, influir en el
						negocio y convertir la tecnología en una ventaja
						competitiva
					</p>

					<p>
						<strong>Este no es un libro de texto.</strong> Es una guía
						práctica para líderes tecnológicos actuales y futuros
					</p>

					<p class="books-page-closing">
						Si estás aquí para mantener el statu quo, da la vuelta ahora
					</p>

					<p class="books-page-action">
						<a
							href="https://www.amazon.com/dp/B0F8MVPN4Q"
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>Ver en Amazon</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>

			<section
				class="books-page-other reveal-section"
				aria-labelledby="other-work-title"
			>
				<h2
					id="other-work-title"
					class="reveal-item"
				>
					Otros trabajos
				</h2>

				<article
					class="books-page-book books-page-book-secondary"
					aria-labelledby="minimal-tolerance-title"
				>
					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5984574"
							target="_blank"
							rel="noopener noreferrer"
							class="books-page-cover-link"
							aria-label="Leer El teorema de la tolerancia mínima en SSRN"
						>
							<img
								src="/images/book-cover-esp.png"
								alt="Portada de Una teoría de la tolerancia mínima"
								class="books-page-cover animated-book-cover"
								loading="lazy"
							/>
						</a>
					</div>

					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<p class="books-page-label">
							Próximamente
						</p>

						<h2 id="minimal-tolerance-title">
							Una Teoría de la Tolerancia Mínima
						</h2>

						<p>
							Una obra que explora la libertad, la coerción, los
							incentivos, las instituciones y los límites que
							deberían restringir el poder político
						</p>

						<p>
							Desarrolla un marco práctico para examinar las
							condiciones bajo las cuales la coerción estatal puede
							ser tolerable
						</p>

						<p class="books-page-action">
							<a
								href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5984574"
								target="_blank"
								rel="noopener noreferrer"
								class="animated-link"
							>
								<span>
									Leer El teorema de la tolerancia mínima en SSRN
								</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>
				</article>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.12,
					rootMargin: '0px 0px -60px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>
