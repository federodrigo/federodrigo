
---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const featuredPaper = {
  status: 'En revisión',
  title: 'Cuando los arreglos se convierten en el sistema',
  subtitle: 'Cómo los arreglos de hoy reducen las opciones de mañana',
  description:
    'Los arreglos que permiten seguir usando una tecnología también pueden aumentar la dependencia de ella. A medida que esas decisiones se acumulan, cambiar se vuelve más costoso y complejo, incluso cuando aparecen mejores alternativas.'
};
---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <SEO
      title="Libros | Fede Rodrigo"
      description="Libros e investigación de Fede Rodrigo sobre liderazgo tecnológico, negocios, incentivos, instituciones y los sistemas que moldean las organizaciones"
      lang="es"
    />

    <style>
      .books-index-page {
        padding-top: 46px;
      }

      .books-index-page .books-page-book-featured {
        margin: 0;
        padding-top: 0;
        padding-bottom: 0;
      }

      .books-page-secondary-action {
        margin-top: 10px;
      }

      .books-index-page .books-page-other {
        margin-top: var(--divider-space-before);
        margin-bottom: 0;
        padding-top: var(--divider-space-after);
        padding-bottom: 0;
        border-top: 1px solid var(--line);
      }

      .research-content .books-page-subtitle {
        max-width: 800px;
      }

      .research-description {
        max-width: 780px;
      }

      .research-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem 1.2rem;
        margin-top: 1.6rem;
      }

      .research-status {
        margin: 0;
        color: #8a6b36;
        font-size: 0.8rem;
        font-weight: 750;
        line-height: 1.3;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .books-page-cover-static {
        cursor: default;
      }

      .coming-soon {
        display: inline-block;
        color: #6d9fdd;
        font-family: inherit;
        font-size: var(--cta-size);
        font-weight: var(--cta-weight);
        line-height: 1.3;
        letter-spacing: normal;
        text-transform: none;
      }

      @media (max-width: 720px) {
        .books-index-page {
          padding-top: 42px;
        }

        .books-index-page .books-page-book {
          grid-template-columns: 1fr;
          gap: 24px;
        }

        .books-index-page .books-page-book-featured {
          padding-top: 0;
          padding-bottom: 0;
        }

        .books-index-page .books-page-cover-wrapper,
        .books-index-page .books-page-cover-link {
          width: 180px;
        }

        .books-index-page .books-page-cover {
          width: 180px;
          max-width: 100%;
          border-radius: 8px;
        }

        .books-index-page .books-page-content h2 {
          font-size: 1.55rem;
        }

        .books-index-page .books-page-subtitle {
          margin-bottom: 18px;
          font-size: 0.92rem;
        }

        .books-index-page .books-page-content > p {
          margin-bottom: 15px;
          font-size: 0.94rem;
          line-height: 1.58;
        }

        .books-index-page .books-page-action {
          margin-top: 18px;
        }

        .books-page-secondary-action {
          margin-top: 10px;
        }

        .books-index-page .books-page-other {
          margin-top: var(--divider-space-mobile);
          padding-top: var(--divider-space-mobile);
          padding-bottom: 0;
        }

      }
    </style>
  </head>

  <body>
    <Header />

    <main class="books-index-page">

      <!-- Libro CIO -->
      <section
        class="books-page-book books-page-book-featured reveal-section"
        aria-labelledby="cio-book-title"
      >
        <div class="books-page-cover-wrapper reveal-item reveal-from-left">
          <a
            href="https://www.amazon.com/dp/B0F8MVPN4Q"
            target="_blank"
            rel="noopener noreferrer"
            class="books-page-cover-link"
            aria-label="Comprar How to Become CIO and Succeed en Amazon"
          >
            <img
              src="/images/cio-book-cover.png"
              alt="Portada de How to Become CIO and Succeed"
              class="books-page-cover animated-book-cover"
            />
          </a>
        </div>

        <div class="books-page-content reveal-item reveal-delay-1">
          <p class="books-page-label">Libro destacado</p>
          <h2 id="cio-book-title">How to Become CIO and Succeed</h2>
          <p class="books-page-subtitle">Personas, Negocio, Estrategia</p>

          <p>
            Este es el libro <strong>que me habría gustado tener</strong>
            cuando comencé mi camino en el liderazgo
          </p>

          <p>
            El rol del CIO no consiste en gestionar sistemas.
            <em>No debería haber una “I” en CIO.</em>
            Se trata de liderar personas, definir la estrategia,
            influir en el negocio y convertir la tecnología
            en una ventaja competitiva
          </p>

          <p>
            <strong>Este no es un libro de texto.</strong>
            Es una guía práctica para líderes tecnológicos
            actuales y futuros
          </p>

          <p class="books-page-closing">
            Si estás acá para mantener el status quo, mejor da la vuelta
          </p>

          <p class="books-page-action">
            <a
              href="https://www.amazon.com/dp/B0F8MVPN4Q"
              target="_blank"
              rel="noopener noreferrer"
              class="animated-link"
            >
              <span>Comprar en Amazon</span>
              <span class="animated-link-arrow" aria-hidden="true">→</span>
            </a>
          </p>

          <p class="books-page-secondary-action">
            <a href="/es/cio-book/" class="animated-link">
              <span>Explorar el libro</span>
              <span class="animated-link-arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>

      <!-- Nuevo libro 2027 -->
      <section
        class="books-page-book books-page-other reveal-section"
        aria-labelledby="funciona-book-title"
      >
        <div class="books-page-cover-wrapper reveal-item reveal-from-left">
          <div class="books-page-cover-link books-page-cover-static">
            <img
              src="/images/funciona-book-cover-es.png"
              alt="Portada de Funciona. Ese es el problema"
              class="books-page-cover animated-book-cover"
              loading="lazy"
            />
          </div>
        </div>

        <div class="books-page-content reveal-item reveal-delay-1">
          <p class="books-page-label">Próximo libro</p>
          <h2 id="funciona-book-title">Funciona. Ese es el problema</h2>
          <p class="books-page-subtitle">
            Cómo las soluciones tecnológicas pueden atraparnos
          </p>

          <p>
            A veces el mayor riesgo no aparece cuando algo falla, sino cuando algo funciona.
            Este libro explora cómo decisiones tecnológicas bien intencionadas, soluciones que
            resuelven urgencias y éxitos operativos pueden convertirse con el tiempo en
            complejidad, dependencia y lock-in
          </p>

          <p>
            A través de historias, ejemplos y una perspectiva práctica de liderazgo, muestra por qué la tecnología nunca es el punto de partida y cómo las organizaciones pueden preservar su capacidad de decidir antes de que sus sistemas terminen decidiendo por ellas
          </p>

          <p class="books-page-action">
            <span class="coming-soon">Disponible en 2027</span>
          </p>
        </div>
      </section>

      <!-- Paper -->
      <section
        id="research"
        class="books-page-book books-page-other reveal-section"
        aria-labelledby="research-title"
      >
        <div class="books-page-cover-wrapper reveal-item reveal-from-left">
          <img
            src="/images/paper-es.png"
            alt="Portada del paper Cuando los arreglos se convierten en el sistema"
            class="books-page-cover animated-book-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="books-page-content research-content reveal-item reveal-delay-1">
          <p class="books-page-label">Paper de investigación</p>
          <h2 id="research-title">{featuredPaper.title}</h2>
          <p class="books-page-subtitle">{featuredPaper.subtitle}</p>
          <p class="research-description">{featuredPaper.description}</p>
          <div class="research-meta">
            <p class="research-status">{featuredPaper.status}</p>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const sections = document.querySelectorAll('.reveal-section');

      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -60px 0px'
        });

        sections.forEach((section) => revealObserver.observe(section));
      } else {
        sections.forEach((section) => section.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

