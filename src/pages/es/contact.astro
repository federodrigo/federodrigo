---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Contacto | Fede Rodrigo"
			description="Contacta a Fede Rodrigo para asesoramiento CIO, speaking, podcasts, consultas de medios y preguntas generales"
			lang="es"
		/>

		<style>
			/* =========================================================
			   CONTACT PAGE
			========================================================= */

			.contact-page-main {
				padding-top: 46px;
			}

			.contact-page-direct {
				margin-top: 0;
				padding-top: 0;
			}


			/* =========================================================
			   CONTACT TITLE
			========================================================= */

			.contact-page-direct .contact-page-info > h2 {
				margin-bottom: 24px;

				font-size: clamp(1.75rem, 2.3vw, 2rem);
				font-weight: 700;
				line-height: 1.12;
				letter-spacing: -0.035em;
			}

			.contact-page-direct .contact-page-info > h2::after {
				content: none;
				display: none;
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.contact-page-main {
					padding-top: 42px;
				}

				.contact-page-direct {
					padding-top: 0;
				}

				.contact-page-direct .contact-page-info > h2 {
					font-size: 1.7rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main class="contact-page-main">

			<section
				class="contact-page contact-page-direct reveal-section"
			>

				<!-- =================================================
				     CONTACT INFORMATION
				================================================= -->

				<div
					class="contact-page-info reveal-item reveal-from-left"
				>
					<h2>
						Información de contacto
					</h2>

					<p class="contact-page-intro">
						Para asesoramiento, speaking, podcasts, medios o
						consultas generales
					</p>


					<div class="contact-page-links">

						<div
							class="contact-page-item"
							style="--contact-index: 0;"
						>
							<span
								class="contact-page-icon"
								aria-hidden="true"
							>
								✉
							</span>

							<div>
								<p class="contact-page-item-label">
									Email
								</p>

								<a href="mailto:contact@federodrigo.com">
									contact@federodrigo.com
								</a>
							</div>
						</div>


						<div
							class="contact-page-item"
							style="--contact-index: 1;"
						>
							<span
								class="contact-page-icon contact-page-linkedin-icon"
								aria-hidden="true"
							>
								in
							</span>

							<div>
								<p class="contact-page-item-label">
									LinkedIn
								</p>

								<a
									href="https://www.linkedin.com/in/fede-rodrigo/"
									target="_blank"
									rel="noopener noreferrer"
								>
									linkedin.com/in/fede-rodrigo
								</a>
							</div>
						</div>

					</div>


					<div class="contact-page-response">

						<p class="contact-page-response-label">
							Tiempo de respuesta
						</p>

						<p>
							Normalmente respondo dentro de 2–3 días hábiles
						</p>

					</div>

				</div>


				<!-- =================================================
				     CONTACT FORM
				================================================= -->

				<div
					class="contact-page-form-wrapper reveal-item reveal-from-right reveal-delay-1"
				>
					<form
						id="contact-form"
						class="contact-page-form"
						method="POST"
						action="/api/contact"
					>

						<div
							class="contact-page-form-row contact-animated-field"
							style="--field-index: 0;"
						>

							<div class="contact-page-field">

								<label for="first-name">
									Nombre
								</label>

								<input
									id="first-name"
									name="firstName"
									type="text"
									autocomplete="given-name"
									placeholder="María"
									required
								/>

							</div>


							<div class="contact-page-field">

								<label for="last-name">
									Apellido
								</label>

								<input
									id="last-name"
									name="lastName"
									type="text"
									autocomplete="family-name"
									placeholder="Pérez"
									required
								/>

							</div>

						</div>


						<div
							class="contact-page-field contact-animated-field"
							style="--field-index: 1;"
						>
							<label for="email">
								Email
							</label>

							<input
								id="email"
								name="email"
								type="email"
								autocomplete="email"
								placeholder="maria@empresa.com"
								required
							/>
						</div>


						<div
							class="contact-page-field contact-animated-field"
							style="--field-index: 2;"
						>
							<label for="subject">
								Asunto
							</label>

							<select
								id="subject"
								name="subject"
								required
							>
								<option
									value=""
									selected
									disabled
								>
									Selecciona un tema...
								</option>

								<option value="cio-advisory">
									Asesoramiento y Fractional CIO
								</option>

								<option value="speaking">
									Speaking, Webinar, Podcast
								</option>

								<option value="general">
									Consulta general
								</option>
							</select>
						</div>


						<div
							class="contact-page-field contact-animated-field"
							style="--field-index: 3;"
						>
							<label for="message">
								Mensaje
							</label>

							<textarea
								id="message"
								name="message"
								rows="7"
								placeholder="¿Cómo puedo ayudarte?"
								required
							></textarea>
						</div>


						<button
							id="contact-submit"
							type="submit"
							class="contact-page-submit contact-animated-field"
							style="--field-index: 4;"
						>
							<span class="contact-page-submit-text">
								Enviar mensaje
							</span>

							<span
								class="contact-page-submit-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</button>


						<p
							id="contact-status"
							class="contact-page-status"
							role="status"
							aria-live="polite"
							hidden
						></p>

					</form>
				</div>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL + FORM
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');


			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.12,
							rootMargin:
								'0px 0px -60px 0px',
						}
					);


				sections.forEach((section) => {
					revealObserver.observe(section);
				});

			} else {

				sections.forEach((section) => {
					section.classList.add(
						'is-visible'
					);
				});

			}


			const form =
				document.querySelector<HTMLFormElement>(
					'#contact-form'
				);

			const submitButton =
				document.querySelector<HTMLButtonElement>(
					'#contact-submit'
				);

			const submitText =
				document.querySelector<HTMLElement>(
					'.contact-page-submit-text'
				);

			const status =
				document.querySelector<HTMLElement>(
					'#contact-status'
				);


			if (
				form &&
				submitButton &&
				submitText &&
				status
			) {

				form.addEventListener(
					'submit',
					async (event) => {

						event.preventDefault();


						if (!form.reportValidity()) {
							return;
						}


						submitButton.disabled = true;

						submitButton.setAttribute(
							'aria-busy',
							'true'
						);

						submitText.textContent =
							'Enviando...';


						status.hidden = true;
						status.textContent = '';

						status.classList.remove(
							'contact-page-status-success',
							'contact-page-status-error'
						);


						try {

							const response =
								await fetch(
									form.action,
									{
										method: 'POST',

										body:
											new FormData(
												form
											),

										headers: {
											Accept:
												'application/json',
										},
									}
								);


							const result =
								await response
									.json()
									.catch(
										() => null
									);


							if (!response.ok) {

								throw new Error(
									result?.message ||
										'No se pudo enviar tu mensaje'
								);

							}


							form.reset();


							status.textContent =
								'Gracias. Tu mensaje fue enviado.';


							status.classList.add(
								'contact-page-status-success'
							);


							status.hidden = false;

						} catch (error) {

							status.textContent =
								error instanceof Error
									? error.message
									: 'No se pudo enviar tu mensaje. Inténtalo nuevamente.';


							status.classList.add(
								'contact-page-status-error'
							);


							status.hidden = false;

						} finally {

							submitButton.disabled =
								false;


							submitButton.removeAttribute(
								'aria-busy'
							);


							submitText.textContent =
								'Enviar mensaje';

						}

					}
				);

			}
		</script>

	</body>
</html>
