---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

type MediaItem = {
	type: string;
	status: 'upcoming' | 'published';
	title: string;
	date: string;
	image: string;
	imageAlt: string;
	description: string;
	url?: string;
	linkLabel?: string;
	pdfUrl?: string;
	pdfLabel?: string;
	internal?: boolean;
	compactTitle?: boolean;
};

const mediaItems: MediaItem[] = [
	{
		type: 'Charla en conferencia',
		status: 'upcoming',
		title: 'LLMday Montevideo 2026',
		date: '5 de diciembre de 2026',
		image: 'https://llmday.com/assets/images/events/llmday-2026-montevideo-q4.png',
		imageAlt:
			'LLMday Montevideo 2026',
		description:
			'Una charla sobre por qué las iniciativas de IA deberían comenzar por el desafío de negocio y un marco práctico para convertir necesidades reales en mejores decisiones tecnológicas',
		url: 'https://llmday.com/2026-montevideo-q4/',
		linkLabel: 'Ver evento',
	},
	{
		type: 'Charla TEDx',
		status: 'upcoming',
		title: 'TEDx Ciudad De La Costa',
		date: '26 de noviembre de 2026',
		image: '/images/TEDx-Logo-v2.png',
		imageAlt:
			'TEDx',
		description:
			'Una charla sobre por qué la tecnología nunca debería ser el punto de partida y cómo las decisiones technology-first pueden crear complejidad, dependencias y menos opciones con el tiempo',
		url: 'https://redtickets.uy/evento/TEDx-Ciudad-de-la-Costa/34038/',
		linkLabel: 'Entradas e información',
	},
	{
		type: 'Webinar',
		status: 'published',
		title: 'XSeed',
		date: 'Agosto 2026',
		image: '/images/xseed-webinar.png',
		imageAlt:
			'Webinar de XSeed con Fede Rodrigo',
		description:
			'Un webinar sobre liderazgo tecnológico: por qué liderar es el trabajo y por qué las personas y el negocio vienen antes que la tecnología',
		compactTitle: true,
	},
	{
		type: 'Podcast',
		status: 'published',
		title: 'The Technology Vanguard',
		date: 'Agosto 2026',
		image: '/images/vanguard.png',
		imageAlt:
			'Fede Rodrigo participando en el podcast The Technology Vanguard',
		description:
			'Una conversación sobre liderazgo de TI, los errores que enseñan, la transición desde la excelencia técnica hacia el liderazgo de personas y las lecciones que realmente forman el camino para convertirse en CIO',
		url: 'https://www.youtube.com/watch?v=2wyTHhaOcWE',
		linkLabel: 'Ver la conversación',
	},
	{
		type: 'Entrevista escrita',
		status: 'published',
		title: 'Turning Cloud Investment into Business Value — Nublit',
		date: 'Enero 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt:
			'Entrevista con Fede Rodrigo publicada por Nublit',
		description:
			'Una conversación con Nublit sobre estrategia cloud en América Latina, adopción híbrida, barreras culturales y regulatorias, y el rol de la tecnología como impulsor del crecimiento, la innovación y la resiliencia operacional',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'Ver informe completo',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Leer mi entrevista',
		compactTitle: true,
	},
	{
		type: 'Finalista',
		status: 'published',
		title: 'ORBIE CIO Awards',
		date: 'Septiembre 2024',
		image: '/images/orbie.jpg',
		imageAlt:
			'ORBIE Awards CIO Central Texas',
		description:
			'Reconocido como finalista en la categoría Global CIO de los premios de Central Texas',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'Ver reconocimiento',
	},
	{
		type: 'Mesa ejecutiva',
		status: 'published',
		title: 'Industrial Reinvention — The Economist',
		date: 'Septiembre 2024',
		image: '/images/impact.png',
		imageAlt:
			'The Economist Impact',
		description:
			'Participante invitado en Industrial Reinvention: New Business Models and Jobs for Tomorrow’s Technology, organizado por The Economist Impact junto a otros CIOs en Houston, Texas',
	},
];
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Speaking | Fede Rodrigo"
			description="Charlas sobre decisiones tecnológicas, valor de negocio, liderazgo, lock-in y por qué la tecnología nunca debería ser el punto de partida"
			lang="es"
		/>

		<style>
			/* =========================================================
			   SPEAKING HERO
			========================================================= */

			.speaking-hero {
				max-width: none;
				padding: 10px 0 24px;
				border-bottom: 0;
				text-align: center;
			}

			.speaking-hero-title {
				width: 100%;
				max-width: 100%;
				margin-left: auto;
				margin-right: auto;

				font-size: clamp(2rem, 3.65vw, 3.75rem);
				line-height: 1.08;
				text-align: center;
			}

			.speaking-hero-title .hero-line {
				display: block;
				width: 100%;
				white-space: nowrap;
			}

			.speaking-hero-accent {
				color: #6fa7ef;
			}

			.speaking-hero-accent {
				display: inline-block;
				opacity: 0;
				transform: translateY(6px);

				animation:
					speaking-accent-reveal
					520ms
					ease
					720ms
					forwards;
			}

			@keyframes speaking-accent-reveal {
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}



			/* =========================================================
			   ALL SPEAKING LINKS
			   Same typography everywhere
			========================================================= */

			.speaking-page
				.speaking-talk-link
				.animated-link,
			.speaking-page
				.speaking-closing-link
				.animated-link,
			.speaking-page
				.media-action
				.animated-link,
			.speaking-page
				.speaking-inquiry-action
				.animated-link {
				font-family: inherit;
				font-size: var(--cta-size);
				font-weight: var(--cta-weight);
				line-height: 1.3;
			}


			/* =========================================================
			   CENTERED TALK LINKS
			========================================================= */

			.speaking-talk-link {
				width: 100%;
				margin: -6px auto 16px;
				text-align: center;
			}

			.speaking-centered-action {
				max-width: none;
				margin: 0;
				text-align: center;
			}

			.speaking-centered-link {
				justify-content: center;
			}

			.speaking-research-note {
				max-width: 760px;
				margin: 10px auto 0;

				color: #8b97a4;

				font-size: 0.96rem;
				line-height: 1.5;
			}

			.speaking-research-note a {
				color: #102b46;
				text-decoration: none;
				border-bottom: 0;
			}

			.speaking-research-note a em {
				color: inherit;
			}

			.speaking-research-note a:hover {
				color: var(--blue);
				border-bottom: 0;
			}


			/* =========================================================
			   SPEAKING SLIDER
			========================================================= */

			.speaking-showcase {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;
			}

			.speaking-slider {
				width: 100%;
			}

			.speaking-slider-stage {
				position: relative;

				width: 100%;
				aspect-ratio: 16 / 9;

				overflow: hidden;

				border: 1px solid rgba(16, 43, 70, 0.06);
				border-radius: 14px;

				background: #ffffff;

				box-shadow:
					0 16px 40px rgba(16, 43, 70, 0.065);
			}

			.speaking-slide {
				position: absolute;

				/*
				 * Dejamos sólo un marco blanco fino alrededor de la imagen.
				 * El inset anterior (24–42px) achicaba demasiado el arte
				 * dentro de la tarjeta del carrusel.
				 */
				inset: clamp(10px, 1.1vw, 16px);

				display: flex;
				align-items: center;
				justify-content: center;

				margin: 0;

				opacity: 0;
				pointer-events: none;

				transition: opacity 650ms ease;
			}

			.speaking-slide.is-active {
				z-index: 2;
				opacity: 1;
				pointer-events: auto;
			}

			.speaking-slide-image {
				display: block;

				width: 100%;
				height: 100%;

				/*
				 * Hacemos que la imagen llene el área disponible para que
				 * tenga más presencia dentro del contenedor. Como los PNG
				 * ya están preparados en formato wide, el recorte es mínimo.
				 */
				object-fit: cover;
				object-position: center;

				border-radius: 8px;
				background: transparent;
			}


			/* =========================================================
			   SLIDER DOTS
			========================================================= */

			.speaking-slider-nav {
				display: flex;
				align-items: center;
				justify-content: center;

				gap: 8px;

				height: 28px;
				margin-top: 3px;
			}

			.speaking-slider-dot {
				width: 7px;
				height: 7px;

				padding: 0;
				border: 0;
				border-radius: 50%;

				background: rgba(16, 43, 70, 0.23);

				cursor: pointer;

				transition:
					width 200ms ease,
					background 200ms ease,
					border-radius 200ms ease;
			}

			.speaking-slider-dot.is-active {
				width: 23px;
				border-radius: 999px;
				background: #102b46;
			}

			.speaking-slider-dot:focus-visible {
				outline: 2px solid #6fa7ef;
				outline-offset: 4px;
			}


			/* =========================================================
			   CLOSING THESIS
			========================================================= */

			.speaking-closing {
				width: 100%;
				margin: 14px auto 0;
				padding-bottom: 0;

				text-align: center;
			}

			.speaking-closing-title {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;

				color: #102b46;

				font-size: clamp(2rem, 3.1vw, 3.25rem);
				font-weight: 700;
				line-height: 1.08;
				letter-spacing: -0.05em;

				white-space: nowrap;
			}

			.speaking-closing-title::after {
				content: none;
				display: none;
			}

			.speaking-closing-rotating {
				display: inline-block;
				color: #6fa7ef;
				transition: color 180ms ease;
			}

			.speaking-closing-rotating::after {
				content: '';
				display: inline-block;
				width: 0.07em;
				height: 0.82em;
				margin-left: 0.07em;
				vertical-align: -0.02em;
				background: currentColor;
				animation: speaking-closing-cursor 760ms step-end infinite;
			}

			@keyframes speaking-closing-cursor {
				0%, 48% { opacity: 1; }
				49%, 100% { opacity: 0; }
			}

			.speaking-closing-link {
				max-width: none;
				margin: 22px 0 0;
				text-align: center;
			}


			/* =========================================================
			   TALK THESIS + TAKEAWAYS
			========================================================= */

			.speaking-thesis-intro {
				width: 100%;
				max-width: 1000px;
				margin: 24px auto 0;
				padding: 0;
			}

			.speaking-thesis-research {
				margin: 0 auto;
				text-align: center;
				color: #8b97a4;
				font-size: 0.96rem;
				line-height: 1.5;
			}

			.speaking-thesis-research a {
				display: inline;
				color: #102b46;
				font-size: inherit;
				font-weight: 650;
				text-decoration: none;
				border-bottom: 0;
				transition: color 180ms ease;
			}

			.speaking-thesis-research a em {
				color: inherit;
				transition: color 180ms ease;
			}

			.speaking-thesis-research a:hover,
			.speaking-thesis-research a:focus-visible {
				color: #6fa7ef;
				border-bottom: 0;
			}

			.speaking-takeaways.page-divider {
				margin-top: calc(var(--divider-space-before) + 30px);
				margin-bottom: 0;
				padding-bottom: 0;
			}

			.speaking-takeaways > h2 {
				margin-bottom: 28px;
			}

			.speaking-takeaway {
				display: grid;
				grid-template-columns: 150px minmax(0, 1fr);
				align-items: center;
				gap: 28px;
				padding: 30px 0;
				border-bottom: 1px solid var(--line);
			}

			.speaking-takeaway:first-of-type {
				padding-top: 4px;
			}

			.speaking-takeaway:last-of-type {
				padding-bottom: 30px;
				border-bottom: 0;
			}

			.speaking-takeaway-number {
				color: var(--navy);
				font-size: clamp(4rem, 7vw, 6.5rem);
				font-weight: 700;
				line-height: 0.9;
				letter-spacing: -0.06em;
				opacity: 0.16;
			}

			.speaking-takeaway .media-content {
				padding-top: 0;
			}

			.speaking-takeaway .media-content h3 {
				margin-bottom: 10px;
			}

			.speaking-takeaway .media-description {
				max-width: 690px;
			}

			@media (max-width: 850px) {
				.speaking-thesis-intro {
					max-width: 720px;
				}
			}

			@media (max-width: 720px) {
				.speaking-thesis-intro {
					margin-top: 24px;
				}

				.speaking-takeaways.page-divider {
					margin-top: calc(var(--divider-space-mobile) + 26px);
				}

				.speaking-takeaways > h2 {
					margin-bottom: 22px;
				}

				.speaking-takeaway {
					grid-template-columns: 72px minmax(0, 1fr);
					align-items: start;
					gap: 18px;
					padding: 26px 0;
				}

				.speaking-takeaway:first-of-type {
					padding-top: 2px;
				}

				.speaking-takeaway:last-of-type {
					padding-bottom: 26px;
				}

				.speaking-takeaway-number {
					padding-top: 4px;
					font-size: 3.4rem;
				}

				.speaking-takeaway .media-content h3 {
					font-size: 1.18rem;
				}

				.speaking-takeaway .media-description {
					font-size: 0.94rem;
					line-height: 1.55;
				}
			}


			/* =========================================================
			   SELECTED APPEARANCES
			========================================================= */

			.media-list.page-divider {
				padding-top: var(--divider-space-after);
			}

			.media-item .media-title-compact {
				font-size: clamp(1rem, 1.45vw, 1.25rem);
				line-height: 1.16;
				letter-spacing: -0.035em;
				white-space: nowrap;
			}


			/* =========================================================
			   SPEAKING INQUIRIES
			========================================================= */

			.speaking-inquiry-action {
				margin: 18px 0 0;
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.speaking-hero {
					padding-top: 8px;
					padding-bottom: 22px;
				}

				.speaking-hero-title {
					font-size: clamp(1.95rem, 7.8vw, 2.65rem);
					line-height: 1.1;
				}

				.speaking-hero-title .hero-line {
					white-space: normal;
				}

				.speaking-talk-link {
					margin: -2px auto 14px;
				}

				.speaking-slider-stage {
					border-radius: 10px;
				}

				.speaking-slide {
					inset: 8px;
				}

				.speaking-slider-nav {
					height: 26px;
					margin-top: 2px;
				}

				.speaking-closing {
					margin-top: 12px;
				}

				.speaking-closing-title {
					font-size: clamp(1.9rem, 7.4vw, 2.5rem);
					font-weight: 700;
					line-height: 1.08;
					white-space: normal;
				}

				.speaking-closing-link {
					margin-top: 18px;
				}

				.media-list.page-divider {
					padding-top: var(--divider-space-mobile);
				}

				.media-item .media-title-compact {
					font-size: 1.08rem;
					white-space: normal;
				}
			}


			/* =========================================================
			   REDUCED MOTION
			========================================================= */

			@media (prefers-reduced-motion: reduce) {
				.speaking-closing-rotating::after {
					display: none;
					animation: none;
				}

				.speaking-hero-accent {
					opacity: 1;
					transform: none;
					animation: none;
				}

				.speaking-slide,
				.speaking-slider-dot {
					transition: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main class="speaking-page">

			<section class="hero speaking-hero">
				<h1 class="hero-title speaking-hero-title">

					<span class="hero-line">
						¿Y si tu próxima decisión
					</span>

					<span class="hero-line">
						tecnológica comenzara
					</span>

					<span class="hero-line">
						<span class="speaking-hero-accent">
							sin tecnología?
						</span>
					</span>

				</h1>
			</section>


			<section
				class="speaking-showcase reveal-section"
				aria-label="Slides de la presentación"
			>
				<div
					class="speaking-slider reveal-item"
					data-speaking-slider
				>

					<div class="speaking-slider-stage">

						<figure
							class="speaking-slide is-active"
							data-speaking-slide
							aria-hidden="false"
						>
							<img
								class="speaking-slide-image"
								src="/images/speaking-cover-es.png"
								alt="Sistema nuevo rodeado de procesos, integraciones, excepciones y dependencias"
								loading="eager"
							/>
						</figure>

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/talk-slide-2-es.png"
								alt="Lock-in: más dependencias, menos opciones"
								loading="lazy"
							/>
						</figure>

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/talk-slide-3-es.png"
								alt="¿Por qué invertir en tecnología? Para cambiar algo que importe"
								loading="lazy"
							/>
						</figure>

					</div>


					<div
						class="speaking-slider-nav"
						aria-label="Elegir slide"
					>
						<button
							type="button"
							class="speaking-slider-dot is-active"
							data-speaking-dot="0"
							aria-label="Mostrar slide 1"
							aria-current="true"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="1"
							aria-label="Mostrar slide 2"
							aria-current="false"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="2"
							aria-label="Mostrar slide 3"
							aria-current="false"
						></button>
					</div>

				</div>
			</section>


			<section
				class="speaking-closing reveal-section"
				aria-labelledby="speaking-closing-title"
			>
				<h2
					id="speaking-closing-title"
					class="speaking-closing-title reveal-item"
				>
					<span data-speaking-closing-article>La</span>
					<span class="speaking-closing-rotating" data-speaking-closing-rotating>tecnología</span>
					nunca <span data-speaking-closing-verb>es</span> el punto de partida
				</h2>
			</section>

			<section class="speaking-thesis-intro reveal-section">
				<p class="speaking-thesis-research reveal-item">
					Basado en mi paper
					<a href="/es/books/#research"><em>Cuando los arreglos se convierten en el sistema</em></a>
				</p>
			</section>

			<section
				class="speaking-takeaways page-divider reveal-section"
				aria-labelledby="speaking-takeaways-title"
			>

				<h2 id="speaking-takeaways-title" class="reveal-item">
					Qué te llevás de esta charla
				</h2>


				<article class="speaking-takeaway reveal-item reveal-delay-1">
					<div class="speaking-takeaway-number">01</div>

					<div class="media-content">
						<h3>Cuando una solución funciona, puede convertirse en el sistema</h3>
						<p class="media-description">
							Procesos, integraciones, excepciones y parches empiezan a crecer alrededor
							de una solución que funciona. Con el tiempo, esas dependencias pasan a
							formar parte del sistema y hacen que el próximo cambio sea más difícil
						</p>
					</div>
				</article>


				<article class="speaking-takeaway reveal-item reveal-delay-2">
					<div class="speaking-takeaway-number">02</div>

					<div class="media-content">
						<h3>El lock-in aparece antes de que algo parezca estar roto</h3>
						<p class="media-description">
							Cómo un sistema puede seguir funcionando durante años mientras se acumulan
							dependencias, cambiarlo se vuelve cada vez más difícil y las opciones
							desaparecen, hasta que nadie sabe del todo qué depende de qué ni qué se
							puede cambiar sin romper otra cosa
						</p>
					</div>
				</article>


				<article class="speaking-takeaway reveal-item reveal-delay-2">
					<div class="speaking-takeaway-number">03</div>

					<div class="media-content">
						<h3>Empezar por las personas y el problema de negocio</h3>
						<p class="media-description">
							Por qué los líderes deberían mantener la decisión abierta el tiempo suficiente
							para entender a las personas, el problema y el resultado esperado
							antes de decidir qué rol debería jugar la tecnología
						</p>
					</div>
				</article>

			</section>

			<section
				class="media-list page-divider reveal-section"
				aria-labelledby="media-list-title"
			>
				<h2
					id="media-list-title"
					class="reveal-item"
				>
					Participaciones destacadas
				</h2>


				{
					mediaItems.map((item, index) => (

						<article
							class="media-item"
							style={`--media-index: ${index};`}
						>

							<div class="media-image-wrapper">

								{
									item.url ? (

										<a
											href={item.url}
											target={
												item.internal
													? undefined
													: '_blank'
											}
											rel={
												item.internal
													? undefined
													: 'noopener noreferrer'
											}
											aria-label={
												item.linkLabel ??
												item.title
											}
										>
											<img
												src={item.image}
												alt={item.imageAlt}
												class="media-image"
												loading="lazy"
											/>
										</a>

									) : (

										<img
											src={item.image}
											alt={item.imageAlt}
											class="media-image"
											loading="lazy"
										/>

									)
								}

							</div>


							<div class="media-content">

								<p class="media-meta">

									<span>{item.type}</span>

									<span aria-hidden="true">
										·
									</span>

									<span>{item.date}</span>

								</p>


								<h3
									class={
										item.compactTitle
											? 'media-title-compact'
											: undefined
									}
								>
									{item.title}
								</h3>


								<p class="media-description">
									{item.description}
								</p>


								{
									item.url ? (

										<div class="media-action">

											{
												item.pdfUrl &&
													item.pdfLabel && (

														<a
															href={item.pdfUrl}
															target="_blank"
															rel="noopener noreferrer"
															class="animated-link"
														>
															<span>
																{item.pdfLabel}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>
														</a>

													)
											}


											<a
												href={item.url}
												target={
													item.internal
														? undefined
														: '_blank'
												}
												rel={
													item.internal
														? undefined
														: 'noopener noreferrer'
												}
												class="animated-link"
											>
												<span>
													{
														item.linkLabel ??
															'Conocer más'
													}
												</span>

												<span
													class="animated-link-arrow"
													aria-hidden="true"
												>
													→
												</span>
											</a>

										</div>

									) : (

										item.status === 'upcoming' && (

											<p class="media-coming-soon">
												Próximamente
											</p>

										)

									)
								}

							</div>

						</article>

					))
				}

			</section>


			<section class="page-closing reveal-section">

				<h2 class="reveal-item">
					Consultas de Speaking
				</h2>

				<div class="reveal-item reveal-delay-1">

					<p>
						Para conferencias, eventos de liderazgo, sesiones ejecutivas,
						podcasts u otras oportunidades de speaking, contáctame
					</p>

					<p class="speaking-inquiry-action">
						<a
							href="/es/contact/"
							class="animated-link"
						>
							<span>Contáctame</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>

				</div>

			</section>

		</main>


		<Footer />


		<script>
			const closingRotatingWord =
				document.querySelector('[data-speaking-closing-rotating]');
			const closingArticle =
				document.querySelector('[data-speaking-closing-article]');
			const closingVerb =
				document.querySelector('[data-speaking-closing-verb]');

			if (
				closingRotatingWord &&
				closingArticle &&
				closingVerb &&
				!window.matchMedia('(prefers-reduced-motion: reduce)').matches
			) {
				const words = [
					{ label: 'tecnología', article: 'La', verb: 'es', color: '#6fa7ef' },
					{ label: 'IA', article: 'La', verb: 'es', color: '#7c3aed' },
					{ label: 'datos', article: 'Los', verb: 'son', color: '#0f766e' },
					{ label: 'nube', article: 'La', verb: 'es', color: '#c53030' },
					{ label: 'ERP', article: 'El', verb: 'es', color: '#b45309' }
				];
				const typeDelay = 125;
				const deleteDelay = 65;
				const holdDelay = 2000;
				const gapDelay = 300;

				let wordIndex = 0;
				let characterIndex = words[0].label.length;
				let deleting = true;

				const step = () => {
					const word = words[wordIndex].label;

					if (deleting) {
						characterIndex = Math.max(0, characterIndex - 1);
						closingRotatingWord.textContent = word.slice(0, characterIndex);

						if (characterIndex === 0) {
							wordIndex = (wordIndex + 1) % words.length;
							closingArticle.textContent = words[wordIndex].article;
							closingVerb.textContent = words[wordIndex].verb;
							closingRotatingWord.style.color = words[wordIndex].color;
							deleting = false;
							window.setTimeout(step, gapDelay);
							return;
						}

						window.setTimeout(step, deleteDelay);
						return;
					}

					const nextWord = words[wordIndex].label;
					characterIndex = Math.min(nextWord.length, characterIndex + 1);
					closingRotatingWord.textContent = nextWord.slice(0, characterIndex);

					if (characterIndex === nextWord.length) {
						deleting = true;
						window.setTimeout(step, holdDelay);
						return;
					}

					window.setTimeout(step, typeDelay);
				};

				window.setTimeout(step, holdDelay);
			}
		</script>


		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.08,
							rootMargin:
								'0px 0px -50px 0px'
						}
					);


				sections.forEach((section) => {
					revealObserver.observe(section);
				});

			} else {

				sections.forEach((section) => {
					section.classList.add(
						'is-visible'
					);
				});

			}
		</script>


		<script>
			const speakingSlider =
				document.querySelector(
					'[data-speaking-slider]'
				);

			if (speakingSlider) {

				const slides = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-slide]'
					)
				);

				const dots = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-dot]'
					)
				);

				const reducedMotion =
					window.matchMedia(
						'(prefers-reduced-motion: reduce)'
					).matches;

				let currentSlide = 0;
				let slideTimer = null;
				let sliderVisible = false;

				const durations = [
					7000,
					5200,
					5200
				];


				function showSlide(index) {

					currentSlide =
						(index + slides.length) %
						slides.length;


					slides.forEach(
						(slide, slideIndex) => {

							const active =
								slideIndex ===
								currentSlide;

							slide.classList.toggle(
								'is-active',
								active
							);

							slide.setAttribute(
								'aria-hidden',
								active
									? 'false'
									: 'true'
							);

						}
					);


					dots.forEach(
						(dot, dotIndex) => {

							const active =
								dotIndex ===
								currentSlide;

							dot.classList.toggle(
								'is-active',
								active
							);

							dot.setAttribute(
								'aria-current',
								active
									? 'true'
									: 'false'
							);

						}
					);

				}


				function stopSlider() {

					if (!slideTimer) {
						return;
					}

					window.clearTimeout(
						slideTimer
					);

					slideTimer = null;
				}


				function scheduleNextSlide() {

					if (
						reducedMotion ||
						!sliderVisible
					) {
						return;
					}

					stopSlider();

					slideTimer =
						window.setTimeout(
							() => {

								showSlide(
									currentSlide + 1
								);

								scheduleNextSlide();

							},
							durations[currentSlide]
						);

				}


				dots.forEach(
					(dot, index) => {

						dot.addEventListener(
							'click',
							() => {

								showSlide(index);
								scheduleNextSlide();

							}
						);

					}
				);


				speakingSlider.addEventListener(
					'mouseenter',
					stopSlider
				);

				speakingSlider.addEventListener(
					'mouseleave',
					scheduleNextSlide
				);


				if ('IntersectionObserver' in window) {

					const sliderObserver =
						new IntersectionObserver(
							(entries) => {

								entries.forEach(
									(entry) => {

										sliderVisible =
											entry.isIntersecting;

										if (sliderVisible) {
											scheduleNextSlide();
										} else {
											stopSlider();
										}

									}
								);

							},
							{
								threshold: 0.35
							}
						);


					sliderObserver.observe(
						speakingSlider
					);

				} else {

					sliderVisible = true;
					scheduleNextSlide();

				}


				document.addEventListener(
					'visibilitychange',
					() => {

						if (document.hidden) {
							stopSlider();
						} else {
							scheduleNextSlide();
						}

					}
				);

			}
		</script>

	</body>
</html>
