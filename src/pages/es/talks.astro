---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const youtubeEmbedUrl =
	'https://www.youtube.com/embed/ZN-d5W68Lp8';
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="La tecnología nunca es el punto de partida | Fede Rodrigo"
			description="Una charla sobre cómo decisiones tecnológicas razonables pueden convertirse en dependencias, generar lock-in y reducir las opciones futuras, y por qué los líderes deberían empezar por las personas y el problema de negocio antes de elegir tecnología"
			lang="es"
		/>

		<style>
			/* =========================================================
			   TALKS PAGE
			========================================================= */

			.talks-page {
				padding-top: 46px;
			}


			/* =========================================================
			   HERO
			========================================================= */

			.talks-hero {
				display: block;

				width: 100%;
				max-width: none;

				margin: 0 auto;

				padding: 0 0 24px;

				border-bottom: 0;

				text-align: center;
			}

			.talks-hero-title {
				width: 100%;
				max-width: 850px;

				margin: 0 auto;

				font-size: clamp(2.4rem, 4.8vw, 4.7rem);
				font-weight: 800;
				line-height: 1.03;
				letter-spacing: -0.055em;

				text-align: center;
			}

			.talks-hero-title .hero-line {
				display: block;
				width: 100%;
			}

			.talks-nunca {
				color: #6fa7ef;
			}


			/* =========================================================
			   PRINCIPLES
			========================================================= */

			.talks-principles {
				display: flex;
				align-items: center;
				justify-content: center;
				flex-wrap: wrap;

				gap: 8px;

				width: 100%;
				max-width: 850px;

				margin: 22px auto 0;

				color: #6f7d8f;

				font-size: 0.82rem;
				font-weight: 650;
				line-height: 1.4;
				letter-spacing: 0.045em;

				text-align: center;
				text-transform: uppercase;
			}

			.talks-principles span:nth-child(2),
			.talks-principles span:nth-child(4) {
				color: #b3bdc7;
			}


			/* =========================================================
			   INTRO
			========================================================= */

			.talks-intro {
				width: 100%;
				max-width: 1000px;

				margin: 44px auto 42px;
				padding: 0;
			}

			.talks-intro-inner {
				display: grid;

				grid-template-columns:
					minmax(0, 0.9fr)
					minmax(0, 1.1fr);

				align-items: start;

				gap: 80px;

				width: 100%;
			}

			.talks-lead {
				max-width: 390px;

				margin: 0;

				color: #102b46;

				font-size: clamp(1.35rem, 2vw, 1.7rem);
				font-weight: 650;
				line-height: 1.35;
				letter-spacing: -0.035em;
			}

			.talks-intro-response {
				max-width: 500px;
				padding-top: 2px;
			}

			.talks-description {
				max-width: 500px;

				margin: 0;

				color: #6f7d8f;

				font-size: clamp(1rem, 1.25vw, 1.12rem);
				line-height: 1.6;
				letter-spacing: -0.014em;
			}

			.talks-description strong {
				display: block;

				margin-bottom: 8px;

				color: #102b46;
				font-size: 1.05em;
				font-weight: 700;
				line-height: 1.4;
			}


			/* =========================================================
			   SECONDARY LINKS
			========================================================= */

			.talks-secondary-links {
				display: flex;
				align-items: center;
				flex-wrap: wrap;

				gap: 24px;

				margin-top: 22px;
			}


			/* =========================================================
			   VIDEO
			========================================================= */

			.talks-video-section {
				margin: 0;
				padding: 0;
			}

			.talks-video-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				flex-wrap: wrap;

				gap: 10px;

				margin: 0 0 14px;
			}

			.talks-video-label {
				margin: 0;

				color: #102b46;

				font-size: 0.8rem;
				font-weight: 750;
				line-height: 1.3;
				letter-spacing: 0.075em;

				text-transform: uppercase;
			}

			.talks-video-note {
				margin: 0;

				color: #8b97a4;

				font-size: 0.82rem;
				line-height: 1.4;
			}

			.talks-video {
				width: 100%;

				aspect-ratio: 16 / 9;

				overflow: hidden;

				border-radius: 14px;

				background: #000000;

				box-shadow:
					0 14px 34px rgba(16, 42, 67, 0.08);
			}

			.talks-video iframe {
				display: block;

				width: 100%;
				height: 100%;

				border: 0;
			}


			/* =========================================================
			   TAKEAWAYS
			========================================================= */

			.talks-takeaways {
				margin-top: 38px;
				margin-bottom: 0;

				padding-top: 0;
				padding-bottom: 0;
			}

			.talks-takeaways > h2 {
				margin-bottom: 28px;
			}

			.talks-takeaway {
				display: grid;

				grid-template-columns:
					150px
					minmax(0, 1fr);

				align-items: center;

				gap: 28px;

				padding: 30px 0;

				border-bottom: 1px solid var(--line);
			}

			.talks-takeaway:first-of-type {
				padding-top: 4px;
			}

			.talks-takeaway:last-of-type {
				padding-bottom: 30px;
				border-bottom: 0;
			}

			.talks-takeaway-number {
				color: var(--navy);

				font-size: clamp(4rem, 7vw, 6.5rem);
				font-weight: 700;
				line-height: 0.9;
				letter-spacing: -0.06em;

				opacity: 0.16;
			}

			.talks-takeaway .media-content {
				padding-top: 0;
			}

			.talks-takeaway .media-content h3 {
				margin-bottom: 10px;
			}

			.talks-takeaway .media-description {
				max-width: 690px;
			}


			/* =========================================================
			   SPEAKING INQUIRIES
			========================================================= */

			.talks-contact {
				margin-top: var(--divider-space-before);

				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);
			}

			.talks-contact-title {
				margin-bottom: 10px;
			}

			.talks-contact-copy {
				max-width: 650px;

				margin: 0;

				color: var(--muted);
			}

			.talks-contact-link {
				margin: 18px 0 0;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 850px) {
				.talks-intro-inner {
					grid-template-columns: 1fr;

					gap: 22px;
				}

				.talks-intro {
					max-width: 720px;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.talks-page {
					padding-top: 42px;
				}

				.talks-hero {
					padding-bottom: 22px;
				}

				.talks-hero-title {
					font-size: clamp(2.3rem, 11vw, 3.15rem);
					line-height: 1.04;
				}

				.talks-principles {
					gap: 6px;

					margin-top: 18px;

					font-size: 0.74rem;
					line-height: 1.45;
				}


				/* INTRO */

				.talks-intro {
					margin-top: 6px;
					margin-bottom: 28px;
				}

				.talks-intro-inner {
					gap: 20px;
				}

				.talks-lead {
					font-size: 1.2rem;
					line-height: 1.42;
				}

				.talks-description {
					font-size: 1rem;
					line-height: 1.58;
				}

				.talks-secondary-links {
					flex-direction: column;
					align-items: flex-start;

					gap: 10px;

					margin-top: 18px;
				}


				/* VIDEO */

				.talks-video-heading {
					display: block;
					margin-bottom: 12px;
				}

				.talks-video-note {
					margin-top: 4px;
				}

				.talks-video {
					border-radius: 10px;
				}


				/* TAKEAWAYS */

				.talks-takeaways {
					margin-top: 32px;
				}

				.talks-takeaways > h2 {
					margin-bottom: 22px;
				}

				.talks-takeaway {
					grid-template-columns:
						72px
						minmax(0, 1fr);

					align-items: start;

					gap: 18px;

					padding: 26px 0;
				}

				.talks-takeaway:first-of-type {
					padding-top: 2px;
				}

				.talks-takeaway:last-of-type {
					padding-bottom: 26px;
				}

				.talks-takeaway-number {
					padding-top: 4px;

					font-size: 3.4rem;
				}

				.talks-takeaway .media-content h3 {
					font-size: 1.18rem;
				}

				.talks-takeaway .media-description {
					font-size: 0.94rem;
					line-height: 1.55;
				}


				/* SPEAKING INQUIRIES */

				.talks-contact {
					margin-top: var(--divider-space-mobile);

					padding-top: var(--divider-space-mobile);
				}
			}
		</style>
	</head>


	<body>
		<Header />


		<main class="talks-page">

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero talks-hero">

				<h1 class="hero-title talks-hero-title">

					<span class="hero-line">
						La tecnología
						<span class="talks-nunca">
							nunca
						</span>
					</span>

					<span class="hero-line">
						es el punto de partida
					</span>

				</h1>


				<div class="talks-principles">

					<span>
						Primero las Personas
					</span>

					<span aria-hidden="true">
						·
					</span>

					<span>
						Orientado al Negocio
					</span>

					<span aria-hidden="true">
						·
					</span>

					<span>
						Habilitado por la Tecnología
					</span>

				</div>

			</section>


			<!-- =====================================================
			     INTRO
			===================================================== -->

			<section class="talks-intro reveal-section">

				<div class="talks-intro-inner">

					<p class="talks-lead reveal-item">
						Las decisiones tecnológicas más peligrosas no siempre
						son las que fracasan
					</p>


					<div
						class="talks-intro-response reveal-item reveal-delay-1"
					>

						<p class="talks-description">

							<strong>
								A veces, son las que funcionan
							</strong>

							Se adoptan, crecen dependencias a su alrededor
							y, con el tiempo, la organización termina eligiendo
							entre las opciones que todavía siguen siendo posibles

						</p>


						<div class="talks-secondary-links">

							<a
								href="/es/contact/"
								class="animated-link"
							>
								<span>
									Consultas de speaking
								</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>


							<a
								href="/es/about/"
								class="animated-link"
							>
								<span>
									Sobre Federico
								</span>
							</a>

						</div>

					</div>

				</div>

			</section>


			<!-- =====================================================
			     VIDEO
			===================================================== -->

			<section
				class="talks-video-section reveal-section"
				aria-label="Muestra de speaking"
			>

				<div class="talks-video-heading reveal-item">

					<p class="talks-video-label">
						Muestra de speaking
					</p>

					<p class="talks-video-note">
						Una versión anterior de la charla
					</p>

				</div>


				<div
					class="talks-video reveal-item reveal-delay-1"
				>
					<iframe
						src={youtubeEmbedUrl}
						title="La tecnología Never the Starting Point — speaking sample"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>
				</div>

			</section>


			<!-- =====================================================
			     TAKEAWAYS
			===================================================== -->

			<section
				class="talks-takeaways reveal-section"
				aria-labelledby="takeaways-title"
			>

				<h2
					id="takeaways-title"
					class="reveal-item"
				>
					Qué te llevás de esta charla
				</h2>


				<!-- 01 -->

				<article
					class="talks-takeaway reveal-item reveal-delay-1"
				>

					<div class="talks-takeaway-number">
						01
					</div>


					<div class="media-content">

						<h3>
							Cuando una solución funciona, puede convertirse en el sistema
						</h3>

						<p class="media-description">
							Por qué los arreglos que funcionan y las decisiones tecnológicas
							razonables pueden crear silenciosamente dependencias que terminan
							formando parte del propio sistema
						</p>

					</div>

				</article>


				<!-- 02 -->

				<article
					class="talks-takeaway reveal-item reveal-delay-2"
				>

					<div class="talks-takeaway-number">
						02
					</div>


					<div class="media-content">

						<h3>
							El lock-in aparece antes de que algo parezca estar roto
						</h3>

						<p class="media-description">
							Cómo un sistema puede seguir funcionando durante años mientras
							el costo, la complejidad y el riesgo de cambiarlo siguen creciendo
							y las opciones futuras empiezan a desaparecer
						</p>

					</div>

				</article>


				<!-- 03 -->

				<article
					class="talks-takeaway reveal-item reveal-delay-2"
				>

					<div class="talks-takeaway-number">
						03
					</div>


					<div class="media-content">

						<h3>
							Empezar por las personas y el problema de negocio
						</h3>

						<p class="media-description">
							Por qué los líderes deberían mantener la decisión abierta el tiempo suficiente
							para entender a las personas, el problema y el resultado esperado
							antes de decidir qué rol debería jugar la tecnología
						</p>

					</div>

				</article>


				<!-- =================================================
				     SPEAKING INQUIRIES
				================================================= -->

				<div class="talks-contact reveal-item">

					<h2 class="talks-contact-title">
						Consultas de Speaking
					</h2>


					<p class="talks-contact-copy">
						Para conferencias, eventos de liderazgo, sesiones ejecutivas,
						podcasts u otras oportunidades de speaking, contáctame
					</p>


					<p class="talks-contact-link">

						<a
							href="/es/contact/"
							class="animated-link"
						>
							<span>
								Contáctame
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>

					</p>

				</div>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll(
					'.reveal-section'
				);


			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}


								entry.target.classList.add(
									'is-visible'
								);


								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.08,

							rootMargin:
								'0px 0px -50px 0px',
						}
					);


				sections.forEach((section) => {

					revealObserver.observe(
						section
					);

				});

			} else {

				sections.forEach((section) => {

					section.classList.add(
						'is-visible'
					);

				});

			}
		</script>

	</body>
</html>

