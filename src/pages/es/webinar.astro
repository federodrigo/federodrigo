---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const youtubeEmbedUrl =
	'https://www.youtube.com/embed/ZN-d5W68Lp8';
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="La tecnología nunca es el punto de partida | Fede Rodrigo"
			description="Las iniciativas tecnológicas suelen comenzar con una solución en lugar de la necesidad del negocio. Comienza con las personas y las prioridades del negocio, y utiliza la tecnología para habilitar el resultado."
			lang="es"
		/>

		<style>
			/* =========================================================
			   WEBINAR PAGE
			========================================================= */

			.webinar-page {
				padding-top: 46px;
			}


			/* =========================================================
			   HERO
			========================================================= */

			.webinar-hero {
				display: block;

				width: 100%;
				max-width: none;

				margin: 0 auto;

				padding: 0 0 24px;

				border-bottom: 0;

				text-align: center;
			}

			.webinar-hero-title {
				width: 100%;
				max-width: 850px;

				margin: 0 auto;

				font-size: clamp(2.4rem, 4.8vw, 4.7rem);
				font-weight: 800;
				line-height: 1.03;
				letter-spacing: -0.055em;

				text-align: center;
			}

			.webinar-hero-title .hero-line {
				display: block;
				width: 100%;
			}

			.webinar-never {
				color: #6fa7ef;
			}


			/* =========================================================
			   PRINCIPLES
			========================================================= */

			.webinar-principles {
				display: flex;
				align-items: center;
				justify-content: center;
				flex-wrap: wrap;

				gap: 8px;

				width: 100%;
				max-width: 850px;

				margin: 22px auto 0;

				color: #6f7d8f;

				font-size: 0.82rem;
				font-weight: 650;
				line-height: 1.4;
				letter-spacing: 0.045em;

				text-align: center;
				text-transform: uppercase;
			}

			.webinar-principles span:nth-child(2),
			.webinar-principles span:nth-child(4) {
				color: #b3bdc7;
			}


			/* =========================================================
			   INTRO
			========================================================= */

			.webinar-intro {
				width: 100%;

				margin: 12px auto 30px;
				padding: 0;
			}

			.webinar-intro-inner {
				display: grid;

				grid-template-columns:
					minmax(0, 0.92fr)
					minmax(0, 1.08fr);

				align-items: start;

				gap: 54px;

				width: 100%;
			}

			.webinar-lead {
				max-width: none;

				margin: 0;

				color: #102b46;

				font-size: clamp(1.25rem, 1.75vw, 1.5rem);
				font-weight: 620;
				line-height: 1.42;
				letter-spacing: -0.032em;
			}

			.webinar-intro-response {
				padding-top: 2px;
			}

			.webinar-description {
				max-width: none;

				margin: 0;

				color: #6f7d8f;

				font-size: clamp(1.02rem, 1.35vw, 1.15rem);
				line-height: 1.62;
				letter-spacing: -0.014em;
			}

			.webinar-description strong {
				color: #102b46;
				font-weight: 700;
			}


			/* =========================================================
			   SECONDARY LINKS
			========================================================= */

			.webinar-secondary-links {
				display: flex;
				align-items: center;
				flex-wrap: wrap;

				gap: 24px;

				margin-top: 20px;
			}


			/* =========================================================
			   VIDEO
			========================================================= */

			.webinar-video-section {
				margin: 0;
				padding: 0;
			}

			.webinar-video {
				width: 100%;

				aspect-ratio: 16 / 9;

				overflow: hidden;

				border-radius: 14px;

				background: #000000;

				box-shadow:
					0 14px 34px rgba(16, 42, 67, 0.08);
			}

			.webinar-video iframe {
				display: block;

				width: 100%;
				height: 100%;

				border: 0;
			}


			/* =========================================================
			   TAKEAWAYS
			========================================================= */

			.webinar-takeaways {
				margin-top: 38px;
				margin-bottom: 0;

				padding-top: 0;
				padding-bottom: 0;
			}

			.webinar-takeaways > h2 {
				margin-bottom: 28px;
			}

			.webinar-takeaway {
				display: grid;

				grid-template-columns:
					150px
					minmax(0, 1fr);

				align-items: center;

				gap: 28px;

				padding: 30px 0;

				border-bottom: 1px solid var(--line);
			}

			.webinar-takeaway:first-of-type {
				padding-top: 4px;
			}

			.webinar-takeaway:last-of-type {
				padding-bottom: 30px;
				border-bottom: 0;
			}

			.webinar-takeaway-number {
				color: var(--navy);

				font-size: clamp(4rem, 7vw, 6.5rem);
				font-weight: 700;
				line-height: 0.9;
				letter-spacing: -0.06em;

				opacity: 0.16;
			}

			.webinar-takeaway .media-content {
				padding-top: 0;
			}

			.webinar-takeaway .media-content h3 {
				margin-bottom: 10px;
			}

			.webinar-takeaway .media-description {
				max-width: 650px;
			}


			/* =========================================================
			   SPEAKING INQUIRIES
			========================================================= */

			.webinar-contact {
				margin-top: var(--divider-space-before);

				padding-top: var(--divider-space-after);
				padding-bottom: 0;

				border-top: 1px solid var(--line);
			}

			.webinar-contact-title {
				margin-bottom: 10px;
			}

			.webinar-contact-copy {
				max-width: 650px;

				margin: 0;

				color: var(--muted);
			}

			.webinar-contact-link {
				margin: 18px 0 0;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 850px) {
				.webinar-intro-inner {
					grid-template-columns: 1fr;

					gap: 22px;
				}

				.webinar-intro {
					max-width: 720px;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.webinar-page {
					padding-top: 42px;
				}

				.webinar-hero {
					padding-bottom: 22px;
				}

				.webinar-hero-title {
					font-size: clamp(2.3rem, 11vw, 3.15rem);
					line-height: 1.04;
				}

				.webinar-principles {
					gap: 6px;

					margin-top: 18px;

					font-size: 0.74rem;
					line-height: 1.45;
				}


				/* INTRO */

				.webinar-intro {
					margin-top: 6px;
					margin-bottom: 28px;
				}

				.webinar-intro-inner {
					gap: 20px;
				}

				.webinar-lead {
					font-size: 1.2rem;
					line-height: 1.42;
				}

				.webinar-description {
					font-size: 1rem;
					line-height: 1.58;
				}

				.webinar-secondary-links {
					flex-direction: column;
					align-items: flex-start;

					gap: 10px;

					margin-top: 18px;
				}


				/* VIDEO */

				.webinar-video {
					border-radius: 10px;
				}


				/* TAKEAWAYS */

				.webinar-takeaways {
					margin-top: 32px;
				}

				.webinar-takeaways > h2 {
					margin-bottom: 22px;
				}

				.webinar-takeaway {
					grid-template-columns:
						72px
						minmax(0, 1fr);

					align-items: start;

					gap: 18px;

					padding: 26px 0;
				}

				.webinar-takeaway:first-of-type {
					padding-top: 2px;
				}

				.webinar-takeaway:last-of-type {
					padding-bottom: 26px;
				}

				.webinar-takeaway-number {
					padding-top: 4px;

					font-size: 3.4rem;
				}

				.webinar-takeaway .media-content h3 {
					font-size: 1.18rem;
				}

				.webinar-takeaway .media-description {
					font-size: 0.94rem;
					line-height: 1.55;
				}


				/* SPEAKING INQUIRIES */

				.webinar-contact {
					margin-top: var(--divider-space-mobile);

					padding-top: var(--divider-space-mobile);
				}
			}
		</style>
	</head>


	<body>
		<Header />


		<main class="webinar-page">

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero webinar-hero">

				<h1 class="hero-title webinar-hero-title">

					<span class="hero-line">
						La tecnología
						<span class="webinar-never">
							nunca
						</span>
					</span>

					<span class="hero-line">
						es el punto de partida
					</span>

				</h1>


				<div class="webinar-principles">

					<span>
						Personas Primero
					</span>

					<span aria-hidden="true">
						·
					</span>

					<span>
						Orientado al Negocio
					</span>

					<span aria-hidden="true">
						·
					</span>

					<span>
						Tecnología como Habilitador
					</span>

				</div>

			</section>


			<!-- =====================================================
			     INTRO
			===================================================== -->

			<section class="webinar-intro reveal-section">

				<div class="webinar-intro-inner">

					<p class="webinar-lead reveal-item">
						Las iniciativas tecnológicas suelen comenzar con una solución
						en lugar de la necesidad del negocio que existe detrás
					</p>


					<div
						class="webinar-intro-response reveal-item reveal-delay-1"
					>

						<p class="webinar-description">
							<strong>
								Esta charla explora un enfoque diferente:
							</strong>

							<br />

							comenzar con las personas y las prioridades del negocio,

							<br />

							y luego utilizar la tecnología para habilitar el resultado
						</p>


						<div class="webinar-secondary-links">

							<a
								href="/es/about/"
								class="animated-link"
							>
								<span>
									Sobre Federico
								</span>
							</a>


							<a
								href="/es/books/"
								class="animated-link"
							>
								<span>
									Explorar el libro
								</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>

						</div>

					</div>

				</div>

			</section>


			<!-- =====================================================
			     VIDEO
			===================================================== -->

			<section
				class="webinar-video-section reveal-section"
				aria-label="Video de La tecnología nunca es el punto de partida"
			>

				<div
					class="webinar-video reveal-item"
				>
					<iframe
						src={youtubeEmbedUrl}
						title="Technology is Never the Starting Point"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>
				</div>

			</section>


			<!-- =====================================================
			     TAKEAWAYS
			===================================================== -->

			<section
				class="webinar-takeaways reveal-section"
				aria-labelledby="takeaways-title"
			>

				<h2
					id="takeaways-title"
					class="reveal-item"
				>
					Qué te llevarás de esta charla
				</h2>


				<!-- 01 -->

				<article
					class="webinar-takeaway reveal-item reveal-delay-1"
				>

					<div class="webinar-takeaway-number">
						01
					</div>


					<div class="media-content">

						<h3>
							Por qué fracasan las iniciativas tecnológicas
						</h3>

						<p class="media-description">
							Por qué tantas iniciativas no logran entregar
							lo esperado y qué pueden hacer los líderes
							de manera diferente
						</p>

					</div>

				</article>


				<!-- 02 -->

				<article
					class="webinar-takeaway reveal-item reveal-delay-2"
				>

					<div class="webinar-takeaway-number">
						02
					</div>


					<div class="media-content">

						<h3>
							TI como organización de servicio
						</h3>

						<p class="media-description">
							Cómo enfocar TI en las personas y en el
							negocio al que sirve, utilizando el valor
							para el negocio como medida del éxito
						</p>

					</div>

				</article>


				<!-- 03 -->

				<article
					class="webinar-takeaway reveal-item reveal-delay-2"
				>

					<div class="webinar-takeaway-number">
						03
					</div>


					<div class="media-content">

						<h3>
							Liderar en la era de la IA
						</h3>

						<p class="media-description">
							Por qué las herramientas cambian, pero no reemplazan
							el liderazgo, la estrategia, el criterio
							y el entendimiento del negocio
						</p>

					</div>

				</article>


				<!-- =================================================
				     SPEAKING INQUIRIES
				================================================= -->

				<div class="webinar-contact reveal-item">

					<h2 class="webinar-contact-title">
						Consultas de Speaking
					</h2>


					<p class="webinar-contact-copy">
						Para charlas, podcasts u otras oportunidades,
						ponte en contacto
					</p>


					<p class="webinar-contact-link">

						<a
							href="/es/contact/"
							class="animated-link"
						>
							<span>
								Contáctame
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>

					</p>

				</div>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll(
					'.reveal-section'
				);


			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}


								entry.target.classList.add(
									'is-visible'
								);


								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.08,

							rootMargin:
								'0px 0px -50px 0px',
						}
					);


				sections.forEach((section) => {

					revealObserver.observe(
						section
					);

				});

			} else {

				sections.forEach((section) => {

					section.classList.add(
						'is-visible'
					);

				});

			}
		</script>

	</body>
</html>
