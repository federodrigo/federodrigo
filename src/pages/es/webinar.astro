---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const registrationUrl =
	'https://forms.gle/TJEuQGhBCBT8cZx28';

const youtubeEmbedUrl =
	'https://www.youtube.com/embed/ZN-d5W68Lp8';
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="La tecnología nunca es el punto de partida | Webinar | Fede Rodrigo"
			description="Webinar en inglés de Fede Rodrigo el 20 de agosto de 2026 sobre cómo crear valor para el negocio comenzando por las personas y las prioridades del negocio antes que por la tecnología"
			lang="es"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						La tecnología <span class="accent">nunca</span>
					</span>

					<span class="hero-line">
						es el punto de partida
					</span>
				</h1>

				<div class="lead-principles">
					<div>Las Personas Primero</div>
					<div>Impulsado por el Negocio</div>
					<div>Habilitado por la Tecnología</div>
				</div>
			</section>


			<!-- WEBINAR -->
			<section
				class="media-list reveal-section"
				aria-labelledby="webinar-title"
			>
				<h2
					id="webinar-title"
					class="reveal-item"
				>
					Webinar
				</h2>

				<article
					class="media-item webinar-main reveal-item reveal-delay-1"
				>
					<div class="media-image-wrapper">
						<a
							href={registrationUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Registrarse al webinar La tecnología nunca es el punto de partida"
						>
							<img
								src="/images/xseed-webinar.png"
								alt="Webinar Technology is Never the Starting Point con Federico Rodrigo"
								class="media-image"
								loading="lazy"
							/>
						</a>
					</div>

					<div class="media-content">
						<p class="media-meta">
							<span>Xseed</span>
							<span aria-hidden="true">·</span>
							<span>20 de agosto de 2026</span>
							<span aria-hidden="true">·</span>
							<span>Webinar en inglés</span>
						</p>

						<h3>
							Technology is Never the Starting Point
						</h3>

						<div class="webinar-intro">
							<p class="media-description">
								Las iniciativas tecnológicas suelen comenzar
								con una solución en lugar de partir de la
								necesidad real del negocio
							</p>

							<p class="media-description">
								<strong>
									Esta sesión práctica propone un enfoque diferente:
								</strong>
								comenzar por las personas y las prioridades del
								negocio, y recién después usar la tecnología para
								habilitar el resultado
							</p>
						</div>

						<p class="media-meta webinar-schedule">
							Jueves 20 de agosto · 1:00 PM ET · 2:00 PM Uruguay · 1 hora
						</p>

						<div class="media-action">
							<a
								href={registrationUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="animated-link"
							>
								<span>Reservar mi lugar</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</div>

						<div class="webinar-secondary-links">
							<a
								href="/es/about/"
								class="animated-link"
							>
								<span>Sobre Federico</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>

							<a
								href="/es/cio-book/"
								class="animated-link"
							>
								<span>Conocer el libro</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</div>
					</div>
				</article>
			</section>


			<!-- VIDEO -->
			<section
				class="media-list reveal-section"
				aria-labelledby="video-title"
			>
				<h2
					id="video-title"
					class="reveal-item"
				>
					Video
				</h2>

				<div
					class="webinar-video reveal-item reveal-delay-1"
				>
					<iframe
						src={youtubeEmbedUrl}
						title="Technology is Never the Starting Point"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>
				</div>
			</section>


			<!-- TAKEAWAYS -->
			<section
				class="media-list reveal-section"
				aria-labelledby="takeaways-title"
			>
				<h2
					id="takeaways-title"
					class="reveal-item"
				>
					Qué te vas a llevar
				</h2>

				<article
					class="media-item webinar-takeaway reveal-item reveal-delay-1"
				>
					<div class="webinar-takeaway-number">
						01
					</div>

					<div class="media-content">
						<h3>
							Por qué fallan las iniciativas tecnológicas
						</h3>

						<p class="media-description">
							Por qué tantas iniciativas no logran los resultados
							esperados y qué pueden hacer diferente los líderes
						</p>
					</div>
				</article>

				<article
					class="media-item webinar-takeaway reveal-item reveal-delay-2"
				>
					<div class="webinar-takeaway-number">
						02
					</div>

					<div class="media-content">
						<h3>
							IT como organización de servicio
						</h3>

						<p class="media-description">
							Cómo enfocar IT en las personas y el negocio al que
							sirve, usando el valor generado como medida de éxito
						</p>
					</div>
				</article>

				<article
					class="media-item webinar-takeaway reveal-item reveal-delay-3"
				>
					<div class="webinar-takeaway-number">
						03
					</div>

					<div class="media-content">
						<h3>
							Liderar en la era de la IA
						</h3>

						<p class="media-description">
							Por qué las nuevas herramientas no reemplazan el
							liderazgo, la estrategia, el criterio y el
							entendimiento del negocio
						</p>
					</div>
				</article>
			</section>


			<!-- FINAL CTA -->
			<section
				class="media-contact reveal-section"
				aria-labelledby="register-title"
			>
				<h2
					id="register-title"
					class="reveal-item"
				>
					Sumate al Webinar
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						Jueves 20 de agosto de 2026 · 1:00 PM ET ·
						2:00 PM Uruguay · 1 hora · Webinar en inglés
					</p>

					<p>
						Registrate y recibirás automáticamente la invitación
						en tu calendario
					</p>

					<p class="media-contact-link">
						<a
							href={registrationUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>Reservar mi lugar</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>

<style>
	/* MAIN WEBINAR */

	.webinar-main {
		grid-template-columns: 340px minmax(0, 1fr);
		column-gap: 2rem;
		align-items: start;
	}

	.webinar-main .media-image-wrapper {
		width: 100%;
		max-width: none;
	}

	.webinar-main .media-image-wrapper a,
	.webinar-main .media-image-wrapper a:hover {
		display: block;
		width: 100%;
		text-decoration: none;
		border-bottom: none;
		background-image: none;
	}

	.webinar-main .media-image-wrapper a::before,
	.webinar-main .media-image-wrapper a::after {
		display: none;
		content: none;
	}

	.webinar-main .media-image {
		display: block;
		width: 100%;
		max-width: none;
		height: auto;
	}


	/* TEXT */

	.webinar-intro {
		margin-top: 0.9rem;
	}

	.webinar-intro .media-description {
		margin-bottom: 1rem;
	}

	.webinar-intro .media-description:last-child {
		margin-bottom: 0;
	}

	.webinar-schedule {
		margin-top: 1.8rem;
		margin-bottom: 0.2rem;
		display: block;
		line-height: 1.5;
	}


	/* SECONDARY LINKS */

	.webinar-secondary-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1.15rem;
	}

	.webinar-secondary-links .animated-link {
		font-size: 0.95rem;
	}


	/* VIDEO */

	.webinar-video {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 14px;
	}

	.webinar-video iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}


	/* TAKEAWAYS */

	.webinar-takeaway {
		align-items: center;
	}

	.webinar-takeaway-number {
		font-size: clamp(4rem, 8vw, 7rem);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: -0.06em;
		opacity: 0.16;
	}


	/* RESPONSIVE */

	@media (max-width: 900px) {
		.webinar-main {
			grid-template-columns: 1fr;
			column-gap: 0;
		}

		.webinar-main .media-image-wrapper {
			max-width: 400px;
		}
	}

	@media (max-width: 700px) {
		.webinar-secondary-links {
			flex-direction: column;
			gap: 0.75rem;
		}

		.webinar-takeaway-number {
			font-size: 4rem;
		}
	}
</style>
