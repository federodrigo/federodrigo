---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Inquiry from '../../components/Inquiry.astro';

const capabilities = [
	{
		title: 'Asesoramiento a Directorios y Alta Dirección',
		description:
			'Asesorar de manera independiente a directorios, CEOs y equipos ejecutivos sobre inversiones tecnológicas, decisiones estratégicas, riesgos e iniciativas críticas',
	},
	{
		title: 'Estrategia y Gobierno de TI',
		description:
			'Definir prioridades tecnológicas, criterios de decisión y mecanismos de gobierno según las necesidades del negocio y el valor a largo plazo',
	},
	{
		title: 'ERP y Sistemas Empresariales',
		description:
			'Evaluar, seleccionar y supervisar iniciativas de ERP y sistemas empresariales, desde el caso de negocio hasta su ejecución, cuestionando supuestos y defendiendo los intereses del cliente',
	},
	{
		title: 'Transformación y Supervisión de Programas',
		description:
			'Acompañar desde una perspectiva ejecutiva transformaciones y programas tecnológicos complejos, con foco en las decisiones, las personas, los riesgos y los resultados del negocio',
	},
	{
		title: 'Fractional CIO',
		description:
			'Aportar liderazgo y criterio de CIO a organizaciones que necesitan dirección ejecutiva en tecnología sin incorporar un CIO a tiempo completo',
	},
	{
		title: 'Inversión Tecnológica y Riesgos',
		description:
			'Evaluar decisiones sobre infraestructura, cloud, ciberseguridad, datos e IA considerando valor para el negocio, costos, riesgos y alternativas',
	},
];

import SiteEffects from '../../components/SiteEffects.astro';
---
<!doctype html>
<html lang="es"><head><SEO
			title="CIO Office | Fede Rodrigo"
			description="Asesoramiento tecnológico independiente a directorios y ejecutivos: estrategia, ERP, transformación, Fractional CIO y riesgos de inversión"
			lang="es"
		/></head><body><Header />
<main id="main-content"><section class="page-intro advisory-page-intro"><div class="advisory-identity"><h1><img class="cio-page-logo" src="/images/cio-office-logo.png" alt="CIO Office" width="1024" height="927" /></h1><p class="advisory-tagline">Estrategia · Asesoramiento · Transformación</p></div></section>
			<section id="services" class="cio-office-capabilities reveal-section">
                <h2 class="visually-hidden">Servicios de consultoría</h2>
				<div class="leadership-grid">
					{
						capabilities.map((capability, index) => (
							<div
								class="leadership-card"
								style={`--card-index: ${index};`}
							>
								<h3>
									{capability.title}
								</h3>
								<p>
									{capability.description}
								</p>
							</div>
						))
					}
				</div>
			</section>
		</main>
<Inquiry lang="es" context="advisory" /><Footer /><SiteEffects /></body></html>
