---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>

<html lang="es">
	<head>
		<SEO
			title="The CIO Office | Fede Rodrigo"
			description="Liderazgo ejecutivo en tecnología enfocado en las personas, el valor para el negocio, la excelencia operacional y la ejecución"
			lang="es"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1>
					The CIO <span class="accent">Office</span>
				</h1>

				<div class="lead-principles">
					<div>El CIO crea valor para el negocio</div>
					<div>No tecnología</div>
				</div>
			</section>

			<section class="cio-office-capabilities">
				<div class="cio-office-capabilities-heading">
					<img
						src="/images/cio-office-logo.png"
						alt="The CIO Office"
						class="cio-office-capabilities-logo"
					/>

					<h2>Liderazgo Ejecutivo • Asesoramiento • Transformación</h2>
				</div>

				<div class="leadership-grid">
					<div class="leadership-card">
						<h3>Liderazgo Ejecutivo en Tecnología</h3>

						<p>
							Alinear la estrategia tecnológica con los objetivos del
							negocio, los modelos operativos, la gobernanza y la
							creación de valor a largo plazo
						</p>
					</div>

					<div class="leadership-card">
						<h3>Infraestructura, Nube y Ciberseguridad</h3>

						<p>
							Modernizar la infraestructura, la nube, las redes, la
							ciberseguridad y los servicios para usuarios finales
						</p>
					</div>

					<div class="leadership-card">
						<h3>Aplicaciones Empresariales y Datos</h3>

						<p>
							Implementar ERP, aplicaciones empresariales, inteligencia
							de negocios e iniciativas de datos que mejoren la
							visibilidad, la ejecución y la toma de decisiones
						</p>
					</div>

					<div class="leadership-card">
						<h3>Integración Tecnológica en Fusiones y Adquisiciones</h3>

						<p>
							Integrar sistemas, infraestructura, aplicaciones, datos
							y equipos durante procesos de fusiones y adquisiciones
						</p>
					</div>

					<div class="leadership-card">
						<h3>Tecnología de la Información y Tecnología Operacional</h3>

						<p>
							Conectar la tecnología de la información con la tecnología
							operacional para mejorar la resiliencia, la seguridad, la
							continuidad del negocio y el desempeño operativo
						</p>
					</div>

					<div class="leadership-card">
						<h3>CIO Fraccional y Asesoramiento</h3>

						<p>
							Apoyar a CEOs y equipos ejecutivos mediante liderazgo
							estratégico en tecnología, transformación y ejecución
						</p>
					</div>
				</div>
			</section>

			<section class="cio-office-contact">
				<h2>Consultas sobre The CIO Office</h2>

				<p>
					Para servicios de CIO fraccional, asesoramiento ejecutivo,
					iniciativas de transformación o conversaciones sobre estrategia
					tecnológica, puedes contactarme directamente
				</p>

				<p class="cio-office-contact-link">
					<a href="/es/contact">
						Contáctame →
					</a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
