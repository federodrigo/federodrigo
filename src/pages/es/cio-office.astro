---
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const capabilities = [
	{
		title: 'Liderazgo Ejecutivo en Tecnología',
		description:
			'Alinear la estrategia, las inversiones, la gobernanza y la ejecución tecnológica con las prioridades del negocio y la creación de valor a largo plazo',
	},
	{
		title: 'ERP y Sistemas Empresariales',
		description:
			'Seleccionar, supervisar, evaluar y recuperar iniciativas de ERP y aplicaciones empresariales con liderazgo independiente del lado del cliente',
	},
	{
		title: 'Infraestructura y Nube',
		description:
			'Definir y supervisar la modernización de infraestructura, estrategia de nube, migraciones, plataformas de trabajo y grandes transiciones tecnológicas',
	},
	{
		title: 'Ciberseguridad y Resiliencia',
		description:
			'Fortalecer la estrategia de ciberseguridad, gobernanza, gestión de riesgos, resiliencia y continuidad del negocio',
	},
	{
		title: 'Estrategia de Datos e IA',
		description:
			'Identificar oportunidades de valor en datos e IA, evaluar capacidades, definir gobernanza, seleccionar soluciones y supervisar su ejecución',
	},
	{
		title: 'CIO Fraccional y Asesoramiento',
		description:
			'Apoyar a CEOs y equipos ejecutivos con criterio independiente de nivel CIO para decisiones tecnológicas críticas y procesos de transformación',
	},
];
---

<!doctype html>

<html lang="es">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="CIO Office | CXY Office"
			description="Asesoramiento tecnológico independiente de nivel CIO para ERP, infraestructura, nube, ciberseguridad, datos, IA y decisiones tecnológicas críticas"
			lang="es"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="cio-office-capabilities reveal-section">
				<div class="cio-office-capabilities-heading reveal-item">
					<img
						src="/images/cio-office-logo.png"
						alt="CIO Office"
						class="cio-office-capabilities-logo animated-image"
					/>

					<h2
						class="cio-office-capabilities-tagline"
						aria-label="Estrategia • Asesoramiento • Transformación"
					>
						<span
							class="tagline-part tagline-part-1"
							aria-hidden="true"
						>
							Estrategia
						</span>

						<span
							class="tagline-dot tagline-part-2 accent"
							aria-hidden="true"
						>
							•
						</span>

						<span
							class="tagline-part tagline-part-3"
							aria-hidden="true"
						>
							Asesoramiento
						</span>

						<span
							class="tagline-dot tagline-part-4 accent"
							aria-hidden="true"
						>
							•
						</span>

						<span
							class="tagline-part tagline-part-5"
							aria-hidden="true"
						>
							Transformación
						</span>
					</h2>
				</div>

				<div class="leadership-grid">
					{
						capabilities.map((capability, index) => (
							<div
								class="leadership-card"
								style={`--card-index: ${index};`}
							>
								<h3>{capability.title}</h3>

								<p>{capability.description}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="cio-office-contact reveal-section">
				<h2 class="reveal-item">
					CXY Office
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						Para asesoramiento tecnológico independiente, iniciativas
						de ERP y transformación, servicios de CIO fraccional o
						decisiones tecnológicas críticas, puedes contactarme
						directamente
					</p>

					<p class="cio-office-contact-link">
						<a href="/es/contact/" class="animated-link">
							<span>Contáctame</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.12,
					rootMargin: '0px 0px -60px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>

		<style>
			.cio-office-capabilities-tagline span {
				display: inline-block;
			}

			.js .cio-office-capabilities-tagline span {
				opacity: 0;
				transform: translateY(12px);
			}

			.cio-office-capabilities.is-visible
				.cio-office-capabilities-tagline
				span {
				animation: tagline-reveal 0.7s
					cubic-bezier(0.22, 1, 0.36, 1) forwards;
			}

			.cio-office-capabilities.is-visible .tagline-part-1 {
				animation-delay: 0.15s;
			}

			.cio-office-capabilities.is-visible .tagline-part-2 {
				animation-delay: 0.25s;
			}

			.cio-office-capabilities.is-visible .tagline-part-3 {
				animation-delay: 0.35s;
			}

			.cio-office-capabilities.is-visible .tagline-part-4 {
				animation-delay: 0.45s;
			}

			.cio-office-capabilities.is-visible .tagline-part-5 {
				animation-delay: 0.55s;
			}

			@keyframes tagline-reveal {
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.js .cio-office-capabilities-tagline span {
					opacity: 1;
					transform: none;
					animation: none;
				}
			}
		</style>
	</body>
</html>
