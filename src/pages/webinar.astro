---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

const registrationUrl =
	'https://forms.gle/TJEuQGhBCBT8cZx28';

const youtubeEmbedUrl =
	'https://www.youtube.com/embed/ZN-d5W68Lp8';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<SEO
			title="Technology is Never the Starting Point | Webinar | Fede Rodrigo"
			description="Join Fede Rodrigo for a free practical webinar on August 20, 2026 about creating business value through technology by starting with people and business priorities."
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="webinar-hero">
				<div class="webinar-hero-inner">
					<div class="webinar-hero-content">
						<p class="webinar-eyebrow">
							Free Webinar · Xseed
						</p>

						<h1>
							Technology is
							<span class="accent">Never</span>
							the Starting Point
						</h1>

						<p class="webinar-hero-lead">
							A practical conversation about how IT becomes
							a true driver of business value by starting
							with people, aligning with the business, and
							letting technology enable the outcome — not
							define it.
						</p>

						<div
							class="webinar-details"
							aria-label="Webinar details"
						>
							<span>August 20, 2026</span>
							<span class="webinar-dot">·</span>
							<span>2:00 PM (UTC-3)</span>
							<span class="webinar-dot">·</span>
							<span>1 hour</span>
							<span class="webinar-dot">·</span>
							<span>Free</span>
						</div>

						<div class="webinar-actions">
							<a
								href={registrationUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="webinar-primary-button"
							>
								Save my spot
								<span aria-hidden="true">→</span>
							</a>
						</div>
					</div>

					<div class="webinar-hero-image-wrapper">
						<img
							src="/images/xseed-webinar.png"
							alt="Technology is Never the Starting Point webinar with Federico Rodrigo"
							class="webinar-hero-image"
						/>
					</div>
				</div>
			</section>


			<!-- ABOUT -->
			<section
				class="webinar-section reveal-section"
				id="about-webinar"
			>
				<div class="webinar-narrow">
					<p class="webinar-section-label reveal-item">
						About the Webinar
					</p>

					<h2 class="reveal-item reveal-delay-1">
						Transformation does not begin with technology
					</h2>

					<div
						class="webinar-copy reveal-item reveal-delay-2"
					>
						<p>
							Organizations spend millions expecting
							technology to transform their business. Too
							often, the outcome is a new system,
							frustrated teams, and very little business
							value.
						</p>

						<p>
							Why? Because they started with the solution
							before understanding the problem.
						</p>

						<p>
							<strong>
								Technology is Never the Starting Point
							</strong>
							is a free, practical session about how IT can
							become a true driver of business value —
							built on one principle:
						</p>
					</div>

					<div
						class="webinar-principles reveal-item reveal-delay-2"
					>
						<div>People First</div>
						<div>Business Driven</div>
						<div>Technology Enabled</div>
					</div>
				</div>
			</section>


			<!-- TAKEAWAYS -->
			<section
				class="webinar-section webinar-section-alt reveal-section"
			>
				<div class="webinar-container">
					<p class="webinar-section-label reveal-item">
						What You'll Take Away
					</p>

					<h2 class="reveal-item reveal-delay-1">
						Three ideas you can put into practice
					</h2>

					<div class="webinar-takeaways">
						<article
							class="webinar-takeaway reveal-item reveal-delay-1"
						>
							<span class="webinar-number">01</span>

							<h3>
								Why technology initiatives fail
							</h3>

							<p>
								Why roughly 70% of technology initiatives
								fail to deliver what was expected — and
								what leaders can do differently to improve
								the odds.
							</p>
						</article>

						<article
							class="webinar-takeaway reveal-item reveal-delay-2"
						>
							<span class="webinar-number">02</span>

							<h3>
								IT as a service organization
							</h3>

							<p>
								How to reframe the role of IT around the
								people and business it serves, with value
								as the measure of success rather than
								technology itself.
							</p>
						</article>

						<article
							class="webinar-takeaway reveal-item reveal-delay-3"
						>
							<span class="webinar-number">03</span>

							<h3>
								Leading through the AI era
							</h3>

							<p>
								A people-first approach to an environment
								where technology changes faster than ever,
								while leadership, strategy, and judgment
								remain essential.
							</p>
						</article>
					</div>
				</div>
			</section>


			<!-- VIDEO -->
			<section
				class="webinar-section reveal-section"
				id="video"
			>
				<div class="webinar-container">
					<p class="webinar-section-label reveal-item">
						Watch
					</p>

					<h2 class="reveal-item reveal-delay-1">
						Technology is never the starting point
					</h2>

					<div
						class="webinar-video-wrapper reveal-item reveal-delay-2"
					>
						<iframe
							src={youtubeEmbedUrl}
							title="Technology is Never the Starting Point"
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							allowfullscreen
						></iframe>
					</div>
				</div>
			</section>


			<!-- SPEAKER -->
			<section
				class="webinar-section webinar-section-alt reveal-section"
			>
				<div class="webinar-speaker">
					<div
						class="webinar-speaker-photo-wrapper reveal-item reveal-from-left"
					>
						<img
							src="/images/fede.png"
							alt="Federico Rodrigo"
							class="webinar-speaker-photo"
						/>
					</div>

					<div
						class="webinar-speaker-content reveal-item reveal-delay-2"
					>
						<p class="webinar-section-label">
							About the Speaker
						</p>

						<h2>Federico Rodrigo</h2>

						<p class="webinar-speaker-role">
							CIO · Technology Leader · Author
						</p>

						<p>
							Federico Rodrigo is a CIO and MBA with more
							than 25 years of experience helping global
							organizations use technology to create
							business value.
						</p>

						<p>
							He has built and transformed technology
							organizations across the U.S., Europe, and
							Latin America, including leadership roles at
							companies such as Ferrovial and Abengoa.
						</p>

						<p>
							He is also the author of
							<em>How to Become CIO and Succeed</em>,
							a practical exploration of leadership,
							business, and strategy in the CIO role.
						</p>

						<p class="webinar-speaker-belief">
							Technology will always change. Leadership
							won't.
						</p>

						<p class="books-page-action">
							<a href="/about/" class="animated-link">
								<span>Learn more about Federico</span>
								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>
				</div>
			</section>


			<!-- DETAILS / CTA -->
			<section
				class="webinar-registration reveal-section"
				id="register"
			>
				<div class="webinar-registration-inner">
					<p class="webinar-section-label reveal-item">
						Join the Session
					</p>

					<h2 class="reveal-item reveal-delay-1">
						Technology is Never the Starting Point
					</h2>

					<div
						class="webinar-registration-details reveal-item reveal-delay-2"
					>
						<div>
							<span class="detail-label">Date</span>
							<strong>Thursday, August 20, 2026</strong>
						</div>

						<div>
							<span class="detail-label">Time</span>
							<strong>2:00 PM (UTC-3)</strong>
						</div>

						<div>
							<span class="detail-label">Duration</span>
							<strong>1 hour</strong>
						</div>

						<div>
							<span class="detail-label">Cost</span>
							<strong>Free</strong>
						</div>
					</div>

					<p
						class="webinar-registration-copy reveal-item reveal-delay-2"
					>
						Register through the form and the calendar invite
						will arrive in your inbox automatically.
					</p>

					<div
						class="webinar-actions webinar-actions-center reveal-item reveal-delay-2"
					>
						<a
							href={registrationUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="webinar-primary-button"
						>
							Save my spot
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.12,
					rootMargin: '0px 0px -60px 0px'
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>


<style>
	.webinar-hero {
		padding: 8rem 2rem 6rem;
	}

	.webinar-hero-inner,
	.webinar-container,
	.webinar-speaker,
	.webinar-registration-inner {
		width: min(1180px, 100%);
		margin: 0 auto;
	}

	.webinar-hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(380px, 0.9fr);
		gap: 5rem;
		align-items: center;
	}

	.webinar-eyebrow,
	.webinar-section-label {
		margin: 0 0 1.25rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.62;
	}

	.webinar-hero h1 {
		max-width: 760px;
		margin: 0;
		font-size: clamp(3.2rem, 6vw, 6.5rem);
		line-height: 0.98;
		letter-spacing: -0.055em;
		font-weight: 600;
	}

	.webinar-hero .accent {
		font-style: italic;
	}

	.webinar-hero-lead {
		max-width: 700px;
		margin: 2rem 0 0;
		font-size: clamp(1.15rem, 1.6vw, 1.45rem);
		line-height: 1.6;
		opacity: 0.82;
	}

	.webinar-details {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 2rem;
		font-size: 1rem;
		font-weight: 600;
	}

	.webinar-dot {
		opacity: 0.35;
	}

	.webinar-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2.25rem;
	}

	.webinar-primary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 1rem 1.4rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		transition:
			transform 180ms ease,
			opacity 180ms ease;
	}

	.webinar-primary-button:hover {
		transform: translateY(-2px);
		opacity: 0.72;
	}

	.webinar-hero-image-wrapper {
		width: 100%;
	}

	.webinar-hero-image {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 18px;
	}

	.webinar-section {
		padding: 7rem 2rem;
	}

	.webinar-section-alt {
		background: rgba(127, 127, 127, 0.055);
	}

	.webinar-narrow {
		width: min(900px, 100%);
		margin: 0 auto;
	}

	.webinar-section h2,
	.webinar-registration h2 {
		margin: 0;
		font-size: clamp(2.4rem, 4.4vw, 4.7rem);
		line-height: 1.04;
		letter-spacing: -0.045em;
		font-weight: 500;
	}

	.webinar-copy {
		max-width: 820px;
		margin-top: 2.5rem;
		font-size: 1.2rem;
		line-height: 1.75;
	}

	.webinar-copy p {
		margin: 0 0 1.35rem;
	}

	.webinar-principles {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin-top: 3.5rem;
		border-top: 1px solid rgba(127, 127, 127, 0.25);
		border-bottom: 1px solid rgba(127, 127, 127, 0.25);
	}

	.webinar-principles div {
		padding: 1.5rem 1rem;
		text-align: center;
		font-size: 1.05rem;
		font-weight: 600;
	}

	.webinar-principles div + div {
		border-left: 1px solid rgba(127, 127, 127, 0.25);
	}

	.webinar-takeaways {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		margin-top: 4rem;
	}

	.webinar-takeaway {
		padding-top: 1.5rem;
		border-top: 1px solid rgba(127, 127, 127, 0.35);
	}

	.webinar-number {
		display: block;
		margin-bottom: 2rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		opacity: 0.45;
	}

	.webinar-takeaway h3 {
		margin: 0 0 1rem;
		font-size: 1.5rem;
		line-height: 1.25;
		font-weight: 600;
	}

	.webinar-takeaway p {
		margin: 0;
		line-height: 1.7;
		opacity: 0.78;
	}

	.webinar-video-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin-top: 3rem;
		overflow: hidden;
		border-radius: 18px;
		background: #000;
	}

	.webinar-video-wrapper iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.webinar-speaker {
		display: grid;
		grid-template-columns: minmax(260px, 0.65fr) minmax(0, 1.35fr);
		gap: 5rem;
		align-items: center;
	}

	.webinar-speaker-photo {
		display: block;
		width: 100%;
		max-width: 420px;
		height: auto;
		margin: 0 auto;
		border-radius: 18px;
	}

	.webinar-speaker-content h2 {
		margin-bottom: 0.7rem;
	}

	.webinar-speaker-role {
		margin: 0 0 2rem;
		font-size: 1.1rem;
		font-weight: 600;
		opacity: 0.58;
	}

	.webinar-speaker-content > p:not(
			.webinar-section-label,
			.webinar-speaker-role,
			.webinar-speaker-belief,
			.books-page-action
		) {
		max-width: 700px;
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.webinar-speaker-belief {
		margin-top: 2rem;
		font-size: 1.3rem;
		font-weight: 600;
	}

	.webinar-registration {
		padding: 8rem 2rem;
		text-align: center;
	}

	.webinar-registration-inner {
		max-width: 980px;
	}

	.webinar-registration-details {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: 4rem auto 0;
		border-top: 1px solid rgba(127, 127, 127, 0.25);
		border-bottom: 1px solid rgba(127, 127, 127, 0.25);
	}

	.webinar-registration-details > div {
		padding: 1.5rem 1rem;
	}

	.webinar-registration-details > div + div {
		border-left: 1px solid rgba(127, 127, 127, 0.25);
	}

	.detail-label {
		display: block;
		margin-bottom: 0.5rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.5;
	}

	.webinar-registration-copy {
		max-width: 600px;
		margin: 2rem auto 0;
		font-size: 1.05rem;
		line-height: 1.65;
		opacity: 0.72;
	}

	.webinar-actions-center {
		justify-content: center;
	}

	@media (max-width: 900px) {
		.webinar-hero {
			padding-top: 6rem;
		}

		.webinar-hero-inner {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.webinar-hero-image-wrapper {
			max-width: 700px;
		}

		.webinar-takeaways {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.webinar-speaker {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.webinar-speaker-photo {
			margin-left: 0;
		}

		.webinar-registration-details {
			grid-template-columns: repeat(2, 1fr);
		}

		.webinar-registration-details > div:nth-child(3) {
			border-left: 0;
			border-top: 1px solid rgba(127, 127, 127, 0.25);
		}

		.webinar-registration-details > div:nth-child(4) {
			border-top: 1px solid rgba(127, 127, 127, 0.25);
		}
	}

	@media (max-width: 640px) {
		.webinar-hero,
		.webinar-section,
		.webinar-registration {
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}

		.webinar-hero {
			padding-top: 4.5rem;
			padding-bottom: 4.5rem;
		}

		.webinar-section {
			padding-top: 5rem;
			padding-bottom: 5rem;
		}

		.webinar-hero h1 {
			font-size: clamp(2.8rem, 14vw, 4.3rem);
		}

		.webinar-details {
			display: grid;
			gap: 0.4rem;
		}

		.webinar-dot {
			display: none;
		}

		.webinar-principles {
			grid-template-columns: 1fr;
		}

		.webinar-principles div + div {
			border-left: 0;
			border-top: 1px solid rgba(127, 127, 127, 0.25);
		}

		.webinar-registration-details {
			grid-template-columns: 1fr;
		}

		.webinar-registration-details > div + div {
			border-left: 0;
			border-top: 1px solid rgba(127, 127, 127, 0.25);
		}

		.webinar-primary-button {
			width: 100%;
		}
	}
</style>
