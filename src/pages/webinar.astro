---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Technology is Never the Starting Point | Fede Rodrigo"
			description="Technology initiatives often begin with a solution instead of the business need behind it. Start with people and business priorities, then use technology to enable the outcome."
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero webinar-hero">

				<h1 class="hero-title webinar-hero-title">

					<span class="hero-line">
						Technology is
						<span class="webinar-never">never</span>
					</span>

					<span class="hero-line">
						the starting point
					</span>

				</h1>


				<div class="webinar-principles">

					<span>People First</span>

					<span aria-hidden="true">·</span>

					<span>Business Driven</span>

					<span aria-hidden="true">·</span>

					<span>Technology Enabled</span>

				</div>

			</section>


			<!-- =====================================================
			     INTRO
			===================================================== -->

			<section class="webinar-intro reveal-section">

				<div class="webinar-intro-inner">

					<p class="webinar-lead reveal-item">
						Technology initiatives often begin with a solution
						instead of the business need behind it
					</p>


					<div class="webinar-intro-response reveal-item reveal-delay-1">

						<p class="webinar-description">
							<strong>This talk explores a different approach:</strong>
							start with people and business priorities,
							then use technology to enable the outcome
						</p>


						<div class="webinar-secondary-links">

							<a
								href="/about/"
								class="animated-link"
							>
								<span>About Federico</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>


							<a
								href="/books/"
								class="animated-link"
							>
								<span>Explore the book</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>

						</div>

					</div>

				</div>

			</section>


			<!-- =====================================================
			     WATCH
			===================================================== -->

			<section
				class="webinar-watch reveal-section"
				aria-labelledby="webinar-watch-title"
			>

				<h2
					id="webinar-watch-title"
					class="webinar-section-title webinar-watch-title reveal-item"
				>
					Watch
				</h2>


				<div class="webinar-video reveal-item reveal-delay-1">

					<iframe
						src="https://www.youtube.com/embed/ZN-d5W68Lp8"
						title="Technology is Never the Starting Point"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>

				</div>


				<p class="webinar-watch-link reveal-item">

					<a
						href="https://www.youtube.com/watch?v=ZN-d5W68Lp8"
						target="_blank"
						rel="noopener noreferrer"
						class="animated-link"
					>
						<span>Watch on YouTube</span>

						<span
							class="animated-link-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>

				</p>

			</section>


			<!-- =====================================================
			     TAKEAWAYS
			===================================================== -->

			<section
				class="webinar-takeaways reveal-section"
				aria-labelledby="webinar-takeaways-title"
			>

				<h2
					id="webinar-takeaways-title"
					class="webinar-section-title webinar-takeaways-title reveal-item"
				>
					What You'll Take Away
				</h2>


				<div class="webinar-takeaways-list">


					<article
						class="webinar-takeaway reveal-item"
						style="--delay: 0ms;"
					>

						<div
							class="webinar-takeaway-number"
							aria-hidden="true"
						>
							01
						</div>


						<div class="webinar-takeaway-copy">

							<h3>
								Why Technology Initiatives Fail
							</h3>

							<p>
								Why so many initiatives fail to deliver what
								was expected — and what leaders can do
								differently
							</p>

						</div>

					</article>


					<article
						class="webinar-takeaway reveal-item"
						style="--delay: 80ms;"
					>

						<div
							class="webinar-takeaway-number"
							aria-hidden="true"
						>
							02
						</div>


						<div class="webinar-takeaway-copy">

							<h3>
								IT as a Service Organization
							</h3>

							<p>
								How to focus IT on the people and business
								it serves, with business value as the
								measure of success
							</p>

						</div>

					</article>


					<article
						class="webinar-takeaway reveal-item"
						style="--delay: 160ms;"
					>

						<div
							class="webinar-takeaway-number"
							aria-hidden="true"
						>
							03
						</div>


						<div class="webinar-takeaway-copy">

							<h3>
								Leading Through the AI Era
							</h3>

							<p>
								Why changing tools do not replace leadership,
								strategy, judgment, and business understanding
							</p>

						</div>

					</article>


				</div>

			</section>


			<!-- =====================================================
			     CONTACT
			===================================================== -->

			<section class="webinar-contact reveal-section">

				<p class="webinar-contact-copy reveal-item">
					For speaking engagements, interviews,
					podcasts, or other opportunities
				</p>


				<p class="webinar-contact-link reveal-item reveal-delay-1">

					<a
						href="/contact/"
						class="animated-link"
					>
						<span>Contact me</span>

						<span
							class="animated-link-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>

				</p>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll(
					'.reveal-section'
				);

			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(

						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},

						{
							threshold: 0.08,
							rootMargin:
								'0px 0px -50px 0px'
						}

					);


				sections.forEach((section) => {
					revealObserver.observe(section);
				});

			} else {

				sections.forEach((section) => {
					section.classList.add(
						'is-visible'
					);
				});

			}
		</script>

	</body>
</html>


