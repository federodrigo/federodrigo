---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const registrationUrl =
	'https://forms.gle/TJEuQGhBCBT8cZx28';

const youtubeEmbedUrl =
	'https://www.youtube.com/embed/ZN-d5W68Lp8';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Technology is Never the Starting Point | Webinar | Fede Rodrigo"
			description="Join Fede Rodrigo for a free practical webinar on August 20, 2026 about creating business value through technology by starting with people and business priorities."
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Technology is <span class="accent">Never</span>
					</span>

					<span class="hero-line">
						the Starting Point
					</span>
				</h1>

				<div class="lead-principles">
					<div>People First</div>
					<div>Business Driven</div>
					<div>Technology Enabled</div>
				</div>
			</section>


			<!-- MAIN WEBINAR BLOCK -->
			<section
				class="media-list reveal-section"
				aria-labelledby="webinar-title"
			>
				<h2
					id="webinar-title"
					class="reveal-item"
				>
					Free Webinar
				</h2>

				<article
					class="media-item reveal-item reveal-delay-1"
				>
					<div class="media-image-wrapper">
						<a
							href={registrationUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Register for Technology is Never the Starting Point"
						>
							<img
								src="/images/xseed-webinar.png"
								alt="Technology is Never the Starting Point webinar with Federico Rodrigo"
								class="media-image"
								loading="lazy"
							/>
						</a>
					</div>

					<div class="media-content">
						<p class="media-meta">
							<span>Xseed</span>
							<span aria-hidden="true">·</span>
							<span>August 20, 2026</span>
						</p>

						<h3>
							Technology is Never the Starting Point
						</h3>

						<p class="media-description">
							Organizations spend millions expecting technology
							to transform their business. Too often, the result
							is a new system, frustrated teams, and very little
							business value.
						</p>

						<p class="media-description">
							The problem is simple: they started with the
							solution before understanding the problem.
						</p>

						<p class="media-description">
							This free, practical session explores how IT becomes
							a true driver of business value by starting with
							people, aligning with the business, and letting
							technology enable the outcome — not define it.
						</p>

						<p class="media-meta">
							<span>Thursday, August 20</span>
							<span aria-hidden="true">·</span>
							<span>2:00 PM (UTC-3)</span>
							<span aria-hidden="true">·</span>
							<span>1 hour</span>
							<span aria-hidden="true">·</span>
							<span>Free</span>
						</p>

						<div class="media-action">
							<a
								href={registrationUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="animated-link"
							>
								<span>Save my spot</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</div>
					</div>
				</article>
			</section>


			<!-- TAKEAWAYS -->
			<section
				class="media-list reveal-section"
				aria-labelledby="takeaways-title"
			>
				<h2
					id="takeaways-title"
					class="reveal-item"
				>
					What You'll Take Away
				</h2>

				<article
					class="media-item reveal-item reveal-delay-1"
				>
					<div class="media-content">
						<p class="media-meta">
							<span>01</span>
						</p>

						<h3>
							Why Technology Initiatives Fail
						</h3>

						<p class="media-description">
							Why roughly 70% of technology initiatives fail to
							deliver what was expected — and how leaders can
							improve the odds of being in the other 30%.
						</p>
					</div>
				</article>

				<article
					class="media-item reveal-item reveal-delay-2"
				>
					<div class="media-content">
						<p class="media-meta">
							<span>02</span>
						</p>

						<h3>
							IT as a Service Organization
						</h3>

						<p class="media-description">
							How to reframe IT around the people and business it
							serves, with business value — rather than technology
							itself — as the measure of success.
						</p>
					</div>
				</article>

				<article
					class="media-item reveal-item reveal-delay-3"
				>
					<div class="media-content">
						<p class="media-meta">
							<span>03</span>
						</p>

						<h3>
							Leading Through the AI Era
						</h3>

						<p class="media-description">
							A people-first approach to an environment where the
							tools are changing dramatically, while leadership,
							strategy, judgment, and business acumen remain
							essential.
						</p>
					</div>
				</article>
			</section>


			<!-- VIDEO -->
			<section
				class="media-list reveal-section"
				aria-labelledby="video-title"
			>
				<h2
					id="video-title"
					class="reveal-item"
				>
					Watch
				</h2>

				<article
					class="media-item reveal-item reveal-delay-1"
				>
					<div
						class="media-image-wrapper"
						style="aspect-ratio: 16 / 9;"
					>
						<iframe
							src={youtubeEmbedUrl}
							title="Technology is Never the Starting Point"
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							allowfullscreen
							style="width: 100%; height: 100%; border: 0; display: block;"
						></iframe>
					</div>

					<div class="media-content">
						<p class="media-meta">
							<span>Video</span>
						</p>

						<h3>
							Technology is Never the Starting Point
						</h3>

						<p class="media-description">
							Every successful technology initiative starts
							somewhere else — with people, the business, and the
							problem we are trying to solve.
						</p>
					</div>
				</article>
			</section>


			<!-- FINAL CTA -->
			<section
				class="media-contact reveal-section"
				aria-labelledby="register-title"
			>
				<h2
					id="register-title"
					class="reveal-item"
				>
					Join the Webinar
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						Thursday, August 20, 2026 · 2:00 PM (UTC-3) ·
						1 hour · Free
					</p>

					<p>
						Register through the form and the calendar invite
						will arrive in your inbox automatically.
					</p>

					<p class="media-contact-link">
						<a
							href={registrationUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>Save my spot</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>
