---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Technology is Never the Starting Point | Fede Rodrigo"
			description="Technology initiatives often begin with a solution instead of the business need behind it. A talk about starting with people and business priorities, then using technology to enable the outcome."
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero webinar-hero">

				<h1 class="hero-title webinar-hero-title">

					<span class="hero-line">
						Technology is
						<span class="webinar-never">never</span>
					</span>

					<span class="hero-line">
						the starting point
					</span>

				</h1>


				<div class="webinar-principles">

					<span>People First</span>

					<span aria-hidden="true">·</span>

					<span>Business Driven</span>

					<span aria-hidden="true">·</span>

					<span>Technology Enabled</span>

				</div>

			</section>


			<!-- =====================================================
			     INTRO
			===================================================== -->

			<section
				class="webinar-intro reveal-section"
				aria-labelledby="webinar-intro-title"
			>

				<p class="webinar-eyebrow reveal-item">
					Talk
				</p>


				<p class="webinar-meta reveal-item">
					Xseed · August 20, 2026
				</p>


				<h2
					id="webinar-intro-title"
					class="webinar-intro-title reveal-item"
				>
					Technology is Never the Starting Point
				</h2>


				<div class="webinar-copy">

					<p class="webinar-lead reveal-item">
						Technology initiatives often begin with a solution
						instead of the business need behind it
					</p>


					<p class="webinar-description reveal-item reveal-delay-1">
						<strong>This talk explores a different approach:</strong>
						start with people and business priorities,
						then use technology to enable the outcome
					</p>

				</div>


				<div class="webinar-secondary-links reveal-item">

					<a
						href="/about/"
						class="animated-link"
					>
						<span>About Federico</span>

						<span
							class="animated-link-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>


					<a
						href="/books/"
						class="animated-link"
					>
						<span>Explore the book</span>

						<span
							class="animated-link-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>

				</div>

			</section>


			<div
				class="webinar-divider"
				aria-hidden="true"
			></div>


			<!-- =====================================================
			     WATCH
			===================================================== -->

			<section
				class="webinar-watch reveal-section"
				aria-labelledby="webinar-watch-title"
			>

				<h2
					id="webinar-watch-title"
					class="reveal-item"
				>
					Watch
				</h2>


				<div class="webinar-video reveal-item reveal-delay-1">

					<iframe
						src="https://www.youtube.com/embed/ZN-d5W68Lp8"
						title="Technology is Never the Starting Point"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>

				</div>


				<p class="webinar-watch-link reveal-item">

					<a
						href="https://www.youtube.com/watch?v=ZN-d5W68Lp8"
						target="_blank"
						rel="noopener noreferrer"
						class="animated-link"
					>
						<span>
							Watch on YouTube
						</span>

						<span
							class="animated-link-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>

				</p>

			</section>


			<div
				class="webinar-divider"
				aria-hidden="true"
			></div>


			<!-- =====================================================
			     TAKEAWAYS
			===================================================== -->

			<section
				class="webinar-takeaways reveal-section"
				aria-labelledby="webinar-takeaways-title"
			>

				<h2
					id="webinar-takeaways-title"
					class="reveal-item"
				>
					What You'll Take Away
				</h2>


				<div class="webinar-takeaways-grid">


					<article
						class="webinar-takeaway reveal-item"
						style="--delay: 0ms;"
					>

						<p class="webinar-takeaway-number">
							01
						</p>

						<h3>
							Why Technology Initiatives Fail
						</h3>

						<p>
							Why so many initiatives fail to deliver
							what was expected — and what leaders
							can do differently
						</p>

					</article>


					<article
						class="webinar-takeaway reveal-item"
						style="--delay: 80ms;"
					>

						<p class="webinar-takeaway-number">
							02
						</p>

						<h3>
							IT as a Service Organization
						</h3>

						<p>
							How to focus IT on the people and
							business it serves, with business value
							as the measure of success
						</p>

					</article>


					<article
						class="webinar-takeaway reveal-item"
						style="--delay: 160ms;"
					>

						<p class="webinar-takeaway-number">
							03
						</p>

						<h3>
							Leading Through the AI Era
						</h3>

						<p>
							Why changing tools do not replace
							leadership, strategy, judgment,
							and business understanding
						</p>

					</article>


				</div>

			</section>


			<!-- =====================================================
			     CLOSING
			===================================================== -->

			<section
				class="webinar-closing reveal-section"
				aria-labelledby="webinar-closing-title"
			>

				<h2
					id="webinar-closing-title"
					class="webinar-closing-title reveal-item"
				>
					Technology is
					<span class="webinar-never">never</span>
					the starting point
				</h2>


				<p class="webinar-closing-copy reveal-item reveal-delay-1">
					For speaking engagements, executive conversations,
					interviews, or other opportunities, get in touch
				</p>


				<p class="webinar-contact-link reveal-item reveal-delay-1">

					<a
						href="/contact/"
						class="animated-link"
					>
						<span>Contact me</span>

						<span
							class="animated-link-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>

				</p>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll(
					'.reveal-section'
				);

			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(

						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},

						{
							threshold: 0.08,
							rootMargin:
								'0px 0px -50px 0px'
						}

					);


				sections.forEach((section) => {
					revealObserver.observe(section);
				});

			} else {

				sections.forEach((section) => {
					section.classList.add(
						'is-visible'
					);
				});

			}
		</script>

	</body>
</html>


<style>

