---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const registrationUrl =
	'https://forms.gle/TJEuQGhBCBT8cZx28';

const youtubeEmbedUrl =
	'https://www.youtube.com/embed/ZN-d5W68Lp8';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Technology is Never the Starting Point | Webinar | Fede Rodrigo"
			description="Join Fede Rodrigo on August 20, 2026 for a practical webinar on creating business value by starting with people and business priorities before technology"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Technology is <span class="accent">Never</span>
					</span>

					<span class="hero-line">
						the Starting Point
					</span>
				</h1>

				<div class="lead-principles">
					<div>People First</div>
					<div>Business Driven</div>
					<div>Technology Enabled</div>
				</div>
			</section>


			<!-- WEBINAR -->
			<section
				class="media-list reveal-section"
				aria-labelledby="webinar-title"
			>
				<h2
					id="webinar-title"
					class="reveal-item"
				>
					Webinar
				</h2>

				<article
					class="media-item reveal-item reveal-delay-1"
				>
					<div class="media-image-wrapper">
						<a
							href={registrationUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Register for Technology is Never the Starting Point"
						>
							<img
								src="/images/xseed-webinar.png"
								alt="Technology is Never the Starting Point webinar with Federico Rodrigo"
								class="media-image"
								loading="lazy"
							/>
						</a>
					</div>

					<div class="media-content">
						<p class="media-meta">
							<span>Xseed</span>
							<span aria-hidden="true">·</span>
							<span>August 20, 2026</span>
						</p>

						<h3>
							Technology is Never the Starting Point
						</h3>

						<div class="webinar-intro">
							<p class="media-description">
								Technology initiatives often begin with a solution
								instead of the business need behind it
							</p>

							<p class="media-description">
								This practical session explores a different approach:
								start with people and business priorities, then use
								technology to enable the outcome
							</p>
						</div>

						<p class="media-meta webinar-schedule">
							<span>Thursday, August 20</span>
							<span aria-hidden="true">·</span>
							<span>1:00 PM ET</span>
							<span aria-hidden="true">·</span>
							<span>2:00 PM Uruguay</span>
							<span aria-hidden="true">·</span>
							<span>1 hour</span>
						</p>

						<div class="media-action">
							<a
								href={registrationUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="animated-link"
							>
								<span>Save my spot</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</div>

						<div class="webinar-secondary-links">
							<a
								href="/about/"
								class="animated-link"
							>
								<span>About Federico</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>

							<a
								href="/cio-book/"
								class="animated-link"
							>
								<span>Explore the book</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</div>
					</div>
				</article>
			</section>


			<!-- VIDEO -->
			<section
				class="media-list reveal-section"
				aria-labelledby="video-title"
			>
				<h2
					id="video-title"
					class="reveal-item"
				>
					Watch
				</h2>

				<div
					class="webinar-video reveal-item reveal-delay-1"
				>
					<iframe
						src={youtubeEmbedUrl}
						title="Technology is Never the Starting Point"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>
				</div>
			</section>


			<!-- TAKEAWAYS -->
			<section
				class="media-list reveal-section"
				aria-labelledby="takeaways-title"
			>
				<h2
					id="takeaways-title"
					class="reveal-item"
				>
					What You'll Take Away
				</h2>

				<article
					class="media-item webinar-takeaway reveal-item reveal-delay-1"
				>
					<div class="webinar-takeaway-number">
						01
					</div>

					<div class="media-content">
						<h3>
							Why Technology Initiatives Fail
						</h3>

						<p class="media-description">
							Why so many initiatives fail to deliver what was
							expected — and what leaders can do differently.
						</p>
					</div>
				</article>

				<article
					class="media-item webinar-takeaway reveal-item reveal-delay-2"
				>
					<div class="webinar-takeaway-number">
						02
					</div>

					<div class="media-content">
						<h3>
							IT as a Service Organization
						</h3>

						<p class="media-description">
							How to focus IT on the people and business it
							serves, with business value as the measure of
							success.
						</p>
					</div>
				</article>

				<article
					class="media-item webinar-takeaway reveal-item reveal-delay-3"
				>
					<div class="webinar-takeaway-number">
						03
					</div>

					<div class="media-content">
						<h3>
							Leading Through the AI Era
						</h3>

						<p class="media-description">
							Why changing tools do not replace leadership,
							strategy, judgment, and business understanding.
						</p>
					</div>
				</article>
			</section>


			<!-- FINAL CTA -->
			<section
				class="media-contact reveal-section"
				aria-labelledby="register-title"
			>
				<h2
					id="register-title"
					class="reveal-item"
				>
					Join the Webinar
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						Thursday, August 20, 2026 · 1:00 PM ET ·
						2:00 PM Uruguay · 1 hour
					</p>

					<p>
						Register and the calendar invite will arrive in
						your inbox automatically.
					</p>

					<p class="media-contact-link">
						<a
							href={registrationUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="animated-link"
						>
							<span>Save my spot</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>

<style>
	.webinar-intro {
		margin-top: 0.9rem;
	}

	.webinar-intro .media-description {
		margin-bottom: 1rem;
	}

	.webinar-intro .media-description:last-child {
		margin-bottom: 0;
	}

	.webinar-schedule {
		margin-top: 1.8rem;
		margin-bottom: 0.2rem;
	}

	.webinar-secondary-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1.15rem;
	}

	.webinar-secondary-links .animated-link {
		font-size: 0.95rem;
	}

	.webinar-video {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 14px;
	}

	.webinar-video iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.webinar-takeaway-number {
		font-size: clamp(4rem, 8vw, 7rem);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: -0.06em;
		opacity: 0.16;
	}

	.webinar-takeaway {
		align-items: center;
	}

	@media (max-width: 700px) {
		.webinar-secondary-links {
			flex-direction: column;
			gap: 0.75rem;
		}

		.webinar-takeaway-number {
			font-size: 4rem;
		}
	}
</style>
