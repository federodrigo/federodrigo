---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const youtubeEmbedUrl =
	'https://www.youtube.com/embed/ZN-d5W68Lp8';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Technology is Never the Starting Point | Fede Rodrigo"
			description="Technology initiatives often begin with a solution instead of the business need behind it. Start with people and business priorities, then use technology to enable the outcome."
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero webinar-hero">

				<h1 class="hero-title webinar-hero-title">

					<span class="hero-line">
						Technology is
						<span class="webinar-never">never</span>
					</span>

					<span class="hero-line">
						the starting point
					</span>

				</h1>


				<div class="webinar-principles">

					<span>People First</span>

					<span aria-hidden="true">·</span>

					<span>Business Driven</span>

					<span aria-hidden="true">·</span>

					<span>Technology Enabled</span>

				</div>

			</section>


			<!-- =====================================================
			     INTRO
			===================================================== -->

			<section class="webinar-intro reveal-section">

				<div class="webinar-intro-inner">

					<p class="webinar-lead reveal-item">

						Technology initiatives often begin with a solution
						instead of the business need behind it

					</p>


					<div
						class="webinar-intro-response reveal-item reveal-delay-1"
					>

						<p class="webinar-description">

							<strong>
								This talk explores a different approach:
							</strong>

							start with people and business priorities,
							then use technology to enable the outcome

						</p>


						<div class="webinar-secondary-links">

							<a
								href="/about/"
								class="animated-link"
							>

								<span>
									About Federico
								</span>

						
							</a>


							<a
								href="/books/"
								class="animated-link"
							>

								<span>
									Explore the book
								</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>

							</a>

						</div>

					</div>

				</div>

			</section>


			<!-- =====================================================
			     VIDEO
			===================================================== -->

			<section
				class="media-list webinar-video-section reveal-section"
				aria-label="Technology is Never the Starting Point video"
			>

				<div
					class="webinar-video reveal-item"
				>

					<iframe
						src={youtubeEmbedUrl}
						title="Technology is Never the Starting Point"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>

				</div>


				<p
					class="webinar-watch-link reveal-item reveal-delay-1"
				>

					<a
						href="https://www.youtube.com/watch?v=ZN-d5W68Lp8"
						target="_blank"
						rel="noopener noreferrer"
						class="animated-link"
					>

					

						

					</a>

				</p>

			</section>


			<!-- =====================================================
			     TAKEAWAYS
			===================================================== -->

			<section
				class="media-list webinar-takeaways reveal-section"
				aria-labelledby="takeaways-title"
			>

				<h2
					id="takeaways-title"
					class="reveal-item"
				>
					What You'll Take Away
				</h2>


				<!-- 01 -->

				<article
					class="media-item webinar-takeaway reveal-item reveal-delay-1"
				>

					<div class="webinar-takeaway-number">
						01
					</div>


					<div class="media-content">

						<h3>
							Why Technology Initiatives Fail
						</h3>


						<p class="media-description">

							Why so many initiatives fail to deliver
							what was expected and what leaders
							can do differently

						</p>

					</div>

				</article>


				<!-- 02 -->

				<article
					class="media-item webinar-takeaway reveal-item reveal-delay-2"
				>

					<div class="webinar-takeaway-number">
						02
					</div>


					<div class="media-content">

						<h3>
							IT as a Service Organization
						</h3>


						<p class="media-description">

							How to focus IT on the people and
							business it serves, with business value
							as the measure of success

						</p>

					</div>

				</article>


				<!-- 03 -->

				<article
					class="media-item webinar-takeaway reveal-item reveal-delay-3"
				>

					<div class="webinar-takeaway-number">
						03
					</div>


					<div class="media-content">

						<h3>
							Leading Through the AI Era
						</h3>


						<p class="media-description">

							Why changing tools do not replace
							leadership, strategy, judgment,
							and business understanding

						</p>

					</div>

				</article>


				<!-- =================================================
				     CONTACT
				================================================= -->

				<div
					class="webinar-contact reveal-item reveal-delay-3"
				>

					<p class="webinar-contact-copy">

						For speaking engagements, interviews,
						podcasts, or other opportunities

					</p>


					<p class="webinar-contact-link">

						<a
							href="/contact/"
							class="animated-link"
						>

							<span>
								Contact me
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>

						</a>

					</p>

				</div>

			</section>

		</main>


		<Footer />


		<script>
			const sections =
				document.querySelectorAll(
					'.reveal-section'
				);


			const revealObserver =
				new IntersectionObserver(

					(entries, observer) => {

						entries.forEach((entry) => {

							if (!entry.isIntersecting) {
								return;
							}


							entry.target.classList.add(
								'is-visible'
							);


							observer.unobserve(
								entry.target
							);

						});

					},

					{
						threshold:
							0.08,

						rootMargin:
							'0px 0px -50px 0px',
					}

				);


			sections.forEach((section) => {

				revealObserver.observe(
					section
				);

			});
		</script>

	</body>
</html>


<style>

	/* =========================================================
	   HERO
	========================================================= */

	.webinar-hero {
		border-bottom:
			0 !important;
	}


	.webinar-hero-title {
		width:
			100%;

		max-width:
			1050px;

		margin-left:
			auto;

		margin-right:
			auto;

		font-size:
			clamp(
				2.4rem,
				4.8vw,
				4.7rem
			);

		line-height:
			1.03;

		letter-spacing:
			-0.055em;

		text-align:
			center;
	}


	.webinar-hero-title
	.hero-line {
		display:
			block;

		width:
			100%;
	}


	.webinar-never {
		color:
			#6fa7ef;
	}


	.webinar-principles {
		display:
			flex;

		align-items:
			center;

		justify-content:
			center;

		flex-wrap:
			wrap;

		gap:
			8px;

		margin:
			22px
			auto
			0;

		color:
			#6f7d8f;

		font-size:
			0.82rem;

		font-weight:
			650;

		line-height:
			1.4;

		letter-spacing:
			0.045em;

		text-transform:
			uppercase;
	}


	.webinar-principles
	span:nth-child(2),
	.webinar-principles
	span:nth-child(4) {
		color:
			#b3bdc7;
	}


	/* =========================================================
	   INTRO
	========================================================= */

	.webinar-intro {
		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		margin:
			-18px
			auto
			22px;
	}


	.webinar-intro-inner {
		display:
			grid;

		grid-template-columns:
			minmax(
				0,
				0.92fr
			)
			minmax(
				0,
				1.08fr
			);

		align-items:
			start;

		gap:
			clamp(
				42px,
				6vw,
				78px
			);

		max-width:
			1040px;

		margin:
			0
			auto;
	}


	.webinar-lead {
		margin:
			0;

		color:
			#102b46;

		font-size:
			clamp(
				1.25rem,
				1.75vw,
				1.5rem
			);

		font-weight:
			620;

		line-height:
			1.42;

		letter-spacing:
			-0.032em;
	}


	.webinar-intro-response {
		padding-top:
			2px;
	}


	.webinar-description {
		margin:
			0;

		color:
			#6f7d8f;

		font-size:
			clamp(
				1.02rem,
				1.35vw,
				1.15rem
			);

		line-height:
			1.62;

		letter-spacing:
			-0.014em;
	}


	.webinar-description
	strong {
		color:
			#102b46;

		font-weight:
			700;
	}


	.webinar-secondary-links {
		display:
			flex;

		align-items:
			center;

		flex-wrap:
			wrap;

		gap:
			1.5rem;

		margin-top:
			1.15rem;
	}


	.webinar-secondary-links
	.animated-link {
		font-size:
			0.95rem;
	}


	/* =========================================================
	   VIDEO
	========================================================= */

	.webinar-video-section {
		margin-top:
			-10px;

		margin-bottom:
			22px;
	}


	.webinar-video {
		width:
			100%;

		aspect-ratio:
			16 / 9;

		overflow:
			hidden;

		border-radius:
			14px;
	}


	.webinar-video
	iframe {
		display:
			block;

		width:
			100%;

		height:
			100%;

		border:
			0;
	}


	.webinar-watch-link {
		margin:
			10px
			0
			0;

		text-align:
			center;
	}


	/* =========================================================
	   TAKEAWAYS
	   SAME STRUCTURE AS ORIGINAL PAGE
	========================================================= */

	.webinar-takeaways {
		margin-top:
			0;

		margin-bottom:
			0;
	}


	.webinar-takeaway {
		align-items:
			center;
	}


	.webinar-takeaway-number {
		font-size:
			clamp(
				4rem,
				8vw,
				7rem
			);

		font-weight:
			700;

		line-height:
			0.9;

		letter-spacing:
			-0.06em;

		opacity:
			0.16;
	}


	/* =========================================================
	   CONTACT
	   INSIDE FINAL SECTION SO FOOTER FOLLOWS NATURALLY
	========================================================= */

	.webinar-contact {
		width:
			100%;

		margin:
			0;

		padding:
			24px
			0
			4px;

		border-top:
			1px solid
			rgba(
				16,
				43,
				70,
				0.12
			);

		text-align:
			center;
	}


	.webinar-contact-copy {
		max-width:
			650px;

		margin:
			0
			auto;

		color:
			#6f7d8f;

		font-size:
			1rem;

		line-height:
			1.6;
	}


	.webinar-contact-link {
		margin:
			8px
			0
			0;
	}


	/* =========================================================
	   RESPONSIVE
	========================================================= */

	@media (
		max-width: 900px
	) {

		.webinar-intro-inner {
			grid-template-columns:
				1fr;

			gap:
				18px;

			max-width:
				760px;
		}

	}


	@media (
		max-width: 700px
	) {

		.webinar-intro {
			width:
				calc(
					100% - 32px
				);

			margin:
				-4px
				auto
				20px;
		}


		.webinar-secondary-links {
			flex-direction:
				column;

			align-items:
				flex-start;

			gap:
				0.75rem;
		}


		.webinar-video-section {
			margin-top:
				-4px;

			margin-bottom:
				18px;
		}


		.webinar-takeaway-number {
			font-size:
				4rem;
		}


		.webinar-contact {
			padding:
				20px
				0
				0;
		}

	}

</style>
