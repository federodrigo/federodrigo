		transition-delay:
			var(
				--delay,
				0ms
			);
	}


	.js
	.reveal-section.is-visible
	.reveal-item {
		opacity:
			1;

		transform:
			translateY(
				0
			);
	}


	.js
	.reveal-delay-1 {
		transition-delay:
			90ms !important;
	}


