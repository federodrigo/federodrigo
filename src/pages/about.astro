---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const profileTags = [
	'Global CIO',
	'Technology Strategy',
	'Business Transformation',
	'Operational Excellence',
	'Author',
];
---

<!doctype html>

<html lang="en">
	<head>
		<SEO
			title="About | Fede Rodrigo"
			description="Learn more about Fede Rodrigo, Chief Information Officer, technology executive, MBA, and author."
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="about-hero">
				<h1>About</h1>

				<p class="lead">
					I am a Chief Information Officer (CIO) with more than 25 years of experience in IT, helping global organizations transform.
				</p>

				<div class="page-statement">
					People First. Business Driven. Technology Enabled.
				</div>
			</section>

			<section class="about-profile">
				<div class="about-profile-layout">

					<div class="about-profile-image-wrapper">
						<img
							src="/images/fede.png"
							alt="Fede Rodrigo"
							class="about-profile-image"
						/>
					</div>

					<div class="about-profile-content">

						<div class="about-profile-tags">
							{
								profileTags.map((tag) => (
									<span>{tag}</span>
								))
							}
						</div>

						<div class="about-profile-text">

							<p>
								My approach is simple: create business value through technology.
								Stay hands-on, think strategically, and build a culture of service,
								operational excellence, and continuous improvement.
							</p>

							<p>
								Throughout my career, I have led global technology organizations
								across North America, Europe, and Latin America, building teams,
								modernizing infrastructure, deploying enterprise platforms,
								strengthening cybersecurity, and leading large-scale transformation
								programs.
							</p>

							<p>
								I have built technology organizations from the ground up,
								led multicultural teams, advised executive leadership and boards,
								and delivered initiatives spanning cloud, ERP, operational technology,
								M&A integration, and digital transformation.
							</p>

							<p>
								Beyond my work, I write about freedom, incentives,
								institutions, and why systems—technical or political—
								fail when they ignore reality.
							</p>

						</div>

						<p class="about-profile-action">
							<a href="/books">
								Explore My Books →
							</a>
						</p>

					</div>

				</div>
			</section>

		</main>

		<Footer />
	</body>
</html>
