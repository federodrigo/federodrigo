---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Inquiry from '../components/Inquiry.astro';

const profileTags = [
	'Business Value',
	'Hands-on Leadership',
	'Strategy + Execution',
	'Operational Excellence',
	'Speaker',
	'Author',
];

import SiteEffects from '../components/SiteEffects.astro';
---
<!doctype html>
<html lang="en"><head><SEO
			title="About | Fede Rodrigo"
			description="Learn more about Fede Rodrigo, Chief Information Officer, technology executive, MBA, and author"
			lang="en"
		/></head><body><Header />
<main id="main-content" class="about-page">
			<section
				class="about-profile reveal-section"
				aria-labelledby="about-profile-title"
			>
				<div class="about-profile-layout">
					<div
						class="about-profile-image-wrapper reveal-item reveal-from-left"
					>
						<img
							src="/images/fede.png"
							alt="Fede Rodrigo"
							class="about-profile-image animated-image"
						/>
					</div>
					<div class="about-profile-content">
						<p
							class="about-profile-eyebrow reveal-item reveal-delay-1"
						>
							About Fede Rodrigo
						</p>
						<h1
							id="about-profile-title"
							class="reveal-item reveal-delay-1"
						>
							Fede Rodrigo
						</h1>
						<div
							class="about-profile-tags reveal-item reveal-delay-2"
							aria-label="Professional profile"
						>
							{
								profileTags.map((tag, index) => (
									<span style={`--tag-index: ${index};`}>
										{tag}
									</span>
								))
							}
						</div>
						<div
							class="about-profile-text reveal-item reveal-delay-2"
						>
							<p class="about-profile-intro">
								<strong>
									I am a Chief Information Officer (CIO) with more than 15 years of IT leadership experience across the US, Europe, and Latin America
								</strong>
							</p>
							<p>
								<strong>My approach:</strong> create
								business value through technology. Stay hands-on,
								think strategically, and build a culture of
								service, operational excellence, and continuous
								improvement
							</p>
							<p>
								I believe technology leadership goes beyond managing IT.
								Its purpose is to help the business move faster, make better
								decisions, and execute its strategy
							</p>
							<p>
								I wrote <strong
									><em>How to Become CIO and Succeed</em></strong
								> to share the lessons I wish I had when I began my leadership journey
							</p>
							<p>
								I hold an MBA from the University of Illinois
								Urbana-Champaign and a Computer Science degree
								from the Catholic University of Uruguay
							</p>
							<p>
								Beyond technology, I write about freedom, incentives,
								institutions, and why complex systems—technological,
								economic, or political—fail when they ignore reality
							</p>
						</div>

					</div>
				</div>
			</section>
		</main>
<Inquiry lang="en" context="general" /><Footer /><SiteEffects /></body></html>
