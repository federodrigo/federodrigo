---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const profileTags = [
	'Global CIO',
	'Technology Executive',
	'Author',
	'MBA',
	'Global Leadership',
];
---

<!doctype html>

<html lang="en">
	<head>
		<SEO
			title="About | Fede Rodrigo"
			description="Fede Rodrigo is a global technology executive, Chief Information Officer, MBA, and author with more than 25 years of experience leading teams, transformation, and technology strategy"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="about-hero">
				<h1>
					About <span class="accent">Fede</span>
				</h1>

				<p class="lead">
					Global technology executive, Chief Information Officer, MBA,
					and author with more than 25 years of experience leading
					organizations through transformation, growth, and change
				</p>

				<div class="page-statement">
					People First. Business Driven. Technology Enabled.
				</div>
			</section>

			<section
				class="about-profile"
				aria-labelledby="about-profile-title"
			>
				<div class="about-profile-layout">
					<div class="about-profile-image-wrapper">
						<img
							src="/images/fede.png"
							alt="Fede Rodrigo, global technology executive, CIO, and author"
							class="about-profile-image"
						/>
					</div>

					<div class="about-profile-content">
						<p class="about-profile-eyebrow">
							About Fede Rodrigo
						</p>

						<h2 id="about-profile-title">
							Fede Rodrigo
						</h2>

						<div
							class="about-profile-tags"
							aria-label="Professional profile"
						>
							{
								profileTags.map((tag) => (
									<span>{tag}</span>
								))
							}
						</div>

						<div class="about-profile-text">
							<p>
								Fede Rodrigo is a global technology executive,
								Chief Information Officer, and author with more than
								25 years of experience building teams, modernizing
								organizations, and creating business value through
								technology.
							</p>

							<p>
								His career has spanned infrastructure, enterprise
								applications, cybersecurity, cloud, operational
								technology, and M&A across North America, Europe,
								and Latin America. He has built global technology
								functions from the ground up, led multicultural
								teams, managed complex transformation programs, and
								advised boards and executive leaders on strategy and
								execution.
							</p>

							<p>
								His approach is grounded in a simple principle:
								technology is never the starting point. People come
								first, business priorities define the direction,
								and technology enables the outcome. He combines
								strategic perspective with hands-on execution and a
								culture centered on service and operational
								excellence.
							</p>

							<p>
								Fede holds an MBA from the University of Illinois
								Urbana-Champaign and a degree in Computer Science
								from the Catholic University of Uruguay. He is the
								author of <em>How to Become CIO and Succeed</em> and
								writes about technology leadership, institutions,
								incentives, freedom, and complex systems.
							</p>
						</div>

						<p class="about-profile-action">
							<a href="/books">
								Explore My Books →
							</a>
						</p>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
