---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const profileTags = [
	'Global CIO',
	'Technology Strategy',
	'Business Value',
	'Operational Excellence',
	'Author',
];
---

<!doctype html>

<html lang="en">
	<head>
		<SEO
			title="About | Fede Rodrigo"
			description="Learn more about Fede Rodrigo, Chief Information Officer, technology executive, MBA, and author"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section
				class="about-profile"
				aria-labelledby="about-profile-title"
			>
				<div class="about-profile-layout">
					<div class="about-profile-image-wrapper">
						<img
							src="/images/fede.png"
							alt="Fede Rodrigo"
							class="about-profile-image"
						/>
					</div>

					<div class="about-profile-content">
						<p class="about-profile-eyebrow">
							About Fede Rodrigo
						</p>

						<h1 id="about-profile-title">
							Fede Rodrigo
						</h1>

						<div
							class="about-profile-tags"
							aria-label="Professional profile"
						>
							{
								profileTags.map((tag) => (
									<span>{tag}</span>
								))
							}
						</div>

					<div class="about-profile-text">
	<p class="about-profile-intro">
	<strong>
		I am a Chief Information Officer (CIO) with more than 25 years of
		experience in IT, helping global organizations transform
	</strong>
</p>

<p>
	<strong>My approach is simple:</strong> create business value through
	technology. Stay hands-on, think strategically, and build a culture of
	service, operational excellence, and continuous improvement
</p>

<p>
	Throughout my career, I have had the opportunity to build technology
	organizations from the ground up, lead global teams, advise executive
	leadership and boards, and deliver transformation initiatives across
	infrastructure, cybersecurity, cloud, ERP, operational technology, and
	M&A
</p>

<p>
	I wrote <strong><em>How to Become CIO and Succeed</em></strong> because it
	was the book I wish I had when I began my leadership journey. It brings
	together practical lessons from more than two decades of experience to
	help current and aspiring technology leaders build successful careers
	and create lasting business value
</p>

<p>
	I hold an MBA from the University of Illinois Urbana-Champaign and a
	degree in Computer Science from the Catholic University of Uruguay,
	combining business strategy with a strong technical foundation
</p>

<p>
	Beyond technology leadership, I write about freedom, incentives,
	institutions, and why complex systems—whether technological, economic,
	or political—fail when they ignore reality
</p></div>
						<p class="about-profile-action">
							<a href="/books">
								Explore My Books →
							</a>
						</p>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
