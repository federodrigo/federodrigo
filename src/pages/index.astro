---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<SEO
			title="Fede Rodrigo | CIO, Author and Technology Leader"
			description="Fede Rodrigo is a Chief Information Officer, author, and technology leader focused on business value, leadership, technology strategy, operational excellence, and transformation"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1>
					Technology is <span class="accent">never</span><br />
					the starting point
				</h1>

				<div class="lead-principles">
					<div>People First</div>
					<div>Business Driven</div>
					<div>Technology Enabled</div>
				</div>
			</section>

			<section id="about">
				<h2>About</h2>

				<div class="about-layout">
					<div class="about-content">
						<p>
							I am a Chief Information Officer with more than 25
							years of experience helping global organizations use
							technology to create business value
						</p>

						<p>
							My approach combines strategic thinking, practical
							execution, strong relationships, and a service-oriented
							culture focused on operational excellence and continuous
							improvement
						</p>
						<p class="books-page-action">
						<a href="/about/">
						My journey →
						</a>
						</p>
					

					</div>

					<div class="about-photo-wrapper">
						<img
							src="/images/fede.png"
							alt="Fede Rodrigo, Chief Information Officer and author"
							class="about-photo"
						/>
					</div>
				</div>
			</section>

			<section id="cio-office" class="contact-section">
				<h2>The CIO Office</h2>

				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-office-title"
				>
					<div class="books-page-cover-wrapper">
						<a
							href="/cio-office/"
							class="books-page-cover-link"
							aria-label="Explore The CIO Office"
						>
							<img
								src="/images/cio-office-logo.png"
								alt="The CIO Office"
								class="cio-office-capabilities-logo"
							/>
						</a>
					</div>

					<div class="books-page-content">
						<p class="books-page-label">
							Executive Technology Leadership
						</p>

						<h3 id="home-cio-office-title">
							Technology that Creates Business Value
						</h3>

						<p>
							Advisory for organizations seeking to align technology with business goals, strengthen operations, and accelerate transformation
						</p>

						<p class="books-page-action">
							<a href="/cio-office/">
								Learn about The CIO Office →
							</a>
						</p>
					</div>
				</article>
			</section>

			<section id="books" class="contact-section">
				<h2>Book</h2>

				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-book-title"
				>
					<div class="books-page-cover-wrapper">
						<a
							href="/books/"
							class="books-page-cover-link"
							aria-label="Learn more about How to Become CIO and Succeed"
						>
							<img
								src="/images/3d5bg.png"
								alt="Cover of How to Become CIO and Succeed"
								class="books-page-cover"
							/>
						</a>
					</div>

					<div class="books-page-content">
						<p class="books-page-label">
							Featured Book
						</p>

						<h3 id="home-cio-book-title">
							How to Become CIO and Succeed
						</h3>

						<p class="books-page-subtitle">
							People, Business, Strategy
						</p>

						<p>

						The CIO role is not about managing systems.
						It is about leading people, shaping strategy, influencing the business, and turning technology into a competitive advantage.
						This is the book I wish I had when I began my leadership journey
						</p>

						<p class="books-page-action">
							<a href="/books/">
								Explore the book →
							</a>
						</p>
					</div>
				</article>
			</section>
		</main>

		<Footer />
	</body>
</html>
