---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Fede Rodrigo | CIO, Author, Speaker & Technology Leader"
			description="Fede Rodrigo is a Chief Information Officer, author, speaker, and technology leader focused on business value, leadership, technology strategy, operational excellence, and transformation"
			lang="en"
		/>

		<style>
			/* =========================================================
			   HOME
			========================================================= */

			.home-main {
				padding-bottom: var(--divider-space-before);
			}

			.home-hero {
				padding-bottom: 0;
				border-bottom: 0;
			}

			.home-feature {
				padding-bottom: 0;
			}

			#about.home-feature {
				padding-top: var(--divider-space-after);
			}

			/*
				CIO Office has a taller visual block than the other
				home features. Remove the additional margin before
				Book so the divider has the same optical spacing.
			*/
			#books.home-feature {
				margin-top: 0;
			}


			/* =========================================================
			   FEATURE LAYOUT
			========================================================= */

			#speaking.home-feature .books-page-book-featured,
			#cio-office.home-feature .books-page-book-featured,
			#books.home-feature .books-page-book-featured {
				padding-top: 0;
				padding-bottom: 0;
			}

			/*
				Keep the three main home features on exactly the same
				two-column grid so every text block starts at the same X.
			*/
			#speaking .books-page-book,
			#cio-office .books-page-book,
			#books .books-page-book {
				grid-template-columns: 260px minmax(0, 1fr);
				column-gap: 53px;
			}

			.home-feature .books-page-content {
				align-self: center;
			}


			/* =========================================================
			   FEATURE TITLES
			========================================================= */

			.home-feature .books-page-content h2 {
				margin: 0 0 0.85rem;
				padding: 0;

				font-size: clamp(1.55rem, 1.8vw, 1.85rem);
				font-weight: 500;
				line-height: 1.18;
				letter-spacing: -0.015em;
			}

			.home-feature .books-page-content h2::after {
				content: none;
				display: none;
			}

			#speaking .books-page-content h2 {
				max-width: 900px;
				text-wrap: balance;
			}

			#speaking .books-page-content
				> p:not(.books-page-subtitle):not(.books-page-action) {
				max-width: 820px;
			}


			/* =========================================================
			   FEATURE TEXT
			========================================================= */

			.home-feature
				.books-page-content
				> p:not(.books-page-subtitle):not(.books-page-action) {
				max-width: 680px;
				margin-top: 0;
				margin-bottom: 0;

				font-size: 1rem;
				line-height: 1.6;
			}

			.home-feature .books-page-action {
				margin-top: 20px;
				margin-bottom: 0;
			}


			/* =========================================================
			   SPEAKING
			========================================================= */

			#speaking .books-page-book {
				align-items: center;
			}

			#speaking .books-page-cover-wrapper {
				display: flex;
				align-items: center;
				justify-content: center;

				padding: 0;
				margin: 0;

				border: 0;
				background: transparent;
				mix-blend-mode: multiply;
			}

			.speaking-cover-link {
				display: block;

				width: 100%;
				max-width: 390px;

				border: 0;
				text-decoration: none;

				transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
			}

			.speaking-cover-link:hover {
				transform: translateY(-4px) scale(1.015);
				border-bottom: 0;
			}

			.speaking-cover-frame {
				/*
				 * No card behind the Speaking artwork.
				 * The PNG is transparent, so the site's own page background
				 * shows through exactly like the CIO Office and book assets.
				 */
				overflow: visible;

				border: 0;
				border-radius: 0;

				background: transparent;

				box-shadow: none;
			}

			.speaking-cover-image {
				display: block;

				width: 100%;
				height: auto;

				border: 0;
				border-radius: 0;
				background: transparent;
			}



			/* Two upcoming talks, without pushing the permanent sections down. */
			#upcoming-events .home-events-heading {
				margin: 0 0 20px;
				color: var(--muted);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.09em;
				line-height: 1.4;
				text-transform: uppercase;
			}

			#upcoming-events .home-events-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				column-gap: 40px;
				row-gap: 28px;
			}

			#upcoming-events .home-event {
				display: flex;
				min-width: 0;
				flex-direction: column;
				align-items: flex-start;
			}

			#upcoming-events .home-event-image-link {
				display: flex;
				width: 100%;
				height: 126px;
				align-items: center;
				justify-content: flex-start;
				border: 0;
				text-decoration: none;
				transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
			}

			#upcoming-events .home-event-image-link:hover {
				transform: translateY(-4px) scale(1.015);
				border: 0;
			}

			#upcoming-events .home-event-image {
				display: block;
				width: auto;
				height: auto;
				max-width: 100%;
				max-height: 120px;
				object-fit: contain;
			}

			#upcoming-events .home-event-image--tedx {
				max-width: 260px;
			}

			#upcoming-events .home-event-details {
				display: flex;
				flex: 1;
				flex-direction: column;
				align-items: flex-start;
			}

			#upcoming-events .home-event-title {
				margin: 14px 0 7px;
				font-size: 1.3rem;
				font-weight: 500;
				letter-spacing: -0.015em;
				line-height: 1.25;
			}

			#upcoming-events .home-event-date {
				margin: 0;
				color: var(--muted);
				font-size: 0.95rem;
				line-height: 1.4;
			}

			#upcoming-events .home-event-action {
				margin: 16px 0 0;
			}

			#upcoming-events .home-event-action a {
				color: var(--blue);
				font-size: var(--cta-size);
				font-weight: var(--cta-weight);
			}

			#upcoming-events .home-event-action a:hover {
				color: var(--red);
			}

			/* =========================================================
			   CIO OFFICE
			========================================================= */

			#cio-office .cio-office-capabilities-logo {
				transform: none;
			}

			#cio-office .cio-office-capabilities-logo:hover {
				transform: translateY(-4px) scale(1.015);

				filter:
					drop-shadow(
						0 16px 18px rgba(16, 42, 67, 0.12)
					);
			}


			/* =========================================================
			   BOOK
			========================================================= */

			#books .books-page-cover {
				display: block;

				width: 85%;
				max-width: 85%;
				height: auto;

				margin-left: auto;
				margin-right: auto;
			}


			/* =========================================================
			   ABOUT
			========================================================= */

			#about .about-photo-wrapper {
				align-self: start;

				padding-top: 0;
				margin-top: 0;

				transform: none;

				border: 0;
				box-shadow: none;

				text-align: right;
			}

			#about .about-photo-wrapper a {
				display: block;

				border: 0;
				box-shadow: none;
				text-decoration: none;
			}

			#about .about-photo {
				display: block;

				width: 81%;
				max-width: 81%;

				margin-left: auto;

				border: 0;
				box-shadow: none;
			}


			/* =========================================================
			   TABLET
			========================================================= */

			@media (max-width: 900px) {
				.home-feature .books-page-content h2 {
					font-size: 1.65rem;
				}

				#about .about-photo-wrapper {
					text-align: center;
				}

				#about .about-photo {
					margin-left: auto;
					margin-right: auto;
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.home-main {
					padding-bottom: var(--divider-space-mobile);
				}

				.home-hero {
					padding-bottom: 0;
					border-bottom: 0;
				}

				#about.home-feature {
					padding-top: var(--divider-space-mobile);
				}

				/*
					On mobile the layout is stacked and the CIO logo
					no longer creates the same height imbalance.
				*/
				#books.home-feature {
					margin-top: var(--divider-space-mobile);
				}

				#speaking .books-page-book,
				#cio-office .books-page-book,
				#books .books-page-book {
					grid-template-columns: 1fr;
					gap: 20px;
				}

				.home-feature .books-page-content h2 {
					font-size: 1.5rem;
				}

				.home-feature
					.books-page-content
					> p:not(.books-page-subtitle):not(.books-page-action) {
					font-size: 1rem;
					line-height: 1.58;
				}

				.home-feature .books-page-action {
					margin-top: 18px;
				}

				#speaking .books-page-cover-wrapper {
					width: 100%;
					justify-content: flex-start;
				}

				.speaking-cover-link {
					max-width: 320px;
				}

				#cio-office .books-page-cover-wrapper,
				#cio-office .books-page-cover-link {
					width: 170px;
				}

				#cio-office .cio-office-capabilities-logo {
					width: 170px;
					transform: none;
				}

				#cio-office .cio-office-capabilities-logo:hover {
					transform: translateY(-4px) scale(1.015);
				}

				#books .books-page-cover-wrapper,
				#books .books-page-cover-link {
					width: 170px;
				}

				#books .books-page-cover {
					width: 100%;
					max-width: 100%;
					margin: 0;
				}


				#upcoming-events .home-events-grid {
					grid-template-columns: 1fr;
					gap: 24px;
				}

				#upcoming-events .home-event {
					display: grid;
					grid-template-columns: 100px minmax(0, 1fr);
					column-gap: 18px;
					align-items: center;
				}

				#upcoming-events .home-event-image-link {
					height: auto;
					min-height: 88px;
				}

				#upcoming-events .home-event-image {
					max-height: 88px;
				}

				#upcoming-events .home-event-title {
					margin: 0 0 6px;
					font-size: 1.125rem;
				}

				#upcoming-events .home-event-date {
					font-size: 0.85rem;
				}

				#upcoming-events .home-event-action {
					margin-top: 10px;
				}

				#upcoming-events .home-event-action a {
					font-size: 0.9rem;
				}

			}

		</style>
	</head>

	<body>
		<Header />

		<main class="home-main">

			<section class="hero home-hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Technology is <span class="accent">never</span>
					</span>

					<span class="hero-line">
						the starting point
					</span>
				</h1>

				<div class="lead-principles">
					<div>People</div>
					<div>Business</div>
					<div>Technology</div>
				</div>
			</section>






			<section id="upcoming-events" class="page-divider home-feature reveal-section" aria-labelledby="home-events-title">
				<h2 id="home-events-title" class="home-events-heading reveal-item">UPCOMING EVENTS</h2>
				<div class="home-events-grid">
					<article class="home-event reveal-item reveal-delay-1" aria-labelledby="home-event-tedx-title">
						<a
							href="https://redtickets.uy/evento/TEDx-Ciudad-de-la-Costa/34038/"
							class="home-event-image-link"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Tickets and details for TEDx Ciudad de la Costa"
						>
							<img src="/images/TEDx-Logo-v2.png" alt="TEDx" class="home-event-image home-event-image--tedx" loading="lazy" decoding="async" />
						</a>
						<div class="home-event-details">
							<h3 id="home-event-tedx-title" class="home-event-title">TEDx Ciudad de la Costa</h3>
							<p class="home-event-date">November 26, 2026</p>
							<p class="home-event-action">
								<a href="https://redtickets.uy/evento/TEDx-Ciudad-de-la-Costa/34038/" class="animated-link" target="_blank" rel="noopener noreferrer">
									<span>Tickets & Details</span>
									<span class="animated-link-arrow" aria-hidden="true">→</span>
								</a>
							</p>
						</div>
					</article>
					<article class="home-event reveal-item reveal-delay-2" aria-labelledby="home-event-llmday-title">
						<a
							href="https://llmday.com/2026-montevideo-q4/"
							class="home-event-image-link"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Tickets and details for LLMday Montevideo 2026"
						>
							<img src="https://llmday.com/assets/images/events/llmday-2026-montevideo-q4.png" alt="LLMday Montevideo 2026" class="home-event-image" loading="lazy" decoding="async" />
						</a>
						<div class="home-event-details">
							<h3 id="home-event-llmday-title" class="home-event-title">LLMday Montevideo 2026</h3>
							<p class="home-event-date">December 5, 2026</p>
							<p class="home-event-action">
								<a href="https://llmday.com/2026-montevideo-q4/" class="animated-link" target="_blank" rel="noopener noreferrer">
									<span>Tickets & Details</span>
									<span class="animated-link-arrow" aria-hidden="true">→</span>
								</a>
							</p>
						</div>
					</article>
				</div>
			</section>

			<section
				id="speaking"
				class="page-divider home-feature reveal-section"
			>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-speaking-title"
				>
					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/speaking/"
							class="speaking-cover-link"
							aria-label="Explore speaking"
						>
							<div class="speaking-cover-frame">
								<img
									src="/images/speaking-cover.png"
									alt="Speaking theme visual about technology decisions starting with no technology at all"
									class="speaking-cover-image"
								/>
							</div>
						</a>
					</div>

					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-speaking-title">
							What if your next technology decision started with… no technology at all?
						</h2>

						<p>
							Even when it works, the wrong starting point can create complexity, dependencies, and lock-in
						</p>


						<p class="books-page-action">
							<a
								href="/speaking/"
								class="animated-link"
							>
								<span>Explore speaking</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>
				</article>
			</section>


			<section
				id="cio-office"
				class="page-divider home-feature reveal-section"
			>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-office-title"
				>
					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/cio-office/"
							class="books-page-cover-link"
							aria-label="Explore the CIO Office"
						>
							<img
								src="/images/cio-office-logo.png"
								alt="CIO Office"
								class="cio-office-capabilities-logo animated-image"
							/>
						</a>
					</div>

					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-cio-office-title">
							Technology that Creates Business Value
						</h2>

						<p>
							Advisory for organizations seeking to align technology
							with business goals, strengthen operations, and
							accelerate transformation
						</p>

						<p class="books-page-action">
							<a
								href="/cio-office/"
								class="animated-link"
							>
								<span>Learn about the CIO Office</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>
				</article>
			</section>


			<section
				id="books"
				class="page-divider home-feature reveal-section"
			>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-book-title"
				>
					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/cio-book/"
							class="books-page-cover-link"
							aria-label="Learn more about How to Become CIO and Succeed"
						>
							<img
								src="/images/cio-book-cover.png"
								alt="Cover of How to Become CIO and Succeed"
								class="books-page-cover animated-book-cover"
							/>
						</a>
					</div>

					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-cio-book-title">
							How to Become CIO and Succeed
						</h2>

						<p class="books-page-subtitle">
							People, Business, Strategy
						</p>

						<p>
							The CIO role is not about managing systems. It is about
							leading people, shaping strategy, influencing the
							business, and turning technology into a competitive
							advantage. This is the book I wish I had when I began my
							leadership journey
						</p>

						<p class="books-page-action">
							<a
								href="/cio-book/"
								class="animated-link"
							>
								<span>Explore the book</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>
				</article>
			</section>


			<section
				id="about"
				class="page-divider home-feature reveal-section"
			>
				<div class="about-layout">

					<div
						class="about-content reveal-item reveal-delay-1"
					>
						<p>
							I am a Chief Information Officer (CIO) with more than
							15 years of international IT leadership experience
							helping global organizations create business value
						</p>

						<p>
							My approach combines strategic thinking, practical
							execution, strong relationships, and a service-oriented
							culture focused on operational excellence and continuous
							improvement
						</p>

						<p class="books-page-action">
							<a
								href="/about/"
								class="animated-link"
							>
								<span>My journey</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

					<div
						class="about-photo-wrapper reveal-item reveal-from-right reveal-delay-2"
					>
						<a
							href="/about/"
							aria-label="Learn more about Fede Rodrigo"
						>
							<img
								src="/images/fede.png"
								alt="Fede Rodrigo, Chief Information Officer, author, and speaker"
								class="about-photo animated-image"
							/>
						</a>
					</div>

				</div>
			</section>

		</main>

		<Footer />


		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver =
				new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;

							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{
						threshold: 0.12,
						rootMargin: '0px 0px -60px 0px'
					}
				);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>

	</body>
</html>
