---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Fede Rodrigo | CIO, Author, Speaker & Technology Leader"
			description="Fede Rodrigo is a Chief Information Officer, author, speaker, and technology leader focused on business value, leadership, technology strategy, operational excellence, and transformation"
			lang="en"
		/>

		<style>
			/* =========================================================
			   HOME FEATURE TITLES
			========================================================= */

			#speaking .books-page-content h2::after,
			#cio-office .books-page-content h2::after,
			#books .books-page-content h2::after {
				content: none !important;
				display: none !important;
			}

			#speaking .books-page-content h2,
			#cio-office .books-page-content h2,
			#books .books-page-content h2 {
				padding-bottom: 0 !important;
			}


			/* =========================================================
			   SPEAKING
			========================================================= */

			#speaking {
				padding-top: 4.25rem;
				padding-bottom: 4.25rem;
			}

			#speaking .books-page-book {
				align-items: center;
				min-height: 0;
			}

			#speaking .books-page-cover-wrapper {
				display: flex;
				justify-content: center;
				align-items: center;

				border: none !important;
				border-bottom: none !important;

				padding: 0 !important;
				margin: 0;
			}

			.speaking-visual-link {
				display: block;

				width: 260px;
				height: 260px;

				margin: 0 auto;

				text-decoration: none !important;
				border: none !important;
			}

			.speaking-visual {
				box-sizing: border-box;

				display: flex;
				align-items: center;
				justify-content: center;

				width: 260px;
				height: 260px;

				padding: 1.9rem;

				border: 1px solid rgba(36, 55, 92, 0.09);
				border-radius: 20px;

				background: linear-gradient(
					145deg,
					rgba(255, 255, 255, 0.98),
					rgba(248, 250, 253, 0.98)
				);

				box-shadow:
					0 12px 30px rgba(28, 44, 76, 0.045);
			}

			.speaking-visual-title {
				width: 100%;
				margin: 0;

				font-size: 1.82rem;
				font-weight: 700;
				line-height: 1.08;
				letter-spacing: -0.035em;

				color: #24365e;
			}

			.speaking-visual-title span {
				display: block;
			}

			.speaking-visual-title .speaking-never {
				color: #4f6df5;
			}

			#speaking .books-page-content {
				align-self: center;
				max-width: 690px;
			}

			#speaking .books-page-content h2 {
				margin-top: 0;
				margin-bottom: 1rem;

				font-size: clamp(2.4rem, 3vw, 3rem);
				line-height: 1;
				letter-spacing: -0.035em;
			}

			#speaking .books-page-content > p:not(.books-page-action) {
				max-width: 680px;

				margin-top: 0;

				font-size: 1.12rem;
				line-height: 1.65;
			}

			#speaking .books-page-action {
				margin-top: 1.7rem;
			}


			/* =========================================================
			   CIO OFFICE
			========================================================= */

			#cio-office .books-page-content {
				align-self: center;
			}


			/* =========================================================
			   BOOK
			========================================================= */

			#books {
				padding-bottom: 1.25rem;
			}

			#books .books-page-book {
				padding-bottom: 0.5rem;
			}


			/* =========================================================
			   ABOUT
			========================================================= */

			#about .about-photo-wrapper {
				border: none !important;
				border-bottom: none !important;
				box-shadow: none !important;

				padding-bottom: 0 !important;

				margin-top: 2px;

				align-self: start;
				text-align: right;
			}

			#about .about-photo-wrapper::before,
			#about .about-photo-wrapper::after {
				content: none !important;
				display: none !important;

				border: none !important;
				box-shadow: none !important;
			}

			#about .about-photo-wrapper a {
				display: block;

				border: none !important;
				border-bottom: none !important;
				box-shadow: none !important;

				text-decoration: none !important;
			}

			#about .about-photo {
				display: block;

				width: 90%;
				max-width: 90%;

				margin-left: auto;

				border: none !important;
				border-bottom: none !important;
				box-shadow: none !important;
			}


			/* =========================================================
			   TABLET / MOBILE
			========================================================= */

			@media (max-width: 900px) {
				#speaking {
					padding-top: 3.25rem;
					padding-bottom: 3.25rem;
				}

				.speaking-visual-link,
				.speaking-visual {
					width: 235px;
					height: 235px;
				}

				.speaking-visual {
					padding: 1.65rem;
				}

				.speaking-visual-title {
					font-size: 1.62rem;
				}

				#speaking .books-page-content h2 {
					font-size: 2.35rem;
				}

				#speaking .books-page-content > p:not(.books-page-action) {
					font-size: 1.05rem;
				}

				#about .about-photo-wrapper {
					margin-top: 0;
					text-align: center;
				}

				#about .about-photo {
					margin-left: auto;
					margin-right: auto;
				}
			}


			@media (max-width: 640px) {
				#speaking {
					padding-top: 2.75rem;
					padding-bottom: 2.75rem;
				}

				.speaking-visual-link,
				.speaking-visual {
					width: 220px;
					height: 220px;
				}

				.speaking-visual {
					padding: 1.5rem;
				}

				.speaking-visual-title {
					font-size: 1.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Technology is <span class="accent">never</span>
					</span>

					<span class="hero-line">
						the starting point
					</span>
				</h1>

				<div class="lead-principles">
					<div>People First</div>
					<div>Business Driven</div>
					<div>Technology Enabled</div>
				</div>
			</section>


			<!-- =====================================================
			     SPEAKING
			===================================================== -->

			<section
				id="speaking"
				class="contact-section reveal-section"
			>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-speaking-title"
				>

					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/speaking/"
							class="speaking-visual-link"
							aria-label="Explore speaking"
						>
							<div class="speaking-visual animated-image">
								<h3 class="speaking-visual-title">
									<span>Technology is</span>
									<span class="speaking-never">never</span>
									<span>the starting</span>
									<span>point</span>
								</h3>
							</div>
						</a>
					</div>


					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-speaking-title">
							Speaking
						</h2>

						<p>
							Talks and conversations about technology leadership,
							business value, transformation, organizational change,
							and the decisions that shape how technology creates
							impact
						</p>

						<p class="books-page-action">
							<a
								href="/speaking/"
								class="animated-link"
							>
								<span>Explore speaking</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

				</article>
			</section>


			<!-- =====================================================
			     CIO OFFICE
			===================================================== -->

			<section
				id="cio-office"
				class="contact-section reveal-section"
			>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-office-title"
				>

					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/cio-office/"
							class="books-page-cover-link"
							aria-label="Explore the CIO Office"
						>
							<img
								src="/images/cio-office-logo.png"
								alt="CIO Office"
								class="cio-office-capabilities-logo animated-image"
							/>
						</a>
					</div>


					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-cio-office-title">
							Technology that Creates Business Value
						</h2>

						<p>
							Advisory for organizations seeking to align technology
							with business goals, strengthen operations, and
							accelerate transformation
						</p>

						<p class="books-page-action">
							<a
								href="/cio-office/"
								class="animated-link"
							>
								<span>Learn about the CIO Office</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

				</article>
			</section>


			<!-- =====================================================
			     BOOK
			===================================================== -->

			<section
				id="books"
				class="contact-section reveal-section"
			>
				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-book-title"
				>

					<div
						class="books-page-cover-wrapper reveal-item reveal-from-left reveal-delay-1"
					>
						<a
							href="/cio-book/"
							class="books-page-cover-link"
							aria-label="Learn more about How to Become CIO and Succeed"
						>
							<img
								src="/images/cio-book-cover.png"
								alt="Cover of How to Become CIO and Succeed"
								class="books-page-cover animated-book-cover"
							/>
						</a>
					</div>


					<div
						class="books-page-content reveal-item reveal-delay-2"
					>
						<h2 id="home-cio-book-title">
							How to Become CIO and Succeed
						</h2>

						<p class="books-page-subtitle">
							People, Business, Strategy
						</p>

						<p>
							The CIO role is not about managing systems. It is about
							leading people, shaping strategy, influencing the
							business, and turning technology into a competitive
							advantage. This is the book I wish I had when I began my
							leadership journey
						</p>

						<p class="books-page-action">
							<a
								href="/cio-book/"
								class="animated-link"
							>
								<span>Explore the book</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>

				</article>
			</section>


			<!-- =====================================================
			     ABOUT
			===================================================== -->

			<section
				id="about"
				class="contact-section reveal-section"
			>
				<div class="about-layout">

					<div
						class="about-content reveal-item reveal-delay-1"
					>
						<p>
							I am a Chief Information Officer (CIO) with more than
							15 years of international IT leadership experience
							helping global organizations create business value
						</p>

						<p>
							My approach combines strategic thinking, practical
							execution, strong relationships, and a service-oriented
							culture focused on operational excellence and continuous
							improvement
						</p>

						<p class="books-page-action">
							<a
								href="/about/"
								class="animated-link"
							>
								<span>My journey</span>

								<span
									class="animated-link-arrow"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</p>
					</div>


					<div
						class="about-photo-wrapper reveal-item reveal-from-right reveal-delay-2"
					>
						<a
							href="/about/"
							aria-label="Learn more about Fede Rodrigo"
						>
							<img
								src="/images/fede.png"
								alt="Fede Rodrigo, Chief Information Officer, author, and speaker"
								class="about-photo animated-image"
							/>
						</a>
					</div>

				</div>
			</section>

		</main>

		<Footer />


		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.12,
					rootMargin: '0px 0px -60px 0px'
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>

	</body>
</html>
