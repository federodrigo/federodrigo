---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<SEO
			title="Fede Rodrigo | CIO, Author and Technology Leader"
			description="Fede Rodrigo is a Chief Information Officer, author, and technology leader focused on business value, leadership, technology strategy, operational excellence, and transformation"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1>
					Technology is <span class="accent">never</span><br />
					the starting point
				</h1>

				<div class="lead-principles">
					<div>People First</div>
					<div>Business Driven</div>
					<div>Technology Enabled</div>
				</div>
			</section>

			<section id="about">
				<h2>About</h2>

				<div class="about-layout">
					<div class="about-content">
						<p>
							I am a Chief Information Officer with more than 25
							years of experience helping global organizations use
							technology to create business value
						</p>

						<p>
							My approach combines strategic thinking, practical
							execution, strong relationships, and a service-oriented
							culture focused on operational excellence and continuous
							improvement
						</p>

						<p class="book-action">
							<a href="/about/">
								Learn more about me →
							</a>
						</p>
					</div>

					<div class="about-photo-wrapper">
						<img
							src="/images/fede.png"
							alt="Fede Rodrigo, Chief Information Officer and author"
							class="about-photo"
						/>
					</div>
				</div>
			</section>

			<section id="books" class="contact-section">
				<h2>Book</h2>

				<article
					class="books-page-book books-page-book-featured"
					aria-labelledby="home-cio-book-title"
				>
					<div class="books-page-cover-wrapper">
						<a
							href="/books/"
							class="books-page-cover-link"
							aria-label="Learn more about How to Become CIO and Succeed"
						>
							<img
								src="/images/cio-book-cover.jpg"
								alt="Cover of How to Become CIO and Succeed"
								class="books-page-cover"
							/>
						</a>
					</div>

					<div class="books-page-content">
						<p class="books-page-label">
							Featured Book
						</p>

						<h3 id="home-cio-book-title">
							How to Become CIO and Succeed
						</h3>

						<p class="books-page-subtitle">
							People, Business, Strategy
						</p>

						<p>
							A practical field guide for current and aspiring
							technology leaders who want to connect IT with business
							value, build strong teams, and succeed in the CIO role
						</p>

						<p class="books-page-action">
							<a href="/books/">
								Explore the book →
							</a>
						</p>
					</div>
				</article>
			</section>

<h2>Contact</h2>

<p class="contact-intro">
	For advisory, speaking engagements, podcasts, media, or general inquiries
</p>

<div class="contact-page-links">
	<div class="contact-page-item">
		<span class="contact-page-icon" aria-hidden="true">
			✉
		</span>

		<div>
			<p class="contact-page-item-label">
				Email
			</p>

			<a href="mailto:contact@federodrigo.com">
				contact@federodrigo.com
			</a>
		</div>
	</div>

	<div class="contact-page-item">
		<span
			class="contact-page-icon contact-page-linkedin-icon"
			aria-hidden="true"
		>
			in
		</span>

		<div>
			<p class="contact-page-item-label">
				LinkedIn
			</p>

			<a
				href="https://www.linkedin.com/in/fede-rodrigo/"
				target="_blank"
				rel="noopener noreferrer"
			>
				linkedin.com/in/fede-rodrigo
			</a>
		</div>
	</div>
</div>



		</main>

		<Footer />
	</body>
</html>
