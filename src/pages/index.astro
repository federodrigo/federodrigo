---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<SEO
			title="Fede Rodrigo | CIO, Author and Technology Leader"
			description="Fede Rodrigo is a Chief Information Officer, author, and technology leader focused on business value, leadership, technology strategy, operational excellence, and transformation"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1>
					Technology is <span class="accent">never</span><br />
					the starting point
				</h1>

				<div class="lead-principles">
					<div>People First</div>
					<div>Business Driven</div>
					<div>Technology Enabled</div>
				</div>
			</section>

			<section id="about">
				<h2>About</h2>

				<div class="about-layout">
					<div class="about-content">
						<p>
							I am a Chief Information Officer with more than 25
							years of experience helping global organizations use
							technology to create business value
						</p>

						<p>
							My approach combines strategic thinking, practical
							execution, strong relationships, and a service-oriented
							culture focused on operational excellence and continuous
							improvement
						</p>

						<p class="book-action">
							<a href="/about/">
								Learn more about me →
							</a>
						</p>
					</div>

					<div class="about-photo-wrapper">
						<img
							src="/images/fede.png"
							alt="Fede Rodrigo, Chief Information Officer and author"
							class="about-photo"
						/>
					</div>
				</div>
			</section>

			<section id="cio-office">
				<h2>The CIO Office</h2>

				<div class="leadership-grid">
					<div class="leadership-card">
						<h3>Operational Excellence & Security</h3>

						<p>
							Build reliable, secure, and resilient technology
							operations through a culture of service and operational
							excellence
						</p>
					</div>

					<div class="leadership-card">
						<h3>Driving Business Growth</h3>

						<p>
							Connect technology strategy with business priorities,
							customer needs, execution, and long-term value creation
						</p>
					</div>

					<div class="leadership-card">
						<h3>Innovation & Continuous Improvement</h3>

						<p>
							Create an environment where teams challenge assumptions,
							improve how the organization works, and turn ideas into
							results
						</p>
					</div>
				</div>

				<p class="book-action">
					<a href="/cio-office/">
						Explore The CIO Office →
					</a>
				</p>
			</section>

			<section id="books">
				<h2>Book</h2>

				<div class="about-layout book-layout">
					<div class="book-cover-wrapper">
						<img
							src="/images/cio-book-cover.jpg"
							alt="How to Become CIO and Succeed"
							class="book-cover"
						/>
					</div>

					<div class="about-content">
						<h3>How to Become CIO and Succeed</h3>

						<p class="book-subtitle">
							People, Business, Strategy
						</p>

						<p>
							A practical guide for technology leaders who want
							to connect IT with business value, build strong
							teams, and succeed in the CIO role
						</p>

						<p class="book-action">
							<a href="/books/">
								Explore the book →
							</a>
						</p>
					</div>
				</div>
			</section>

			<section id="media">
				<h2>Media</h2>

				<div class="about-content">
					<p>
						Conversations about technology leadership, business value,
						the CIO role, transformation, execution, and the future of
						technology
					</p>

					<p class="book-action">
						<a href="/media/">
							Explore media appearances →
						</a>
					</p>
				</div>
			</section>

			<section id="contact" class="contact-section">
				<h2>Contact</h2>

				<p class="contact-intro">
					For advisory, speaking engagements, podcasts, media, or
					general inquiries
				</p>

				<p class="book-action">
					<a href="/contact/">
						Get in touch →
					</a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
