---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type MediaItem = {
	type: string;
	title: string;
	date: string;
	image: string;
	imageAlt: string;
	url?: string;
	linkLabel?: string;
	pdfUrl?: string;
	pdfLabel?: string;
	internal?: boolean;
	imageFit?: 'cover' | 'contain';
	imagePosition?: string;
	imageClass?: string;
};

const mediaItems: MediaItem[] = [
	{
		type: 'Webinar',
		title: 'Technology is Never the Starting Point — Xseed',
		date: 'August 2026',
		image: '/images/xseed-webinar.png',
		imageAlt:
			'Technology is Never the Starting Point webinar with Federico Rodrigo',
		url: '/webinar/',
		linkLabel: 'Explore the talk',
		internal: true,
		imageFit: 'contain',
		imagePosition: 'center center',
	},
	{
		type: 'Podcast',
		title: 'The Technology Vanguard',
		date: 'August 2026',
		image: '/images/vanguard.png',
		imageAlt:
			'Fede Rodrigo appearing on The Technology Vanguard podcast',
		url: 'https://www.youtube.com/watch?v=2wyTHhaOcWE',
		linkLabel: 'Watch the conversation',
		imageFit: 'cover',
		imagePosition: 'center 42%',
		imageClass: 'media-image-vanguard',
	},
	{
		type: 'Interview',
		title: 'Cloud Investment & Business Value — Nublit',
		date: 'January 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt:
			'Interview with Fede Rodrigo published by Nublit',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'View full report',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Read my interview',
		imageFit: 'contain',
		imagePosition: 'center center',
		imageClass: 'media-image-nublit',
	},
	{
		type: 'Executive Roundtable',
		title: 'Industrial Reinvention — The Economist',
		date: 'September 2024',
		image: '/images/impact.png',
		imageAlt: 'The Economist Impact',
		imageFit: 'cover',
		imagePosition: 'center 38%',
		imageClass: 'media-image-economist',
	},
	{
		type: 'Recognition',
		title: 'ORBIE CIO Awards',
		date: 'September 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'ORBIE Awards CIO Central Texas',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'View recognition',
		imageFit: 'cover',
		imagePosition: 'center 42%',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Speaking | Fede Rodrigo"
			description="Speaking engagements, webinars, executive sessions, podcasts, interviews, and conversations on technology, business, leadership, and execution"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Speaking
					</span>
				</h1>

				<div class="lead-principles">
					<div>Technology Is Part of the Job</div>
					<div>Leadership Is the Job</div>
				</div>
			</section>


			<!-- =====================================================
			     SPEAKING SLIDES
			===================================================== -->

			<section
				class="speaking-showcase reveal-section"
				aria-label="Selected ideas from Fede Rodrigo's talks"
			>
				<div
					class="speaking-slider reveal-item"
					data-speaking-slider
				>

					<div class="speaking-slider-stage">

						<!-- SLIDE 1 -->

						<figure
							class="speaking-slide is-active"
							data-speaking-slide
							aria-hidden="false"
						>
							<img
								class="speaking-slide-image"
								src="/images/speaking-slide-question-clean.png"
								alt="What if your next technology decision started with no technology at all?"
								loading="eager"
							/>
						</figure>


						<!-- SLIDE 2 -->

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/speaking-slide-business-value.png"
								alt="Why does IT exist? To create business value"
								loading="lazy"
							/>
						</figure>


						<!-- SLIDE 3 -->

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/speaking-slide-leadership.png"
								alt="Technology will always change. Leadership won't. Technology is never the starting point"
								loading="lazy"
							/>
						</figure>

					</div>


					<!-- SLIDER DOTS -->

					<div
						class="speaking-slider-nav"
						aria-label="Choose slide"
					>
						<button
							type="button"
							class="speaking-slider-dot is-active"
							data-speaking-dot="0"
							aria-label="Show slide 1"
							aria-current="true"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="1"
							aria-label="Show slide 2"
							aria-current="false"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="2"
							aria-label="Show slide 3"
							aria-current="false"
						></button>
					</div>

				</div>
			</section>


			<!-- =====================================================
			     SPEAKING INTRO
			===================================================== -->

			<section class="speaking-intro reveal-section">

				<div class="speaking-intro-copy reveal-item">

<p>
	Companies sometimes start with one problem, buy a new system to solve it,
	and end up with the original problem plus five new ones.
	<strong>
		Technology is not the starting point. The business problem is.
	</strong>
</p>
				</div>

			</section>


			<div
				class="speaking-divider"
				aria-hidden="true"
			></div>


			<!-- =====================================================
			     Recent Engagements
			===================================================== -->

			<section
				class="media-events reveal-section"
				aria-labelledby="media-events-title"
			>

				<h2
					id="media-events-title"
					class="reveal-item"
				>
					Recent Engagements
				</h2>


				<div class="media-grid">

					{
						mediaItems.map((item, index) => (

							<article
								class:list={[
									'media-card',
									'reveal-item',
									{
										'media-card--nublit':
											Boolean(item.pdfUrl),
									},
								]}
								style={`
									--delay: ${index * 60}ms;
									--media-fit: ${item.imageFit ?? 'cover'};
									--media-position: ${item.imagePosition ?? 'center center'};
								`}
							>

								<!-- IMAGE -->

								<div class="media-card-image">

									{
										item.url ? (

											<a
												href={item.url}
												target={
													item.internal
														? undefined
														: '_blank'
												}
												rel={
													item.internal
														? undefined
														: 'noopener noreferrer'
												}
												aria-label={
													item.linkLabel ??
													item.title
												}
											>

												<img
													class:list={[
														'media-card-image-element',
														item.imageClass,
													]}
													src={item.image}
													alt={item.imageAlt}
													loading="lazy"
												/>

											</a>

										) : (

											<img
												class:list={[
													'media-card-image-element',
													item.imageClass,
												]}
												src={item.image}
												alt={item.imageAlt}
												loading="lazy"
											/>

										)
									}

								</div>


								<!-- CONTENT -->

								<div class="media-card-content">

									<p class="media-card-meta">

										<span>
											{item.type}
										</span>

										<span aria-hidden="true">
											·
										</span>

										<span>
											{item.date}
										</span>

									</p>


									<h3>
										{item.title}
									</h3>


									{
										(item.url || item.pdfUrl) && (

											<div class="media-card-actions">

												{
													item.pdfUrl &&
													item.pdfLabel && (

														<a
															href={item.pdfUrl}
															target="_blank"
															rel="noopener noreferrer"
															class="animated-link"
														>

															<span>
																{item.pdfLabel}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>

														</a>

													)
												}


												{
													item.url && (

														<a
															href={item.url}
															target={
																item.internal
																	? undefined
																	: '_blank'
															}
															rel={
																item.internal
																	? undefined
																	: 'noopener noreferrer'
															}
															class="animated-link"
														>

															<span>
																{
																	item.linkLabel ??
																	'Learn more'
																}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>

														</a>

													)
												}

											</div>

										)
									}

								</div>

							</article>

						))
					}

				</div>

			</section>


			<!-- =====================================================
			     SPEAKING INQUIRIES
			===================================================== -->

			<section class="media-contact reveal-section">

				<h2 class="reveal-item">
					Speaking Inquiries
				</h2>


				<div class="reveal-item reveal-delay-1">

					<p>
						For speaking engagements, interviews, podcasts,
						or other media opportunities, please get in touch
					</p>


					<p class="media-contact-link">

						<a
							href="/contact/"
							class="animated-link"
						>

							<span>
								Contact me
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>

						</a>

					</p>

				</div>

			</section>

		</main>

		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>

			const sections =
				document.querySelectorAll(
					'.reveal-section'
				);


			const revealObserver =
				new IntersectionObserver(

					(entries, observer) => {

						entries.forEach(
							(entry) => {

								if (!entry.isIntersecting) {
									return;
								}


								entry.target.classList.add(
									'is-visible'
								);


								observer.unobserve(
									entry.target
								);

							}
						);

					},

					{
						threshold: 0.08,
						rootMargin:
							'0px 0px -50px 0px',
					}

				);


			sections.forEach(
				(section) => {

					revealObserver.observe(
						section
					);

				}
			);

		</script>


		<!-- =====================================================
		     SLIDER
		===================================================== -->

		<script>

			const speakingSlider =
				document.querySelector(
					'[data-speaking-slider]'
				);


			if (speakingSlider) {

				const slides =
					Array.from(
						speakingSlider.querySelectorAll(
							'[data-speaking-slide]'
						)
					);


				const dots =
					Array.from(
						speakingSlider.querySelectorAll(
							'[data-speaking-dot]'
						)
					);


				const reducedMotion =
					window.matchMedia(
						'(prefers-reduced-motion: reduce)'
					).matches;


				let currentSlide = 0;
				let slideTimer = null;
				let sliderVisible = false;


				const durations = [
					7000,
					5200,
					5200,
				];


				function showSlide(index) {

					currentSlide =
						(
							index +
							slides.length
						) %
						slides.length;


					slides.forEach(
						(
							slide,
							slideIndex
						) => {

							const active =
								slideIndex ===
								currentSlide;


							slide.classList.toggle(
								'is-active',
								active
							);


							slide.setAttribute(
								'aria-hidden',
								active
									? 'false'
									: 'true'
							);

						}
					);


					dots.forEach(
						(
							dot,
							dotIndex
						) => {

							const active =
								dotIndex ===
								currentSlide;


							dot.classList.toggle(
								'is-active',
								active
							);


							dot.setAttribute(
								'aria-current',
								active
									? 'true'
									: 'false'
							);

						}
					);

				}


				function stopSlider() {

					if (!slideTimer) {
						return;
					}


					window.clearTimeout(
						slideTimer
					);


					slideTimer = null;

				}


				function scheduleNextSlide() {

					if (
						reducedMotion ||
						!sliderVisible
					) {
						return;
					}


					stopSlider();


					slideTimer =
						window.setTimeout(

							() => {

								showSlide(
									currentSlide + 1
								);


								scheduleNextSlide();

							},

							durations[
								currentSlide
							]

						);

				}


				dots.forEach(
					(dot, index) => {

						dot.addEventListener(
							'click',

							() => {

								showSlide(
									index
								);


								scheduleNextSlide();

							}
						);

					}
				);


				speakingSlider.addEventListener(
					'mouseenter',
					stopSlider
				);


				speakingSlider.addEventListener(
					'mouseleave',
					scheduleNextSlide
				);


				const speakingSliderObserver =
					new IntersectionObserver(

						(entries) => {

							entries.forEach(
								(entry) => {

									sliderVisible =
										entry.isIntersecting;


									if (
										sliderVisible
									) {

										scheduleNextSlide();

									} else {

										stopSlider();

									}

								}
							);

						},

						{
							threshold: 0.35,
						}

					);


				speakingSliderObserver.observe(
					speakingSlider
				);


				document.addEventListener(
					'visibilitychange',

					() => {

						if (
							document.hidden
						) {

							stopSlider();

						} else {

							scheduleNextSlide();

						}

					}
				);

			}

		</script>

	</body>
</html>


<style>

	/* =========================================================
	   HERO
	   NOT TOUCHED
	========================================================= */


	/* =========================================================
	   SLIDES
	========================================================= */

	.speaking-showcase {

		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		margin:
			18px auto 10px;

	}


	.speaking-slider {

		width: 100%;

	}


	.speaking-slider-stage {

		position: relative;

		width: 100%;

		aspect-ratio: 16 / 9;

		overflow: hidden;

		border-radius: 14px;

		background: #ffffff;

		box-shadow:
			0 18px 45px
			rgba(
				16,
				43,
				70,
				0.07
			);

	}


	.speaking-slide {

		position: absolute;

		inset:
			clamp(
				30px,
				3vw,
				48px
			);

		display: flex;

		align-items: center;

		justify-content: center;

		margin: 0;

		opacity: 0;

		pointer-events: none;

		transition:
			opacity 650ms ease;

	}


	.speaking-slide.is-active {

		z-index: 2;

		opacity: 1;

		pointer-events: auto;

	}


	.speaking-slide-image {

		display: block !important;

		width: 100% !important;

		height: 100% !important;

		max-width: 100% !important;

		max-height: 100% !important;

		object-fit:
			contain !important;

		object-position:
			center center !important;

		background:
			#ffffff;

	}


	/* =========================================================
	   SLIDER DOTS
	========================================================= */

	.speaking-slider-nav {

		display: flex;

		align-items: center;

		justify-content: center;

		gap: 8px;

		height: 30px;

		margin-top: 5px;

	}


	.speaking-slider-dot {

		width: 7px;

		height: 7px;

		padding: 0;

		border: 0;

		border-radius: 50%;

		background:
			rgba(
				16,
				43,
				70,
				0.23
			);

		cursor: pointer;

		transition:
			width 200ms ease,
			background 200ms ease,
			border-radius 200ms ease;

	}


	.speaking-slider-dot.is-active {

		width: 23px;

		border-radius:
			999px;

		background:
			#102b46;

	}


	/* =========================================================
	   SPEAKING INTRO
	========================================================= */

	.speaking-intro {

		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		margin:
			14px auto 30px;

		padding:
			0 !important;

	}


	.speaking-intro-copy {

		max-width:
			790px;

	}


	.speaking-intro p {

		margin:
			0;

		color:
			#5f7083;

		font-size:
			clamp(
				1.05rem,
				1.45vw,
				1.22rem
			);

		line-height:
			1.65;

	}


	.speaking-intro strong {

		color:
			#102b46;

		font-weight:
			650;

	}


	.speaking-divider {

		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		height:
			1px;

		margin:
			0 auto 30px;

		background:
			rgba(
				16,
				43,
				70,
				0.12
			);

	}


	/* =========================================================
	   MEDIA & EVENTS
	========================================================= */

	.media-events {

		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		margin:
			0 auto 20px !important;

		padding:
			0 !important;

	}


	.media-events > h2 {

		margin:
			0 0 22px;

		color:
			#102b46;

		font-size:
			clamp(
				1.95rem,
				2.9vw,
				2.75rem
			);

		font-weight:
			600;

		line-height:
			1.05;

		letter-spacing:
			-0.035em;

	}


	.media-grid {

		display:
			grid;

		grid-template-columns:
			repeat(
				3,
				minmax(
					0,
					1fr
				)
			);

		gap:
			18px;

	}


	/* =========================================================
	   MEDIA CARD
	========================================================= */

	.media-card {

		display:
			flex;

		flex-direction:
			column;

		width:
			100%;

		height:
			300px;

		min-width:
			0;

		overflow:
			hidden;

		border:
			1px solid
			rgba(
				16,
				43,
				70,
				0.10
			);

		border-radius:
			13px;

		background:
			#ffffff;

		transition:
			transform 200ms ease,
			box-shadow 200ms ease;

	}


	.media-card:hover {

		transform:
			translateY(-2px);

		box-shadow:
			0 12px 28px
			rgba(
				16,
				43,
				70,
				0.06
			);

	}


	/* =========================================================
	   MEDIA IMAGE CONTAINER
	========================================================= */

	.media-card-image {

		flex:
			0 0 145px;

		width:
			100%;

		height:
			145px;

		overflow:
			hidden;

		background:
			#f4f5f7;

		border-bottom:
			1px solid
			rgba(
				16,
				43,
				70,
				0.08
			);

	}


	.media-card-image a {

		display:
			block;

		width:
			100%;

		height:
			100%;

	}


	.media-card-image-element {

		display:
			block !important;

		width:
			100% !important;

		height:
			100% !important;

		max-width:
			none !important;

		max-height:
			none !important;

		object-fit:
			var(
				--media-fit,
				cover
			) !important;

		object-position:
			var(
				--media-position,
				center center
			) !important;

		transform-origin:
			center center;

	}


	/* =========================================================
	   THESE ARE THE 3 VALUES TO TWEAK
	   =========================================================

	   Vanguard smaller:
	   0.80 = much smaller
	   0.90 = slightly smaller
	   1.00 = normal

	   Nublit:
	   1.10 = bigger
	   1.20 = bigger
	   1.30 = much bigger

	   Economist:
	   same logic as Vanguard
	========================================================= */


	.media-image-vanguard {

		transform:
			scale(0.70) !important;

	}


	.media-image-nublit {

		transform:
			scale(1.30) !important;

	}


	.media-image-economist {

		transform:
			scale(0.70) !important;

	}


	/* =========================================================
	   MEDIA CONTENT
	========================================================= */

	.media-card-content {

		display:
			flex;

		flex:
			1;

		flex-direction:
			column;

		min-height:
			0;

		padding:
			13px 16px 14px;

	}


	.media-card-meta {

		display:
			flex;

		flex-wrap:
			wrap;

		gap:
			5px;

		margin:
			0 0 8px;

		color:
			#7d8b9a;

		font-size:
			0.70rem;

		font-weight:
			700;

		line-height:
			1.3;

		letter-spacing:
			0.06em;

		text-transform:
			uppercase;

	}


