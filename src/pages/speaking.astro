---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type MediaItem = {
	type: string;
	title: string;
	date: string;
	image: string;
	imageAlt: string;
	url?: string;
	linkLabel?: string;
	pdfUrl?: string;
	pdfLabel?: string;
	internal?: boolean;
};

const mediaItems: MediaItem[] = [
	{
		type: 'Webinar',
		title: 'Technology is Never the Starting Point — Xseed',
		date: 'August 2026',
		image: '/images/xseed-webinar.png',
		imageAlt:
			'Technology is Never the Starting Point webinar with Federico Rodrigo',
		url: '/webinar/',
		linkLabel: 'Explore the talk',
		internal: true,
	},
	{
		type: 'Podcast',
		title: 'The Technology Vanguard',
		date: 'August 2026',
		image: '/images/vanguard.png',
		imageAlt:
			'Fede Rodrigo appearing on The Technology Vanguard podcast',
		url: 'https://www.youtube.com/watch?v=2wyTHhaOcWE',
		linkLabel: 'Watch the conversation',
	},
	{
		type: 'Written Interview',
		title: 'Turning Cloud Investment into Business Value — Nublit',
		date: 'January 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt:
			'Interview with Fede Rodrigo published by Nublit',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'View full report',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Read my interview',
	},
	{
		type: 'Executive Roundtable',
		title: 'Industrial Reinvention — The Economist',
		date: 'September 2024',
		image: '/images/impact.png',
		imageAlt: 'The Economist Impact',
	},
	{
		type: 'Recognition',
		title: 'ORBIE CIO Awards',
		date: 'September 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'ORBIE Awards CIO Central Texas',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'View recognition',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Speaking | Fede Rodrigo"
			description="Speaking engagements, webinars, executive sessions, podcasts, interviews, and conversations on technology, business, leadership, and execution"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     HERO
			     ORIGINAL STRUCTURE — DO NOT TOUCH ANIMATION
			===================================================== -->

			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Speaking
					</span>
				</h1>

				<div class="lead-principles">
					<div>Technology Is Part of the Job</div>
					<div>Leadership Is the Job</div>
				</div>
			</section>


			<!-- =====================================================
			     SPEAKING SLIDES
			===================================================== -->

			<section
				class="speaking-showcase reveal-section"
				aria-label="Selected ideas from Fede Rodrigo's talks"
			>
				<div
					class="speaking-slider reveal-item"
					data-speaking-slider
				>

					<!-- SLIDE 1 -->

					<figure
						class="speaking-slide is-active"
						data-speaking-slide
						aria-hidden="false"
					>
						<img
							src="/images/speaking-slide-question-clean.png"
							alt="What if your next technology decision started with no technology at all?"
							loading="eager"
						/>
					</figure>


					<!-- SLIDE 2 -->

					<figure
						class="speaking-slide"
						data-speaking-slide
						aria-hidden="true"
					>
						<img
							src="/images/speaking-slide-business-value.png"
							alt="Why does IT exist? To create business value"
							loading="lazy"
						/>
					</figure>


					<!-- SLIDE 3 -->

					<figure
						class="speaking-slide"
						data-speaking-slide
						aria-hidden="true"
					>
						<img
							src="/images/speaking-slide-leadership.png"
							alt="Technology will always change. Leadership won't. Technology is never the starting point"
							loading="lazy"
						/>
					</figure>


					<!-- DOTS -->

					<div
						class="speaking-slider-nav"
						aria-label="Choose slide"
					>
						<button
							type="button"
							class="speaking-slider-dot is-active"
							data-speaking-dot="0"
							aria-label="Show slide 1"
							aria-current="true"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="1"
							aria-label="Show slide 2"
							aria-current="false"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="2"
							aria-label="Show slide 3"
							aria-current="false"
						></button>
					</div>

				</div>
			</section>


			<!-- =====================================================
			     MEDIA & EVENTS
			===================================================== -->

			<section
				class="media-events reveal-section"
				aria-labelledby="media-events-title"
			>
				<h2
					id="media-events-title"
					class="reveal-item"
				>
					Media & Events
				</h2>

				<div class="media-grid">
					{
						mediaItems.map((item, index) => (
							<article
								class="media-card reveal-item"
								style={`--delay: ${index * 60}ms`}
							>

								<div class="media-card-image">
									{
										item.url ? (
											<a
												href={item.url}
												target={
													item.internal
														? undefined
														: '_blank'
												}
												rel={
													item.internal
														? undefined
														: 'noopener noreferrer'
												}
												aria-label={
													item.linkLabel ??
													item.title
												}
											>
												<img
													src={item.image}
													alt={item.imageAlt}
													loading="lazy"
												/>
											</a>
										) : (
											<img
												src={item.image}
												alt={item.imageAlt}
												loading="lazy"
											/>
										)
									}
								</div>


								<div class="media-card-content">

									<p class="media-card-meta">
										<span>{item.type}</span>

										<span aria-hidden="true">
											·
										</span>

										<span>{item.date}</span>
									</p>


									<h3>
										{item.title}
									</h3>


									{
										(item.url || item.pdfUrl) && (
											<div class="media-card-actions">

												{
													item.pdfUrl &&
													item.pdfLabel && (
														<a
															href={item.pdfUrl}
															target="_blank"
															rel="noopener noreferrer"
															class="animated-link"
														>
															<span>
																{item.pdfLabel}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>
														</a>
													)
												}


												{
													item.url && (
														<a
															href={item.url}
															target={
																item.internal
																	? undefined
																	: '_blank'
															}
															rel={
																item.internal
																	? undefined
																	: 'noopener noreferrer'
															}
															class="animated-link"
														>
															<span>
																{
																	item.linkLabel ??
																	'Learn more'
																}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>
														</a>
													)
												}

											</div>
										)
									}

								</div>

							</article>
						))
					}
				</div>
			</section>


			<!-- =====================================================
			     CONTACT
			===================================================== -->

			<section class="media-contact reveal-section">

				<h2 class="reveal-item">
					Speaking Inquiries
				</h2>

				<div class="reveal-item reveal-delay-1">

					<p>
						For speaking engagements, interviews, podcasts,
						or other media opportunities, please get in touch
					</p>

					<p class="media-contact-link">
						<a
							href="/contact/"
							class="animated-link"
						>
							<span>Contact me</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>

				</div>

			</section>

		</main>

		<Footer />


		<!-- =====================================================
		     EXISTING REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver =
				new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;

							entry.target.classList.add(
								'is-visible'
							);

							observer.unobserve(
								entry.target
							);
						});
					},
					{
						threshold: 0.08,
						rootMargin:
							'0px 0px -50px 0px',
					}
				);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>


		<!-- =====================================================
		     SPEAKING SLIDER
		     ONLY AFFECTS THE SLIDES
		===================================================== -->

		<script>
			const speakingSlider =
				document.querySelector(
					'[data-speaking-slider]'
				);

			if (speakingSlider) {

				const slides = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-slide]'
					)
				);

				const dots = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-dot]'
					)
				);

				const reducedMotion =
					window.matchMedia(
						'(prefers-reduced-motion: reduce)'
					).matches;

				let currentSlide = 0;
				let slideTimer = null;
				let sliderVisible = false;


				/*
					First slide gets more time because
					it is the opening question.
				*/

				const durations = [
					7000,
					5200,
					5200,
				];


				function showSlide(index) {

					currentSlide =
						(index + slides.length) %
						slides.length;

					slides.forEach(
						(slide, slideIndex) => {

							const active =
								slideIndex ===
								currentSlide;

							slide.classList.toggle(
								'is-active',
								active
							);

							slide.setAttribute(
								'aria-hidden',
								active
									? 'false'
									: 'true'
							);
						}
					);


					dots.forEach(
						(dot, dotIndex) => {

							const active =
								dotIndex ===
								currentSlide;

							dot.classList.toggle(
								'is-active',
								active
							);

							dot.setAttribute(
								'aria-current',
								active
									? 'true'
									: 'false'
							);
						}
					);
				}


				function stopSlider() {

					if (slideTimer) {
						window.clearTimeout(
							slideTimer
						);

						slideTimer = null;
					}
				}


				function scheduleNextSlide() {

					if (
						reducedMotion ||
						!sliderVisible
					) {
						return;
					}

					stopSlider();

					slideTimer =
						window.setTimeout(
							() => {

								showSlide(
									currentSlide + 1
								);

								scheduleNextSlide();
							},
							durations[
								currentSlide
							]
						);
				}


				dots.forEach(
					(dot, index) => {

						dot.addEventListener(
							'click',
							() => {

								showSlide(index);

								scheduleNextSlide();
							}
						);
					}
				);


				speakingSlider.addEventListener(
					'mouseenter',
					() => {
						stopSlider();
					}
				);


				speakingSlider.addEventListener(
					'mouseleave',
					() => {
						scheduleNextSlide();
					}
				);


				const speakingSliderObserver =
					new IntersectionObserver(
						(entries) => {

							entries.forEach(
								(entry) => {

									sliderVisible =
										entry.isIntersecting;

									if (
										sliderVisible
									) {
										scheduleNextSlide();
									} else {
										stopSlider();
									}
								}
							);
						},
						{
							threshold: 0.35,
						}
					);


				speakingSliderObserver.observe(
					speakingSlider
				);


				document.addEventListener(
					'visibilitychange',
					() => {

						if (document.hidden) {
							stopSlider();
						} else {
							scheduleNextSlide();
						}
					}
				);

			}
		</script>

	</body>
</html>


<style>

	/* =========================================================
	   IMPORTANT:
	   NOTHING HERE OVERRIDES .hero, .hero-title,
	   .hero-line OR .lead-principles
	========================================================= */


	/* =========================================================
	   SLIDES
	========================================================= */

	.speaking-showcase {
		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		margin:
			20px auto 58px;
	}


	.speaking-slider {
		position: relative;

		width: 100%;

		aspect-ratio: 16 / 9;

		overflow: hidden;

		border-radius: 14px;

		background: #f5f7f9;

		box-shadow:
			0 18px 45px
			rgba(
				16,
				43,
				70,
				0.07
			);
	}


	.speaking-slide {
		position: absolute;

		inset: 0;

		margin: 0;

		opacity: 0;

		transform:
			scale(1.006);

		pointer-events: none;

		transition:
			opacity 700ms ease,
			transform 1300ms
				cubic-bezier(
					0.22,
					1,
					0.36,
					1
				);
	}


	.speaking-slide.is-active {
		z-index: 2;

		opacity: 1;

		transform:
			scale(1);

		pointer-events: auto;
	}


	.speaking-slide img {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;
	}


	/* =========================================================
	   SLIDE NAVIGATION
	========================================================= */

	.speaking-slider-nav {
		position: absolute;

		z-index: 10;

		left: 50%;
		bottom: 15px;

		display: flex;

		align-items: center;

		gap: 8px;

		padding:
			8px 11px;

		border-radius:
			999px;

		background:
			rgba(
				255,
				255,
				255,
				0.82
			);

		backdrop-filter:
			blur(10px);

		transform:
			translateX(-50%);
	}


	.speaking-slider-dot {
		width: 7px;
		height: 7px;

		padding: 0;

		border: 0;

		border-radius: 50%;

		background:
			rgba(
				16,
				43,
				70,
				0.25
			);

		cursor: pointer;

		transition:
			width 200ms ease,
			background 200ms ease,
			border-radius 200ms ease;
	}


	.speaking-slider-dot.is-active {
		width: 23px;

		border-radius:
			999px;

		background:
			#102b46;
	}


	/* =========================================================
	   MEDIA & EVENTS
	========================================================= */

	.media-events {
		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		margin:
			0 auto
			clamp(
				85px,
				8vw,
				120px
			);
	}


	.media-events > h2 {
		margin:
			0 0 28px;

		color: #102b46;

		font-size:
			clamp(
				1.85rem,
				2.8vw,
				2.65rem
			);

		font-weight: 600;

		line-height: 1.05;

		letter-spacing:
			-0.035em;
	}


	.media-grid {
		display: grid;

		grid-template-columns:
			repeat(
				3,
				minmax(0, 1fr)
			);

		gap: 20px;
	}


	/* =========================================================
	   MEDIA CARD
	========================================================= */

	.media-card {
		display: flex;

		flex-direction: column;

		min-width: 0;

		overflow: hidden;

		border:
			1px solid
			rgba(
				16,
				43,
				70,
				0.10
			);

		border-radius: 13px;

		background: #ffffff;

		transition:
			transform 200ms ease,
			box-shadow 200ms ease;
	}


	.media-card:hover {
		transform:
			translateY(-2px);

		box-shadow:
			0 13px 30px
			rgba(
				16,
				43,
				70,
				0.06
			);
	}


	.media-card-image {
		overflow: hidden;

		aspect-ratio: 16 / 9;

		background: #f1f3f5;
	}


	.media-card-image a {
		display: block;

		width: 100%;
		height: 100%;
	}


	.media-card-image img {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;

		transition:
			transform 450ms
				cubic-bezier(
					0.22,
					1,
					0.36,
					1
				);
	}


	.media-card:hover
	.media-card-image img {
		transform:
			scale(1.025);
	}


	.media-card-content {
		display: flex;

		flex: 1;

		flex-direction: column;

		padding:
			18px 18px 20px;
	}


	.media-card-meta {
		display: flex;

		flex-wrap: wrap;

		gap: 6px;

		margin:
			0 0 9px;

		color: #7d8b9a;

		font-size: 0.68rem;

		font-weight: 700;

		line-height: 1.35;

		letter-spacing:
			0.065em;

		text-transform:
			uppercase;
	}


	.media-card h3 {
		margin: 0;

		color: #102b46;

		font-size:
			clamp(
				1.02rem,
				1.35vw,
				1.2rem
			);

		font-weight: 600;

		line-height: 1.2;

		letter-spacing:
			-0.02em;
	}


	.media-card-actions {
		display: flex;

		flex-wrap: wrap;

		gap:
			8px 16px;

		margin-top: 19px;
	}


	.media-card-actions
	.animated-link {
		font-size: 0.78rem;
	}


	/* =========================================================
	   CONTACT
	   SMALL LOCAL ADJUSTMENTS ONLY
	========================================================= */

	.media-contact {
		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		margin:
			0 auto
			clamp(
				90px,
				10vw,
				145px
			);
	}


	.media-contact h2 {
		margin:
			0 0 17px;

		color: #102b46;

		font-size:
			clamp(
				1.85rem,
				2.8vw,
				2.65rem
			);

		font-weight: 600;

		line-height: 1.05;

		letter-spacing:
			-0.035em;
	}


	.media-contact p {
		max-width: 650px;

		margin:
			0;

		color: #6d7c8d;

		font-size: 1rem;

		line-height: 1.6;
	}


	.media-contact-link {
		margin-top:
			18px !important;
	}


	/* =========================================================
	   REVEALS
	========================================================= */

	.js
	.reveal-section
	.reveal-item {
		opacity: 0;

		transform:
			translateY(16px);

		transition:
			opacity 600ms ease,
			transform 600ms
				cubic-bezier(
					0.22,
					1,
					0.36,
					1
				);

		transition-delay:
			var(--delay, 0ms);
	}


	.js
	.reveal-section.is-visible
	.reveal-item {
		opacity: 1;

		transform:
			translateY(0);
	}


	.js
	.reveal-delay-1 {
		transition-delay:
			80ms !important;
	}


	/* =========================================================
	   TABLET
	========================================================= */

	@media (max-width: 900px) {

		.media-grid {
			grid-template-columns:
				repeat(
					2,
					minmax(0, 1fr)
				);
		}

	}


	/* =========================================================
	   MOBILE
	========================================================= */

	@media (max-width: 620px) {

		.speaking-showcase,
		.media-events,
		.media-contact {
			width:
				calc(
					100% - 32px
				);
		}


		.speaking-showcase {
			margin:
				14px auto 45px;
		}


		.speaking-slider {
			border-radius:
				10px;
		}


		.speaking-slider-nav {
			bottom:
				9px;

			padding:
				6px 8px;
		}


		.media-events > h2 {
			margin-bottom:
				22px;
		}


		.media-grid {
			grid-template-columns:
				1fr;
		}


		.media-card-content {
			padding:
				17px 17px 19px;
		}

	}


	/* =========================================================
	   REDUCED MOTION
	========================================================= */

	@media (
		prefers-reduced-motion:
		reduce
	) {

		.speaking-slide,
		.speaking-slider-dot,
		.media-card,
		.media-card-image img,
		.reveal-item {
			transition:
				none !important;
		}

	}

</style>
