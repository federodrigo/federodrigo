---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const capabilities = [
	{
		title: 'Executive Technology Leadership',
		description:
			'Align technology strategy, investment, governance, and execution with business priorities and long-term value',
	},
	{
		title: 'ERP & Enterprise Systems',
		description:
			'Select, oversee, assess, and recover ERP and enterprise application initiatives with independent client-side leadership',
	},
	{
		title: 'Infrastructure & Cloud',
		description:
			'Define and oversee infrastructure modernization, cloud strategy, migrations, workplace platforms, and major technology transitions',
	},
	{
		title: 'Cybersecurity & Resilience',
		description:
			'Strengthen cybersecurity strategy, governance, risk management, resilience, and business continuity',
	},
	{
		title: 'Data & AI Strategy',
		description:
			'Identify valuable data and AI opportunities, assess readiness, define governance, select solutions, and oversee execution',
	},
	{
		title: 'Fractional CIO & Advisory',
		description:
			'Support CEOs and executive teams with independent CIO-level judgment for critical technology decisions and transformations',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="CIO Office | CXY Office"
			description="Independent CIO-level advisory for ERP, infrastructure, cloud, cybersecurity, data, AI, and critical technology decisions"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="cio-office-capabilities reveal-section">
				<div class="cio-office-capabilities-heading reveal-item">
					<img
						src="/images/cio-office-logo.png"
						alt="CIO Office"
						class="cio-office-capabilities-logo animated-image"
					/>

					<h2
						class="cio-office-capabilities-tagline"
						aria-label="Strategy • Advisory • Transformation"
					>
						<span
							class="tagline-part tagline-part-1"
							aria-hidden="true"
						>
							Strategy
						</span>

						<span
							class="tagline-dot tagline-part-2 accent"
							aria-hidden="true"
						>
							•
						</span>

						<span
							class="tagline-part tagline-part-3"
							aria-hidden="true"
						>
							Advisory
						</span>

						<span
							class="tagline-dot tagline-part-4 accent"
							aria-hidden="true"
						>
							•
						</span>

						<span
							class="tagline-part tagline-part-5"
							aria-hidden="true"
						>
							Transformation
						</span>
					</h2>
				</div>

				<div class="leadership-grid">
					{
						capabilities.map((capability, index) => (
							<div
								class="leadership-card"
								style={`--card-index: ${index};`}
							>
								<h3>{capability.title}</h3>

								<p>{capability.description}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="cio-office-contact reveal-section">
				<h2 class="reveal-item">
					CXY Office
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						For independent technology advisory, ERP and transformation
						initiatives, fractional CIO engagements, or critical
						technology decisions, please reach out directly
					</p>

					<p class="cio-office-contact-link">
						<a href="/contact/" class="animated-link">
							<span>Contact me</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.12,
					rootMargin: '0px 0px -60px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>

		<style>
			.cio-office-capabilities-tagline span {
				display: inline-block;
			}

			.js .cio-office-capabilities-tagline span {
				opacity: 0;
				transform: translateY(12px);
			}

			.cio-office-capabilities.is-visible
				.cio-office-capabilities-tagline
				span {
				animation: tagline-reveal 0.7s
					cubic-bezier(0.22, 1, 0.36, 1) forwards;
			}

			.cio-office-capabilities.is-visible .tagline-part-1 {
				animation-delay: 0.15s;
			}

			.cio-office-capabilities.is-visible .tagline-part-2 {
				animation-delay: 0.25s;
			}

			.cio-office-capabilities.is-visible .tagline-part-3 {
				animation-delay: 0.35s;
			}

			.cio-office-capabilities.is-visible .tagline-part-4 {
				animation-delay: 0.45s;
			}

			.cio-office-capabilities.is-visible .tagline-part-5 {
				animation-delay: 0.55s;
			}

			@keyframes tagline-reveal {
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.js .cio-office-capabilities-tagline span {
					opacity: 1;
					transform: none;
					animation: none;
				}
			}
		</style>
	</body>
</html>
