---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type MediaItem = {
	type: string;
	status: 'upcoming' | 'published';
	title: string;
	date: string;
	image: string;
	imageAlt: string;
	description: string;
	url?: string;
	linkLabel?: string;
	pdfUrl?: string;
	pdfLabel?: string;
	internal?: boolean;
	compactTitle?: boolean;
};

const mediaItems: MediaItem[] = [
	{
		type: 'Webinar',
		status: 'upcoming',
		title: 'Technology is Never the Starting Point — Xseed',
		date: 'August 2026',
		image: '/images/xseed-webinar.png',
		imageAlt:
			'Technology is Never the Starting Point webinar with Federico Rodrigo',
		description:
			'A practical session on how to start with people and business priorities, and use technology to enable the outcome',
		url: '/webinar/',
		linkLabel: 'Explore the talk',
		internal: true,
		compactTitle: true,
	},
	{
		type: 'Podcast',
		status: 'published',
		title: 'The Technology Vanguard',
		date: 'August 2026',
		image: '/images/vanguard.png',
		imageAlt:
			'Fede Rodrigo appearing on The Technology Vanguard podcast',
		description:
			'An honest conversation about IT leadership, the mistakes that teach us, the transition from technical excellence to leading people, and the lessons that really shape the path to becoming a CIO',
		url: 'https://www.youtube.com/watch?v=2wyTHhaOcWE',
		linkLabel: 'Watch the conversation',
	},
	{
		type: 'Written Interview',
		status: 'published',
		title: 'Turning Cloud Investment into Business Value — Nublit',
		date: 'January 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt:
			'Interview with Fede Rodrigo published by Nublit',
		description:
			'A conversation with Nublit about cloud strategy in Latin America, hybrid adoption, cultural and regulatory barriers, and the role of technology as a driver of growth, innovation, and operational resilience',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'View full report',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Read my interview',
		compactTitle: true,
	},
	{
		type: 'Award Finalist',
		status: 'published',
		title: 'ORBIE CIO Awards',
		date: 'September 2024',
		image: '/images/orbie.jpg',
		imageAlt:
			'ORBIE Awards CIO Central Texas',
		description:
			'Recognized as a finalist in the Global CIO category at the Central Texas awards',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'View recognition',
	},
	{
		type: 'Executive Roundtable',
		status: 'published',
		title: 'Industrial Reinvention — The Economist',
		date: 'September 2024',
		image: '/images/impact.png',
		imageAlt:
			'The Economist Impact',
		description:
			'Invited participant in Industrial Reinvention: New Business Models and Jobs for Tomorrow’s Technology, hosted by The Economist Impact, with fellow CIOs in Houston, Texas',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Speaking | Fede Rodrigo"
			description="Speaking engagements, webinars, executive sessions, podcasts, interviews, and conversations on technology, business, leadership, and execution"
			lang="en"
		/>

		<style>
			/* =========================================================
			   SPEAKING HERO
			========================================================= */

			.speaking-hero {
				max-width: none;
				padding: 10px 0 24px;
				border-bottom: 0;
				text-align: center;
			}

			.speaking-hero-title {
				width: 100%;
				max-width: 100%;
				margin-left: auto;
				margin-right: auto;

				font-size: clamp(2rem, 3.65vw, 3.75rem);
				line-height: 1.08;
				text-align: center;
			}

			.speaking-hero-title .hero-line {
				display: block;
				width: 100%;
				white-space: nowrap;
			}

			.speaking-hero-accent,
			.speaking-never {
				color: #6fa7ef;
			}

			.speaking-hero-accent {
				display: inline-block;
				opacity: 0;
				transform: translateY(6px);

				animation:
					speaking-accent-reveal
					520ms
					ease
					720ms
					forwards;
			}

			@keyframes speaking-accent-reveal {
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}


			/* =========================================================
			   EDITORIAL EVIDENCE
			========================================================= */

			.speaking-evidence {
				width: 100%;
				max-width: 400px;
				margin: -34px auto 12px;
			}

			.speaking-evidence-grid {
				display: flex;
				align-items: flex-start;
				justify-content: center;
				gap: 20px;
			}

			.speaking-evidence-item {
				flex: 0 1 190px;
				text-align: center;
			}

			.speaking-evidence-value {
				display: inline-block;
				margin: 0 0 4px;

				color: #102b46;
				font-size: clamp(1.35rem, 2vw, 1.7rem);
				font-weight: 700;
				line-height: 1;
				letter-spacing: -0.04em;
				font-variant-numeric: tabular-nums;
			}

			.speaking-evidence-number,
			.speaking-evidence-symbol {
				display: inline-block;
			}

			.speaking-evidence-symbol {
				margin-right: 0.04em;
			}

			.speaking-evidence-label {
				margin: 0;

				color: #102b46;
				font-size: 0.9rem;
				font-weight: 550;
				line-height: 1.35;
				letter-spacing: -0.015em;
			}

			.speaking-evidence-source {
				margin: 6px 0 0;

				color: #8b97a4;
				font-size: 0.68rem;
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: 0.07em;
				text-transform: uppercase;
			}


			/* =========================================================
			   CENTERED TALK LINKS
			========================================================= */

			.speaking-talk-link {
				width: 100%;
				margin: -6px auto 16px;
				text-align: center;
			}

			.speaking-centered-action {
				max-width: none;
				margin: 0;
				text-align: center;
			}

			.speaking-centered-link {
				justify-content: center;
			}


			/* =========================================================
			   SPEAKING SLIDER
			========================================================= */

			.speaking-showcase {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;
			}

			.speaking-slider {
				width: 100%;
			}

			.speaking-slider-stage {
				position: relative;

				width: 100%;
				aspect-ratio: 16 / 9;

				overflow: hidden;

				border: 1px solid rgba(16, 43, 70, 0.06);
				border-radius: 14px;

				background: #ffffff;

				box-shadow:
					0 16px 40px rgba(16, 43, 70, 0.065);
			}

			.speaking-slide {
				position: absolute;
				inset: clamp(24px, 3vw, 42px);

				display: flex;
				align-items: center;
				justify-content: center;

				margin: 0;

				opacity: 0;
				pointer-events: none;

				transition: opacity 650ms ease;
			}

			.speaking-slide.is-active {
				z-index: 2;
				opacity: 1;
				pointer-events: auto;
			}

			.speaking-slide-image {
				display: block;

				width: 100%;
				height: 100%;

				max-width: 100%;
				max-height: 100%;

				object-fit: contain;
				object-position: center;

				border-radius: 0;
				background: #ffffff;
			}


			/* =========================================================
			   SLIDER DOTS
			========================================================= */

			.speaking-slider-nav {
				display: flex;
				align-items: center;
				justify-content: center;

				gap: 8px;

				height: 28px;
				margin-top: 3px;
			}

			.speaking-slider-dot {
				width: 7px;
				height: 7px;

				padding: 0;
				border: 0;
				border-radius: 50%;

				background: rgba(16, 43, 70, 0.23);

				cursor: pointer;

				transition:
					width 200ms ease,
					background 200ms ease,
					border-radius 200ms ease;
			}

			.speaking-slider-dot.is-active {
				width: 23px;
				border-radius: 999px;
				background: #102b46;
			}

			.speaking-slider-dot:focus-visible {
				outline: 2px solid #6fa7ef;
				outline-offset: 4px;
			}


			/* =========================================================
			   CLOSING THESIS
			========================================================= */

			.speaking-closing {
				width: 100%;
				margin: 14px auto 0;
				padding-bottom: 0;

				text-align: center;
			}

			.speaking-closing-title {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;

				color: #102b46;

				font-size: clamp(2rem, 3.1vw, 3.25rem);
				font-weight: 700;
				line-height: 1.08;
				letter-spacing: -0.05em;

				white-space: nowrap;
			}

			.speaking-closing-title::after {
				content: none;
				display: none;
			}

			.speaking-closing-link {
				max-width: none;
				margin: 22px 0 0;
				text-align: center;
			}


			/* =========================================================
			   SELECTED APPEARANCES
			========================================================= */

			.media-list.page-divider {
				padding-top: var(--divider-space-after);
			}

			.media-item .media-title-compact {
				font-size: clamp(1rem, 1.45vw, 1.25rem);
				line-height: 1.16;
				letter-spacing: -0.035em;
				white-space: nowrap;
			}


			/* =========================================================
			   SPEAKING INQUIRIES
			========================================================= */

			.speaking-inquiry-action {
				margin: 18px 0 0;
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.speaking-hero {
					padding-top: 8px;
					padding-bottom: 22px;
				}

				.speaking-hero-title {
					font-size: clamp(1.95rem, 7.8vw, 2.65rem);
					line-height: 1.1;
				}

				.speaking-hero-title .hero-line {
					white-space: normal;
				}

				.speaking-evidence {
					margin: -12px auto 12px;
				}

				.speaking-evidence-grid {
					gap: 12px;
				}

				.speaking-evidence-item {
					flex: 1 1 0;
				}

				.speaking-evidence-value {
					font-size: 1.35rem;
				}

				.speaking-evidence-label {
					font-size: 0.78rem;
				}

				.speaking-evidence-source {
					font-size: 0.58rem;
				}

				.speaking-talk-link {
					margin: -2px auto 14px;
				}

				.speaking-slider-stage {
					border-radius: 10px;
				}

				.speaking-slide {
					inset: 15px;
				}

				.speaking-slider-nav {
					height: 26px;
					margin-top: 2px;
				}

				.speaking-closing {
					margin-top: 12px;
				}

				.speaking-closing-title {
					font-size: clamp(1.9rem, 7.4vw, 2.5rem);
					font-weight: 700;
					line-height: 1.08;
					white-space: normal;
				}

				.speaking-closing-link {
					margin-top: 18px;
				}

				.media-list.page-divider {
					padding-top: var(--divider-space-mobile);
				}

				.media-item .media-title-compact {
					font-size: 1.08rem;
					white-space: normal;
				}
			}


			/* =========================================================
			   REDUCED MOTION
			========================================================= */

			@media (prefers-reduced-motion: reduce) {
				.speaking-hero-accent {
					opacity: 1;
					transform: none;
					animation: none;
				}

				.speaking-slide,
				.speaking-slider-dot {
					transition: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     HERO
			===================================================== -->

			<section class="hero speaking-hero">
				<h1 class="hero-title speaking-hero-title">

					<span class="hero-line">
						What if your next technology
					</span>

					<span class="hero-line">
						decision started with
					</span>

					<span class="hero-line">
						<span class="speaking-hero-accent">
							no technology at all?
						</span>
					</span>

				</h1>
			</section>


			<!-- =====================================================
			     EDITORIAL EVIDENCE
			===================================================== -->

			<section
				class="speaking-evidence reveal-section"
				aria-label="Why this matters"
			>
				<div class="speaking-evidence-grid">

					<div class="speaking-evidence-item reveal-item">
						<p class="speaking-evidence-value">
							<span class="speaking-evidence-symbol">~</span>
							<span class="speaking-evidence-number">70%</span>
						</p>

						<p class="speaking-evidence-label">
							of transformation efforts fail
						</p>

						<p class="speaking-evidence-source">
							McKinsey · 2020
						</p>
					</div>


					<div
						class="speaking-evidence-item reveal-item reveal-delay-1"
					>
						<p class="speaking-evidence-value">
							<span class="speaking-evidence-symbol">&gt;</span>
							<span class="speaking-evidence-number">80%</span>
						</p>

						<p class="speaking-evidence-label">
							of AI projects fail
						</p>

						<p class="speaking-evidence-source">
							RAND · 2024
						</p>
					</div>

				</div>
			</section>


			<!-- =====================================================
			     EXPLORE TALK — TOP
			===================================================== -->

			<section
				class="speaking-talk-link reveal-section"
				aria-label="Explore the talk"
			>
				<p class="speaking-centered-action reveal-item">

					<a
						href="/webinar/"
						class="animated-link speaking-centered-link"
					>
						<span>Explore the talk</span>

						<span
							class="animated-link-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>

				</p>
			</section>


			<!-- =====================================================
			     SPEAKING SLIDES
			===================================================== -->

			<section
				class="speaking-showcase reveal-section"
				aria-label="Speaking presentation slides"
			>
				<div
					class="speaking-slider reveal-item"
					data-speaking-slider
				>

					<div class="speaking-slider-stage">

						<figure
							class="speaking-slide is-active"
							data-speaking-slide
							aria-hidden="false"
						>
							<img
								class="speaking-slide-image"
								src="/images/slide1.png"
								alt="People First · Busines Driven · Technology Enabled?"
								loading="eager"
							/>
						</figure>

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/slide2.png"
								alt="Why does IT exist? To create business value?"
								loading="lazy"
							/>
						</figure>

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/slide3.png"
								alt="AI changes everything except..."
								loading="lazy"
							/>
						</figure>

					</div>


					<div
						class="speaking-slider-nav"
						aria-label="Choose slide"
					>
						<button
							type="button"
							class="speaking-slider-dot is-active"
							data-speaking-dot="0"
							aria-label="Show slide 1"
							aria-current="true"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="1"
							aria-label="Show slide 2"
							aria-current="false"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="2"
							aria-label="Show slide 3"
							aria-current="false"
						></button>
					</div>

				</div>
			</section>


			<!-- =====================================================
			     CLOSING THESIS
			===================================================== -->

			<section
				class="speaking-closing reveal-section"
				aria-labelledby="speaking-closing-title"
			>
				<h2
					id="speaking-closing-title"
					class="speaking-closing-title reveal-item"
				>
					Technology is
					<span class="speaking-never">never</span>
					the starting point
				</h2>

				<p
					class="speaking-closing-link reveal-item reveal-delay-1"
				>
					<a
						href="/webinar/"
						class="animated-link speaking-centered-link"
					>
						<span>Explore the talk</span>

						<span
							class="animated-link-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>
				</p>
			</section>


			<!-- =====================================================
			     SELECTED APPEARANCES
			===================================================== -->

			<section
				class="media-list page-divider reveal-section"
				aria-labelledby="media-list-title"
			>
				<h2
					id="media-list-title"
					class="reveal-item"
				>
					Selected Appearances
				</h2>


				{
					mediaItems.map((item, index) => (

						<article
							class="media-item"
							style={`--media-index: ${index};`}
						>

							<div class="media-image-wrapper">

								{
									item.url ? (

										<a
											href={item.url}
											target={
												item.internal
													? undefined
													: '_blank'
											}
											rel={
												item.internal
													? undefined
													: 'noopener noreferrer'
											}
											aria-label={
												item.linkLabel ??
												item.title
											}
										>
											<img
												src={item.image}
												alt={item.imageAlt}
												class="media-image"
												loading="lazy"
											/>
										</a>

									) : (

										<img
											src={item.image}
											alt={item.imageAlt}
											class="media-image"
											loading="lazy"
										/>

									)
								}

							</div>


							<div class="media-content">

								<p class="media-meta">

									<span>{item.type}</span>

									<span aria-hidden="true">
										·
									</span>

									<span>{item.date}</span>

								</p>


								<h3
									class={
										item.compactTitle
											? 'media-title-compact'
											: undefined
									}
								>
									{item.title}
								</h3>


								<p class="media-description">
									{item.description}
								</p>


								{
									item.url ? (

										<div class="media-action">

											{
												item.pdfUrl &&
													item.pdfLabel && (

														<a
															href={item.pdfUrl}
															target="_blank"
															rel="noopener noreferrer"
															class="animated-link"
														>
															<span>
																{item.pdfLabel}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>
														</a>

													)
											}


											<a
												href={item.url}
												target={
													item.internal
														? undefined
														: '_blank'
												}
												rel={
													item.internal
														? undefined
														: 'noopener noreferrer'
												}
												class="animated-link"
											>
												<span>
													{
														item.linkLabel ??
															'Learn more'
													}
												</span>

												<span
													class="animated-link-arrow"
													aria-hidden="true"
												>
													→
												</span>
											</a>

										</div>

									) : (

										item.status === 'upcoming' && (

											<p class="media-coming-soon">
												Coming soon
											</p>

										)

									)
								}

							</div>

						</article>

					))
				}

			</section>


			<!-- =====================================================
			     SPEAKING INQUIRIES
			===================================================== -->

			<section class="page-closing reveal-section">

				<h2 class="reveal-item">
					Speaking Inquiries
				</h2>

				<div class="reveal-item reveal-delay-1">

					<p>
						For speaking engagements, podcasts, or other opportunities,
						please get in touch
					</p>

					<p class="speaking-inquiry-action">
						<a
							href="/contact/"
							class="animated-link"
						>
							<span>Contact me</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>

				</div>

			</section>

		</main>


		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.08,
							rootMargin:
								'0px 0px -50px 0px'
						}
					);


				sections.forEach((section) => {
					revealObserver.observe(section);
				});

			} else {

				sections.forEach((section) => {
					section.classList.add(
						'is-visible'
					);
				});

			}
		</script>


		<!-- =====================================================
		     SLIDER
		===================================================== -->

		<script>
			const speakingSlider =
				document.querySelector(
					'[data-speaking-slider]'
				);

			if (speakingSlider) {

				const slides = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-slide]'
					)
				);

				const dots = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-dot]'
					)
				);

				const reducedMotion =
					window.matchMedia(
						'(prefers-reduced-motion: reduce)'
					).matches;

				let currentSlide = 0;
				let slideTimer = null;
				let sliderVisible = false;

				const durations = [
					7000,
					5200,
					5200
				];


				function showSlide(index) {

					currentSlide =
						(index + slides.length) %
						slides.length;


					slides.forEach(
						(slide, slideIndex) => {

							const active =
								slideIndex ===
								currentSlide;

							slide.classList.toggle(
								'is-active',
								active
							);

							slide.setAttribute(
								'aria-hidden',
								active
									? 'false'
									: 'true'
							);

						}
					);


					dots.forEach(
						(dot, dotIndex) => {

							const active =
								dotIndex ===
								currentSlide;

							dot.classList.toggle(
								'is-active',
								active
							);

							dot.setAttribute(
								'aria-current',
								active
									? 'true'
									: 'false'
							);

						}
					);

				}


				function stopSlider() {

					if (!slideTimer) {
						return;
					}

					window.clearTimeout(
						slideTimer
					);

					slideTimer = null;
				}


				function scheduleNextSlide() {

					if (
						reducedMotion ||
						!sliderVisible
					) {
						return;
					}

					stopSlider();

					slideTimer =
						window.setTimeout(
							() => {

								showSlide(
									currentSlide + 1
								);

								scheduleNextSlide();

							},
							durations[currentSlide]
						);

				}


				dots.forEach(
					(dot, index) => {

						dot.addEventListener(
							'click',
							() => {

								showSlide(index);
								scheduleNextSlide();

							}
						);

					}
				);


				speakingSlider.addEventListener(
					'mouseenter',
					stopSlider
				);

				speakingSlider.addEventListener(
					'mouseleave',
					scheduleNextSlide
				);


				if ('IntersectionObserver' in window) {

					const sliderObserver =
						new IntersectionObserver(
							(entries) => {

								entries.forEach(
									(entry) => {

										sliderVisible =
											entry.isIntersecting;

										if (sliderVisible) {
											scheduleNextSlide();
										} else {
											stopSlider();
										}

									}
								);

							},
							{
								threshold: 0.35
							}
						);


					sliderObserver.observe(
						speakingSlider
					);

				} else {

					sliderVisible = true;
					scheduleNextSlide();

				}


				document.addEventListener(
					'visibilitychange',
					() => {

						if (document.hidden) {
							stopSlider();
						} else {
							scheduleNextSlide();
						}

					}
				);

			}
		</script>

	</body>
</html>
