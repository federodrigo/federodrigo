---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type MediaItem = {
	type: string;
	title: string;
	date: string;
	image: string;
	imageAlt: string;
	url?: string;
	linkLabel?: string;
	pdfUrl?: string;
	pdfLabel?: string;
	internal?: boolean;
};

const mediaItems: MediaItem[] = [
	{
		type: 'Webinar',
		title: 'Technology is Never the Starting Point — Xseed',
		date: 'August 2026',
		image: '/images/xseed-webinar.png',
		imageAlt:
			'Technology is Never the Starting Point webinar with Federico Rodrigo',
		url: '/webinar/',
		linkLabel: 'Explore the talk',
		internal: true,
	},
	{
		type: 'Podcast',
		title: 'The Technology Vanguard',
		date: 'August 2026',
		image: '/images/vanguard.png',
		imageAlt:
			'Fede Rodrigo appearing on The Technology Vanguard podcast',
		url: 'https://www.youtube.com/watch?v=2wyTHhaOcWE',
		linkLabel: 'Watch the conversation',
	},
	{
		type: 'Interview',
		title: 'Cloud Investment & Business Value — Nublit',
		date: 'January 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt:
			'Interview with Fede Rodrigo published by Nublit',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Read the interview',
	},
	{
		type: 'Executive Roundtable',
		title: 'Industrial Reinvention — The Economist',
		date: 'September 2024',
		image: '/images/impact.png',
		imageAlt: 'The Economist Impact',
	},
	{
		type: 'Recognition',
		title: 'ORBIE CIO Awards',
		date: 'September 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'ORBIE Awards CIO Central Texas',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'View recognition',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Speaking | Fede Rodrigo"
			description="Speaking engagements, webinars, executive sessions, podcasts, interviews, and conversations on technology, business, leadership, and execution"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     HERO
			     ORIGINAL STRUCTURE — NO NEW CSS
			===================================================== -->

			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Speaking
					</span>
				</h1>

				<div class="lead-principles">
					<div>Technology Is Part of the Job</div>
					<div>Leadership Is the Job</div>
				</div>
			</section>


			<!-- =====================================================
			     SPEAKING SLIDES
			===================================================== -->

			<section
				class="speaking-showcase reveal-section"
				aria-label="Selected ideas from Fede Rodrigo's talks"
			>
				<div
					class="speaking-slider reveal-item"
					data-speaking-slider
				>

					<div class="speaking-slider-stage">

						<!-- SLIDE 1 -->

						<figure
							class="speaking-slide is-active"
							data-speaking-slide
							aria-hidden="false"
						>
							<img
								class="speaking-slide-image"
								src="/images/speaking-slide-question-clean.png"
								alt="What if your next technology decision started with no technology at all?"
								loading="eager"
							/>
						</figure>


						<!-- SLIDE 2 -->

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/speaking-slide-business-value.png"
								alt="Why does IT exist? To create business value"
								loading="lazy"
							/>
						</figure>


						<!-- SLIDE 3 -->

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/speaking-slide-leadership.png"
								alt="Technology will always change. Leadership won't. Technology is never the starting point"
								loading="lazy"
							/>
						</figure>

					</div>


					<!-- DOTS OUTSIDE THE IMAGE -->

					<div
						class="speaking-slider-nav"
						aria-label="Choose slide"
					>
						<button
							type="button"
							class="speaking-slider-dot is-active"
							data-speaking-dot="0"
							aria-label="Show slide 1"
							aria-current="true"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="1"
							aria-label="Show slide 2"
							aria-current="false"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="2"
							aria-label="Show slide 3"
							aria-current="false"
						></button>
					</div>

				</div>
			</section>


			<!-- =====================================================
			     MEDIA & EVENTS
			===================================================== -->

			<section
				class="media-events reveal-section"
				aria-labelledby="media-events-title"
			>
				<h2
					id="media-events-title"
					class="reveal-item"
				>
					Media & Events
				</h2>


				<div class="media-grid">

					{
						mediaItems.map((item, index) => (
							<article
								class="media-card reveal-item"
								style={`--delay: ${index * 60}ms`}
							>

								<div class="media-card-image">

									{
										item.url ? (
											<a
												href={item.url}
												target={
													item.internal
														? undefined
														: '_blank'
												}
												rel={
													item.internal
														? undefined
														: 'noopener noreferrer'
												}
												aria-label={
													item.linkLabel ??
													item.title
												}
											>
												<img
													src={item.image}
													alt={item.imageAlt}
													loading="lazy"
												/>
											</a>
										) : (
											<img
												src={item.image}
												alt={item.imageAlt}
												loading="lazy"
											/>
										)
									}

								</div>


								<div class="media-card-content">

									<p class="media-card-meta">
										<span>{item.type}</span>

										<span aria-hidden="true">
											·
										</span>

										<span>{item.date}</span>
									</p>


									<h3>
										{item.title}
									</h3>


									{
										(item.url || item.pdfUrl) && (
											<div class="media-card-actions">

												{
													item.pdfUrl &&
													item.pdfLabel && (
														<a
															href={item.pdfUrl}
															target="_blank"
															rel="noopener noreferrer"
															class="animated-link"
														>
															<span>
																{item.pdfLabel}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>
														</a>
													)
												}


												{
													item.url && (
														<a
															href={item.url}
															target={
																item.internal
																	? undefined
																	: '_blank'
															}
															rel={
																item.internal
																	? undefined
																	: 'noopener noreferrer'
															}
															class="animated-link"
														>
															<span>
																{
																	item.linkLabel ??
																	'Learn more'
																}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>
														</a>
													)
												}

											</div>
										)
									}

								</div>

							</article>
						))
					}

				</div>
			</section>


			<!-- =====================================================
			     SPEAKING INQUIRIES
			===================================================== -->

			<section class="media-contact reveal-section">

				<h2 class="reveal-item">
					Speaking Inquiries
				</h2>

				<div class="reveal-item reveal-delay-1">

					<p>
						For speaking engagements, interviews, podcasts,
						or other media opportunities, please get in touch
					</p>

					<p class="media-contact-link">
						<a
							href="/contact/"
							class="animated-link"
						>
							<span>Contact me</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>

				</div>

			</section>

		</main>

		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver =
				new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;

							entry.target.classList.add(
								'is-visible'
							);

							observer.unobserve(
								entry.target
							);
						});
					},
					{
						threshold: 0.08,
						rootMargin:
							'0px 0px -50px 0px',
					}
				);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>


		<!-- =====================================================
		     SLIDER
		===================================================== -->

		<script>
			const speakingSlider =
				document.querySelector(
					'[data-speaking-slider]'
				);

			if (speakingSlider) {

				const slides = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-slide]'
					)
				);

				const dots = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-dot]'
					)
				);

				const reducedMotion =
					window.matchMedia(
						'(prefers-reduced-motion: reduce)'
					).matches;

				let currentSlide = 0;
				let slideTimer = null;
				let sliderVisible = false;


				const durations = [
					7000,
					5200,
					5200,
				];


				function showSlide(index) {

					currentSlide =
						(index + slides.length) %
						slides.length;


					slides.forEach(
						(slide, slideIndex) => {

							const active =
								slideIndex ===
								currentSlide;

							slide.classList.toggle(
								'is-active',
								active
							);

							slide.setAttribute(
								'aria-hidden',
								active
									? 'false'
									: 'true'
							);
						}
					);


					dots.forEach(
						(dot, dotIndex) => {

							const active =
								dotIndex ===
								currentSlide;

							dot.classList.toggle(
								'is-active',
								active
							);

							dot.setAttribute(
								'aria-current',
								active
									? 'true'
									: 'false'
							);
						}
					);

				}


				function stopSlider() {

					if (!slideTimer) return;

					window.clearTimeout(
						slideTimer
					);

					slideTimer = null;
				}


				function scheduleNextSlide() {

					if (
						reducedMotion ||
						!sliderVisible
					) {
						return;
					}

					stopSlider();

					slideTimer =
						window.setTimeout(
							() => {

								showSlide(
									currentSlide + 1
								);

								scheduleNextSlide();

							},
							durations[
								currentSlide
							]
						);
				}


				dots.forEach(
					(dot, index) => {

						dot.addEventListener(
							'click',
							() => {

								showSlide(index);

								scheduleNextSlide();
							}
						);
					}
				);


				speakingSlider.addEventListener(
					'mouseenter',
					stopSlider
				);


				speakingSlider.addEventListener(
					'mouseleave',
					scheduleNextSlide
				);


				const speakingSliderObserver =
					new IntersectionObserver(
						(entries) => {

							entries.forEach(
								(entry) => {

									sliderVisible =
										entry.isIntersecting;

									if (
										sliderVisible
									) {
										scheduleNextSlide();
									} else {
										stopSlider();
									}

								}
							);
						},
						{
							threshold: 0.35,
						}
					);


				speakingSliderObserver.observe(
					speakingSlider
				);


				document.addEventListener(
					'visibilitychange',
					() => {

						if (document.hidden) {
							stopSlider();
						} else {
							scheduleNextSlide();
						}

					}
				);

			}
		</script>

	</body>
</html>


<style>

	/* =========================================================
	   HERO NOT TOUCHED
	========================================================= */


	/* =========================================================
	   SLIDES
	========================================================= */

	.speaking-showcase {
		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		margin:
			18px auto 28px;
	}


	.speaking-slider {
		width: 100%;
	}


	/*
		The image itself lives in this frame.
		Navigation is OUTSIDE so nothing covers the slide.
	*/

	.speaking-slider-stage {
		position: relative;

		width: 100%;

		aspect-ratio: 16 / 9;

		overflow: hidden;

		border-radius: 14px;

		background: #ffffff;

		box-shadow:
			0 18px 45px
			rgba(
				16,
				43,
				70,
				0.07
			);
	}


	.speaking-slide {
		position: absolute;

		inset: 0;

		display: flex;

		align-items: center;

		justify-content: center;

		margin: 0;

		opacity: 0;

		pointer-events: none;

		transition:
			opacity 650ms ease;
	}


	.speaking-slide.is-active {
		z-index: 2;

		opacity: 1;

		pointer-events: auto;
	}


	/*
		IMPORTANT:
		NO CROPPING.

		!important protects this from any global img/object-fit
		style elsewhere on the site.
	*/

	.speaking-slide-image {
		display: block !important;

		width: 100% !important;
		height: 100% !important;

		max-width: 100% !important;
		max-height: 100% !important;

		object-fit: contain !important;

		object-position: center center !important;

		background: #ffffff;
	}


	/* =========================================================
	   SLIDER DOTS
	========================================================= */

	.speaking-slider-nav {
		display: flex;

		align-items: center;

		justify-content: center;

		gap: 8px;

		height: 34px;

		margin-top: 8px;
	}


	.speaking-slider-dot {
		width: 7px;
		height: 7px;

		padding: 0;

		border: 0;

		border-radius: 50%;

		background:
			rgba(
				16,
				43,
				70,
				0.23
			);

		cursor: pointer;

		transition:
			width 200ms ease,
			background 200ms ease,
			border-radius 200ms ease;
	}


	.speaking-slider-dot.is-active {
		width: 23px;

		border-radius: 999px;

		background: #102b46;
	}


	/* =========================================================
	   MEDIA & EVENTS
	========================================================= */

	.media-events {
		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		margin:
			0 auto 26px !important;

		padding: 0 !important;
	}


	.media-events > h2 {
		margin:
			0 0 24px;

		color: #102b46;

		font-size:
			clamp(
				1.85rem,
				2.8vw,
				2.65rem
			);

		font-weight: 600;

		line-height: 1.05;

		letter-spacing:
			-0.035em;
	}


	.media-grid {
		display: grid;

		grid-template-columns:
			repeat(
				3,
				minmax(0, 1fr)
			);

		gap: 20px;
	}


	/* =========================================================
	   MEDIA CARDS
	   EXACT SAME HEIGHT ON DESKTOP
	========================================================= */

	.media-card {
		display: flex;

		flex-direction: column;

		width: 100%;

		height: 350px;

		min-width: 0;

		overflow: hidden;

		border:
			1px solid
			rgba(
				16,
				43,
				70,
				0.10
			);

		border-radius: 13px;

		background: #ffffff;

		transition:
			transform 200ms ease,
			box-shadow 200ms ease;
	}


	.media-card:hover {
		transform:
			translateY(-2px);

		box-shadow:
			0 13px 30px
			rgba(
				16,
				43,
				70,
				0.06
			);
	}


	/* =========================================================
	   MEDIA IMAGES
	   FIXED AREA + NO CROPPING
	========================================================= */

	.media-card-image {
		flex:
			0 0 178px;

		width: 100%;

		height: 178px;

		overflow: hidden;

		background: #ffffff;

		border-bottom:
			1px solid
			rgba(
				16,
				43,
				70,
				0.08
			);
	}


	.media-card-image a {
		display: flex;

		align-items: center;

		justify-content: center;

		width: 100%;

		height: 100%;
	}


	/*
		NO MORE CROPPED MEDIA IMAGES
	*/

	.media-card-image img {
		display: block !important;

		width: 100% !important;

		height: 100% !important;

		max-width: 100% !important;

		max-height: 100% !important;

		object-fit: contain !important;

		object-position:
			center center !important;

		background: #ffffff;
	}


	/* =========================================================
	   MEDIA CONTENT
	========================================================= */

	.media-card-content {
		display: flex;

		flex: 1;

		flex-direction: column;

		min-height: 0;

		padding:
			17px 18px 18px;
	}


	.media-card-meta {
		display: flex;

		flex-wrap: wrap;

		gap: 6px;

		margin:
			0 0 8px;

		color: #7d8b9a;

		font-size: 0.67rem;

		font-weight: 700;

		line-height: 1.35;

		letter-spacing:
			0.065em;

		text-transform:
			uppercase;
	}


	.media-card h3 {
		display: -webkit-box;

		margin: 0;

		overflow: hidden;

		-webkit-box-orient: vertical;

		-webkit-line-clamp: 2;

		color: #102b46;

		font-size:
			clamp(
				1rem,
				1.25vw,
				1.16rem
			);

		font-weight: 600;

		line-height: 1.18;

		letter-spacing:
			-0.02em;
	}


	.media-card-actions {
		display: flex;

		flex-wrap: wrap;

		gap:
			7px 14px;

		margin-top: auto;

		padding-top: 14px;
	}


	.media-card-actions
	.animated-link {
		font-size: 0.76rem;
	}


	/* =========================================================
	   SPEAKING INQUIRIES
	   COMPACT — NO HUGE EMPTY AREA
	========================================================= */

	.media-contact {
		width:
			min(
				1120px,
				calc(100% - 48px)
			);

		min-height: 0 !important;

		margin:
			22px auto 0 !important;

		padding:
			30px 0 38px !important;

		border-top:
			1px solid
			rgba(
				16,
				43,
				70,
				0.12
			);
	}


	.media-contact h2 {
		margin:
			0 0 14px !important;

		color: #102b46;

		font-size:
			clamp(
				1.85rem,
				2.8vw,
				2.65rem
			);

		font-weight: 600;

		line-height: 1.05;

		letter-spacing:
			-0.035em;
	}


	.media-contact p {
		max-width: 700px;

		margin: 0 !important;

		color: #6d7c8d;

		font-size: 1rem;

		line-height: 1.55;
	}


	.media-contact-link {
		margin-top:
			14px !important;
	}


	/* =========================================================
	   REVEAL
	========================================================= */

	.js
	.reveal-section
	.reveal-item {
		opacity: 0;

		transform:
			translateY(14px);

		transition:
			opacity 600ms ease,
			transform 600ms
				cubic-bezier(
					0.22,
					1,
					0.36,
					1
				);

		transition-delay:
			var(--delay, 0ms);
	}


	.js
	.reveal-section.is-visible
	.reveal-item {
		opacity: 1;

		transform:
			translateY(0);
	}


	.js
	.reveal-delay-1 {
		transition-delay:
			80ms !important;
	}


	/* =========================================================
	   TABLET
	========================================================= */

	@media (max-width: 900px) {

		.media-grid {
			grid-template-columns:
				repeat(
					2,
					minmax(0, 1fr)
				);
		}


		.media-card {
			height: 345px;
		}

	}


	/* =========================================================
	   MOBILE
	========================================================= */

	@media (max-width: 620px) {

		.speaking-showcase,
		.media-events,
		.media-contact {
			width:
				calc(
					100% - 32px
				);
		}


		.speaking-showcase {
			margin:
				12px auto 22px;
		}


		.speaking-slider-stage {
			border-radius: 10px;
		}


		.speaking-slider-nav {
			margin-top: 5px;

			height: 30px;
		}


		.media-events {
			margin-bottom:
				18px !important;
		}


		.media-events > h2 {
			margin-bottom:
				20px;
		}


		.media-grid {
			grid-template-columns:
				1fr;
		}


		/*
			On mobile allow content to determine card height,
			but every image area remains identical.
		*/

		.media-card {
			height: auto;

			min-height: 330px;
		}


		.media-card-image {
			flex:
				0 0 175px;

			height: 175px;
		}


		.media-card-content {
			min-height: 145px;

			padding:
				16px 17px 17px;
		}


		.media-contact {
			margin:
