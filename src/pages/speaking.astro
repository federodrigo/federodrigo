---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type MediaItem = {
	type: string;
	status: 'upcoming' | 'published';
	title: string;
	date: string;
	image: string;
	imageAlt: string;
	description: string;
	url?: string;
	linkLabel?: string;
	pdfUrl?: string;
	pdfLabel?: string;
	internal?: boolean;
	compactTitle?: boolean;
};

const mediaItems: MediaItem[] = [
	{
		type: 'Conference Talk',
		status: 'upcoming',
		title: 'LLMday Montevideo 2026',
		date: 'December 5, 2026',
		image: 'https://llmday.com/assets/images/events/llmday-2026-montevideo-q4.png',
		imageAlt:
			'LLMday Montevideo 2026',
		description:
			'A talk on why AI initiatives should begin with the problem, not the technology—and a practical framework for problem first, technology second',
		url: 'https://llmday.com/2026-montevideo-q4/',
		linkLabel: 'View event',
	},
	{
		type: 'TEDx Talk',
		status: 'upcoming',
		title: 'TEDxCiudad De La Costa',
		date: 'November 26, 2026',
		image: '/images/TEDx-Logo-v2.png',
		imageAlt:
			'TEDx',
		description:
			'A talk about why technology should never be the starting point—and how technology-first decisions can create complexity, dependencies, and fewer options over time',
		url: 'https://www.ted.com/tedx/events/69348',
		linkLabel: 'View event',
	},
	{
		type: 'Webinar',
		status: 'published',
		title: 'XSeed',
		date: 'August 2026',
		image: '/images/xseed-webinar.png',
		imageAlt:
			'XSeed webinar with Fede Rodrigo',
		description:
			'A webinar on technology leadership—why leadership is the job, and why people and the business come before technology',
		compactTitle: true,
	},
	{
		type: 'Podcast',
		status: 'published',
		title: 'The Technology Vanguard',
		date: 'August 2026',
		image: '/images/vanguard.png',
		imageAlt:
			'Fede Rodrigo appearing on The Technology Vanguard podcast',
		description:
			'An honest conversation about IT leadership, the mistakes that teach us, the transition from technical excellence to leading people, and the lessons that really shape the path to becoming a CIO',
		url: 'https://www.youtube.com/watch?v=2wyTHhaOcWE',
		linkLabel: 'Watch the conversation',
	},
	{
		type: 'Written Interview',
		status: 'published',
		title: 'Turning Cloud Investment into Business Value — Nublit',
		date: 'January 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt:
			'Interview with Fede Rodrigo published by Nublit',
		description:
			'A conversation with Nublit about cloud strategy in Latin America, hybrid adoption, cultural and regulatory barriers, and the role of technology as a driver of growth, innovation, and operational resilience',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'View full report',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Read my interview',
		compactTitle: true,
	},
	{
		type: 'Award Finalist',
		status: 'published',
		title: 'ORBIE CIO Awards',
		date: 'September 2024',
		image: '/images/orbie.jpg',
		imageAlt:
			'ORBIE Awards CIO Central Texas',
		description:
			'Recognized as a finalist in the Global CIO category at the Central Texas awards',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'View recognition',
	},
	{
		type: 'Executive Roundtable',
		status: 'published',
		title: 'Industrial Reinvention — The Economist',
		date: 'September 2024',
		image: '/images/impact.png',
		imageAlt:
			'The Economist Impact',
		description:
			'Invited participant in Industrial Reinvention: New Business Models and Jobs for Tomorrow’s Technology, hosted by The Economist Impact, with fellow CIOs in Houston, Texas',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Speaking | Fede Rodrigo"
			description="Speaking on technology decisions, business value, leadership, lock-in, and why technology should never be the starting point"
			lang="en"
		/>

		<style>
			/* =========================================================
			   SPEAKING HERO
			========================================================= */

			.speaking-hero {
				max-width: none;
				padding: 10px 0 24px;
				border-bottom: 0;
				text-align: center;
			}

			.speaking-hero-title {
				width: 100%;
				max-width: 100%;
				margin-left: auto;
				margin-right: auto;

				font-size: clamp(2rem, 3.65vw, 3.75rem);
				line-height: 1.08;
				text-align: center;
			}

			.speaking-hero-title .hero-line {
				display: block;
				width: 100%;
				white-space: nowrap;
			}

			.speaking-hero-accent {
				color: #6fa7ef;
			}

			.speaking-hero-accent {
				display: inline-block;
				opacity: 0;
				transform: translateY(6px);

				animation:
					speaking-accent-reveal
					520ms
					ease
					720ms
					forwards;
			}

			@keyframes speaking-accent-reveal {
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}



			/* =========================================================
			   ALL SPEAKING LINKS
			   Same typography everywhere
			========================================================= */

			.speaking-page
				.speaking-talk-link
				.animated-link,
			.speaking-page
				.speaking-closing-link
				.animated-link,
			.speaking-page
				.media-action
				.animated-link,
			.speaking-page
				.speaking-inquiry-action
				.animated-link {
				font-family: inherit;
				font-size: var(--cta-size);
				font-weight: var(--cta-weight);
				line-height: 1.3;
			}


			/* =========================================================
			   CENTERED TALK LINKS
			========================================================= */

			.speaking-talk-link {
				width: 100%;
				margin: -6px auto 16px;
				text-align: center;
			}

			.speaking-centered-action {
				max-width: none;
				margin: 0;
				text-align: center;
			}

			.speaking-centered-link {
				justify-content: center;
			}

			.speaking-research-note {
				max-width: 760px;
				margin: 10px auto 0;

				color: #8b97a4;

				font-size: 0.96rem;
				line-height: 1.5;
			}

			.speaking-research-note a {
				color: #102b46;
				text-decoration: none;
				border-bottom: 0;
			}

			.speaking-research-note a em {
				color: inherit;
			}

			.speaking-research-note a:hover {
				color: var(--blue);
				border-bottom: 0;
			}


			/* =========================================================
			   SPEAKING SLIDER
			========================================================= */

			.speaking-showcase {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;
			}

			.speaking-slider {
				width: 100%;
			}

			.speaking-slider-stage {
				position: relative;

				width: 100%;
				aspect-ratio: 16 / 9;

				overflow: hidden;

				border: 1px solid rgba(16, 43, 70, 0.06);
				border-radius: 14px;

				background: #ffffff;

				box-shadow:
					0 16px 40px rgba(16, 43, 70, 0.065);
			}

			.speaking-slide {
				position: absolute;

				/*
				 * Keep only a slim white frame around the artwork.
				 * The previous 24–42px inset made the image look
				 * unnecessarily small inside the card.
				 */
				inset: clamp(10px, 1.1vw, 16px);

				display: flex;
				align-items: center;
				justify-content: center;

				margin: 0;

				opacity: 0;
				pointer-events: none;

				transition: opacity 650ms ease;
			}

			.speaking-slide.is-active {
				z-index: 2;
				opacity: 1;
				pointer-events: auto;
			}

			.speaking-slide-image {
				display: block;

				width: 100%;
				height: 100%;

				/*
				 * Fill the available slide area so the artwork has
				 * more presence. Because the source images are 16:9,
				 * cover only trims a negligible amount at the edges.
				 */
				object-fit: cover;
				object-position: center;

				border-radius: 8px;
				background: transparent;
			}


			/* =========================================================
			   SLIDER DOTS
			========================================================= */

			.speaking-slider-nav {
				display: flex;
				align-items: center;
				justify-content: center;

				gap: 8px;

				height: 28px;
				margin-top: 3px;
			}

			.speaking-slider-dot {
				width: 7px;
				height: 7px;

				padding: 0;
				border: 0;
				border-radius: 50%;

				background: rgba(16, 43, 70, 0.23);

				cursor: pointer;

				transition:
					width 200ms ease,
					background 200ms ease,
					border-radius 200ms ease;
			}

			.speaking-slider-dot.is-active {
				width: 23px;
				border-radius: 999px;
				background: #102b46;
			}

			.speaking-slider-dot:focus-visible {
				outline: 2px solid #6fa7ef;
				outline-offset: 4px;
			}


			/* =========================================================
			   CLOSING THESIS
			========================================================= */

			.speaking-closing {
				width: 100%;
				margin: 14px auto 0;
				padding-bottom: 0;

				text-align: center;
			}

			.speaking-closing-title {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;

				color: #102b46;

				font-size: clamp(2rem, 3.1vw, 3.25rem);
				font-weight: 700;
				line-height: 1.08;
				letter-spacing: -0.05em;

				white-space: nowrap;
			}

			.speaking-closing-title::after {
				content: none;
				display: none;
			}

			.speaking-closing-rotating {
				display: inline-block;
				color: #6fa7ef;
				transition: color 180ms ease;
			}

			.speaking-closing-rotating::after {
				content: '';
				display: inline-block;
				width: 0.07em;
				height: 0.82em;
				margin-left: 0.07em;
				vertical-align: -0.02em;
				background: currentColor;
				animation: speaking-closing-cursor 760ms step-end infinite;
			}

			@keyframes speaking-closing-cursor {
				0%, 48% { opacity: 1; }
				49%, 100% { opacity: 0; }
			}

			.speaking-closing-link {
				max-width: none;
				margin: 22px 0 0;
				text-align: center;
			}


			/* =========================================================
			   TALK THESIS + TAKEAWAYS
			========================================================= */

			.speaking-thesis-intro {
				width: 100%;
				max-width: 1000px;
				margin: 44px auto 0;
				padding: 0;
			}

			.speaking-thesis-intro-inner {
				width: 100%;
				max-width: 820px;
				margin: 0 auto;
				text-align: center;
			}

			.speaking-thesis-statement {
				max-width: 820px;
				margin: 0 auto;
			}

			.speaking-thesis-lead,
			.speaking-thesis-counter {
				margin: 0;
				color: #102b46;
				font-weight: 700;
				letter-spacing: -0.035em;
			}

			.speaking-thesis-lead {
				font-size: clamp(1.4rem, 2.15vw, 1.8rem);
				line-height: 1.34;
			}

			.speaking-thesis-counter {
				margin-top: 14px;
				font-size: clamp(1.08rem, 1.55vw, 1.24rem);
				line-height: 1.4;
			}

			.speaking-thesis-research {
				margin: 22px auto 0;
				text-align: center;
				color: #8b97a4;
				font-size: 0.96rem;
				line-height: 1.5;
			}

			.speaking-thesis-research a {
				display: inline;
				color: #102b46;
				font-size: inherit;
				font-weight: 650;
				text-decoration: none;
				border-bottom: 0;
				transition: color 180ms ease;
			}

			.speaking-thesis-research a:hover,
			.speaking-thesis-research a:focus-visible {
				color: #6fa7ef;
				border-bottom: 0;
			}

			.speaking-takeaways.page-divider {
				margin-top: calc(var(--divider-space-before) + 30px);
				margin-bottom: 0;
				padding-bottom: 0;
			}

			.speaking-takeaways > h2 {
				margin-bottom: 28px;
			}

			.speaking-takeaway {
				display: grid;
				grid-template-columns: 150px minmax(0, 1fr);
				align-items: center;
				gap: 28px;
				padding: 30px 0;
				border-bottom: 1px solid var(--line);
			}

			.speaking-takeaway:first-of-type {
				padding-top: 4px;
			}

			.speaking-takeaway:last-of-type {
				padding-bottom: 30px;
				border-bottom: 0;
			}

			.speaking-takeaway-number {
				color: var(--navy);
				font-size: clamp(4rem, 7vw, 6.5rem);
				font-weight: 700;
				line-height: 0.9;
				letter-spacing: -0.06em;
				opacity: 0.16;
			}

			.speaking-takeaway .media-content {
				padding-top: 0;
			}

			.speaking-takeaway .media-content h3 {
				margin-bottom: 10px;
			}

			.speaking-takeaway .media-description {
				max-width: 690px;
			}

			@media (max-width: 850px) {
				.speaking-thesis-intro {
					max-width: 720px;
				}

				.speaking-thesis-intro-inner,
				.speaking-thesis-statement {
					max-width: 680px;
				}
			}

			@media (max-width: 720px) {
				.speaking-thesis-intro {
					margin-top: 24px;
				}

				.speaking-thesis-lead {
					font-size: 1.2rem;
					line-height: 1.42;
				}

				.speaking-thesis-counter {
					margin-top: 14px;
					font-size: 1.05rem;
				}

				.speaking-thesis-research {
					margin-top: 18px;
				}

				.speaking-takeaways.page-divider {
					margin-top: calc(var(--divider-space-mobile) + 26px);
				}

				.speaking-takeaways > h2 {
					margin-bottom: 22px;
				}

				.speaking-takeaway {
					grid-template-columns: 72px minmax(0, 1fr);
					align-items: start;
					gap: 18px;
					padding: 26px 0;
				}

				.speaking-takeaway:first-of-type {
					padding-top: 2px;
				}

				.speaking-takeaway:last-of-type {
					padding-bottom: 26px;
				}

				.speaking-takeaway-number {
					padding-top: 4px;
					font-size: 3.4rem;
				}

				.speaking-takeaway .media-content h3 {
					font-size: 1.18rem;
				}

				.speaking-takeaway .media-description {
					font-size: 0.94rem;
					line-height: 1.55;
				}
			}


			/* =========================================================
			   SELECTED APPEARANCES
			========================================================= */

			.media-list.page-divider {
				padding-top: var(--divider-space-after);
			}

			.media-item .media-title-compact {
				font-size: clamp(1rem, 1.45vw, 1.25rem);
				line-height: 1.16;
				letter-spacing: -0.035em;
				white-space: nowrap;
			}


			/* =========================================================
			   SPEAKING INQUIRIES
			========================================================= */

			.speaking-inquiry-action {
				margin: 18px 0 0;
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.speaking-hero {
					padding-top: 8px;
					padding-bottom: 22px;
				}

				.speaking-hero-title {
					font-size: clamp(1.95rem, 7.8vw, 2.65rem);
					line-height: 1.1;
				}

				.speaking-hero-title .hero-line {
					white-space: normal;
				}

				.speaking-talk-link {
					margin: -2px auto 14px;
				}

				.speaking-slider-stage {
					border-radius: 10px;
				}

				.speaking-slide {
					inset: 8px;
				}

				.speaking-slider-nav {
					height: 26px;
					margin-top: 2px;
				}

				.speaking-closing {
					margin-top: 12px;
				}

				.speaking-closing-title {
					font-size: clamp(1.9rem, 7.4vw, 2.5rem);
					font-weight: 700;
					line-height: 1.08;
					white-space: normal;
				}

				.speaking-closing-link {
					margin-top: 18px;
				}

				.media-list.page-divider {
					padding-top: var(--divider-space-mobile);
				}

				.media-item .media-title-compact {
					font-size: 1.08rem;
					white-space: normal;
				}
			}


			/* =========================================================
			   REDUCED MOTION
			========================================================= */

			@media (prefers-reduced-motion: reduce) {
				.speaking-closing-rotating::after {
					display: none;
					animation: none;
				}

				.speaking-hero-accent {
					opacity: 1;
					transform: none;
					animation: none;
				}

				.speaking-slide,
				.speaking-slider-dot {
					transition: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main class="speaking-page">

			<section class="hero speaking-hero">
				<h1 class="hero-title speaking-hero-title">

					<span class="hero-line">
						What if your next technology
					</span>

					<span class="hero-line">
						decision started with
					</span>

					<span class="hero-line">
						<span class="speaking-hero-accent">
							no technology at all?
						</span>
					</span>

				</h1>
			</section>


			<section
				class="speaking-showcase reveal-section"
				aria-label="Speaking presentation slides"
			>
				<div
					class="speaking-slider reveal-item"
					data-speaking-slider
				>

					<div class="speaking-slider-stage">

						<figure
							class="speaking-slide is-active"
							data-speaking-slide
							aria-hidden="false"
						>
							<img
								class="speaking-slide-image"
								src="/images/speaking-cover.png"
								alt="New system surrounded by processes, integrations, exceptions, and dependencies"
								loading="eager"
							/>
						</figure>

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/talk-slide-2.png"
								alt="Lock-in: more dependencies, fewer options"
								loading="lazy"
							/>
						</figure>

						<figure
							class="speaking-slide"
							data-speaking-slide
							aria-hidden="true"
						>
							<img
								class="speaking-slide-image"
								src="/images/talk-slide-3.png"
								alt="Why invest in technology? To change something that matters"
								loading="lazy"
							/>
						</figure>

					</div>


					<div
						class="speaking-slider-nav"
						aria-label="Choose slide"
					>
						<button
							type="button"
							class="speaking-slider-dot is-active"
							data-speaking-dot="0"
							aria-label="Show slide 1"
							aria-current="true"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="1"
							aria-label="Show slide 2"
							aria-current="false"
						></button>

						<button
							type="button"
							class="speaking-slider-dot"
							data-speaking-dot="2"
							aria-label="Show slide 3"
							aria-current="false"
						></button>
					</div>

				</div>
			</section>


			<section
				class="speaking-closing reveal-section"
				aria-labelledby="speaking-closing-title"
			>
				<h2
					id="speaking-closing-title"
					class="speaking-closing-title reveal-item"
				>
					<span class="speaking-closing-rotating" data-speaking-closing-rotating>Technology</span>
					is never the starting point
				</h2>
			</section>

			<section class="speaking-thesis-intro reveal-section">

				<div class="speaking-thesis-intro-inner">

					<div class="speaking-thesis-statement reveal-item">
						<p class="speaking-thesis-lead">
							The most dangerous technology decisions are not always
							the ones that fail
						</p>

						<p class="speaking-thesis-counter">
							Sometimes, they are the ones that work
						</p>
					</div>


				</div>


				<p class="speaking-thesis-research reveal-item reveal-delay-1">
					Based on my research paper
					<a href="/books/#research"><em>When Fixes Become the System</em></a>
				</p>

			</section>

			<section
				class="speaking-takeaways page-divider reveal-section"
				aria-labelledby="speaking-takeaways-title"
			>

				<h2 id="speaking-takeaways-title" class="reveal-item">
					What You'll Take Away
				</h2>


				<article class="speaking-takeaway reveal-item reveal-delay-1">
					<div class="speaking-takeaway-number">01</div>

					<div class="media-content">
						<h3>When a Solution Works, It Can Become the System</h3>
						<p class="media-description">
							Why successful fixes and reasonable technology choices can quietly
							create dependencies that become part of the system itself
						</p>
					</div>
				</article>


				<article class="speaking-takeaway reveal-item reveal-delay-2">
					<div class="speaking-takeaway-number">02</div>

					<div class="media-content">
						<h3>Lock-In Happens Before Anything Looks Broken</h3>
						<p class="media-description">
							How a system can keep working for years while the cost, complexity,
							and risk of changing it continue to grow — and future options slowly disappear
						</p>
					</div>
				</article>


				<article class="speaking-takeaway reveal-item reveal-delay-2">
					<div class="speaking-takeaway-number">03</div>

					<div class="media-content">
						<h3>Start With People and the Business Problem</h3>
						<p class="media-description">
							Why leaders should keep the decision open long enough to understand
							the people, the problem, and the outcome before deciding what role
							technology should play
						</p>
					</div>
				</article>

			</section>

			<section
				class="media-list page-divider reveal-section"
				aria-labelledby="media-list-title"
			>
				<h2
					id="media-list-title"
					class="reveal-item"
				>
					Selected Appearances
				</h2>


				{
					mediaItems.map((item, index) => (

						<article
							class="media-item"
							style={`--media-index: ${index};`}
						>

							<div class="media-image-wrapper">

								{
									item.url ? (

										<a
											href={item.url}
											target={
												item.internal
													? undefined
													: '_blank'
											}
											rel={
												item.internal
													? undefined
													: 'noopener noreferrer'
											}
											aria-label={
												item.linkLabel ??
												item.title
											}
										>
											<img
												src={item.image}
												alt={item.imageAlt}
												class="media-image"
												loading="lazy"
											/>
										</a>

									) : (

										<img
											src={item.image}
											alt={item.imageAlt}
											class="media-image"
											loading="lazy"
										/>

									)
								}

							</div>


							<div class="media-content">

								<p class="media-meta">

									<span>{item.type}</span>

									<span aria-hidden="true">
										·
									</span>

									<span>{item.date}</span>

								</p>


								<h3
									class={
										item.compactTitle
											? 'media-title-compact'
											: undefined
									}
								>
									{item.title}
								</h3>


								<p class="media-description">
									{item.description}
								</p>


								{
									item.url ? (

										<div class="media-action">

											{
												item.pdfUrl &&
													item.pdfLabel && (

														<a
															href={item.pdfUrl}
															target="_blank"
															rel="noopener noreferrer"
															class="animated-link"
														>
															<span>
																{item.pdfLabel}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>
														</a>

													)
											}


											<a
												href={item.url}
												target={
													item.internal
														? undefined
														: '_blank'
												}
												rel={
													item.internal
														? undefined
														: 'noopener noreferrer'
												}
												class="animated-link"
											>
												<span>
													{
														item.linkLabel ??
															'Learn more'
													}
												</span>

												<span
													class="animated-link-arrow"
													aria-hidden="true"
												>
													→
												</span>
											</a>

										</div>

									) : (

										item.status === 'upcoming' && (

											<p class="media-coming-soon">
												Coming soon
											</p>

										)

									)
								}

							</div>

						</article>

					))
				}

			</section>


			<section class="page-closing reveal-section">

				<h2 class="reveal-item">
					Speaking Inquiries
				</h2>

				<div class="reveal-item reveal-delay-1">

					<p>
						For conferences, leadership events, executive sessions,
						podcasts, or other speaking opportunities, please get in touch
					</p>

					<p class="speaking-inquiry-action">
						<a
							href="/contact/"
							class="animated-link"
						>
							<span>Contact me</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>

				</div>

			</section>

		</main>


		<Footer />


		<script>
			const closingRotatingWord =
				document.querySelector('[data-speaking-closing-rotating]');

			if (
				closingRotatingWord &&
				!window.matchMedia('(prefers-reduced-motion: reduce)').matches
			) {
				const words = [
					{ label: 'Technology', color: '#6fa7ef' },
					{ label: 'AI', color: '#7c3aed' },
					{ label: 'Data', color: '#0f766e' },
					{ label: 'Cloud', color: '#c53030' },
					{ label: 'ERP', color: '#b45309' }
				];
				const typeDelay = 95;
				const deleteDelay = 55;
				const holdDelay = 1800;
				const gapDelay = 260;

				let wordIndex = 0;
				let characterIndex = words[0].label.length;
				let deleting = true;

				const step = () => {
					const word = words[wordIndex].label;

					if (deleting) {
						characterIndex = Math.max(0, characterIndex - 1);
						closingRotatingWord.textContent = word.slice(0, characterIndex);

						if (characterIndex === 0) {
							wordIndex = (wordIndex + 1) % words.length;
							closingRotatingWord.style.color = words[wordIndex].color;
							deleting = false;
							window.setTimeout(step, gapDelay);
							return;
						}

						window.setTimeout(step, deleteDelay);
						return;
					}

					const nextWord = words[wordIndex].label;
					characterIndex = Math.min(nextWord.length, characterIndex + 1);
					closingRotatingWord.textContent = nextWord.slice(0, characterIndex);

					if (characterIndex === nextWord.length) {
						deleting = true;
						window.setTimeout(step, holdDelay);
						return;
					}

					window.setTimeout(step, typeDelay);
				};

				window.setTimeout(step, holdDelay);
			}
		</script>


		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			if ('IntersectionObserver' in window) {

				const revealObserver =
					new IntersectionObserver(
						(entries, observer) => {

							entries.forEach((entry) => {

								if (!entry.isIntersecting) {
									return;
								}

								entry.target.classList.add(
									'is-visible'
								);

								observer.unobserve(
									entry.target
								);

							});

						},
						{
							threshold: 0.08,
							rootMargin:
								'0px 0px -50px 0px'
						}
					);


				sections.forEach((section) => {
					revealObserver.observe(section);
				});

			} else {

				sections.forEach((section) => {
					section.classList.add(
						'is-visible'
					);
				});

			}
		</script>


		<script>
			const speakingSlider =
				document.querySelector(
					'[data-speaking-slider]'
				);

			if (speakingSlider) {

				const slides = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-slide]'
					)
				);

				const dots = Array.from(
					speakingSlider.querySelectorAll(
						'[data-speaking-dot]'
					)
				);

				const reducedMotion =
					window.matchMedia(
						'(prefers-reduced-motion: reduce)'
					).matches;

				let currentSlide = 0;
				let slideTimer = null;
				let sliderVisible = false;

				const durations = [
					7000,
					5200,
					5200
				];


				function showSlide(index) {

					currentSlide =
						(index + slides.length) %
						slides.length;


					slides.forEach(
						(slide, slideIndex) => {

							const active =
								slideIndex ===
								currentSlide;

							slide.classList.toggle(
								'is-active',
								active
							);

							slide.setAttribute(
								'aria-hidden',
								active
									? 'false'
									: 'true'
							);

						}
					);


					dots.forEach(
						(dot, dotIndex) => {

							const active =
								dotIndex ===
								currentSlide;

							dot.classList.toggle(
								'is-active',
								active
							);

							dot.setAttribute(
								'aria-current',
								active
									? 'true'
									: 'false'
							);

						}
					);

				}


				function stopSlider() {

					if (!slideTimer) {
						return;
					}

					window.clearTimeout(
						slideTimer
					);

					slideTimer = null;
				}


				function scheduleNextSlide() {

					if (
						reducedMotion ||
						!sliderVisible
					) {
						return;
					}

					stopSlider();

					slideTimer =
						window.setTimeout(
							() => {

								showSlide(
									currentSlide + 1
								);

								scheduleNextSlide();

							},
							durations[currentSlide]
						);

				}


				dots.forEach(
					(dot, index) => {

						dot.addEventListener(
							'click',
							() => {

								showSlide(index);
								scheduleNextSlide();

							}
						);

					}
				);


				speakingSlider.addEventListener(
					'mouseenter',
					stopSlider
				);

				speakingSlider.addEventListener(
					'mouseleave',
					scheduleNextSlide
				);


				if ('IntersectionObserver' in window) {

					const sliderObserver =
						new IntersectionObserver(
							(entries) => {

								entries.forEach(
									(entry) => {

										sliderVisible =
											entry.isIntersecting;

										if (sliderVisible) {
											scheduleNextSlide();
										} else {
											stopSlider();
										}

									}
								);

							},
							{
								threshold: 0.35
							}
						);


					sliderObserver.observe(
						speakingSlider
					);

				} else {

					sliderVisible = true;
					scheduleNextSlide();

				}


				document.addEventListener(
					'visibilitychange',
					() => {

						if (document.hidden) {
							stopSlider();
						} else {
							scheduleNextSlide();
						}

					}
				);

			}
		</script>

	</body>
</html>
