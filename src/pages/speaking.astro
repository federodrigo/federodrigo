---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type AppearanceItem = {
	type: string;
	title: string;
	date: string;
	image: string;
	imageAlt: string;
	description: string;
	url?: string;
	linkLabel?: string;
	pdfUrl?: string;
	pdfLabel?: string;
};

const featuredTalk = {
	type: 'Webinar',
	title: 'Technology is Never the Starting Point — Xseed',
	date: 'August 2026',
	image: '/images/xseed-webinar.png',
	imageAlt:
		'Technology is Never the Starting Point webinar with Federico Rodrigo',
	description:
		'A practical session on how to start with people and business priorities, and use technology to enable the outcome',
	url: '/webinar/',
	linkLabel: 'Explore the talk',
};

const appearances: AppearanceItem[] = [
	{
		type: 'Podcast',
		title: 'The Technology Vanguard',
		date: 'August 2026',
		image: '/images/vanguard.png',
		imageAlt:
			'Fede Rodrigo appearing on The Technology Vanguard podcast',
		description:
			'An honest conversation about IT leadership, the transition from technical excellence to leading people, and the lessons that shape the path to becoming a CIO',
		url: 'https://www.youtube.com/watch?v=2wyTHhaOcWE',
		linkLabel: 'Watch the conversation',
	},
	{
		type: 'Written Interview',
		title: 'Turning Cloud Investment into Business Value — Nublit',
		date: 'January 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt:
			'Interview with Fede Rodrigo published by Nublit',
		description:
			'A conversation about cloud strategy, business value, cultural barriers, and technology as a driver of growth and operational resilience',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'View full report',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Read my interview',
	},
	{
		type: 'Executive Roundtable',
		title: 'Industrial Reinvention — The Economist',
		date: 'September 2024',
		image: '/images/impact.png',
		imageAlt: 'The Economist Impact',
		description:
			'Invited participant in Industrial Reinvention: New Business Models and Jobs for Tomorrow’s Technology, hosted by The Economist Impact',
	},
	{
		type: 'Recognition',
		title: 'ORBIE CIO Awards',
		date: 'September 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'ORBIE Awards CIO Central Texas',
		description:
			'Recognized as a finalist in the Global CIO category at the Central Texas awards',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'View recognition',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Speaking | Fede Rodrigo"
			description="Speaking engagements, keynotes, webinars, executive sessions, podcasts, and conversations on technology, business, leadership, and execution"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     HERO
			     KEEPING YOUR ORIGINAL STRUCTURE / ANIMATION
			===================================================== -->

			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						Speaking
					</span>
				</h1>

				<div class="lead-principles">
					<div>Technology Is Part of the Job</div>
					<div>Leadership Is the Job</div>
				</div>
			</section>


			<!-- =====================================================
			     SLIDES
			===================================================== -->

			<section
				class="speaking-showcase reveal-section"
				aria-label="Selected ideas from Fede Rodrigo's talks"
			>
				<div
					class="speaking-slides reveal-item"
					data-speaking-slider
				>
					<figure
						class="speaking-slide is-active"
						data-speaking-slide
						aria-hidden="false"
					>
						<img
							src="/images/speaking-slide-question.png"
							alt="What if your next technology decision started with no technology at all?"
							loading="eager"
						/>
					</figure>

					<figure
						class="speaking-slide"
						data-speaking-slide
						aria-hidden="true"
					>
						<img
							src="/images/speaking-slide-business-value.png"
							alt="Why does IT exist? To create business value"
							loading="lazy"
						/>
					</figure>

					<figure
						class="speaking-slide"
						data-speaking-slide
						aria-hidden="true"
					>
						<img
							src="/images/speaking-slide-leadership.png"
							alt="Technology will always change. Leadership won't. Technology is never the starting point"
							loading="lazy"
						/>
					</figure>

					<div
						class="speaking-slide-nav"
						aria-label="Choose slide"
					>
						<button
							type="button"
							class="speaking-slide-dot is-active"
							data-speaking-dot="0"
							aria-label="Show slide 1"
							aria-current="true"
						></button>

						<button
							type="button"
							class="speaking-slide-dot"
							data-speaking-dot="1"
							aria-label="Show slide 2"
							aria-current="false"
						></button>

						<button
							type="button"
							class="speaking-slide-dot"
							data-speaking-dot="2"
							aria-label="Show slide 3"
							aria-current="false"
						></button>
					</div>
				</div>
			</section>


			<!-- =====================================================
			     SELECTED TALKS & APPEARANCES
			===================================================== -->

			<section
				class="speaking-selected reveal-section"
				aria-labelledby="speaking-selected-title"
			>
				<div class="speaking-selected-heading">
					<div>
						<h2
							id="speaking-selected-title"
							class="reveal-item"
						>
							Selected Talks & Appearances
						</h2>

						<p
							class="speaking-formats reveal-item reveal-delay-1"
						>
							Keynotes · Webinars · Executive Sessions · Panels · Podcasts
						</p>
					</div>
				</div>


				<!-- FEATURED TALK -->

				<article
					class="speaking-featured reveal-item reveal-delay-1"
				>
					<a
						href={featuredTalk.url}
						class="speaking-featured-image"
						aria-label={featuredTalk.linkLabel}
					>
						<img
							src={featuredTalk.image}
							alt={featuredTalk.imageAlt}
							loading="lazy"
						/>
					</a>

					<div class="speaking-featured-content">
						<p class="speaking-meta">
							<span>{featuredTalk.type}</span>

							<span aria-hidden="true">·</span>

							<span>{featuredTalk.date}</span>
						</p>

						<h3>
							{featuredTalk.title}
						</h3>

						<p class="speaking-featured-description">
							{featuredTalk.description}
						</p>

						<a
							href={featuredTalk.url}
							class="animated-link"
						>
							<span>{featuredTalk.linkLabel}</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</div>
				</article>


				<!-- OTHER APPEARANCES -->

				<div class="speaking-appearances-grid">
					{
						appearances.map((item, index) => (
							<article
								class="speaking-appearance-card reveal-item"
								style={`--appearance-delay: ${index * 70}ms`}
							>
								<div class="speaking-appearance-image-wrapper">
									{
										item.url ? (
											<a
												href={item.url}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={
													item.linkLabel ??
													item.title
												}
											>
												<img
													src={item.image}
													alt={item.imageAlt}
													class="speaking-appearance-image"
													loading="lazy"
												/>
											</a>
										) : (
											<img
												src={item.image}
												alt={item.imageAlt}
												class="speaking-appearance-image"
												loading="lazy"
											/>
										)
									}
								</div>

								<div class="speaking-appearance-content">
									<p class="speaking-meta">
										<span>{item.type}</span>

										<span aria-hidden="true">
											·
										</span>

										<span>{item.date}</span>
									</p>

									<h3>{item.title}</h3>

									<p class="speaking-appearance-description">
										{item.description}
									</p>

									{
										(item.url || item.pdfUrl) && (
											<div class="speaking-appearance-actions">
												{
													item.pdfUrl &&
													item.pdfLabel && (
														<a
															href={item.pdfUrl}
															target="_blank"
															rel="noopener noreferrer"
															class="animated-link"
														>
															<span>
																{
																	item.pdfLabel
																}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>
														</a>
													)
												}

												{
													item.url &&
													item.linkLabel && (
														<a
															href={item.url}
															target="_blank"
															rel="noopener noreferrer"
															class="animated-link"
														>
															<span>
																{
																	item.linkLabel
																}
															</span>

															<span
																class="animated-link-arrow"
																aria-hidden="true"
															>
																→
															</span>
														</a>
													)
												}
											</div>
										)
									}
								</div>
							</article>
						))
					}
				</div>
			</section>


			<!-- =====================================================
			     CONTACT
			===================================================== -->

			<section class="media-contact reveal-section">
				<h2 class="reveal-item">
					Speaking Inquiries
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						For speaking inquiries, collaborations, or media
						opportunities, please get in touch
					</p>

					<p class="media-contact-link">
						<a
							href="/contact/"
							class="animated-link"
						>
							<span>Contact me</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>

		</main>

		<Footer />


		<!-- =========================================================
		     EXISTING REVEAL ANIMATION
		     SAME LOGIC AS YOUR ORIGINAL
		========================================================= -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>


		<!-- =========================================================
		     SLIDE ANIMATION
		     FULLY SCOPED — DOES NOT TOUCH HERO
		========================================================= -->

		<script>
			const slider =
				document.querySelector('[data-speaking-slider]');

			if (slider) {
				const slides = Array.from(
					slider.querySelectorAll('[data-speaking-slide]')
				);

				const dots = Array.from(
					slider.querySelectorAll('[data-speaking-dot]')
				);

				const reduceMotion =
					window.matchMedia(
						'(prefers-reduced-motion: reduce)'
					).matches;

				let current = 0;
				let timer = null;
				let hasStarted = false;

				const showSlide = (index) => {
					current =
						(index + slides.length) %
						slides.length;

					slides.forEach((slide, slideIndex) => {
						const active =
							slideIndex === current;

						slide.classList.toggle(
							'is-active',
							active
						);

						slide.setAttribute(
							'aria-hidden',
							active ? 'false' : 'true'
						);
					});

					dots.forEach((dot, dotIndex) => {
						const active =
							dotIndex === current;

						dot.classList.toggle(
							'is-active',
							active
						);

						dot.setAttribute(
							'aria-current',
							active ? 'true' : 'false'
						);
					});
				};

				const stop = () => {
					if (!timer) return;

					window.clearInterval(timer);
					timer = null;
				};

				const start = () => {
					if (reduceMotion) return;

					stop();

					timer = window.setInterval(() => {
						showSlide(current + 1);
					}, 5200);
				};

				dots.forEach((dot, index) => {
					dot.addEventListener('click', () => {
						showSlide(index);
						start();
					});
				});

				slider.addEventListener(
					'mouseenter',
					stop
				);

				slider.addEventListener(
					'mouseleave',
					() => {
						if (hasStarted) start();
					}
				);

				const sliderObserver =
					new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (
									entry.isIntersecting &&
									!hasStarted
								) {
									hasStarted = true;
									showSlide(0);
									start();
								}

								if (!entry.isIntersecting) {
									stop();
								}

								if (
									entry.isIntersecting &&
									hasStarted
								) {
									start();
								}
							});
						},
						{
							threshold: 0.35,
						}
					);

				sliderObserver.observe(slider);

				document.addEventListener(
					'visibilitychange',
					() => {
						if (document.hidden) {
							stop();
						} else if (hasStarted) {
							start();
						}
					}
				);
			}
		</script>

	</body>
</html>


<style>

	/* =========================================================
	   NEW SLIDES SECTION
	   EVERYTHING PREFIXED SO IT DOES NOT TOUCH YOUR HERO
	========================================================= */

	.speaking-showcase {
		width: min(
			1180px,
			calc(100% - 48px)
		);

		margin:
			clamp(20px, 3vw, 45px)
			auto
			clamp(90px, 10vw, 145px);
	}


	.speaking-slides {
		position: relative;

		width: 100%;

		aspect-ratio: 16 / 9;

		overflow: hidden;

		border-radius: 18px;

		background: #f5f7f9;

		box-shadow:
			0 22px 55px
			rgba(18, 43, 68, 0.08);
	}


	.speaking-slide {
		position: absolute;

		inset: 0;

		margin: 0;

		opacity: 0;

		transform:
			scale(1.008);

		pointer-events: none;

		transition:
			opacity 650ms ease,
			transform 1100ms
				cubic-bezier(
					0.22,
					1,
					0.36,
					1
				);
	}


	.speaking-slide.is-active {
		z-index: 2;

		opacity: 1;

		transform:
			scale(1);

		pointer-events: auto;
	}


	.speaking-slide img {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;
	}


	.speaking-slide-nav {
		position: absolute;

		z-index: 10;

		left: 50%;
		bottom: 18px;

		display: flex;

		gap: 9px;

		transform:
			translateX(-50%);

		padding: 9px 12px;

		border-radius: 999px;

		background:
			rgba(
				255,
				255,
				255,
				0.82
			);

		backdrop-filter:
			blur(10px);
	}


	.speaking-slide-dot {
		width: 7px;
		height: 7px;

		padding: 0;

		border: 0;
		border-radius: 50%;

		background:
			rgba(
				18,
				43,
				68,
				0.24
			);

		cursor: pointer;

		transition:
			width 220ms ease,
			border-radius 220ms ease,
			background 220ms ease;
	}


	.speaking-slide-dot.is-active {
		width: 25px;

		border-radius: 999px;

		background: #102b46;
	}


	/* =========================================================
	   SELECTED TALKS
	========================================================= */

	.speaking-selected {
		width: min(
			1180px,
			calc(100% - 48px)
		);

		margin:
			0 auto
			clamp(100px, 11vw, 165px);
	}


	.speaking-selected-heading {
		margin-bottom:
			clamp(36px, 5vw, 60px);
	}


	.speaking-selected-heading h2 {
		margin: 0;

		font-size:
			clamp(
				2rem,
				3.8vw,
				3.7rem
			);

		font-weight: 600;

		line-height: 1.05;

		letter-spacing:
			-0.04em;

		color: #102b46;
	}


	.speaking-formats {
		margin:
			16px 0 0;

		font-size:
			clamp(
				0.9rem,
				1.2vw,
				1rem
			);

		line-height: 1.5;

		color: #6e7d8e;
	}


	/* =========================================================
	   FEATURED TALK
	========================================================= */

	.speaking-featured {
		display: grid;

		grid-template-columns:
			minmax(0, 1.08fr)
			minmax(300px, 0.92fr);

		gap:
			clamp(38px, 6vw, 80px);

		align-items: center;

		margin-bottom:
			clamp(55px, 7vw, 90px);
	}


	.speaking-featured-image {
		display: block;

		overflow: hidden;

		border-radius: 15px;

		background: #f3f5f7;
	}


	.speaking-featured-image img {
		display: block;

		width: 100%;

		aspect-ratio: 16 / 9;

		object-fit: cover;

		transition:
			transform 500ms
				cubic-bezier(
					0.22,
					1,
					0.36,
					1
				);
	}


	.speaking-featured-image:hover img {
		transform: scale(1.02);
	}


	.speaking-featured-content h3 {
		max-width: 520px;

		margin:
			0 0 18px;

		font-size:
			clamp(
				1.8rem,
				3vw,
				3rem
			);

		font-weight: 600;

		line-height: 1.08;

		letter-spacing:
			-0.035em;

		color: #102b46;
	}


	.speaking-featured-description {
		max-width: 520px;

		margin:
			0 0 25px;

		font-size: 1rem;

		line-height: 1.6;

		color: #667789;
	}


	.speaking-meta {
		display: flex;

		flex-wrap: wrap;

		gap: 7px;

		margin:
			0 0 13px;

		font-size: 0.74rem;

		font-weight: 650;

		letter-spacing:
			0.06em;

		text-transform:
			uppercase;

		color: #778698;
	}


	/* =========================================================
	   SMALLER APPEARANCES
	========================================================= */

	.speaking-appearances-grid {
		display: grid;

		grid-template-columns:
			repeat(
				2,
				minmax(0, 1fr)
			);

		gap: 22px;
	}


	.speaking-appearance-card {
		display: grid;

		grid-template-columns:
			180px
			minmax(0, 1fr);

		min-height: 210px;

		overflow: hidden;

		border:
			1px solid
			rgba(
				16,
				43,
				70,
				0.10
			);

		border-radius: 13px;

		background: #fff;

		transition:
			transform 220ms ease,
			box-shadow 220ms ease;
	}


	.speaking-appearance-card:hover {
		transform:
			translateY(-2px);

		box-shadow:
			0 14px 35px
				rgba(
					16,
					43,
					70,
					0.06
				);
	}


	.speaking-appearance-image-wrapper {
		overflow: hidden;

		background: #f3f5f7;
	}


	.speaking-appearance-image-wrapper a {
		display: block;

		width: 100%;
		height: 100%;
	}


	.speaking-appearance-image {
		display: block;

		width: 100%;
		height: 100%;

		min-height: 210px;

		object-fit: cover;

		transition:
			transform 400ms ease;
	}


	.speaking-appearance-image-wrapper:hover
	.speaking-appearance-image {
		transform: scale(1.025);
	}


	.speaking-appearance-content {
		display: flex;

		flex-direction: column;

		padding: 22px;
	}


	.speaking-appearance-content h3 {
		margin:
			0 0 11px;

		font-size: 1.17rem;

		font-weight: 600;

		line-height: 1.18;

		letter-spacing:
			-0.02em;

		color: #102b46;
	}


	.speaking-appearance-description {
		display: -webkit-box;

		margin:
			0 0 18px;

		overflow: hidden;

		-webkit-box-orient:
			vertical;

		-webkit-line-clamp: 3;

		font-size: 0.88rem;

		line-height: 1.52;

		color: #6e7d8e;
	}


	.speaking-appearance-actions {
		display: flex;

		flex-wrap: wrap;

		gap: 15px;

		margin-top: auto;
	}


	.speaking-appearance-actions
	.animated-link {
		font-size: 0.82rem;
	}


	/* =========================================================
	   TABLET
	========================================================= */

	@media (max-width: 950px) {

		.speaking-featured {
			grid-template-columns: 1fr;

			gap: 30px;
		}


		.speaking-featured-content {
			max-width: 680px;
		}


		.speaking-appearances-grid {
			grid-template-columns: 1fr;
		}


		.speaking-appearance-card {
			grid-template-columns:
				220px
				minmax(0, 1fr);
		}

	}


	/* =========================================================
	   MOBILE
	========================================================= */

	@media (max-width: 620px) {

		.speaking-showcase,
		.speaking-selected {
			width:
				calc(
					100% - 32px
				);
		}


		.speaking-showcase {
			margin-bottom: 80px;
		}


		.speaking-slides {
			border-radius: 11px;
		}


		.speaking-slide-nav {
			bottom: 10px;

			padding: 7px 9px;
		}


		.speaking-selected-heading {
			margin-bottom: 32px;
		}


