---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type AppearanceItem = {
	type: string;
	title: string;
	date: string;
	image: string;
	imageAlt: string;
	description: string;
	url?: string;
	linkLabel?: string;
	pdfUrl?: string;
	pdfLabel?: string;
};

const appearances: AppearanceItem[] = [
	{
		type: 'Podcast',
		title: 'The Technology Vanguard',
		date: 'August 2026',
		image: '/images/vanguard.png',
		imageAlt: 'Fede Rodrigo appearing on The Technology Vanguard podcast',
		description:
			'An honest conversation about IT leadership, the transition from technical excellence to leading people, and the lessons that shape the path to becoming a CIO',
		url: 'https://www.youtube.com/watch?v=2wyTHhaOcWE',
		linkLabel: 'Watch',
	},
	{
		type: 'Written Interview',
		title: 'Turning Cloud Investment into Business Value — Nublit',
		date: 'January 2026',
		image: '/images/cloud-interview.jpg',
		imageAlt: 'Interview with Fede Rodrigo published by Nublit',
		description:
			'A conversation about cloud strategy, business value, cultural barriers, and technology as a driver of growth and operational resilience',
		url: 'https://informe2026.nublit.com/',
		linkLabel: 'View report',
		pdfUrl: '/pdfs/Fede-Rodrigo-Interview-Nublit.pdf',
		pdfLabel: 'Read interview',
	},
	{
		type: 'Executive Roundtable',
		title: 'Industrial Reinvention — The Economist',
		date: 'September 2024',
		image: '/images/impact.png',
		imageAlt: 'The Economist Impact',
		description:
			'Invited participant in Industrial Reinvention: New Business Models and Jobs for Tomorrow’s Technology, hosted by The Economist Impact',
	},
	{
		type: 'Recognition',
		title: 'ORBIE CIO Awards',
		date: 'September 2024',
		image: '/images/orbie.jpg',
		imageAlt: 'ORBIE Awards CIO Central Texas',
		description:
			'Recognized as a finalist in the Global CIO category at the Central Texas awards',
		url: 'https://orbie.org/honoree/federico-rodrigo/4324',
		linkLabel: 'View recognition',
	},
];

const topics = [
	{
		number: '01',
		title: 'Technology & Business Value',
		description:
			'How to make better technology decisions by starting with business outcomes, not tools',
	},
	{
		number: '02',
		title: 'Leadership & the CIO Role',
		description:
			'What changes when technical responsibility becomes leadership responsibility',
	},
	{
		number: '03',
		title: 'Strategy & Execution',
		description:
			'Why strategy creates value only when organizations can actually execute it',
	},
];

const formats = [
	'Keynotes',
	'Webinars',
	'Executive Sessions',
	'Workshops',
	'Panels',
	'Podcasts',
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="Speaking | Fede Rodrigo"
			description="Keynotes, webinars, executive sessions, workshops, panels, and conversations on technology leadership, business value, strategy, and execution"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- =========================================================
			     HERO
			========================================================= -->

			<section class="hero">
				<div class="hero-inner">
					<p class="eyebrow">SPEAKING</p>

					<h1 class="hero-title">
						<span>Technology is part of the job.</span>
						<span class="hero-accent">Leadership is the job.</span>
					</h1>

					<p class="hero-copy">
						Talks on technology leadership, business value, strategy,
						and execution — grounded in real operating experience.
					</p>

					<div class="hero-actions">
						<a href="/contact/" class="primary-link">
							<span>Invite Fede to speak</span>
							<span aria-hidden="true">→</span>
						</a>

						<a href="#topics" class="secondary-link">
							Explore speaking topics
						</a>
					</div>
				</div>
			</section>

			<!-- =========================================================
			     VISUAL STORY / SPEAKING TRAILER
			========================================================= -->

			<section
				class="story-section"
				aria-labelledby="story-title"
			>
				<div class="section-heading reveal-section">
					<p class="eyebrow reveal-item">A DIFFERENT STARTING POINT</p>

					<h2 id="story-title" class="reveal-item reveal-delay-1">
						Technology conversations should not start with technology
					</h2>
				</div>

				<div class="story-layout">
					<div class="story-stage-wrapper">
						<div
							class="story-stage"
							aria-live="polite"
						>
							<!-- FRAME 1 -->

							<div
								class="story-frame story-frame-question is-active"
								data-story-frame="0"
							>
								<div class="mountain-scene" aria-hidden="true">
									<div class="mountain mountain-one"></div>
									<div class="mountain mountain-two"></div>
									<div class="mountain mountain-three"></div>
									<div class="road"></div>
								</div>

								<div class="story-frame-content story-question">
									<p>
										What if your next technology
										decision started with…
									</p>

									<strong>
										no technology at all?
									</strong>
								</div>
							</div>

							<!-- FRAME 2 -->

							<div
								class="story-frame story-frame-value"
								data-story-frame="1"
							>
								<div class="story-frame-content centered-frame">
									<p class="frame-question">
										Why does IT exist?
									</p>

									<div class="value-answer">
										<span>To create</span>
										<strong>BUSINESS VALUE</strong>
									</div>

									<p class="frame-conclusion">
										Everything else is a consequence
									</p>
								</div>
							</div>

							<!-- FRAME 3 -->

							<div
								class="story-frame story-frame-model"
								data-story-frame="2"
							>
								<div class="story-frame-content model-frame">
									<div class="model-item">
										<span class="model-number">01</span>
										<strong>People First</strong>
									</div>

									<div class="model-divider"></div>

									<div class="model-item">
										<span class="model-number">02</span>
										<strong>Business Driven</strong>
									</div>

									<div class="model-divider"></div>

									<div class="model-item">
										<span class="model-number">03</span>
										<strong>Technology Enabled</strong>
									</div>
								</div>
							</div>

							<!-- FRAME 4 -->

							<div
								class="story-frame story-frame-closing"
								data-story-frame="3"
							>
								<div class="story-frame-content closing-frame">
									<div class="closing-pair">
										<p>
											Technology
											<span>will always</span>
											change
										</p>

										<p>
											Leadership
											<span>won’t</span>
										</p>
									</div>

									<div class="closing-rule"></div>

									<strong class="closing-statement">
										Technology is never
										<br />
										the starting point
									</strong>
								</div>
							</div>
						</div>
					</div>

					<div class="story-steps">
						<button
							type="button"
							class="story-step is-active"
							data-story-step="0"
							aria-label="Show opening question"
						>
							<span>01</span>
							<p>Start with the question</p>
						</button>

						<button
							type="button"
							class="story-step"
							data-story-step="1"
							aria-label="Show business value"
						>
							<span>02</span>
							<p>Define the purpose</p>
						</button>

						<button
							type="button"
							class="story-step"
							data-story-step="2"
							aria-label="Show operating model"
						>
							<span>03</span>
							<p>Put the order right</p>
						</button>

						<button
							type="button"
							class="story-step"
							data-story-step="3"
							aria-label="Show closing principle"
						>
							<span>04</span>
							<p>Lead through change</p>
						</button>
					</div>
				</div>
			</section>

			<!-- =========================================================
			     SPEAKING TOPICS
			========================================================= -->

			<section
				id="topics"
				class="topics reveal-section"
				aria-labelledby="topics-title"
			>
				<div class="section-heading">
					<p class="eyebrow reveal-item">
						SPEAKING TOPICS
					</p>

					<h2
						id="topics-title"
						class="reveal-item reveal-delay-1"
					>
						Where technology meets leadership
					</h2>
				</div>

				<div class="topics-grid">
					{
						topics.map((topic, index) => (
							<article
								class="topic-card reveal-item"
								style={`--delay: ${index * 0.08}s`}
							>
								<span class="topic-number">
									{topic.number}
								</span>

								<h3>{topic.title}</h3>

								<p>{topic.description}</p>
							</article>
						))
					}
				</div>
			</section>

			<!-- =========================================================
			     FORMATS
			========================================================= -->

			<section class="formats reveal-section">
				<div class="formats-inner">
					<div class="formats-heading reveal-item">
						<p class="eyebrow">FORMATS</p>

						<h2>
							From a conference stage to an executive room
						</h2>
					</div>

					<div class="format-list reveal-item reveal-delay-1">
						{
							formats.map((format) => (
								<div class="format-item">
									<span>{format}</span>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- =========================================================
			     FEATURED TALK
			========================================================= -->

			<section
				class="featured-talk reveal-section"
				aria-labelledby="featured-talk-title"
			>
				<div class="featured-talk-grid">
					<div class="featured-talk-copy">
						<p class="eyebrow reveal-item">
							FEATURED TALK
						</p>

						<h2
							id="featured-talk-title"
							class="reveal-item reveal-delay-1"
						>
							Technology Is Never the Starting Point
						</h2>

						<p class="featured-intro reveal-item reveal-delay-2">
							Technology initiatives often begin with platforms,
							tools, and architecture. The better starting point is
							the outcome the organization is trying to create.
						</p>

						<p class="featured-description reveal-item reveal-delay-2">
							This session explores how leaders can start with
							people and business priorities, connect strategy with
							execution, and use technology to enable the outcome
							rather than define it.
						</p>

						<div class="featured-actions reveal-item reveal-delay-3">
							<a
								href="/webinar/"
								class="primary-link"
							>
								<span>Explore the talk</span>
								<span aria-hidden="true">→</span>
							</a>
						</div>
					</div>

					<a
						href="/webinar/"
						class="featured-talk-image reveal-item reveal-delay-2"
						aria-label="Explore Technology Is Never the Starting Point"
					>
						<img
							src="/images/xseed-webinar.png"
							alt="Technology Is Never the Starting Point presentation"
							loading="lazy"
						/>

						<div class="featured-image-overlay">
							<span>Technology Is Never the Starting Point</span>
							<span aria-hidden="true">→</span>
						</div>
					</a>
				</div>
			</section>

			<!-- =========================================================
			     SELECTED APPEARANCES
			========================================================= -->

			<section
				class="appearances reveal-section"
				aria-labelledby="appearances-title"
			>
				<div class="section-heading appearances-heading">
					<div>
						<p class="eyebrow reveal-item">
							SELECTED APPEARANCES
						</p>

						<h2
							id="appearances-title"
							class="reveal-item reveal-delay-1"
						>
							Conversations, events & recognition
						</h2>
					</div>
				</div>

				<div class="appearances-grid">
					{
						appearances.map((item, index) => (
							<article
								class="appearance-card reveal-item"
								style={`--delay: ${index * 0.07}s`}
							>
								<div class="appearance-image-wrapper">
									{
										item.url ? (
											<a
												href={item.url}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={item.linkLabel ?? item.title}
											>
												<img
													src={item.image}
													alt={item.imageAlt}
													class="appearance-image"
													loading="lazy"
												/>
											</a>
										) : (
											<img
												src={item.image}
												alt={item.imageAlt}
												class="appearance-image"
												loading="lazy"
											/>
										)
									}
								</div>

								<div class="appearance-content">
									<p class="appearance-meta">
										<span>{item.type}</span>
										<span aria-hidden="true">·</span>
										<span>{item.date}</span>
									</p>

									<h3>{item.title}</h3>

									<p class="appearance-description">
										{item.description}
									</p>

									{
										(item.url || item.pdfUrl) && (
											<div class="appearance-actions">
												{
													item.pdfUrl &&
													item.pdfLabel && (
														<a
															href={item.pdfUrl}
															target="_blank"
															rel="noopener noreferrer"
															class="text-link"
														>
															{item.pdfLabel}
															<span aria-hidden="true">
																→
															</span>
														</a>
													)
												}

												{
													item.url &&
													item.linkLabel && (
														<a
															href={item.url}
															target="_blank"
															rel="noopener noreferrer"
															class="text-link"
														>
															{item.linkLabel}
															<span aria-hidden="true">
																→
															</span>
														</a>
													)
												}
											</div>
										)
									}
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- =========================================================
			     FINAL CTA
			========================================================= -->

			<section class="speaking-contact reveal-section">
				<div class="speaking-contact-inner">
					<p class="eyebrow reveal-item">
						SPEAKING INQUIRIES
					</p>

					<h2 class="reveal-item reveal-delay-1">
						Bring a business-first perspective on technology to your audience.
					</h2>

					<p class="contact-copy reveal-item reveal-delay-2">
						Available for keynotes, webinars, executive sessions,
						workshops, panels, podcasts, and selected media conversations.
					</p>

					<div class="reveal-item reveal-delay-3">
						<a
							href="/contact/"
							class="contact-button"
						>
							<span>Invite Fede to speak</span>
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			// =========================================================
			// GENERAL REVEALS
			// =========================================================

			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.08,
					rootMargin: '0px 0px -50px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});

			// =========================================================
			// SPEAKING STORY
			// =========================================================

			const storyFrames =
				document.querySelectorAll('[data-story-frame]');

			const storySteps =
				document.querySelectorAll('[data-story-step]');

			function activateStoryFrame(index) {
				storyFrames.forEach((frame, frameIndex) => {
					frame.classList.toggle(
						'is-active',
						frameIndex === index
					);
				});

				storySteps.forEach((step, stepIndex) => {
					step.classList.toggle(
						'is-active',
						stepIndex === index
					);
				});
			}

			storySteps.forEach((step, index) => {
				step.addEventListener('click', () => {
					activateStoryFrame(index);
				});
			});

			const desktopQuery =
				window.matchMedia('(min-width: 901px)');

			let storyObserver;

			function initializeStoryObserver() {
				if (storyObserver) {
					storyObserver.disconnect();
				}

				if (!desktopQuery.matches) {
					return;
				}

				storyObserver = new IntersectionObserver(
					(entries) => {
						const visible = entries
							.filter((entry) => entry.isIntersecting)
							.sort(
								(a, b) =>
									b.intersectionRatio -
									a.intersectionRatio
							);

						if (!visible.length) return;

						const index = Number(
							visible[0].target.getAttribute(
								'data-story-step'
							)
						);

						activateStoryFrame(index);
					},
					{
						threshold: [0.35, 0.5, 0.65, 0.8],
						rootMargin: '-25% 0px -25% 0px',
					}
				);

				storySteps.forEach((step) => {
					storyObserver.observe(step);
				});
			}

			initializeStoryObserver();

			desktopQuery.addEventListener(
				'change',
				initializeStoryObserver
			);
		</script>
	</body>
</html>

<style>
	/* =========================================================
	   PAGE TOKENS
	========================================================= */

	:root {
		--speaking-ink: #102b46;
		--speaking-muted: #64768a;
		--speaking-accent: #6f9fe8;
		--speaking-soft: #f5f7fa;
		--speaking-line: rgba(16, 43, 70, 0.12);
		--speaking-max: 1180px;
	}

	main {
		overflow: clip;
	}

	.hero,
	.story-section,
	.topics,
	.formats,
	.featured-talk,
	.appearances,
	.speaking-contact {
		padding-left: clamp(24px, 6vw, 88px);
		padding-right: clamp(24px, 6vw, 88px);
	}

	.eyebrow {
		margin: 0 0 18px;
		font-size: 0.73rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: var(--speaking-muted);
	}

	.section-heading {
		width: min(100%, var(--speaking-max));
		margin: 0 auto 52px;
	}

	.section-heading h2,
	.formats h2,
	.featured-talk h2,
	.speaking-contact h2 {
		margin: 0;
		color: var(--speaking-ink);
		font-size: clamp(2rem, 4vw, 4.25rem);
		font-weight: 600;
		line-height: 1.03;
		letter-spacing: -0.045em;
	}

	/* =========================================================
	   HERO
	========================================================= */

	.hero {
		padding-top: clamp(110px, 14vw, 190px);
		padding-bottom: clamp(90px, 11vw, 150px);
	}

	.hero-inner {
		width: min(100%, var(--speaking-max));
		margin: 0 auto;
	}

	.hero-title {
		display: flex;
		flex-direction: column;
		max-width: 1040px;
		margin: 0;
		color: var(--speaking-ink);
		font-size: clamp(3.35rem, 7vw, 7rem);
		font-weight: 650;
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.hero-accent {
		margin-top: 0.12em;
		color: var(--speaking-accent);
	}

	.hero-copy {
		max-width: 690px;
		margin: 38px 0 0;
		color: var(--speaking-muted);
		font-size: clamp(1.08rem, 1.55vw, 1.35rem);
		line-height: 1.6;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 26px;
		margin-top: 38px;
	}

	.primary-link,
	.contact-button {
		display: inline-flex;
		align-items: center;
		gap: 18px;
		text-decoration: none;
	}

	.primary-link {
		color: var(--speaking-ink);
		font-size: 1rem;
		font-weight: 650;
	}

	.primary-link span:last-child {
		transition: transform 180ms ease;
	}

	.primary-link:hover span:last-child {
		transform: translateX(5px);
	}

	.secondary-link {
		color: var(--speaking-muted);
		font-size: 0.95rem;
		text-decoration: none;
	}

	.secondary-link:hover {
		color: var(--speaking-ink);
	}

	/* =========================================================
	   STORY
	========================================================= */

	.story-section {
		padding-top: clamp(80px, 9vw, 130px);
		padding-bottom: clamp(100px, 12vw, 170px);
		background:
			linear-gradient(
				to bottom,
				#ffffff 0%,
				#f7f9fb 20%,
				#f7f9fb 80%,
				#ffffff 100%
			);
	}

	.story-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		gap: clamp(40px, 7vw, 100px);
		width: min(100%, var(--speaking-max));
		margin: 0 auto;
	}

	.story-stage-wrapper {
		min-width: 0;
	}

	.story-stage {
		position: sticky;
		top: 11vh;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #fff;
		border: 1px solid var(--speaking-line);
		border-radius: 22px;
		box-shadow:
			0 28px 70px rgba(16, 43, 70, 0.08);
	}

	.story-frame {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		opacity: 0;
		transform: scale(1.015);
		pointer-events: none;
		transition:
			opacity 600ms ease,
			transform 850ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.story-frame.is-active {
		z-index: 2;
		opacity: 1;
		transform: scale(1);
	}

	.story-frame-content {
		position: relative;
		z-index: 3;
	}

	.story-steps {
		display: flex;
		flex-direction: column;
	}

	.story-step {
		min-height: 48vh;
		padding: 30px 0;
		border: 0;
		border-left: 1px solid var(--speaking-line);
		background: transparent;
		color: var(--speaking-muted);
		text-align: left;
		cursor: pointer;
		transition:
			color 200ms ease,
			border-color 200ms ease;
	}

	.story-step span,
	.story-step p {
