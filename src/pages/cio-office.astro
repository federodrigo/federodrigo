---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const capabilities = [
	{
		title: 'Board & Executive Advisory',
		description:
			'Independent advice to boards, CEOs, and executive teams on technology investments, strategic decisions, risks, and critical initiatives',
	},
	{
		title: 'Technology Strategy & Governance',
		description:
			'Define technology priorities, decision processes, and governance around business needs, outcomes, and long-term value',
	},
	{
		title: 'ERP & Enterprise Systems Advisory',
		description:
			'Evaluate, select, and oversee ERP and enterprise systems from the business case through delivery, challenging assumptions and protecting the client\'s interests',
	},
	{
		title: 'Transformation & Program Oversight',
		description:
			'Provide executive oversight of complex programs and transformations, keeping decisions, people, risks, and business outcomes in focus',
	},
	{
		title: 'Fractional CIO',
		description:
			'Provide CIO-level leadership and judgment to organizations that need executive technology direction without hiring a full-time CIO',
	},
	{
		title: 'Technology Investment & Risk',
		description:
			'Evaluate choices across infrastructure, cloud, cybersecurity, data, and AI, weighing business value, costs, risks, and alternatives',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="CIO Office | Fede Rodrigo"
			description="Independent technology advisory for boards and executives: strategy, ERP, transformation oversight, fractional CIO, and investment risk"
			lang="en"
		/>

		<style>
			/* =========================================================
			   CIO OFFICE TITLE
			========================================================= */

			.cio-office-capabilities-tagline {
				margin: 0;

				font-size: clamp(1.85rem, 2.7vw, 2.25rem);
				font-weight: 650;
				line-height: 1.12;
				letter-spacing: -0.035em;

				color: var(--navy);
			}

			.cio-office-capabilities-tagline::after {
				content: none;
				display: none;
			}

			.cio-office-capabilities-tagline span {
				display: inline-block;
			}


			/* =========================================================
			   TAGLINE ANIMATION
			========================================================= */

			.js .cio-office-capabilities-tagline span {
				opacity: 0;
				transform: translateY(12px);
			}

			.cio-office-capabilities.is-visible
				.cio-office-capabilities-tagline
				span {
				animation:
					tagline-reveal
					0.7s
					cubic-bezier(0.22, 1, 0.36, 1)
					forwards;
			}

			.cio-office-capabilities.is-visible
				.tagline-part-1 {
				animation-delay: 0.15s;
			}

			.cio-office-capabilities.is-visible
				.tagline-part-2 {
				animation-delay: 0.25s;
			}

			.cio-office-capabilities.is-visible
				.tagline-part-3 {
				animation-delay: 0.35s;
			}

			.cio-office-capabilities.is-visible
				.tagline-part-4 {
				animation-delay: 0.45s;
			}

			.cio-office-capabilities.is-visible
				.tagline-part-5 {
				animation-delay: 0.55s;
			}

			@keyframes tagline-reveal {
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}


			/* =========================================================
			   MOBILE
			========================================================= */

			@media (max-width: 720px) {
				.cio-office-capabilities-tagline {
					font-size: 1.6rem;
					line-height: 1.15;
				}
			}


			/* =========================================================
			   REDUCED MOTION
			========================================================= */

			@media (prefers-reduced-motion: reduce) {
				.js .cio-office-capabilities-tagline span {
					opacity: 1;
					transform: none;
					animation: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>

			<!-- =====================================================
			     CAPABILITIES
			===================================================== -->

			<section class="cio-office-capabilities reveal-section">

				<div class="cio-office-capabilities-heading reveal-item">

					<img
						src="/images/cio-office-logo.png"
						alt="CIO Office"
						class="cio-office-capabilities-logo animated-image"
					/>

					<h2
						class="cio-office-capabilities-tagline"
						aria-label="Strategy • Advisory • Transformation"
					>
						<span
							class="tagline-part tagline-part-1"
							aria-hidden="true"
						>
							Strategy
						</span>

						<span
							class="tagline-dot tagline-part-2 accent"
							aria-hidden="true"
						>
							•
						</span>

						<span
							class="tagline-part tagline-part-3"
							aria-hidden="true"
						>
							Advisory
						</span>

						<span
							class="tagline-dot tagline-part-4 accent"
							aria-hidden="true"
						>
							•
						</span>

						<span
							class="tagline-part tagline-part-5"
							aria-hidden="true"
						>
							Transformation
						</span>
					</h2>

				</div>


				<div class="leadership-grid">

					{
						capabilities.map((capability, index) => (

							<div
								class="leadership-card"
								style={`--card-index: ${index};`}
							>
								<h3>
									{capability.title}
								</h3>

								<p>
									{capability.description}
								</p>
							</div>

						))
					}

				</div>

			</section>


			<!-- =====================================================
			     CONTACT
			===================================================== -->

			<section class="page-closing reveal-section">

				<h2 class="reveal-item">
					CIO Office
				</h2>

				<div class="reveal-item reveal-delay-1">

					<p>
						For independent board and executive advisory, ERP
						decisions, transformation oversight, or fractional CIO
						leadership, please reach out directly
					</p>

					<p class="cio-office-contact-link">

						<a
							href="/contact/"
							class="animated-link"
						>
							<span>
								Contact me
							</span>

							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>

					</p>

				</div>

			</section>

		</main>

		<Footer />


		<!-- =====================================================
		     REVEAL
		===================================================== -->

		<script>
			const sections =
				document.querySelectorAll('.reveal-section');

			const revealObserver =
				new IntersectionObserver(
					(entries, observer) => {

						entries.forEach((entry) => {

							if (!entry.isIntersecting) {
								return;
							}

							entry.target.classList.add(
								'is-visible'
							);

							observer.unobserve(
								entry.target
							);

						});

					},
					{
						threshold: 0.12,
						rootMargin:
							'0px 0px -60px 0px',
					}
				);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>

	</body>
</html>
