---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">
	<head>
		<SEO
			title="The CIO Office | Fede Rodrigo"
			description="Executive technology leadership focused on people, business value, operational excellence, and execution"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="cio-office-hero">
				<h1>
					The CIO <span class="accent">Office</span>
				</h1>

				<p class="lead">
					Strategic and hands-on technology leadership focused on aligning
					people, business objectives, operational excellence, and execution
				</p>

				<div class="page-statement">
					People First. Business Driven. Technology Enabled.
				</div>
			</section>

			<section class="cio-office-capabilities">
				<div class="cio-office-capabilities-heading">
					<img
						src="/images/cio-office-logo.png"
						alt="The CIO Office"
						class="cio-office-capabilities-logo"
					/>

					<h2>Executive Leadership • Advisory • Transformation</h2>
				</div>

				<div class="leadership-grid">
					<div class="leadership-card">
						<h3>Executive Technology Leadership</h3>

						<p>
							Align technology strategy with business objectives, operating
							models, governance, and long-term value creation
						</p>
					</div>

					<div class="leadership-card">
						<h3>Infrastructure, Cloud & Cybersecurity</h3>

						<p>
							Modernize infrastructure, cloud, networks, cybersecurity, and
							end-user services
						</p>
					</div>

					<div class="leadership-card">
						<h3>Enterprise Applications & Data</h3>

						<p>
							Deliver ERP, enterprise applications, business intelligence,
							and data initiatives that improve visibility, execution, and
							decision-making
						</p>
					</div>

					<div class="leadership-card">
						<h3>M&A Technology Integration</h3>

						<p>
							Integrate systems, infrastructure, applications, data, and
							teams during mergers and acquisitions
						</p>
					</div>

					<div class="leadership-card">
						<h3>IT & Operational Technology</h3>

						<p>
							Connect IT and operational technology to improve resilience,
							security, business continuity, and operational performance
						</p>
					</div>

					<div class="leadership-card">
						<h3>Fractional CIO & Advisory</h3>

						<p>
							Support CEOs and executive teams with strategic technology
							leadership, transformation, and execution
						</p>
					</div>
				</div>
			</section>

			<section class="cio-office-contact">
				<h2>Executive Leadership & Advisory</h2>

				<p>
					For CIO leadership, fractional CIO engagements, executive advisory,
					transformation initiatives, or technology strategy discussions,
					please reach out directly
				</p>

				<p class="cio-office-contact-link">
					<a href="/contact">
						Contact me →
					</a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
