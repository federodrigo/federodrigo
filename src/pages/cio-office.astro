---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const capabilities = [
	{
		title: 'Executive Technology Leadership',
		description:
			'Align technology strategy, investment, governance, and execution with business priorities and long-term value',
	},
	{
		title: 'ERP & Enterprise Systems',
		description:
			'Select, oversee, assess, and recover ERP and enterprise application initiatives with independent client-side leadership',
	},
	{
		title: 'Infrastructure & Cloud',
		description:
			'Define and oversee infrastructure modernization, cloud strategy, migrations, workplace platforms, and major technology transitions',
	},
	{
		title: 'Cybersecurity & Resilience',
		description:
			'Strengthen cybersecurity strategy, governance, risk management, resilience, and business continuity',
	},
	{
		title: 'Data & AI Strategy',
		description:
			'Identify valuable data and AI opportunities, assess readiness, define governance, select solutions, and oversee execution',
	},
	{
		title: 'Fractional CIO & Advisory',
		description:
			'Support CEOs and executive teams with independent CIO-level judgment for critical technology decisions and transformations',
	},
];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<SEO
			title="The CIO Office | CXY Office"
			description="Independent CIO-level advisory for ERP, infrastructure, cloud, cybersecurity, data, AI, and critical technology decisions"
			lang="en"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1 class="hero-title">
					<span class="hero-line">
						The CIO <span class="accent">Office</span>
					</span>
				</h1>

				<div class="lead-principles">
					<div>Technology Is Not the Starting Point</div>
					<div>Business Is</div>
				</div>
			</section>

			<section class="cio-office-capabilities reveal-section">
				<div
					class="cio-office-capabilities-heading reveal-item"
				>
					<img
						src="/images/cio-office-logo.png"
						alt="The CIO Office"
						class="cio-office-capabilities-logo animated-image"
					/>

					<h2>
						Strategy • Advisory • Transformation
					</h2>
				</div>

				<div class="leadership-grid">
					{
						capabilities.map((capability, index) => (
							<div
								class="leadership-card"
								style={`--card-index: ${index};`}
							>
								<h3>{capability.title}</h3>

								<p>{capability.description}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="cio-office-contact reveal-section">
				<h2 class="reveal-item">
					CXY Office
				</h2>

				<div class="reveal-item reveal-delay-1">
					<p>
						For independent technology advisory, ERP and transformation
						initiatives, fractional CIO engagements, or critical
						technology decisions, please reach out directly
					</p>

					<p class="cio-office-contact-link">
						<a href="/contact/" class="animated-link">
							<span>Contact me</span>
							<span
								class="animated-link-arrow"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			const sections = document.querySelectorAll('.reveal-section');

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				},
				{
					threshold: 0.12,
					rootMargin: '0px 0px -60px 0px',
				}
			);

			sections.forEach((section) => {
				revealObserver.observe(section);
			});
		</script>
	</body>
</html>
