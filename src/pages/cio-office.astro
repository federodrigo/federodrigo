---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Inquiry from '../components/Inquiry.astro';

const capabilities = [
	{
		title: 'Board & Executive Advisory',
		description:
			'Independent advice to boards, CEOs, and executive teams on technology investments, strategic decisions, risks, and critical initiatives',
	},
	{
		title: 'Technology Strategy & Governance',
		description:
			'Define technology priorities, decision processes, and governance around business needs, outcomes, and long-term value',
	},
	{
		title: 'ERP & Corporate Applications Advisory',
		description:
			'Provide independent advice to boards and executive teams on business cases, evaluation, and selection of ERP, human resources, payroll, finance, and other corporate applications, with executive oversight of implementation when appropriate',
	},
	{
		title: 'IT Turnaround & Program Oversight',
		description:
			'Assess troubled IT departments, services, and technology projects, identify root causes, and advise executive leadership on restoring control, with executive oversight rather than day-to-day project management',
	},
	{
		title: 'Fractional CIO',
		description:
			'Provide CIO-level leadership and judgment to organizations that need executive technology direction without hiring a full-time CIO',
	},
	{
		title: 'Technology Investment & Risk',
		description:
			'Evaluate choices across infrastructure, cloud, cybersecurity, data, and AI, weighing business value, costs, risks, and alternatives',
	},
];

import SiteEffects from '../components/SiteEffects.astro';
---
<!doctype html>
<html lang="en"><head><SEO
			title="CIO Office | Fede Rodrigo"
			description="Independent technology advisory for boards and executives: strategy, ERP, transformation oversight, fractional CIO, and investment risk"
			lang="en"
		/></head><body><Header />
<main id="main-content"><section class="page-intro advisory-page-intro"><div class="advisory-identity"><h1><img class="cio-page-logo" src="/images/cio-office-logo.png" alt="CIO Office" width="1024" height="927" /></h1><p class="advisory-tagline">Strategy · Advisory · Transformation</p></div></section>
			<section id="services" class="cio-office-capabilities reveal-section">
                <h2 class="visually-hidden">Advisory services</h2>
				<div class="leadership-grid">
					{
						capabilities.map((capability, index) => (
							<div
								class="leadership-card"
								style={`--card-index: ${index};`}
							>
								<h3>
									{capability.title}
								</h3>
								<p>
									{capability.description}
								</p>
							</div>
						))
					}
				</div>
			</section>
		</main>
<Inquiry lang="en" context="advisory" /><Footer /><SiteEffects /></body></html>
